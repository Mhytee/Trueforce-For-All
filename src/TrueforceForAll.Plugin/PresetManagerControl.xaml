<!-- The user's preset library, embedded inline as the Presets tab of the
     main settings panel (was a stand-alone "Manage presets" Window). Three
     inner tabs: game presets, car presets, custom engines. Mutations raise
     LibraryChanged so the host can refresh its always-visible header combos. -->
<UserControl x:Class="TrueforceForAll.Plugin.PresetManagerControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins">
    <UserControl.Resources>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Custom-templated row button. SimHub's stock theme greys every
             Button.Background regardless of IsEnabled, which made the dialog's
             action buttons look the same color whether they were usable or
             not. The template here uses explicit Background colors per state
             so disabled buttons are visibly dimmer than enabled ones. -->
        <!-- Segmented selector button (RadioButton). Replaces the inner tab
             strip so the Presets tab doesn't stack a second row of tabs under
             the main tab bar. Checked = accent blue (matches the app's Test
             button), unchecked = flat grey pill. -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#CFCFCF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#3A3A3A" CornerRadius="4"
                                SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#474747"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A6BBE"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Game-filter chip in the car tab. RadioButton so the chips are
             mutually exclusive (one game at a time, or 'All'). Compact pad
             vs SegmentButton because there can be many of them. -->
        <Style x:Key="ChipButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#CFCFCF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#3A3A3A" CornerRadius="3"
                                SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#474747"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A6BBE"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Multi-select chip (CheckBox) for the community game filter. Same
             pill look as the single-select ChipButton (RadioButton) but lets
             several games be active at once. Checked = accent blue. -->
        <Style x:Key="ToggleChipButton" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#CFCFCF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="#3A3A3A" CornerRadius="3"
                                SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#474747"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A6BBE"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Width" Value="92"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#5A5A5A" CornerRadius="3" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6E6E6E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#454545"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#363636"/>
                                <Setter Property="Foreground" Value="#777"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Primary call-to-action button: RowButton with a warm gold fill
             so the one action that matters most in a view stands out from
             the grey neighbours. Used on the library's "Set as default"
             (the day-to-day primary action), the community Download button
             (the whole point of the browser), and the empty-state Share CTA.
             Note: the library Share buttons are deliberately NOT gold; an
             occasional upload shouldn't out-shout setting a default. -->
        <Style x:Key="SharePrimaryButton" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Padding is template-bound so auto-width users (the
                             empty-state share CTA) get side breathing room; the
                             fixed-width users default to Padding=1, unchanged. -->
                        <Border x:Name="Bd" Background="#E5C04A" BorderBrush="#E5C04A" BorderThickness="1" CornerRadius="3" SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2D165"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F2D165"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C9A53A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C9A53A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3F3727"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3F3727"/>
                                <Setter Property="Foreground" Value="#7A6D4D"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Destructive action button. RowButton sizing, but red-tinted so
             Delete / Remove read as dangerous instead of looking identical
             to Edit / Duplicate. Quiet by default (soft red text on a dim
             red-grey fill), stronger red on hover so the consequence is
             clear without shouting. -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Width" Value="92"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#7A3333" BorderBrush="#9E4444" BorderThickness="1"
                                CornerRadius="3" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9E4040"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C05858"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5E2727"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3A2E2E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A2E2E"/>
                                <Setter Property="Foreground" Value="#8A7373"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Mouse-following details popup. IsHitTestVisible=False so the
             popup itself doesn't catch the cursor (which would stop the
             ListView's MouseMove from firing, breaking the follow). The
             code-behind sets PlacementTarget to whichever ListView the
             cursor is over and updates HorizontalOffset / VerticalOffset
             on each MouseMove so the popup tracks the cursor. -->
        <Popup x:Name="DetailsPopup" AllowsTransparency="True"
               Placement="Relative" StaysOpen="True" IsOpen="False" IsHitTestVisible="False">
            <Border Background="#FF2A2A2A" CornerRadius="3"
                    BorderBrush="#3A6BBE" BorderThickness="1" Padding="10,8" MaxWidth="500">
                <TextBlock x:Name="DetailsPopupText" TextWrapping="Wrap"
                           FontSize="11" Foreground="#FFE6E6E6"/>
            </Border>
        </Popup>

        <DockPanel Grid.Row="0">
            <!-- DEV-mode banner. Hidden by default; shown by code-behind
                 when Settings.DevModeUnlocked flips true so the user sees
                 a clear in-context cue that the elevated tooling on this
                 tab is unlocked (per-row 'Set as built-in' buttons + the
                 Developer toolbar at the bottom). -->
            <Border x:Name="DevModeBanner" DockPanel.Dock="Top"
                    Visibility="Collapsed" Margin="0,0,0,10" Padding="10,6,10,6"
                    Background="#3A6BBE" CornerRadius="3">
                <TextBlock Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="Developer mode is active. Per-row Set as built-in buttons + the Developer toolbar at the bottom are unlocked. Type DEV again in Settings to turn it off."/>
            </Border>
            <!-- Segmented selector in place of an inner tab strip. The one
                 refresh icon docked right is context-aware: in a Library
                 view it reloads built-ins + user library from disk (handy
                 for files dropped into the library folders); in a Community
                 or My-uploads view it re-fetches the latest server list.
                 This replaces the separate "Refresh" button that used to
                 live inside the community panel. -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button x:Name="RefreshLibraryBtn" DockPanel.Dock="Right"
                        Width="28" Height="28" Padding="0"
                        Background="#3A3A3A" BorderBrush="#3A3A3A" Foreground="#CFCFCF"
                        Cursor="Hand" Click="RefreshLibrary_Click"
                        AutomationProperties.Name="Refresh library"
                        ToolTip="Refresh. In a Library view, reloads presets from disk (use after dropping JSON files into the library folders). When browsing Community or My uploads, re-fetches the latest list from the server.">
                    <TextBlock x:Name="RefreshGlyph" Text="&#x21BB;" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="RefreshGlyphRotate" Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>
                <!-- Persistent gold chip surfacing pending community preset
                     updates (rows the user hasn't yet acted on). Hidden when
                     count is zero. Click re-runs the update check and opens
                     PresetUpdatesAvailableWindow for per-row decisions. -->
                <Button x:Name="UpdatesChip" DockPanel.Dock="Right"
                        Visibility="Collapsed"
                        Height="28" Padding="12,0"
                        Margin="0,0,8,0"
                        Background="#E5C04A" BorderBrush="#E5C04A"
                        Foreground="#1E1E1E" FontWeight="Bold" FontSize="12"
                        Cursor="Hand" Click="UpdatesChip_Click"
                        Focusable="False" FocusVisualStyle="{x:Null}"
                        ToolTip="One or more community presets you downloaded have a newer version. Click to review them."/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SegGame"      Content="Game presets"      GroupName="PresetSeg" Style="{StaticResource SegmentButton}" IsChecked="True" Checked="Segment_Checked"/>
                    <RadioButton x:Name="SegCar"       Content="Car presets"       GroupName="PresetSeg" Style="{StaticResource SegmentButton}" Checked="Segment_Checked"/>
                    <RadioButton x:Name="SegCustom"    Content="Custom engines"    GroupName="PresetSeg" Style="{StaticResource SegmentButton}" Checked="Segment_Checked"/>
                    <RadioButton x:Name="SegPacks"     Content="Packs"             GroupName="PresetSeg" Style="{StaticResource SegmentButton}" Checked="Segment_Checked"/>
                    <!-- ONE global view-mode strip: Library | Community | My
                         uploads. It applies to whichever segment (kind) is
                         active and PERSISTS across segment switches, so picking
                         Community on Game presets keeps you on Community when
                         you move to Car presets. (Was a separate strip per
                         segment, which jumped you back to Library on a switch.)
                         "Library" rather than "Mine" since downloaded community
                         presets also become "yours" once saved locally. -->
                    <Border x:Name="ModeWrap"
                            Margin="12,0,0,0" Padding="0"
                            BorderBrush="#3A3A3A" BorderThickness="1,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                            <RadioButton x:Name="ModeLibrary"   Content="Library"    GroupName="ManagerMode" Style="{StaticResource SegmentButton}" IsChecked="True" Checked="Mode_Checked"
                                         ToolTip="Presets saved on this machine (yours plus anything downloaded from the community)."/>
                            <RadioButton x:Name="ModeCommunity" Content="Community"  GroupName="ManagerMode" Style="{StaticResource SegmentButton}" Checked="Mode_Checked"
                                         ToolTip="Browse presets shared by other drivers."/>
                            <RadioButton x:Name="ModeUploads"   Content="My uploads" GroupName="ManagerMode" Style="{StaticResource SegmentButton}" Checked="Mode_Checked"
                                         ToolTip="Presets you've uploaded. Select a row to edit or delete your upload."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- The three views share one cell; the selected segment shows one. -->
            <Grid>
            <!-- ===================== Game presets ===================== -->
            <!-- DockPanel layout (not Grid) so the dynamic-visibility details
                 panel can collapse/expand cleanly without juggling Grid.Row
                 indices. Top: help, search. Bottom (in declared order):
                 buttons, then details above them. LastChildFill: list. -->
            <DockPanel x:Name="GamePanel">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource HelpText}" Margin="0,0,0,8"
                               Text="Select a preset to see what it contains; or Edit to open it on the Effects tab. You can rename, duplicate, delete, and choose which games auto-load each preset. Built-ins can't be renamed or deleted; saving over one forks a copy."/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="#FFB0B0B0" FontSize="11" Text="Filter:"/>
                        <TextBox x:Name="GameSearchBox" Height="26" Padding="6,2"
                                 ToolTip="Type to narrow the list by preset name. Cleared automatically when the tab reloads."
                                 TextChanged="GameSearchBox_TextChanged"/>
                    </DockPanel>
                    <!-- Bottom-docked buttons row. The selected-row details
                         render INLINE inside each ListViewItem via the
                         ExpandableRow ItemContainerStyle, not as a separate
                         panel here, so the list never has to shrink. -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="True">
                        <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <!-- Order mirrors the Car action bar: apply, edit,
                                 share, destructive last, DEV trailing. Wraps to a
                                 second row instead of clipping on a narrow panel. -->
                            <Button x:Name="GameSetDefaultBtn" Content="Set default games…" Style="{StaticResource SharePrimaryButton}" Width="160" Click="GameSetDefault_Click" IsEnabled="False"
                                    ToolTip="Check the games this preset should auto-load for. Uncheck to drop a game's binding. Replaces the older Set / Clear pair."/>
                            <Button x:Name="GameEditBtn"       Content="Edit"           Style="{StaticResource RowButton}" Click="GameEdit_Click"       IsEnabled="False"
                                    ToolTip="Open this preset for editing on the Effects tab, with an Editing banner. Edit and save the usual way; Done returns you to your previously-active preset (saving over a built-in forks a copy)."/>
                            <Button x:Name="GameDuplicateBtn"  Content="Duplicate…"     Style="{StaticResource RowButton}" Click="GameDuplicate_Click"  IsEnabled="False"/>
                            <Button x:Name="GameRenameBtn"     Content="Rename…"        Style="{StaticResource RowButton}" Click="GameRename_Click"     IsEnabled="False"/>
                            <Button x:Name="GameShareBtn"      Content="Share"          Style="{StaticResource RowButton}" Click="GameShare_Click"      IsEnabled="False"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Upload this game preset to the community so other drivers can find it."/>
                            <Button x:Name="GameDeleteBtn"     Content="Delete"         Style="{StaticResource DangerButton}" Click="GameDelete_Click"     IsEnabled="False"/>
                            <Button x:Name="GamePromoteBuiltinBtn" Content="Set as built-in" Style="{StaticResource RowButton}" Width="120" Click="GamePromoteBuiltin_Click" IsEnabled="False" Visibility="Collapsed"
                                    ToolTip="DEV: promote this preset to a factory built-in. It gets the 'Built-in' badge and its file moves to the factory folder. Pick one row or check several to bulk-promote."/>
                        </WrapPanel>
                        <!-- Inline result line for rename / duplicate / delete /
                             set-default, mirroring the Community pane's status. -->
                        <TextBlock x:Name="GameLibStatus" DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Foreground="#7FC77F" FontSize="11" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" Text=""/>
                        <TextBlock x:Name="GameCheckedLabel" VerticalAlignment="Center"
                                   Foreground="#FFD54F" FontSize="11" Margin="0,0,8,0" Text=""/>
                    </DockPanel>
                    <!-- LastChildFill: DataGrid fills whatever space the
                         docked top + bottom items leave. Star-sized name
                         column keeps the right edge pinned automatically;
                         no hand-rolled cascade/flex code needed. -->
                    <Grid>
                    <DataGrid x:Name="GameList"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserResizeRows="False"
                              CanUserSortColumns="False" CanUserReorderColumns="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              IsReadOnly="True" RowHeaderWidth="0"
                              HorizontalScrollBarVisibility="Auto"
                              SelectionChanged="GameList_SelectionChanged"
                              ColumnDisplayIndexChanged="List_ColumnDisplayIndexChanged"
                              MouseMove="List_MouseMove" MouseLeave="List_MouseLeave">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="34" MinWidth="34" CanUserSort="False" CanUserReorder="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="GameSelectAllCheck" IsThreeState="False"
                                              Click="GameSelectAll_Click" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                              ToolTip="Check / uncheck every visible game preset."/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="RowCheckBox_Toggled" Unchecked="RowCheckBox_Toggled"
                                                  HorizontalAlignment="Left" Margin="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Default for"  Width="240" MinWidth="130" Binding="{Binding DefaultForLabel}"/>
                            <DataGridTextColumn Header="Preset name"  Width="*"   MinWidth="130" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Source"       Width="120" MinWidth="100" Binding="{Binding Source}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- Empty-state overlay: visible when the grid has
                         no rows. Driven by ReloadGames in code-behind. -->
                    <TextBlock x:Name="GameListEmpty" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#FFB0B0B0" FontSize="12" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="420" Margin="0,40,0,0"
                               Text="No game presets yet. Save your tuning as a preset from the Effects tab to start a library."/>
                    </Grid>
            </DockPanel>

            <!-- ===================== Car presets ===================== -->
            <!-- DockPanel layout (see GamePanel notes). Order: top items first,
                 bottom items in reverse-visual order (buttons, then details
                 above them), list last (LastChildFill). -->
            <DockPanel x:Name="CarPanel" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource HelpText}" Margin="0,0,0,8"
                               Text="Every car preset, grouped by game then car. A car can have several presets; the ★ in Default marks the one that loads for that car. Rename, duplicate, delete, or set a preset as the car's default."/>
                    <!-- Per-game filter chips. Rebuilt from the loaded rows on
                         every ReloadCars; click a chip to narrow to that game. -->
                    <WrapPanel DockPanel.Dock="Top" x:Name="CarGameChips" Margin="0,0,0,6"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="#FFB0B0B0" FontSize="11" Text="Filter:"/>
                        <TextBox x:Name="CarSearchBox" Height="26" Padding="6,2"
                                 ToolTip="Type to narrow the list by car ID or preset name. Composes with the game chips above."
                                 TextChanged="CarSearchBox_TextChanged"/>
                    </DockPanel>
                    <!-- Bottom-docked: buttons at the very bottom; details
                         Border above them (next bottom slot). Both declared
                         BEFORE the ListView so the list (LastChild) gets
                         whatever space is left. -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="True">
                        <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <!-- Order: apply (Set as default, Edit) -> edit
                                 (Duplicate, Rename) -> share -> destructive
                                 (Delete) -> DEV. Groups read left-to-right by
                                 frequency / role; destructive last so a stray
                                 click doesn't blow away work. Renaming the CAR
                                 (vs the preset) lives in the Car facts panel's
                                 Name box on the active card, so there's no
                                 second "name" button here. -->
                            <Button x:Name="CarSetActiveBtn" Content="Set as default" Style="{StaticResource SharePrimaryButton}" Width="120" Click="CarSetActive_Click" IsEnabled="False"
                                    ToolTip="Make this the preset that loads for this car by default. With multiple rows checked, sets each as its own car's default (one per car; it won't apply if two rows target the same car)."/>
                            <Button x:Name="CarEditBtn"      Content="Edit"         Style="{StaticResource RowButton}" Click="CarEdit_Click"      IsEnabled="False"
                                    ToolTip="Open this car preset on the Effects tab to change its values. Saving over a built-in makes a copy."/>
                            <Button x:Name="CarDuplicateBtn" Content="Duplicate…"   Style="{StaticResource RowButton}" Click="CarDuplicate_Click" IsEnabled="False"/>
                            <Button x:Name="CarRenameBtn"    Content="Rename…"      Style="{StaticResource RowButton}" Click="CarRename_Click"    IsEnabled="False"
                                    ToolTip="Rename this preset (e.g. 'Wet setup' to 'Endurance'). To rename the CAR instead, click Edit and use the Rename button on the header card."/>
                            <Button x:Name="CarShareBtn"     Content="Share"        Style="{StaticResource RowButton}" Click="CarShare_Click"     IsEnabled="False"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Upload this car preset to the community so other drivers can find it."/>
                            <Button x:Name="CarDeleteBtn"    Content="Delete"       Style="{StaticResource DangerButton}" Click="CarDelete_Click"    IsEnabled="False"/>
                            <Button x:Name="CarPromoteBuiltinBtn" Content="Set as built-in" Style="{StaticResource RowButton}" Width="120" Click="CarPromoteBuiltin_Click" IsEnabled="False" Visibility="Collapsed"
                                    ToolTip="DEV: promote this car preset to a factory built-in. It gets the 'Built-in' badge and its file moves to the factory folder. Pick one row or check several to bulk-promote."/>
                        </WrapPanel>
                        <TextBlock x:Name="CarLibStatus" DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Foreground="#7FC77F" FontSize="11" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" Text=""/>
                        <TextBlock x:Name="CarCheckedLabel" VerticalAlignment="Center"
                                   Foreground="#FFD54F" FontSize="11" Margin="0,0,8,0" Text=""/>
                    </DockPanel>
                    <Grid>
                    <DataGrid x:Name="CarList"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserResizeRows="False"
                              CanUserSortColumns="False" CanUserReorderColumns="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              IsReadOnly="True" RowHeaderWidth="0"
                              HorizontalScrollBarVisibility="Auto"
                              SelectionChanged="CarList_SelectionChanged"
                              ColumnDisplayIndexChanged="List_ColumnDisplayIndexChanged"
                              MouseMove="List_MouseMove" MouseLeave="List_MouseLeave">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="34" MinWidth="34" CanUserSort="False" CanUserReorder="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="CarSelectAllCheck" IsThreeState="False"
                                              Click="CarSelectAll_Click" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                              ToolTip="Check / uncheck every visible car preset."/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="RowCheckBox_Toggled" Unchecked="RowCheckBox_Toggled"
                                                  HorizontalAlignment="Left" Margin="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Default"     Width="60"  MinWidth="60"  Binding="{Binding ActiveLabel}"/>
                            <DataGridTextColumn Header="Game"        Width="130" MinWidth="70"  Binding="{Binding GameLabel}"/>
                            <DataGridTextColumn Header="Car name"    Width="*"   MinWidth="160" Binding="{Binding CarName}"/>
                            <DataGridTextColumn Header="Preset name" Width="190" MinWidth="130" Binding="{Binding DisplayName}"/>
                            <DataGridTextColumn Header="Car ID"      Width="170" MinWidth="120" Binding="{Binding CarId}"/>
                            <DataGridTextColumn Header="Source"      Width="120" MinWidth="100" Binding="{Binding Source}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="CarListEmpty" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#FFB0B0B0" FontSize="12" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="420" Margin="0,40,0,0"
                               Text="No car-specific presets yet. Load a car in a game, tune an effect section, and use Save for this car on the Effects tab."/>
                    </Grid>
            </DockPanel>

            <!-- ===================== Custom engines ===================== -->
            <DockPanel x:Name="CustomPanel" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource HelpText}" Margin="0,0,0,8"
                               Text="Your saved custom engines. Edit or delete them here; if you delete one a preset uses, that preset falls back to the Auto engine mode until you pick a new one. Built-in layouts (V8, Rotary, etc.) aren't listed."/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="#FFB0B0B0" FontSize="11" Text="Filter:"/>
                        <TextBox x:Name="CustomSearchBox" Height="26" Padding="6,2"
                                 ToolTip="Type to narrow the list by engine name."
                                 TextChanged="CustomSearchBox_TextChanged"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="CustomEditBtn"   Content="Edit…"   Style="{StaticResource RowButton}" Click="CustomEdit_Click"   IsEnabled="False"/>
                            <Button x:Name="CustomShareBtn"  Content="Share"  Style="{StaticResource RowButton}" Click="CustomShare_Click"  IsEnabled="False"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Upload this custom engine to the community so other drivers can find it."/>
                            <Button x:Name="CustomDeleteBtn" Content="Delete"  Style="{StaticResource DangerButton}" Click="CustomDelete_Click" IsEnabled="False"/>
                        </StackPanel>
                        <TextBlock x:Name="CustomCheckedLabel" VerticalAlignment="Center"
                                   Foreground="#FFD54F" FontSize="11" Margin="0,0,8,0" Text=""/>
                    </DockPanel>
                    <Grid>
                    <DataGrid x:Name="CustomList"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserResizeRows="False"
                              CanUserSortColumns="False" CanUserReorderColumns="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              IsReadOnly="True" RowHeaderWidth="0"
                              HorizontalScrollBarVisibility="Auto"
                              SelectionChanged="CustomList_SelectionChanged"
                              ColumnDisplayIndexChanged="List_ColumnDisplayIndexChanged"
                              MouseMove="List_MouseMove" MouseLeave="List_MouseLeave">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="34" MinWidth="34" CanUserSort="False" CanUserReorder="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="CustomSelectAllCheck" IsThreeState="False"
                                              Click="CustomSelectAll_Click" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                              ToolTip="Check / uncheck every visible custom engine."/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="RowCheckBox_Toggled" Unchecked="RowCheckBox_Toggled"
                                                  HorizontalAlignment="Left" Margin="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name"   Width="*"   MinWidth="150" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Type"   Width="130" MinWidth="80"  Binding="{Binding TypeLabel}"/>
                            <DataGridTextColumn Header="Detail" Width="220" MinWidth="100" Binding="{Binding Detail}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="CustomListEmpty" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#FFB0B0B0" FontSize="12" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="420" Margin="0,40,0,0"
                               Text="No custom engines yet. Create one from the Engine pulse section on the Effects tab (drop-down > New custom engine)."/>
                    </Grid>
            </DockPanel>

            <!-- ===================== Packs (Library mode) ===================== -->
            <!-- Inline list of installed packs, mirroring the
                 Games/Cars/Engines panels. Bottom button row exposes
                 the same Set-as-defaults / Remove flows the standalone
                 PackManagerWindow has, plus the new Create button. -->
            <DockPanel x:Name="PacksPanel" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource HelpText}" Margin="0,0,0,8"
                           Text="A pack bundles several presets at once. Pick an installed pack to set every preset it includes as a default in one go, or to remove the whole bundle (preserving any entries you've edited). Browse the Community view to find packs other drivers have shared."/>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="PacksCreateBtn"      Content="Create a pack…"   Style="{StaticResource RowButton}" Width="120" Click="CreatePack_Click"
                                ToolTip="Bundle game presets, car presets, and custom engines from your library into a pack and upload it to the community."/>
                        <Button x:Name="PacksSetDefaultsBtn" Content="Set as defaults"  Style="{StaticResource SharePrimaryButton}" Width="120" Click="PacksSetDefaults_Click" IsEnabled="False"
                                ToolTip="Bind every preset this pack ships as the auto-load default for the games / cars it targets."/>
                        <Button x:Name="PacksRemoveBtn"      Content="Remove pack"      Style="{StaticResource DangerButton}" Width="100" Click="PacksRemove_Click" IsEnabled="False"
                                ToolTip="Delete every preset this pack installed that you haven't edited. User-edited entries are preserved."/>
                    </StackPanel>
                    <TextBlock x:Name="PacksStatusLabel" VerticalAlignment="Center"
                               Foreground="#FFB0B0B0" FontSize="11" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" Text=""/>
                </DockPanel>
                <DataGrid x:Name="PacksList"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserResizeRows="False"
                          CanUserSortColumns="False" CanUserReorderColumns="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          IsReadOnly="True" RowHeaderWidth="0"
                          HorizontalScrollBarVisibility="Auto"
                          SelectionChanged="PacksList_SelectionChanged"
                          MouseMove="List_MouseMove" MouseLeave="List_MouseLeave">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pack name" Width="*"   MinWidth="160" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Shared by"    Width="140" MinWidth="80"  Binding="{Binding Author}"/>
                        <DataGridTextColumn Header="Version"   Width="80"  MinWidth="60"  Binding="{Binding Version}"/>
                        <DataGridTextColumn Header="Entries"   Width="70"  MinWidth="60"  Binding="{Binding EntryCount}"/>
                        <DataGridTextColumn Header="Imported"  Width="120" MinWidth="100" Binding="{Binding ImportedLabel}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- ===================== Community Browser ===================== -->
            <!-- Shared by all four segments' Community + My-uploads sub-tabs.
                 Which scope (for-car browse vs your own uploads) is driven by
                 the segment strip above, not by an in-panel switch. -->
            <DockPanel x:Name="CommunityPanel" Visibility="Collapsed">
                <TextBlock x:Name="CommunityHelpText" DockPanel.Dock="Top" Style="{StaticResource HelpText}" Margin="0,0,0,8"
                           Text="Browse + download community presets for the car you're driving. Pick a row and Download to import; you'll get a section picker so you can take just the parts you want."/>
                <!-- Gated empty-state. Community presets need online features turned
                     on AND an account (browse is account-required). When either is
                     missing, ApplyCommunityGate shows this in place of the browser
                     and the button clears the missing gate (enable, then sign in). -->
                <StackPanel x:Name="CommunityGatePanel" DockPanel.Dock="Top" Visibility="Collapsed"
                            HorizontalAlignment="Center" MaxWidth="380" Margin="0,40,0,0">
                    <TextBlock x:Name="CommunityGateTitle" FontSize="14" FontWeight="SemiBold"
                               Foreground="#FFE0E0E0" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,0,0,6" Text=""/>
                    <TextBlock x:Name="CommunityGateBody" FontSize="12" Foreground="#FFB0B0B0"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14" Text=""/>
                    <!-- Explicit Width: SharePrimaryButton hard-sets Width=100 and
                         its template ignores Padding, so without this the longer
                         "Enable community features" label clips. 220 fits both labels. -->
                    <Button x:Name="CommunityGateBtn" Style="{StaticResource SharePrimaryButton}"
                            HorizontalAlignment="Center" Width="220" Height="32"
                            Click="CommunityGate_Click" Content="Enable community features"/>
                </StackPanel>
                <!-- Search row. Typing broadens past the active-car default to
                     all cars across the selected games, matching preset name,
                     author, or car name. The ✕ clears back to the active car. -->
                <DockPanel x:Name="CommunitySearchRow" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#FFB0B0B0" FontSize="11" Text="Search:"/>
                    <Button x:Name="CommunitySearchClearBtn" DockPanel.Dock="Right" Width="26" Height="26"
                            Margin="6,0,0,0" Content="&#x2715;"
                            Background="#3A3A3A" BorderBrush="#3A3A3A" Foreground="#CFCFCF"
                            Cursor="Hand" Click="CommunitySearchClear_Click"
                            Focusable="False" FocusVisualStyle="{x:Null}"
                            ToolTip="Clear the search and go back to the car you're driving."/>
                    <TextBox x:Name="CommunitySearchBox" Height="26" Padding="6,2"
                             TextChanged="CommunitySearchBox_TextChanged"
                             ToolTip="Find presets by name, author, or car name (e.g. type 'mx5') across the games selected below. Clear to go back to the car you're driving."/>
                </DockPanel>
                <!-- Multi-select game filter (built in code-behind). Lets the
                     user widen the browse to several games at once. Visible
                     only for car / game presets. -->
                <WrapPanel x:Name="CommunityGameChips" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                <DockPanel x:Name="CommunityScopeRow" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock x:Name="CommunityScopeLabel" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#FFB0B0B0" FontSize="11" Text="Active car:"/>
                    <ComboBox x:Name="CommunitySortCombo" DockPanel.Dock="Right" Width="120" Height="26"
                              SelectionChanged="CommunitySort_Changed"
                              ToolTip="How to order the list.">
                        <ComboBoxItem Content="Top rated" IsSelected="True"/>
                        <ComboBoxItem Content="Newest"/>
                        <ComboBoxItem Content="Most downloaded"/>
                    </ComboBox>
                    <TextBlock x:Name="CommunityCarLabel" VerticalAlignment="Center"
                               Foreground="#FFE0E0E0" FontSize="12" Text="(none)"/>
                </DockPanel>
                <DockPanel x:Name="CommunityActionsRow" DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="CommunityFixAppealBtn" Content="Fix / appeal" Style="{StaticResource SharePrimaryButton}" Click="CommunityFixAppeal_Click" IsEnabled="False" Visibility="Collapsed"
                                ToolTip="This upload was removed or suspended. Fix it and request a moderator review."/>
                        <Button x:Name="CommunityReportBtn"   Content="Report"   Style="{StaticResource RowButton}" Click="CommunityReport_Click"   IsEnabled="False"
                                ToolTip="Flag inappropriate content for moderator review."/>
                        <Button x:Name="CommunityEditBtn"     Content="Edit…"    Style="{StaticResource RowButton}" Click="CommunityEdit_Click"     IsEnabled="False" Visibility="Collapsed"
                                ToolTip="Edit one of your own uploads (name, description, body). Visible only on rows you uploaded while signed in."/>
                        <Button x:Name="CommunityDeleteBtn"   Content="Delete"   Style="{StaticResource DangerButton}" Click="CommunityDelete_Click"   IsEnabled="False" Visibility="Collapsed"
                                ToolTip="Soft-delete one of your own uploads. Visible only on rows you uploaded while signed in."/>
                        <Button x:Name="CommunityDownloadBtn" Content="Download…" Style="{StaticResource SharePrimaryButton}" Click="CommunityDownload_Click" IsEnabled="False"
                                ToolTip="Opens a preview of what's inside; pick which parts to import, then confirm."/>
                    </StackPanel>
                    <TextBlock x:Name="CommunityStatusLabel" VerticalAlignment="Center"
                               Foreground="#FFB0B0B0" FontSize="11" Margin="0,0,8,0" Text=""/>
                </DockPanel>
                <DockPanel x:Name="CommunityDescriptionRow" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock x:Name="CommunityDescriptionText" Style="{StaticResource HelpText}"
                               TextWrapping="Wrap" Text=""/>
                </DockPanel>
                <!-- Paginate: pull the next page on demand instead of all at once.
                     Cached, so a return visit shows everything already loaded. -->
                <Button x:Name="CommunityShowMoreBtn" DockPanel.Dock="Bottom" Content="Show more"
                        Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,8,0,0"
                        Padding="16,4" Click="CommunityShowMore_Click"
                        ToolTip="Load the next page of community results."/>
                <Grid>
                <DataGrid x:Name="CommunityList"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserResizeRows="False"
                          CanUserSortColumns="False" CanUserReorderColumns="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          IsReadOnly="True" RowHeaderWidth="0"
                          HorizontalScrollBarVisibility="Auto"
                          SelectionChanged="CommunityList_SelectionChanged"
                          LoadingRow="CommunityList_LoadingRow"
                          MouseMove="List_MouseMove" MouseLeave="List_MouseLeave">
                    <!-- Moderated (removed/suspended/under-review) own-upload rows are
                         greyed by dimming the realized row container in CommunityList_LoadingRow,
                         NOT via a DataGridRow style. Any RowStyle here (even BasedOn the
                         theme's) dropped the theme's hover / selection accent (the orange
                         highlight) that the Library lists get for free, so the dimming is
                         applied imperatively to leave the row style untouched. -->
                    <DataGrid.Columns>
                        <!-- Reddit-style vote column: up + score + down. Click
                             on the same arrow you previously voted toggles it
                             off (retraction). Tag carries the row reference. -->
                        <DataGridTemplateColumn Header="Vote" Width="64" MinWidth="64" CanUserResize="False" CanUserReorder="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="▲" FontSize="13"
                                                   Foreground="{Binding UpArrowBrush}"
                                                   Cursor="Hand" Margin="0,0,4,0"
                                                   MouseLeftButtonUp="CommunityVoteUpCell_Click"
                                                   Tag="{Binding}"/>
                                        <TextBlock Text="{Binding ScoreLabel}" FontSize="11" MinWidth="20"
                                                   Foreground="#FFCFCFCF" VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="▼" FontSize="13"
                                                   Foreground="{Binding DownArrowBrush}"
                                                   Cursor="Hand" Margin="4,0,0,0"
                                                   MouseLeftButtonUp="CommunityVoteDownCell_Click"
                                                   Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name"      Width="*"   MinWidth="160" Binding="{Binding Name}"/>
                        <!-- Moderation state of your own uploads (Removed / Suspended / Under review).
                             Toggled visible only in "My uploads" mode; blank otherwise. -->
                        <DataGridTextColumn x:Name="CommunityStateCol" Header="Status" Width="110" MinWidth="90" Binding="{Binding StateLabel}" Visibility="Collapsed"/>
                        <DataGridTextColumn Header="Shared by"    Width="120" MinWidth="80"  Binding="{Binding Author}"/>
                        <!-- Pack-only: how many items (presets + custom engines) the
                             bundle ships, so a small pack is distinguishable from a big
                             one without opening Preview. Toggled visible for the pack
                             kind in RelabelCommunityScopeRadio. -->
                        <DataGridTextColumn x:Name="CommunityItemCountCol" Header="Items" Width="80" MinWidth="60" Binding="{Binding PackItemCount}"/>
                        <DataGridTextColumn x:Name="CommunityGameCol" Header="Game"      Width="100" MinWidth="70"  Binding="{Binding Game}"/>
                        <!-- Game-preset only: per-row tier badge from target_games. Blank for car-preset rows. -->
                        <DataGridTextColumn x:Name="CommunityScopeCol" Header="Scope"     Width="120" MinWidth="80"  Binding="{Binding TierBadge}"/>
                        <DataGridTextColumn x:Name="CommunityCarIdCol" Header="Car ID"    Width="120" MinWidth="80"  Binding="{Binding CarId}"/>
                        <DataGridTextColumn Header="Downloads" Width="80"  MinWidth="60"  Binding="{Binding Downloads}"/>
                        <DataGridTextColumn x:Name="CommunitySectionsCol" Header="Sections"  Width="160" MinWidth="100" Binding="{Binding TagsLabel}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- Empty-state share CTA: centered where results would be.
                     CommunityRefreshAsync flips this panel visible when the
                     community list is empty for the active scope AND the user
                     has a non-builtin local preset they could publish. -->
                <StackPanel x:Name="CommunityEmptyState" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,40,0,0" MaxWidth="420">
                    <TextBlock x:Name="CommunityEmptyText"
                               Foreground="#FFB0B0B0" FontSize="12" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,10"
                               Text="Nothing shared here yet."/>
                    <Button x:Name="EmptyShareCtaBtn"
                            Style="{StaticResource SharePrimaryButton}"
                            Width="Auto" MaxWidth="360" Padding="14,0"
                            HorizontalAlignment="Center"
                            Height="28"
                            FontSize="12"
                            Click="EmptyShareCta_Click"
                            ToolTip="Share your local preset so other drivers can find it for this scope."/>
                </StackPanel>
                </Grid>
            </DockPanel>
            </Grid>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Export…" Width="100" Height="28" Margin="0,0,8,0" Click="DialogExport_Click"
                        ToolTip="Pick which presets and car tunings to bundle into a shareable file. Same flow as the Export button on the main panel."/>
                <Button Content="Import…" Width="100" Height="28" Margin="0,0,8,0" Click="DialogImport_Click"
                        ToolTip="Import a preset, car preset, pack, or full settings backup. The file kind is auto-detected."/>
                <Button Content="Installed packs…" Width="140" Height="28" Click="ManagePacks_Click"
                        ToolTip="View installed community packs. Set a pack's contents as defaults in bulk, or remove a pack (deletes its presets; entries you have edited are kept)."/>
            </StackPanel>

            <TextBlock x:Name="IoStatusLabel" FontSize="11" Foreground="#FFB0B0B0"
                       Margin="0,6,0,0" TextWrapping="Wrap" Text=""/>

            <!-- Developer tools (built-in folder maintenance). Hidden unless the
                 DEV access code is entered (Settings.DevModeUnlocked). -->
            <Border x:Name="DevBar" Visibility="Collapsed" Margin="0,12,0,0" Padding="0,10,0,0"
                    BorderBrush="#3A3A3A" BorderThickness="0,1,0,0">
                <StackPanel>
                    <TextBlock Text="Developer: built-in preset folder" FontWeight="SemiBold" FontSize="12" Foreground="#CFCFCF"/>
                    <TextBlock x:Name="DevFolderPathText" Margin="0,2,0,8" FontSize="11" Foreground="#FFB0B0B0" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button Content="Open folder"          Height="26" Width="110" Margin="0,0,8,8" Click="DevOpenFolder_Click"
                                ToolTip="Open the built-in preset folder in Explorer."/>
                        <Button Content="Validate"             Height="26" Width="90"  Margin="0,0,8,8" Click="DevValidate_Click"
                                ToolTip="Parse every built-in and flag any that fail to load or are missing a newer effect section."/>
                        <Button Content="Refresh library"      Height="26" Width="120" Margin="0,0,8,8" Click="DevRefreshLibrary_Click"
                                ToolTip="Re-scan the factory + user folders and rebuild every runtime cache. Use after editing files in the folders outside the app (imports, manual edits)."/>
                    </WrapPanel>
                    <TextBlock x:Name="DevStatusText" Margin="0,2,0,0" FontSize="11" Foreground="#FFC8C8C8" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
