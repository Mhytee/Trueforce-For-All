<Window x:Class="TrueforceForAll.Plugin.CustomEngineEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom engine"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF2A2A2A"
        TextElement.Foreground="#FFEAEAEA">
    <Window.Resources>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- How-to intro -->
        <TextBlock Grid.Row="0" Style="{StaticResource HelpText}" Margin="0,0,0,12"
                   Text="Build the pulse rhythm your wheel plays for an engine nothing built-in matches. Pick the firing pattern closest to the real engine and set the cylinder or rotor count; the pattern below fills in from those until you hand-edit it (Regenerate refills it on demand). Save it, then choose it in a variant's Engine dropdown to hear it on that car."/>

        <!-- Shown only when editing a legacy ELECTRIC custom: saving converts
             it to a firing-pattern engine, which flips every variant pinned
             to it from EV hum to pulses. Say so instead of doing it silently. -->
        <TextBlock Grid.Row="1" x:Name="ElectricConvertNote" Visibility="Collapsed"
                   FontSize="11" Foreground="#FFE082" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="This engine was saved as electric. Saving here converts it to a firing-pattern engine. For electric cars, use the built-in Electric engine type and the EV behavior setting instead."/>

        <!-- Name -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Name:" Style="{StaticResource LabelText}"/>
            <TextBox Grid.Column="1" x:Name="NameTextBox" Padding="4,2"
                     ToolTip="What this engine is called in the Engine dropdowns, e.g. 'LS3 swap' or 'Crossplane R1'."/>
        </Grid>

        <!-- Firing pattern shape -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Firing pattern:" Style="{StaticResource LabelText}"
                       ToolTip="Picks how pulses distribute within one 720° engine cycle. Even-fire covers Inline / Boxer / V60° / V90° / V8 flat-plane / V10 / V12 / W12-16 / V4."/>
            <ComboBox Grid.Column="1" x:Name="ShapeCombo" SelectionChanged="Shape_Changed">
                <ComboBoxItem Content="Even-fire (cyl count picks Inline / Boxer / V / W)"/>
                <ComboBoxItem Content="V8 cross-plane (American muscle, locks at 8)"/>
                <ComboBoxItem Content="V6 odd-fire 90° (locks at 6)"/>
                <ComboBoxItem Content="V-twin 90° (Ducati, locks at 2)"/>
                <ComboBoxItem Content="V-twin 60° (Aprilia, KTM, locks at 2)"/>
                <ComboBoxItem Content="V-twin 45° (Harley, locks at 2)"/>
                <ComboBoxItem Content="Inline-4 cross-plane (Yamaha R1, locks at 4)"/>
                <ComboBoxItem Content="Rotary (rotor count)"/>
                <ComboBoxItem Content="Parallel twin 180° (MT-07, RS660, locks at 2)"/>
                <ComboBoxItem Content="V4 Twin Pulse (Panigale, locks at 4)"/>
                <ComboBoxItem Content="Boxer-4 rumble (Subaru, locks at 4)"/>
            </ComboBox>
        </Grid>

        <!-- Cylinder/rotor count -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="CountLabel" Text="Cylinders:" Style="{StaticResource LabelText}"/>
            <Slider Grid.Column="1" x:Name="CountSlider" Minimum="1" Maximum="16" SmallChange="1" LargeChange="2"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="Count_ValueChanged" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" x:Name="CountText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="4"/>
        </Grid>

        <!-- Pattern textbox -->
        <Grid Grid.Row="5" Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Pattern:" Style="{StaticResource LabelText}"
                       ToolTip="Comma-separated phase positions in [0, 1) representing where each pulse fires within one 720° cycle. Optional ':amplitude' suffix per pulse. Auto-fills when you pick a shape / count above; edit freely for expert tuning."/>
            <TextBox Grid.Column="1" x:Name="PatternTextBox" FontFamily="Consolas" Padding="4,2"/>
        </Grid>

        <Grid Grid.Row="6" Margin="140,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="PatternHelp" Style="{StaticResource HelpText}"
                       Text="Each number is when a cylinder fires within one engine cycle, from 0 to 1. Hand-edit for odd-fire engines; an optional :weight per pulse (0.25:0.85) makes that pulse softer."/>
            <Button Grid.Column="1" x:Name="RegeneratePatternButton" Content="Regenerate"
                    Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Top"
                    Click="RegeneratePattern_Click"
                    ToolTip="Rebuild the pattern from the shape and cylinder count above. Replaces any manual edits."/>
        </Grid>

        <!-- Buttons -->
        <Grid Grid.Row="8" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Cancel" Width="84" Height="28" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Grid.Column="2" Content="Save" Width="84" Height="28" Click="Save_Click" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
