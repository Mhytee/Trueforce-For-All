<Window x:Class="TrueforceForAll.Plugin.CustomEngineEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TrueforceForAll.Plugin.Localization"
        Title="{loc:T EngineEditor_CustomEngine_Title}"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF2A2A2A"
        TextElement.Foreground="#FFEAEAEA">
    <Window.Resources>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- How-to intro -->
        <TextBlock Grid.Row="0" Style="{StaticResource HelpText}" Margin="0,0,0,12"
                   Text="{loc:T EngineEditor_PickTheFiringPattern}"/>

        <!-- Shown only when editing a legacy ELECTRIC custom: saving converts
             it to a firing-pattern engine, which flips every variant pinned
             to it from EV hum to pulses. Say so instead of doing it silently. -->
        <TextBlock Grid.Row="1" x:Name="ElectricConvertNote" Visibility="Collapsed"
                   FontSize="11" Foreground="#FFE082" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="{loc:T EngineEditor_ElectricConvertNote}"/>

        <!-- Name -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:T EngineEditor_Name}" Style="{StaticResource LabelText}"/>
            <TextBox Grid.Column="1" x:Name="NameTextBox" Padding="4,2"
                     ToolTip="{loc:T EngineEditor_NameText_Tip}"/>
        </Grid>

        <!-- Firing pattern shape -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:T EngineEditor_FiringPattern}" Style="{StaticResource LabelText}"
                       ToolTip="{loc:T EngineEditor_FiringPattern_Tip}"/>
            <ComboBox Grid.Column="1" x:Name="ShapeCombo" SelectionChanged="Shape_Changed">
                <ComboBoxItem Content="{loc:T EngineEditor_ShapeEvenFireCylCount}"/>
                <ComboBoxItem Content="{loc:T EngineEditor_ShapeV8CrossPlaneAmerican}"/>
                <ComboBoxItem Content="{loc:T EngineEditor_ShapeV6OddFire90Locks}"/>
                <ComboBoxItem Content="{loc:T EngineEditor_ShapeVTwin90DucatiLocks}"/>
                <ComboBoxItem Content="{loc:T EngineEditor_ShapeVTwin60ApriliaKtm}"/>
                <ComboBoxItem Content="{loc:T EngineEditor_ShapeVTwin45HarleyLocks}"/>
                <ComboBoxItem Content="{loc:T EngineEditor_ShapeInline4CrossPlane}"/>
                <ComboBoxItem Content="{loc:T EngineEditor_ShapeRotaryRotorCount}"/>
                <ComboBoxItem Content="{loc:T EngineEditor_ShapeParallelTwin180Mt}"/>
                <ComboBoxItem Content="{loc:T EngineEditor_ShapeV4TwinPulsePanigale}"/>
                <ComboBoxItem Content="{loc:T EngineEditor_ShapeBoxer4RumbleSubaru}"/>
            </ComboBox>
        </Grid>

        <!-- Cylinder/rotor count -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="CountLabel" Text="{loc:T EngineEditor_Count}" Style="{StaticResource LabelText}"/>
            <Slider Grid.Column="1" x:Name="CountSlider" Minimum="1" Maximum="16" SmallChange="1" LargeChange="2"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="Count_ValueChanged" VerticalAlignment="Center"/>
            <TextBox Grid.Column="2" x:Name="CountText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="4"/>
        </Grid>

        <!-- Pattern textbox -->
        <Grid Grid.Row="5" Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:T EngineEditor_Pattern}" Style="{StaticResource LabelText}"
                       ToolTip="{loc:T EngineEditor_Pattern_Tip}"/>
            <TextBox Grid.Column="1" x:Name="PatternTextBox" FontFamily="Consolas" Padding="4,2"/>
        </Grid>

        <Grid Grid.Row="6" Margin="140,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="PatternHelp" Style="{StaticResource HelpText}"
                       Text="{loc:T EngineEditor_PatternHelp}"/>
            <Button Grid.Column="1" x:Name="RegeneratePatternButton" Content="{loc:T EngineEditor_RegeneratePattern}"
                    Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Top"
                    Click="RegeneratePattern_Click"
                    ToolTip="{loc:T EngineEditor_RegeneratePattern_Tip}"/>
        </Grid>

        <!-- Buttons -->
        <Grid Grid.Row="8" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{loc:T Common_Cancel}" Width="84" Height="28" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Grid.Column="2" Content="{loc:T Common_Save}" Width="84" Height="28" Click="Save_Click" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
