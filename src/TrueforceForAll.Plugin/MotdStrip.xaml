<UserControl x:Class="TrueforceForAll.Plugin.MotdStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <!-- Flat, link-like button so the strip's actions read as text, not chrome. -->
        <Style x:Key="MotdFlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#9FC0FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Collapsed by default; the code-behind only makes it visible when there's
         an undismissed message to show (zero idle footprint). -->
    <Border x:Name="StripRoot" Visibility="Collapsed" CornerRadius="4"
            Background="#23262B" BorderBrush="#3A6BBE" BorderThickness="1"
            Padding="10,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="IconText" Grid.Column="0" Text="&#128226;" FontSize="13"
                       Margin="0,0,8,0" VerticalAlignment="Center"/>

            <TextBlock x:Name="BodyText" Grid.Column="1" VerticalAlignment="Center"
                       Foreground="#E6E6E6" FontSize="12.5"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

            <Button x:Name="MoreButton" Grid.Column="2" Style="{StaticResource MotdFlatButton}"
                    Content="more" Visibility="Collapsed" Click="MoreButton_Click"/>

            <Button x:Name="LinkButton" Grid.Column="3" Style="{StaticResource MotdFlatButton}"
                    Content="Learn more" Visibility="Collapsed" Click="LinkButton_Click"/>

            <TextBlock x:Name="CountText" Grid.Column="4" Foreground="#7F8794" FontSize="11"
                       VerticalAlignment="Center" Margin="6,0,2,0" Visibility="Collapsed"/>

            <Button x:Name="DismissButton" Grid.Column="5" Style="{StaticResource MotdFlatButton}"
                    Content="&#10005;" Foreground="#9AA0A8" FontSize="12"
                    ToolTip="Dismiss" Click="DismissButton_Click"/>
        </Grid>
    </Border>
</UserControl>
