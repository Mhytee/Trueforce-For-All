                        <Border Visibility="{Binding Visibility, ElementName=ModeBReversalGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ModeBReversalGainText" Text="0.50"/></Border>
                    </Grid>

                    <CheckBox x:Name="ModeBPhaseLeadCheck" Margin="0,0,0,2" Content="{loc:T TelemetryFfb_ModeBPhaseLead}"
