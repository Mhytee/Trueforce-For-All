                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF4752C4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3C45A5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FF4A4D5E"/>
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Generic branded support button. Full ControlTemplate so SimHub's stock theme
             doesn't grey the Background; each button sets its own brand Background inline (a
             local value beats the theme setter, and applying this Style explicitly replaces
             SimHub's implicit Button style), and the template binds to it. Hover / pressed
             darken via opacity so ONE style serves Patreon / Ko-fi / PayPal. -->
        <Style x:Key="SupportButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.74"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- Root is a two-row Grid: a persistent header (title + update CTA +
         conditional banners + Game/Car/Preset context card) that stays put on
         every tab, and a TabControl beneath it (Effects / Presets / Controls /
         Settings). Each tab scrolls independently. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="20,20,20,4">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Trueforce For All" FontSize="22" FontWeight="Bold"/>
                <TextBlock x:Name="HeaderVersionText" Text="" FontSize="13" Opacity="0.5"
                           VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                <!-- "Check for updates" link. Hidden when an update is available;
                     the UpdateAvailableButton takes its place. -->
                <Button x:Name="CheckForUpdatesButton" Content="Check for updates"
                        Style="{StaticResource LinkButton}" Margin="12,0,0,3"
                        VerticalAlignment="Bottom"
                        Click="CheckForUpdatesButton_Click"
                        ToolTip="Re-poll GitHub for a newer release. The plugin also checks once automatically on startup."/>
                <TextBlock x:Name="CheckForUpdatesStatus" Text="" FontSize="11" Opacity="0.6"
                           VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                <!-- Community-preset update checking moved into the Preset browser; the
                     header keeps only the primary "Check for updates" button. -->

                <!-- Prominent inline CTA. Hidden until UpdateChecker confirms a
                     newer GitHub release; visibility + label are driven from
                     RefreshFromPlugin. Click opens the same modal that the
                     legacy banner used to open. -->
                <Button x:Name="UpdateAvailableButton" Visibility="Collapsed"
                        Style="{StaticResource UpdateCtaButton}"
                        Margin="12,0,0,3" VerticalAlignment="Bottom"
                        Click="UpdateAvailableButton_Click"
                        ToolTip="Open the update dialog (release notes + Update now button).">
                    <TextBlock x:Name="UpdateAvailableButtonText" Text="Update available"/>
                </Button>
            </StackPanel>
            <TextBlock Text="Brings Trueforce-style haptics to any SimHub-enabled game. Unofficial reverse-engineered implementation of Logitech's Trueforce protocol, not affiliated with Logitech. Supports G PRO / RS50 / G923 wheels."
                       FontSize="13" Opacity="0.7" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <!-- "What's new" banner. Shown when the running build's version
                 is ahead of Settings.LastSeenVersion (i.e. the user just
                 upgraded). Click opens a modal listing every changelog
                 entry newer than their stamp; dismissing the modal stamps
                 LastSeenVersion to the current build. Hidden after dismiss. -->
            <Border x:Name="WhatsNewBanner" Visibility="Collapsed"
                    Background="#3D8B40" CornerRadius="4" Padding="10,8,10,8" Margin="0,0,0,10"
                    Cursor="Hand" MouseLeftButtonUp="WhatsNewBanner_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="WhatsNewBannerText" Foreground="White"
                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                               Text="What's new"/>
                    <TextBlock Grid.Column="1" Foreground="White" Opacity="0.85"
                               FontSize="12" VerticalAlignment="Center" Text="View →"/>
                </Grid>
            </Border>

            <!-- "Spread the word" banner. One-and-done. Surfaces only after
                 the user has banked real working seat time
                 (Settings.ActiveStreamingSeconds past the threshold) so it
                 never lands mid-setup. Clicking copies a short blurb and
                 opens the project page; the x declines. Either path latches
                 ShareCtaDismissed so it never shows again. -->
            <Border x:Name="ShareCtaBanner" Visibility="Collapsed"
                    Background="#5B4B9E" CornerRadius="4" Padding="10,8,10,8" Margin="0,0,0,10"
                    Cursor="Hand" MouseLeftButtonUp="ShareCtaBanner_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="White"
                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Wheel feeling alive in a game that never had Trueforce? Help another driver find TF4ALL."/>
                    <TextBlock Grid.Column="1" Foreground="White" Opacity="0.85"
                               FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                               Text="Share →"/>
                    <Button Grid.Column="2" x:Name="ShareCtaDismiss"
                            Content="✕" Width="22" Height="22" Margin="10,0,0,0"
                            Click="ShareCtaDismiss_Click"
                            Background="Transparent" Foreground="White"
                            BorderBrush="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Don't show this again"/>
                </Grid>
            </Border>

            <!-- Experimental FFB success prompt. Shows once when experimental
                 FFB detection was load-bearing in getting capture working
                 (ShouldShowExperimentalSuccessReport). Clicking opens a
                 prefilled GitHub Discussions post in the "FFB compatibility
                 reports" category (wheel VID/PID + capture fingerprint already
                 filled in) so we learn which wheels to graduate out of
                 experimental; the x declines. Either path latches
                 ExperimentalSuccessReportDismissed. -->
            <Border x:Name="ExperimentalSuccessBanner" Visibility="Collapsed"
                    Background="#2E7D52" CornerRadius="4" Padding="10,8,10,8" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Foreground="White"
                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="Experimental FFB detection started capturing your wheel. Is your force feedback working now?"/>
                        <Button Grid.Column="1" x:Name="ExperimentalSuccessDismiss"
                                Content="✕" Width="22" Height="22" Margin="10,0,0,0" VerticalAlignment="Top"
                                Click="ExperimentalSuccessDismiss_Click"
                                Background="Transparent" Foreground="White"
                                BorderBrush="Transparent" BorderThickness="0"
                                Cursor="Hand" ToolTip="Don't show this again"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="ExperimentalSuccessYes" Content="Yes, it's working"
                                Padding="12,3" Cursor="Hand" Click="ExperimentalSuccessYes_Click"
                                ToolTip="Opens a prefilled compatibility report (wheel ID + details already filled in)."/>
                        <Button x:Name="ExperimentalSuccessNo" Content="No, still no FFB"
                                Padding="12,3" Margin="8,0,0,0" Cursor="Hand" Click="ExperimentalSuccessNo_Click"
                                ToolTip="Opens the diagnostics / troubleshooter."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Auto-tuned ring buffer notice. Surfaces when the auto-
                 ratchet bumps a ring size to recover from sustained
                 dropouts. One banner consolidates every bump in the
                 current session: the "from" caps stay pinned to the
                 sizes that were active when the banner first appeared,
                 the "to" caps update to the latest after each bump.
                 Inline and non-modal (never grabs foreground) per user
                 feedback that the old centered Window was disruptive. -->
            <Border x:Name="RatchetNoticeBanner" Visibility="Collapsed"
                    Background="#3A6BBE" CornerRadius="4" Padding="12,8,12,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="13"
                                   Text="Auto-tuned ring buffer"/>
                        <TextBlock x:Name="RatchetNoticeDetail" Foreground="White" FontSize="11"
                                   Opacity="0.9" Margin="0,2,0,0" TextWrapping="Wrap" Text=""/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="RatchetNoticeRevert"
                            Content="Revert" Padding="10,3" Margin="10,0,0,0"
                            VerticalAlignment="Center" Cursor="Hand"
                            Click="RatchetNoticeRevert_Click"
                            ToolTip="Drop the ring(s) back to the size(s) they were at before this session's auto-bumps. Trades dropout resilience for tighter latency."/>
                    <Button Grid.Column="2" x:Name="RatchetNoticeDismiss"
                            Content="✕" Width="22" Height="22" Margin="6,0,0,0"
                            Click="RatchetNoticeDismiss_Click"
                            Background="Transparent" Foreground="White"
                            BorderBrush="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Dismiss"/>
                </Grid>
            </Border>

            <!-- Offline-edit mode banner. Visible when the user clicked Edit
                 on a preset row in the Manage Presets dialog. While shown,
                 the plugin holds back the auto-apply-game-default path so a
                 background game launch doesn't clobber in-progress edits.
                 Built-ins use the same banner with the Save button relabeled
                 "Save as new…" so the fork behavior is obvious from the
                 button itself, no separate subtitle needed. -->
            <Border x:Name="OfflineEditBanner" Visibility="Collapsed"
                    Background="#3A6BBE" CornerRadius="4" Padding="12,8,12,8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="OfflineEditTitle" Foreground="White" FontWeight="SemiBold"
                                   FontSize="13" Text="Editing preset"/>
                        <TextBlock x:Name="OfflineEditHint" Foreground="White" Opacity="0.85" FontSize="11"
                                   Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="The game defaults are shown (and locked) for context; only the per-car effects are editable. Save the usual way, or Revert a section to undo it. Done finishes and returns to your live setup."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="OfflineEditDoneBtn" Content="Done" Width="84" Height="26"
                                Click="OfflineEditDone_Click"
                                ToolTip="Finish editing: keep what you've saved, drop the live edit overlay, and return to your running game/car."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- UDP setup nudge. Forza delivers telemetry over UDP, which
                 must be turned on in-game and pointed at the plugin. The setup
                 lives on the Settings tab; this persistent banner surfaces
                 when Forza is running but no packets are arriving,
                 so a user whose wheel is silent doesn't have to go digging.
                 Driven from UpdateUdpSetupBanner on the refresh tick. -->
            <Border x:Name="UdpSetupBanner" Visibility="Collapsed"
                    Background="#FF8F00" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚠" FontSize="14" Foreground="#222"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" x:Name="UdpSetupBannerText" Foreground="#222"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text=""/>
                    <Button Grid.Column="2" x:Name="UdpSetupBannerButton" Content="Set up…"
                            Width="90" Height="28" Margin="10,0,0,0"
                            Click="UdpSetupBannerButton_Click"
                            Background="#222" Foreground="#FFC107"
                            BorderBrush="#222" BorderThickness="1" Cursor="Hand"
                            ToolTip="Jump to the UDP telemetry setup for this game."/>
                </Grid>
            </Border>

            <!-- Forza SimHub-fallback notice. Shown when a Forza title is
                 running and telemetry IS reaching the plugin, but only via
                 SimHub (Forza's Data Out is pointed at SimHub's port, not the
                 plugin's). Everything still works; the effects that lean on
                 Forza's richer telemetry (road texture detail, airborne feel,
                 per-tire / cylinder data) just aren't as precise as they are
                 when Forza talks to the plugin directly. Less severe than the
                 no-telemetry banner above, so it's styled as info, not a
                 warning. Driven from UpdateForzaFallbackBanner. -->
            <Border x:Name="ForzaFallbackBanner" Visibility="Collapsed"
                    Background="#332196F3" BorderBrush="#2196F3" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ⓘ" FontSize="15" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" x:Name="ForzaFallbackBannerText" Foreground="White"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="Force feedback is working, but the plugin is reading Forza's telemetry secondhand from SimHub, which carries less detail than Forza's own feed. Point Forza's Data Out at the plugin for more precise road texture and airborne feel."/>
                    <Button Grid.Column="2" x:Name="ForzaFallbackBannerButton" Content="Set up…"
                            Style="{StaticResource InfoBannerButton}"
                            Width="90" Height="28" Margin="10,0,0,0"
                            Click="ForzaFallbackBannerButton_Click"
                            ToolTip="Jump to the Forza telemetry setup."/>
                </Grid>
            </Border>

            <!-- Header strip: master toggle + at-a-glance context.
                 Just Game / Car / Preset and a single status pill. Verbose
                 wheel/stream/telemetry strings live in Diagnostics. -->
            <Border Background="#22FFFFFF" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" x:Name="PluginEnabledCheck" FontSize="14" FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Content="Plugin enabled"
                                  ToolTip="Choice is auto-remembered per game. Disable for games with native Trueforce (e.g. iRacing) so this plugin yields the wheel."
                                  Checked="PluginEnabled_Changed" Unchecked="PluginEnabled_Changed"/>
                        <!-- Live status pill, moved up beside the on/off toggle so the
                             control and the state it produces read together. The gold
                             "Enhanced" badge rides alongside when a per-game source is
                             delivering frames. Reclaims the old dedicated status row. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <Border x:Name="StatusPill" CornerRadius="10" Padding="10,3" Background="#3D8B40">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusPillDot" Width="8" Height="8" Fill="#A5D6A7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="StatusPillText" Text="Idle" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="EnhancedBadge" CornerRadius="10" Padding="10,3" Background="#FFB300"
                                    Margin="6,0,0,0" Visibility="Collapsed"
                                    ToolTip="Per-game enhanced telemetry source. Higher rate and more physics signals than the standard SimHub data pipe.">
                                <TextBlock x:Name="EnhancedBadgeText" Text="✨ Enhanced" Foreground="#1A1A1A" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <!-- Account chip. Always visible: a lightweight, persistent
                             entry point to community sign-in that doubles as an
                             identity readout, riding on every tab via this header
                             card. Signed out -> "Sign in" opens the sign-in dialog.
                             Signed in -> shows the username; clicking drops a small
                             menu (Account settings / Sign out). The full Account
                             section still lives on the Settings tab; this is just a
                             shortcut. Driven by RefreshAccountChip. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                            <!-- TF4ALL Dash phone access. Opens our QR dialog
                                 (DashPhoneWindow) deep-linked to the dash, so scanning
                                 the QR lands straight on TF4ALL Dash instead of
                                 SimHub's dashboard list. Always visible: this is the
                                 funnel for users who don't know SimHub's web dash
                                 exists. The Settings > TF4ALL Dash section has the
                                 same entry point. -->
                            <Button x:Name="DashPhoneHeaderButton"
                                    Height="26" Padding="6,0" Margin="0,0,4,0" Cursor="Hand"
                                    Click="DashPhoneAccess_Click"
                                    ToolTip="Control effects from your phone or tablet. Shows a QR code that opens TF4ALL Dash."
                                    ToolTipService.InitialShowDelay="150">
                                <TextBlock Text="📱" FontSize="13" VerticalAlignment="Center"/>
                            </Button>
                            <!-- Achievements crown + new-achievement dot. Shown when signed
                                 in; click opens the Achievements tracker and clears the dot. -->
                            <Button x:Name="AchievementCrownButton" Visibility="Collapsed"
                                    Height="26" Padding="6,0" Margin="0,0,4,0" Cursor="Hand"
                                    Click="AchievementCrown_Click" ToolTip="Achievements">
                                <Grid>
                                    <TextBlock x:Name="AchievementCrownIcon" Text="👑" FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <Ellipse x:Name="AchievementCrownDot" Width="8" Height="8"
                                             Fill="#FFE5453F" Stroke="#FF231F1F" StrokeThickness="1"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,-1,-2,0" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                            <Button x:Name="AccountChipButton"
                                    VerticalAlignment="Center" Height="26" Padding="10,0" Cursor="Hand"
                                    Click="AccountChip_Click"
                                    ToolTip="Sign in to share presets and use community car data.">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Connection dot. Drawn as an Ellipse (not a text
                                         glyph) so green-filled and grey-hollow are exactly
                                         the same size. Fill/Stroke set in ApplyAccountDot. -->
                                    <Ellipse x:Name="AccountChipIcon" Width="11" Height="11"
                                             VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="AccountChipText" Text="Sign in" FontSize="12"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AccountChipCaret" Text="▾" FontSize="10"
                                               VerticalAlignment="Center" Margin="5,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <!-- Game + Car share one row to save vertical space; the 84-wide
                         label column lines up with the preset labels below. -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Game" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="HeaderGameText" Text="(none)" FontSize="12"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="2" Text="Car" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderCarText" Text="(none)" FontSize="12"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <!-- The header "Rename…" button was removed: car naming lives in
                                 the Car facts panel right below (Name box + Save), which runs
                                 the same CarNameShareFlow. -->
                            <!-- Old "★ N community" discoverability chip + popover
                                 removed in favour of the inline "── Top community
                                 presets ──" section that the car preset dropdown
                                 surfaces. One path with a preview-first apply
                                 flow is clearer than two paths with different
                                 semantics. -->
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Game preset" FontSize="12" Opacity="0.6" Margin="0,3,0,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,0">
                            <ComboBox x:Name="HeaderPresetCombo" SelectionChanged="HeaderPresetCombo_Changed"
                                      MinWidth="220" MaxWidth="340" VerticalAlignment="Center"
                                      MaxDropDownHeight="420" IsTextSearchEnabled="True"
                                      ToolTip="The active game preset."/>
                            <Button x:Name="HeaderGameSaveAllBtn" Content="★ Save"
                                    Style="{StaticResource HeaderSaveAllButton}" Click="HeaderGameSaveAll_Click"
                                    ToolTip="Save your current tuning to this game's preset."/>
                            <!-- Conditional: shown alongside ★ Save all (i.e.
                                 when there's unsaved tuning), see
                                 UpdateGlobalDirtyFromEffects. -->
                            <Button x:Name="HeaderSaveAsNewBtn" Content="Save as new…" Visibility="Collapsed"
                                    Style="{StaticResource LinkButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Click="SaveAsPreset_Click"
                                    ToolTip="Save current tuning under a new preset name (doesn't overwrite the active one)."/>
                            <!-- Conditional: visible when community is on AND the
                                 active preset is user-owned (not a built-in).
                                 Hidden in UpdateHeaderShareButtons. -->
                            <Button x:Name="HeaderGameShareBtn" Content="&#xE72D;" Visibility="Collapsed"
                                    Style="{StaticResource HeaderShareIconButton}"
                                    Click="HeaderGameShare_Click"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Share this game preset with the community."/>
                            <!-- Transient "Saved ✓" flash after a header save, in place of
                                 the old blocking success dialog. Cleared on a timer. -->
                            <TextBlock x:Name="HeaderGameSaveStatus" Text="" FontSize="11"
                                       Foreground="#7FC77F" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Car preset" FontSize="12" Opacity="0.6" Margin="0,3,0,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,0">
                            <ComboBox x:Name="HeaderCarPresetCombo" SelectionChanged="HeaderCarPresetCombo_Changed"
                                      MinWidth="220" MaxWidth="340"
                                      VerticalAlignment="Center"
                                      MaxDropDownHeight="420" IsTextSearchEnabled="True"
                                      ToolTip="The preset for the current car. Pick this car's preset, or another car's to load its tuning onto the current car. Save in the Active car section saves it to this car. Confirms first if you have unsaved tuning."/>
                            <Button x:Name="HeaderCarSaveAllBtn" Content="★ Save"
                                    Style="{StaticResource HeaderSaveAllButton}" Click="HeaderCarSaveAll_Click"
                                    ToolTip="Save your current tuning to this car's preset."/>
                            <!-- Conditional: shown alongside the car ★ Save all
                                 (i.e. when this car has unsaved tuning), see
                                 UpdateGlobalDirtyFromEffects. -->
                            <Button x:Name="HeaderCarSaveAsNewBtn" Content="Save as new…" Visibility="Collapsed"
                                    Style="{StaticResource LinkButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Click="CarSaveAsNew_Click"
                                    ToolTip="Save this car's current tuning as a new car preset (doesn't overwrite the active one)."/>
                            <!-- Conditional: visible when community is on AND a
                                 real car preset is selected (not "(none)" /
                                 not a built-in). Hidden in
                                 UpdateHeaderShareButtons. -->
                            <Button x:Name="HeaderCarShareBtn" Content="&#xE72D;" Visibility="Collapsed"
                                    Style="{StaticResource HeaderShareIconButton}"
                                    Click="HeaderCarShare_Click"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Share this car preset with the community."/>
                            <TextBlock x:Name="HeaderCarSaveStatus" Text="" FontSize="11"
                                       Foreground="#7FC77F" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Community vote row: shown only when the applied car
                         preset is a community download. Lets the user rate
                         the tune they're running without leaving the card.
                         Score + up/down arrows mirror the browse list; the
                         arrow the user picked is highlighted. Built / shown /
                         hidden in code (UpdateActiveCardVoteControl). -->
                    <Border x:Name="CommunityVoteRow" Visibility="Collapsed"
                            Background="#22303030" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Rate this community preset:" FontSize="12"
                                       Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <!-- Chip-styled buttons (background + outline) so they
                                 read as obviously clickable. The arrow lives INSIDE
                                 the chip; the score in the middle is plain net
                                 number. Margin on the score keeps it close to the
                                 chips (was 4px each side, now 2px). -->
                            <Border Background="#33000000" BorderBrush="#55FFFFFF"
                                    BorderThickness="1" CornerRadius="3"
                                    Padding="6,1" Cursor="Hand"
                                    MouseLeftButtonUp="ActiveCardVoteUp_Click"
                                    ToolTip="Good tune. Click again to undo your vote.">
                                <TextBlock x:Name="CommunityVoteUpArrow" Text="▲" FontSize="13"
                                           Foreground="#888888" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="CommunityVoteScore" Text="0" FontSize="12"
                                       Foreground="#CFCFCF" VerticalAlignment="Center"
                                       TextAlignment="Center" MinWidth="22" Margin="2,0,2,0"/>
                            <Border Background="#33000000" BorderBrush="#55FFFFFF"
                                    BorderThickness="1" CornerRadius="3"
                                    Padding="6,1" Cursor="Hand"
                                    MouseLeftButtonUp="ActiveCardVoteDown_Click"
                                    ToolTip="Not for me. Click again to undo your vote.">
                                <TextBlock x:Name="CommunityVoteDownArrow" Text="▼" FontSize="13"
                                           Foreground="#888888" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="CommunityVoteStatus" Text="" FontSize="11"
                                       Foreground="#9E9E9E" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- One-time inline "rate it?" nudge. Non-blocking (no
                         MessageBox). Fires at most once per item and obeys a
                         global cooldown; built / shown in code
                         (MaybeShowVoteNudge). -->
                    <Border x:Name="CommunityVoteNudge" Visibility="Collapsed"
                            Background="#2E3A2E" BorderBrush="#3D8B40" BorderThickness="1"
                            CornerRadius="4" Padding="10,7" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CommunityVoteNudgeText" FontSize="12"
                                       Foreground="#E8F5E9" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Text="Rate the preset you've been running?"/>
                            <Button x:Name="CommunityVoteNudgeGood" Content="▲ Good"
                                    Style="{StaticResource LinkButton}" Margin="14,0,0,0"
                                    Foreground="#A5D6A7" Click="ActiveCardNudgeGood_Click"/>
                            <Button x:Name="CommunityVoteNudgeBad" Content="▼ Not for me"
                                    Style="{StaticResource LinkButton}" Margin="14,0,0,0"
                                    Foreground="#EF9A9A" Click="ActiveCardNudgeBad_Click"/>
                            <Button x:Name="CommunityVoteNudgeLater" Content="Later"
                                    Style="{StaticResource LinkButton}" Margin="14,0,0,0"
                                    Click="ActiveCardNudgeLater_Click"/>
                        </StackPanel>
                    </Border>


                    <!-- Car facts summary: at-a-glance view of what the plugin
                         knows about the active car (name, engine/variant + its
                         source, redline + its source), editable inline for the
                         name and redline. Engine/variant edits route to the
                         existing Manage Variants modal. ALWAYS visible and
                         EXPANDED by default (people open the plugin before the
                         game; they should discover car facts exist and that a
                         wrong-feeling redline buzz or shift lights get fixed
                         here); with no active car the body is just the hint
                         line. Populated by RefreshCarFactsPanel. -->
                    <Expander x:Name="CarFactsExpander" IsExpanded="True" Margin="0,10,0,0"
                              ToolTip="What the plugin currently believes about the car you're driving. Correct anything that looks wrong.">
                        <Expander.Header>
                            <TextBlock Text="Car facts" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <!-- No-car placeholder: tells the user what will appear
                                 here and why they'd care, before they ever drive. -->
                            <TextBlock x:Name="CarFactsNoCarHint" FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                       Text="Once you're driving, the car's facts (name, engine, redline) show here. If the redline buzz or the rev lights fire at the wrong RPM, this is where to fix it."/>
                            <StackPanel x:Name="CarFactsRowsPanel">
                            <!-- Name -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Car name" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                <TextBox  Grid.Column="1" x:Name="CarFactsNameBox" VerticalAlignment="Center" Margin="0,0,8,0"
                                          TextChanged="CarFactsNameBox_TextChanged"
                                          KeyDown="CarFactsName_KeyDown"/>
                                <Button   Grid.Column="2" x:Name="CarFactsNameSaveBtn" Content="Save"
                                          Style="{StaticResource EffectSaveButton}" Visibility="Collapsed"
                                          Click="CarFactsNameSave_Click"
                                          ToolTip="Save a human-readable name for this car. Saved locally; also shared with the community when 'Enable community features (online)' is on."/>
                            </Grid>
                            <TextBlock x:Name="CarFactsCommunityNameText" FontSize="11" Opacity="0.55"
                                       Margin="64,0,0,6" Visibility="Collapsed"/>
                            <!-- Engine type: THE engine picker since the 2026-07
                                 centralization (pins the active variant; the gray
                                 readout below carries the auto-detect context and
                                 rev ceiling). -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Engine" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                <ComboBox  Grid.Column="1" x:Name="CarFactsEngineCombo" SelectionChanged="CarFactsEngine_Changed"
                                           DropDownClosed="CarFactsEngine_DropDownClosed"
                                           LostKeyboardFocus="CarFactsEngine_LostKeyboardFocus"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           ToolTip="The engine type used for the firing pattern. Correct it if the auto-detected type is wrong."/>
                                <TextBlock Grid.Column="2" Style="{StaticResource HelpText}" VerticalAlignment="Center">
                                    <Hyperlink x:Name="CarFactsRefreshCommunityLink" Click="CarFactsRefreshCommunity_Click"
                                               ToolTip="Refresh this car's community facts from the server now (they otherwise refresh at most weekly).">↻ Refresh</Hyperlink>
                                    <Run Text="   "/>
                                    <Hyperlink x:Name="CarFactsManageVariantsLink" Click="CarFactsManageVariants_Click">Manage variants…</Hyperlink>
                                </TextBlock>
                            </Grid>
                            <!-- Auto-detect readout (max RPM rides its end) + community
                                 context. The x:Names are load-bearing: their updaters
                                 also drive the shared per-car community fetch. Custom-
                                 engine authoring lives in the Manage variants modal. -->
                            <TextBlock x:Name="EngineLayoutAutoText" FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="64,0,0,2" Text=""/>
                            <TextBlock x:Name="EngineCommunityText" FontSize="11" Opacity="0.55" Margin="64,0,0,6" Text="" Visibility="Collapsed"/>
                            <!-- Redline -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Redline" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                <TextBox   Grid.Column="1" x:Name="CarFactsRedlineBox" Width="70" VerticalAlignment="Center"
                                           KeyDown="CarFactsRedline_KeyDown"
                                           ToolTip="The redline start: where the tachometer turns red and you should upshift."/>
                                <TextBlock Grid.Column="2" Text="RPM" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                <Button    Grid.Column="3" x:Name="CarFactsRedlineSetBtn" Content="Set"
                                           Style="{StaticResource EffectSaveButton}" Visibility="Visible"
                                           Click="CarFactsRedlineSet_Click"
                                           ToolTip="Save the redline start for this variant (this tune)."/>
                                <TextBlock Grid.Column="4" x:Name="CarFactsRedlineSourceText" FontSize="11" Opacity="0.6"
                                           VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                            <TextBlock Margin="64,0,0,4" FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                                       Text="The redline start: where the tachometer turns red and you upshift. Not the rev limiter cutoff (that sits a little higher)."/>
                            <!-- Factual note when no community redline exists yet. No share
                                 button: Set routes through the submit path by itself. -->
                            <TextBlock x:Name="CarFactsNoCommunityNudge" Margin="64,4,0,0" FontSize="11"
                                       Foreground="#FFE082" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <!-- Per-gear redline overrides (gears 1..N). The redline above
                                 is the default (gear 0); rows here override specific gears,
                                 e.g. a lower 1st-gear limit. Rows are built in code by
                                 RebuildPerGearEditors. This is the ONLY per-gear editor
                                 (the Redline buzz section's duplicate was retired). -->
                            <Expander x:Name="CarFactsPerGearExpander" IsExpanded="False" Margin="0,6,0,0" Visibility="Collapsed">
                                <Expander.Header>
                                    <TextBlock Text="Per-gear redlines" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
                                </Expander.Header>
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Text="Optional. Set a different redline start (where you upshift) for specific gears, e.g. a lower 1st-gear shift point. Gears you don't list use the redline above."/>
                                    <StackPanel x:Name="CarFactsPerGearRows"/>
                                    <Button x:Name="CarFactsAddGearBtn" Content="+ Add gear" HorizontalAlignment="Left"
                                            Padding="10,2" Margin="0,2,0,0" Click="CarFactsAddGear_Click"/>
                                </StackPanel>
                            </Expander>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Coalesced "issues" region: at most one banner shows at a
                         time (severity order), with a "+N more" bar to reveal the
                         rest. Keeps a misconfigured machine from stacking five
                         full-width banners and crushing the tabs below. Driven by
                         CoalesceCardIssues on the refresh tick. -->
                    <StackPanel x:Name="IssuesHost">
                    <!-- Logitech G HUB warning banner. G HUB claims the wheel's
                         HID interface; while it's running we can't talk to the
                         wheel. Surfaced as a dedicated red banner (separate from
                         the WheelQuietDiagnostic below) so the user sees it even
                         when other issues coexist (e.g., master gain also at 0).
                         Hidden when G HUB isn't detected. -->
                    <Border x:Name="GHubWarningBox" Visibility="Collapsed"
                            Background="#D32F2F" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Foreground="White" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="Logitech G HUB is running. Close it, then restart SimHub (G HUB claims the wheel and blocks force feedback)."/>
                        </StackPanel>
                    </Border>

                    <!-- Admin/elevation warning. SimHub needs to run as
                         administrator for reliable force feedback: USBPcap's
                         bus capture (which mirrors the game's FFB) can fail
                         silently without it, and some games only pass FFB
                         through when elevated. Shown whenever SimHub isn't
                         elevated; treated as effectively required. -->
                    <Border x:Name="AdminWarningBox" Visibility="Collapsed"
                            Background="#D32F2F" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Foreground="White" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="SimHub is not running as administrator. This is required for reliable force feedback (the USB capture that mirrors the game's FFB can fail without it). Easiest fix: turn on 'Run as administrator' in SimHub's Settings, then restart SimHub."/>
                        </StackPanel>
                    </Border>

                    <!-- Why-is-my-wheel-quiet diagnostic. Shown only when the
                         plugin detects a likely reason output is silent
                         (master switch off, wheel disconnected, no telemetry,
                         all effects disabled, ducker swallowing everything,
                         etc). Hidden when healthy. Yellow background so it's
                         visually distinct from regular status text. -->
                    <Border x:Name="WheelQuietDiagnosticBox" Visibility="Collapsed"
                            Background="#FFC107" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="14" Foreground="#222" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="WheelQuietDiagnosticText" Foreground="#222"
                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text=""/>
                        </StackPanel>
                    </Border>

                    <!-- FFB-tap divergence banner. HID found the wheel (so
                         Trueforce effects play) but USBPcap couldn't find it
                         on the bus, so the game's native force feedback gets
                         clobbered. Surfaces the manual picker right where the
                         user notices the problem instead of hiding it inside
                         Diagnostics. Hidden once the user picks a device. -->
                    <Border x:Name="FfbTapPickerBanner" Visibility="Collapsed"
                            Background="#FF8F00" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚠" FontSize="14" Foreground="#222"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Foreground="#222"
                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="Your wheel is connected, but FFB pass-through can't find it on the USB bus, so your game's force feedback may feel wrong or be silenced. This is most often fixed by restarting your computer (USBPcap's capture driver only loads at boot, especially right after it was installed). If a reboot doesn't fix it, please use the in-app Report an issue flow with a log attached."/>
                            <!-- Manual-pick fallback is hidden by default
                                 (forgotten pins silently broke FFB after a
                                 replug; the report-an-issue path gives us the
                                 data to fix the root cause instead). Power
                                 users with multi-wheel disambiguation or a
                                 specific USBPcap-interface mismatch can flip
                                 it back on with MANUALPIN. -->
                            <Button Grid.Column="2" x:Name="FfbTapPickerBannerButton"
                                    Content="Pick device manually…"
                                    Width="170" Height="28" Margin="10,0,0,0"
                                    Visibility="Collapsed"
                                    Click="UsbPcapPickDevice_Click"
                                    Background="#222" Foreground="#FFC107"
                                    BorderBrush="#222" BorderThickness="1"/>
                        </Grid>
                    </Border>

                    <!-- Unverified-wheel notice. Detected PID is supported by
                         inference (shared HID++ family) but not hardware-tested.
                         Asks the user to report the one failure mode we can't
                         rule out: Trueforce effects play but game FFB is silent
                         (init/handshake divergence). Blue = informational,
                         not an error. Hidden for confirmed wheels (all supported
                         PIDs today, so this banner is currently never shown). -->
                    <Border x:Name="UnverifiedWheelBanner" Visibility="Collapsed"
                            Background="#1565C0" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ⓘ" FontSize="14" Foreground="White"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="UnverifiedWheelText" Foreground="White"
                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text=""/>
                        </StackPanel>
                    </Border>

                    <!-- Dropped-default notice: a game's default preset pointed at
                         a name that no longer exists, so the built-in default took
                         over. Previously log-only, which let a user unknowingly
                         edit the built-in (2026-07-19). Dismiss clears the notice. -->
                    <Border x:Name="DefaultDroppedBanner" Visibility="Collapsed"
                            Background="#1565C0" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ⓘ" FontSize="14" Foreground="White"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" x:Name="DefaultDroppedText" Foreground="White"
                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text=""/>
                            <Button Grid.Column="2" Content="Dismiss" Padding="10,3" Margin="10,0,0,0"
                                    VerticalAlignment="Center" Click="DefaultDroppedDismiss_Click"/>
                        </Grid>
                    </Border>

                    <!-- "+N more" reveal. Shown only when more than one issue is
                         active; the collapsed view shows just the top-severity
                         banner. Clicking expands to the full stack (and back). -->
                    <Border x:Name="MoreIssuesBar" Visibility="Collapsed" Cursor="Hand"
                            Background="#1FFFFFFF" CornerRadius="4" Padding="10,5" Margin="0,8,0,0"
                            MouseLeftButtonUp="MoreIssues_Click"
                            ToolTip="Show the other active issues.">
                        <TextBlock x:Name="MoreIssuesText" FontSize="12" Foreground="#E0E0E0"
                                   Text="+1 more issue ▾"/>
                    </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Message-of-the-day strip: spans all tabs, sits between the header and
             the tab content. Hosts the MotdStrip control (added in code-behind);
             collapses to nothing when there's no message. -->
        <ContentControl x:Name="MotdStripHost" Grid.Row="1" Margin="20,0,20,8"/>

        <sh:SHTabControl x:Name="MainTabs" Grid.Row="2" Margin="20,4,20,12" SelectionChanged="MainTabs_SelectionChanged">
            <!-- ============================ EFFECTS (main) ============================ -->
            <sh:SHTabItem x:Name="EffectsTab" Header="Effects">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12,14,14">

            <!-- Master. Master gain is a GLOBAL setting (auto-saved, not
                 preset-scoped), so this section has no Save/Revert. The
                 FFB pass-through Save/Revert (which cover scale/smooth/invert,
                 EffectKind.Master) live with those controls in the FFB tweaks
                 expander below. -->
            <Border Style="{StaticResource SectionHeaderBorder}">
                <TextBlock Text="Master" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"/>
            </Border>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Master gain:" Style="{StaticResource LabelText}"
                           ToolTip="Overall strength of the plugin's effects. Doesn't change the game's own force feedback."/>
                <Slider     Grid.Column="1" x:Name="MasterGainSlider"
                            ToolTip="Overall strength of the plugin's effects. Doesn't change the game's own force feedback."
                            Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                            TickFrequency="0.25" ValueChanged="MasterGainSlider_ValueChanged" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" x:Name="MasterGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
            </Grid>
            <!-- (The old "Active car" Save/Delete box was removed: per-car
                 tuning now saves via each effect's ★/Save popover ("For this
                 car"), and deleting a car preset lives in Manage Presets. The
                 header car-preset picker still switches the active car preset.) -->

            <!-- FFB tweaks: optional force-feedback comfort/feel adjustments,
                 collapsed by default so they don't crowd the top of the Effects
                 tab. Holds the parked-car "stationary spring" and FFB spike
                 reduction. -->
            <Expander x:Name="FfbTweaksExpander" IsExpanded="False" Margin="0,12,0,4">
                <Expander.Header>
                    <TextBlock Text="FFB tweaks" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">

                <!-- FFB pass-through: how the game's own force feedback is
                     mirrored to the wheel - output scale, smoothing, and sign. -->
                <Expander IsExpanded="False" Margin="0,0,0,4">
                    <Expander.Header>
                        <TextBlock Text="FFB pass-through" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Expander.Header>
                    <StackPanel x:Name="FfbPassthroughControls" Margin="0,8,0,0">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FFB scale:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="FfbScaleSlider"
                                        Minimum="0" Maximum="1.5" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="FfbScaleSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="FfbScaleText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FFB smooth (ms):" Style="{StaticResource LabelText}"
                                       ToolTip="Smooths the game's force feedback before it reaches the wheel. Higher = smoother feel but more lag; lower = tighter response. 0 = no smoothing (tightest, the default)."/>
                            <Slider     Grid.Column="1" x:Name="FfbSmoothSlider"
                                        Minimum="0" Maximum="10" SmallChange="0.5" LargeChange="1"
                                        TickFrequency="1" ValueChanged="FfbSmoothSlider_ValueChanged" VerticalAlignment="Center"
                                        ToolTip="Smooths the game's force feedback before it reaches the wheel. Higher = smoother feel but more lag; lower = tighter response. 0 = no smoothing (tightest, the default)."/>
                            <TextBox Grid.Column="2" x:Name="FfbSmoothText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.0"/>
                        </Grid>
                        <CheckBox x:Name="FfbInvertCheck" Content="Invert FFB sign (uncheck if forces feel reversed)"
                                  Margin="0,2,0,0" VerticalAlignment="Center"
                                  Checked="FfbInvert_Changed" Unchecked="FfbInvert_Changed"
                                  ToolTip="Flips the direction of the game's force feedback sent to the wheel. On by default. If your wheel pushes the wrong way (e.g. forces feel reversed in RaceRoom), uncheck this."/>
                        <!-- Save/Revert for the FFB pass-through trio (scale/smooth/
                             invert). Tag="Master" so the existing EffectKind.Master
                             save/revert handlers apply unchanged. Shown only when
                             these values drift from the active preset. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button x:Name="MasterRevertBtn" Content="↶" Tag="Master" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="MasterSaveBtn"   Content="Save…" Tag="Master" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Stationary spring: synthesizes a parked-car centering
                     force the game itself doesn't send (a stationary tire has
                     ~0 self-aligning torque). Deficit-fill + speed-fade, so it
                     can't fight the game's FFB. Uses the game's reported
                     steering whenever it provides one (AC / Forza), and falls
                     back to the wheel's physical position (WheelSteeringReader)
                     for any game that doesn't report steering via telemetry, so
                     it works in any game; always off for iRacing (MAIRA already
                     weights it). Forza's steering is coarse so the consumer
                     smooths it. -->
                <Expander IsExpanded="False" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Stationary spring" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="StationarySpringRevertBtn" Content="↶" Tag="StationarySpring" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="StationarySpringSaveBtn"   Content="Save…" Tag="StationarySpring" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox x:Name="StationarySpringCheck"
                                      Content="Stationary spring (adds parked-car wheel weight)"
                                      VerticalAlignment="Center"
                                      Checked="StationarySpring_Changed" Unchecked="StationarySpring_Changed"
                                      ToolTip="A parked car sends almost no force feedback, so the wheel feels limp. This adds a centering weight that fades out as you start moving and never fights the game's own FFB. It works in any game, and is ignored for iRacing (MAIRA already weights the wheel)."/>
                            <TextBlock x:Name="StationarySpringUnsupportedBadge" Style="{StaticResource UnsupportedBadge}"
                                       Text="not used in Forza"
                                       ToolTip="The spring conflicted with Forza's force feedback across pause and matchmaking transitions and could pull the wheel to its rotational stop. It is bypassed for Forza so the wheel stays free across those transitions; your tuning still applies to other games."/>
                        </StackPanel>
                        <StackPanel x:Name="StationarySpringSliders">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Spring strength:" Style="{StaticResource LabelText}"
                                           ToolTip="How much centering weight to add when fully parked, as a fraction of full FFB. Start low; a strong spring can snap the wheel to center hard."/>
                                <Slider     Grid.Column="1" x:Name="StationarySpringStrengthSlider"
                                            Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.25"
                                            TickFrequency="0.25" ValueChanged="StationarySpringStrengthSlider_ValueChanged" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="2" x:Name="StationarySpringStrengthText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Fade-out (km/h):" Style="{StaticResource LabelText}"
                                           ToolTip="The spring is at full strength when stopped and fades to nothing by this speed. Keep it low so it's gone before real cornering forces build."/>
                                <Slider     Grid.Column="1" x:Name="StationarySpringCutoffSlider"
                                            Minimum="2" Maximum="30" SmallChange="1" LargeChange="5"
                                            TickFrequency="2" ValueChanged="StationarySpringCutoffSlider_ValueChanged" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="2" x:Name="StationarySpringCutoffText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="12"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- FFB spike reduction. Save/Revert live in the expander header. -->
                <Expander IsExpanded="False" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FFB spike reduction" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="SpikeReductionRevertBtn" Content="↶" Tag="SpikeReduction" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="SpikeReductionSaveBtn"   Content="Save…" Tag="SpikeReduction" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <CheckBox x:Name="SpikeTamingEnabledCheck" Content="FFB spike reduction (recommended for Assetto Corsa)"
                                  FontWeight="SemiBold" Margin="0,0,0,4"
                                  Checked="SpikeTamingEnabled_Changed" Unchecked="SpikeTamingEnabled_Changed"/>
                        <!-- Spike reduction has two mutually exclusive methods: exactly
                             one runs when the box above is on, neither when it's off.
                             The selector and tuning stay readable even when it's off so
                             the method can be set any time. The active method's controls
                             show; the other method's are hidden (no graying). The label,
                             help text and description swap by method in code
                             (UpdateSpikeModeUi). The shared limit slider is one setting
                             (FfbSpikeMaxLsbPerMs) read as LSB/ms in slew or an LSB
                             threshold in transient. "Cap softness" is transient-only so
                             it only appears under Transient. -->
                        <StackPanel x:Name="SpikeTamingBody" Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8"
                                       Text="Some games deliver kerb and collision FFB spikes well beyond what's safe or comfortable on stronger wheelbases (Assetto Corsa is the worst offender we've seen). Hits can be sharp enough to wrench the wheel against your grip, ruin a racing line, or strain your wrists on a long session. Pick one of the two methods below; it only applies while the box above is checked."/>
                            <TextBlock Text="Method:" Style="{StaticResource LabelText}" Margin="0,2,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <RadioButton x:Name="SpikeModeTransientRadio" GroupName="SpikeMode"
                                             Content="Transient detector" VerticalAlignment="Center"
                                             Checked="SpikeMode_Changed"/>
                                <RadioButton x:Name="SpikeModeSlewRadio" GroupName="SpikeMode"
                                             Content="Slew-rate limiter (iRacing-style)" VerticalAlignment="Center"
                                             Margin="18,0,0,0" Checked="SpikeMode_Changed"/>
                            </StackPanel>
                            <TextBlock x:Name="SpikeModeDescription" Style="{StaticResource HelpText}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="FfbSpikeLimitLabel" Text="Slew rate:" Style="{StaticResource LabelText}"/>
                                <Slider     Grid.Column="1" x:Name="FfbSpikeLimitSlider"
                                            Minimum="0" Maximum="30000" SmallChange="500" LargeChange="2000"
                                            TickFrequency="2500" ValueChanged="FfbSpikeLimitSlider_ValueChanged" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="2" x:Name="FfbSpikeLimitText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="2061"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HelpText}" Margin="140,4,0,8" x:Name="FfbSpikeLimitHelp"/>
                            <StackPanel x:Name="SpikeCapSoftnessRow">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cap softness:" Style="{StaticResource LabelText}"/>
                                    <Slider     Grid.Column="1" x:Name="FfbPeakLimitSlider"
                                                Minimum="0" Maximum="20000" SmallChange="500" LargeChange="2000"
                                                TickFrequency="2000" ValueChanged="FfbPeakLimitSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" x:Name="FfbPeakLimitText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1562"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HelpText}" Margin="140,4,0,0"
                                           Text="How hard spikes above the threshold get compressed. Peak force during a big hit levels off near threshold plus this value. Transient method only."/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Expander>
                </StackPanel>
            </Expander>

            <!-- Effects -->
            <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,24,0,12"><TextBlock Text="Effects" Style="{StaticResource SectionHeaderText}"/></Border>

            <!-- Audio capture (game audio → wheel). Lives outside the
                 telemetry-greyed panel because it works even when the game
                 emits no useful telemetry (custom SimHub games etc). -->
            <Expander x:Name="AudioExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="AudioEnabledCheck" Content="Audio rumble"
                                  FontWeight="SemiBold" VerticalAlignment="Center"
                                  ToolTip="Turns the game's sound (engine, tires, impacts) into wheel vibration. Works even when a game sends no useful telemetry."
                                  Checked="AudioEnabled_Changed" Unchecked="AudioEnabled_Changed"/>
                        <Border x:Name="AudioNewBadge" Style="{StaticResource NewEffectBadge}">
                            <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="AudioOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                        <Button    x:Name="AudioRevertBtn"  Content="↶" Tag="Audio" Margin="14,0,0,0"
                                   Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                        <Button    x:Name="AudioSaveBtn"    Content="Save…" Tag="Audio"
                                   Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource LabelText}"/>
                        <Slider     Grid.Column="1" x:Name="AudioGainSlider"
                                    Minimum="0" Maximum="3.0" SmallChange="0.05" LargeChange="0.25"
                                    TickFrequency="0.5" ValueChanged="AudioGainSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="AudioGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Highpass (Hz):" Style="{StaticResource LabelText}"/>
                        <Slider     Grid.Column="1" x:Name="AudioHighpassSlider"
                                    Minimum="0" Maximum="200" SmallChange="5" LargeChange="20"
                                    TickFrequency="20" ValueChanged="AudioHighpassSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="AudioHighpassText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="30"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Lowpass (Hz):" Style="{StaticResource LabelText}"/>
                        <Slider     Grid.Column="1" x:Name="AudioFilterSlider"
                                    Minimum="100" Maximum="1500" SmallChange="10" LargeChange="50"
                                    TickFrequency="100" ValueChanged="AudioFilterSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="AudioFilterText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="350"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Level:" Style="{StaticResource LabelText}"/>
                        <ProgressBar Grid.Column="1" x:Name="AudioLevelMeter" Minimum="0" Maximum="1" Height="14" Foreground="#4CAF50"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Status:" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Column="1" x:Name="CaptureStatusText" Text="Idle" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Power-user: per-game capture exe override. Hidden by
                         default; surfaces when auto-detect misses a game. -->
                    <Expander x:Name="CaptureNotWorkingExpander" IsExpanded="False" Margin="0,8,0,0">
                        <Expander.Header>
                            <TextBlock Text="Audio capture not picking up your game?" FontSize="12"/>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,4"
                                       Text="Type the game's exe name here (with or without &quot;.exe&quot;). Saved per-game and applied within 1 second."/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Capture exe:" Style="{StaticResource LabelText}"/>
                                <TextBox   Grid.Column="1" x:Name="CaptureExeOverrideBox"
                                           VerticalAlignment="Center" LostFocus="CaptureExeOverride_LostFocus"
                                           KeyDown="CaptureExeOverride_KeyDown"/>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Expander>

            <!-- Telemetry-driven effects: greyed when a game is running but
                 emits no useful telemetry (e.g. SimHub custom games where
                 only audio capture produces output). When no game is loaded,
                 the panel stays enabled so the user can still tune presets
                 for future sessions. -->
            <StackPanel x:Name="TelemetryEffectsPanel">

                <!-- Engine pulse -->
                <Expander x:Name="EngineExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="EngineEnabledCheck" Content="Engine pulse"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      ToolTip="The engine's firing pulse through the wheel, rising with RPM."
                                      Checked="EngineEnabled_Changed" Unchecked="EngineEnabled_Changed"/>
                            <Border x:Name="EngineNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="EngineOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="Test" Style="{StaticResource EffectTestButton}" Click="EngineTest_Click"/>
                            <Button x:Name="EngineRevertBtn" Content="↶" Tag="Engine" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="EngineSaveBtn"   Content="Save…" Tag="Engine" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <!-- Evergreen guidance (not a migration note) so it reads
                             right for new users too. -->
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8"
                                   Text="For the most accurate engine pulse, make sure the engine type is correct in Car facts on the active car card."/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="EngineGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="EngineGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="EngineGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pitch:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="EnginePitchSlider" Minimum="0.25" Maximum="4.0" SmallChange="0.05" LargeChange="0.25"
                                        TickFrequency="0.25" ValueChanged="EnginePitchSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="EnginePitchText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waveform:" Style="{StaticResource LabelText}"/>
                            <ComboBox  Grid.Column="1" x:Name="EngineWaveformCombo" SelectionChanged="EngineWaveform_Changed">
                                <ComboBoxItem Content="Sine"/><ComboBoxItem Content="Square"/><ComboBoxItem Content="Saw"/><ComboBoxItem Content="Triangle"/><ComboBoxItem Content="Noise"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Lowpass (Hz):" Style="{StaticResource LabelText}"
                                       ToolTip="0 = disabled. Lowers buzzy harmonics on Square/Saw without changing pitch."/>
                            <Slider     Grid.Column="1" x:Name="EngineLowpassSlider" Minimum="0" Maximum="2000" SmallChange="10" LargeChange="50"
                                        TickFrequency="200" ValueChanged="EngineLowpassSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="EngineLowpassText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0"/>
                        </Grid>
                        <!-- Electric car behavior: applies only when the resolver
                             flags the active car as a pure EV. Combustion cars
                             ignore this. Per-car preset overrides the global. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Electric cars:" Style="{StaticResource LabelText}"
                                       ToolTip="What Engine pulse does for electric cars (detected as electric, or set to Electric in Car facts). Most users prefer the muted hum since real EVs aren't silent (many pump synthetic engine sound). Pick Silent if you want true silence on EVs."/>
                            <ComboBox  Grid.Column="1" x:Name="EngineElectricModeCombo" SelectionChanged="EngineElectricMode_Changed">
                                <ComboBoxItem Content="Muted hum (50%)"/>
                                <ComboBoxItem Content="Silent (off)"/>
                            </ComboBox>
                        </Grid>
                        <!-- Engine TYPE, its auto-detect/community context, the
                             variant readout, and the pattern readout all moved to
                             the Car facts panel on the active card (2026-07
                             centralization): the engine is car truth, not preset
                             feel. This section keeps feel knobs only; the Car
                             facts guidance line sits at the top of the section. -->
                        <!-- High-RPM perceptibility helpers. On by default;
                             keep the engine feel present where the wheel
                             motor naturally rolls off the firing pulse. -->
                        <Separator Margin="0,8,0,8"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,6"
                                   Text="Helps the engine still feel present at high RPM, where the wheel's motor can't keep up with the firing rate."/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="EngineLoadLayerCheck"
                                      Content="Low-end body" VerticalAlignment="Center"
                                      Checked="EngineLoadLayer_Changed" Unchecked="EngineLoadLayer_Changed"
                                      ToolTip="Adds a low-frequency oscillation at the engine's cycle rate (RPM/120 Hz) alongside the firing pulse. Sits in the band the wheel actually moves at, so the engine keeps feeling present as the firing pulse rolls off at high RPM."/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="  Strength:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="EngineLoadLayerGainSlider" Minimum="0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="EngineLoadLayerGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="EngineLoadLayerGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.80"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="EngineHighRpmBoostCheck"
                                      Content="High-RPM boost" VerticalAlignment="Center"
                                      Checked="EngineHighRpmBoost_Changed" Unchecked="EngineHighRpmBoost_Changed"
                                      ToolTip="Pre-emphasis: extra firing-pulse gain ramping in above 50% RPM. Partially compensates for the wheel's natural high-frequency rolloff."/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="  Amount:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="EngineHighRpmBoostSlider" Minimum="0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="EngineHighRpmBoostSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="EngineHighRpmBoostText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.70"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Road bumps -->
                <Expander x:Name="BumpsExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="SlipEnabledCheck" Content="Road bumps &amp; kerbs"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="SlipEnabled_Changed" Unchecked="SlipEnabled_Changed"/>
                            <Border x:Name="BumpsNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="BumpsOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="Test" Style="{StaticResource EffectTestButton}" Click="BumpsTest_Click"/>
                            <Button x:Name="BumpsRevertBtn" Content="↶" Tag="Bumps" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="BumpsSaveBtn"   Content="Save…" Tag="Bumps" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="SlipGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="SlipGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="SlipGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waveform:" Style="{StaticResource LabelText}"/>
                            <ComboBox  Grid.Column="1" x:Name="BumpsWaveformCombo" SelectionChanged="BumpsWaveform_Changed">
                                <ComboBoxItem Content="Sine"/><ComboBoxItem Content="Square"/><ComboBoxItem Content="Saw"/><ComboBoxItem Content="Triangle"/><ComboBoxItem Content="Noise"/>
                            </ComboBox>
                        </Grid>
                        <Grid x:Name="BumpsFreqRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Frequency (Hz):" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="BumpsFreqSlider" Minimum="20" Maximum="300" SmallChange="1" LargeChange="10"
                                        TickFrequency="20" ValueChanged="BumpsFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="BumpsFreqText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="60"/>
                        </Grid>

                        <!-- Surface texture (Forza-supplied SurfaceRumble + WheelOnRumbleStrip).
                             Has its own oscillator so the user can pick a higher freq /
                             brighter waveform than the heave path. Knobs stay visible
                             on non-Forza games but won't produce sound (source supplies
                             no SurfaceRumble). Clearly labeled (Forza) so users don't
                             waste time tuning controls that won't fire on AC etc. -->
                        <Border BorderThickness="0,1,0,0" BorderBrush="#22FFFFFF" Margin="0,4,0,8" Padding="0,8,0,0">
                            <StackPanel>
                                <CheckBox x:Name="BumpsSurfaceEnabledCheck" Content="Surface texture (Forza)" FontWeight="SemiBold" Margin="0,0,0,4"
                                          Checked="BumpsSurfaceEnabled_Changed" Unchecked="BumpsSurfaceEnabled_Changed"
                                          ToolTip="Forza-only: drives a second oscillator from the per-tire SurfaceRumble channel. Continuous road feel that's stronger on dirt/grass and lighter on asphalt. Adds a leading-edge pulse on rumble-strip contact."/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Surface gain:" Style="{StaticResource LabelText}"/>
                                    <Slider     Grid.Column="1" x:Name="BumpsSurfaceGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                                TickFrequency="0.25" ValueChanged="BumpsSurfaceGainSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" x:Name="BumpsSurfaceGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Surface freq (Hz):" Style="{StaticResource LabelText}"/>
                                    <Slider     Grid.Column="1" x:Name="BumpsSurfaceFreqSlider" Minimum="20" Maximum="600" SmallChange="5" LargeChange="25"
                                                TickFrequency="50" ValueChanged="BumpsSurfaceFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" x:Name="BumpsSurfaceFreqText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="120"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Surface waveform:" Style="{StaticResource LabelText}"/>
                                    <ComboBox  Grid.Column="1" x:Name="BumpsSurfaceWaveformCombo" SelectionChanged="BumpsSurfaceWaveform_Changed">
                                        <ComboBoxItem Content="Sine"/><ComboBoxItem Content="Square"/><ComboBoxItem Content="Saw"/><ComboBoxItem Content="Triangle"/><ComboBoxItem Content="Noise"/>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Rumble scale:" Style="{StaticResource LabelText}"
                                               ToolTip="Multiplier on Forza's SurfaceRumble before driving the oscillator. 1.0 = use as-is. Bump up for more aggressive surface feel."/>
                                    <Slider     Grid.Column="1" x:Name="BumpsSurfaceRumbleScaleSlider" Minimum="0.1" Maximum="3.0" SmallChange="0.1" LargeChange="0.25"
                                                TickFrequency="0.25" ValueChanged="BumpsSurfaceRumbleScaleSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" x:Name="BumpsSurfaceRumbleScaleText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                                </Grid>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Kerb pulse:" Style="{StaticResource LabelText}"
                                               ToolTip="Extra amplitude added on the rising edge of any wheel touching a rumble strip. 0 = disabled."/>
                                    <Slider     Grid.Column="1" x:Name="BumpsRumbleStripPulseSlider" Minimum="0" Maximum="1.5" SmallChange="0.05" LargeChange="0.1"
                                                TickFrequency="0.25" ValueChanged="BumpsRumbleStripPulseSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" x:Name="BumpsRumbleStripPulseText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.50"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>

                <!-- Traction loss -->
                <Expander x:Name="TractionExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="TractionEnabledCheck" Content="Traction loss (rear breaking loose / wheelspin)"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="TractionEnabled_Changed" Unchecked="TractionEnabled_Changed"/>
                            <Border x:Name="TractionNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="TractionOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="Test" Style="{StaticResource EffectTestButton}" Click="TractionTest_Click"/>
                            <Button x:Name="TractionRevertBtn" Content="↶" Tag="Traction" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="TractionSaveBtn"   Content="Save…" Tag="Traction" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="TractionGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="TractionGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="TractionGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sensitivity:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="TractionSensitivitySlider" Minimum="0.1" Maximum="3.0" SmallChange="0.1" LargeChange="0.25"
                                        TickFrequency="0.25" ValueChanged="TractionSensitivitySlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="TractionSensitivityText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waveform:" Style="{StaticResource LabelText}"/>
                            <ComboBox  Grid.Column="1" x:Name="TractionWaveformCombo" SelectionChanged="TractionWaveform_Changed">
                                <ComboBoxItem Content="Sine"/><ComboBoxItem Content="Square"/><ComboBoxItem Content="Saw"/><ComboBoxItem Content="Triangle"/><ComboBoxItem Content="Noise"/>
                            </ComboBox>
                        </Grid>
                        <Grid x:Name="TractionFreqRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Frequency (Hz):" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="TractionFreqSlider" Minimum="20" Maximum="300" SmallChange="1" LargeChange="10"
                                        TickFrequency="20" ValueChanged="TractionFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="TractionFreqText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="100"/>
                        </Grid>
                        <!-- Noise filter rows: only relevant for Noise waveform.
                             Collapsed otherwise so the panel doesn't show
                             controls that have no audible effect. -->
                        <Grid x:Name="TractionNoiseLpRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Noise lowpass (Hz):" Style="{StaticResource LabelText}"
                                       ToolTip="Cut high frequencies from noise. Lower = smoother rumble, higher = grittier."/>
                            <Slider     Grid.Column="1" x:Name="TractionNoiseLpSlider" Minimum="50" Maximum="1000" SmallChange="10" LargeChange="50"
                                        TickFrequency="100" ValueChanged="TractionNoiseLpSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="TractionNoiseLpText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="250"/>
                        </Grid>
                        <Grid x:Name="TractionNoiseHpRow" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Noise highpass (Hz):" Style="{StaticResource LabelText}"
                                       ToolTip="Cut sub-audible drift / DC thump from noise. 0 disables."/>
                            <Slider     Grid.Column="1" x:Name="TractionNoiseHpSlider" Minimum="0" Maximum="200" SmallChange="5" LargeChange="20"
                                        TickFrequency="20" ValueChanged="TractionNoiseHpSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="TractionNoiseHpText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="30"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Axle slip (which end of the car is letting go). A high
                     scrub texture as the front washes wide, a deep pulse as
                     the rear steps out. Needs per-tire telemetry. -->
                <Expander x:Name="AxleSlipExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="AxleSlipEnabledCheck" Content="Axle slip"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="AxleSlipEnabled_Changed" Unchecked="AxleSlipEnabled_Changed"/>
                            <Border x:Name="AxleSlipNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="AxleSlipOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="Test" Style="{StaticResource EffectTestButton}" Click="AxleSlipTest_Click"/>
                            <Button x:Name="AxleSlipRevertBtn" Content="↶" Tag="AxleSlip" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="AxleSlipSaveBtn"   Content="Save…" Tag="AxleSlip" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="Feel which axle is slipping: a high scrub texture as the front washes wide, a deep pulse as the rear steps out. The louder axle is the one losing grip. Needs per-tire telemetry (Forza and Assetto Corsa today)."/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="AxleSlipGainSlider" Minimum="0" Maximum="3" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="AxleSlipGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="AxleSlipGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Front strength:" Style="{StaticResource LabelText}"
                                       ToolTip="Volume of the high front scrub voice, under the main gain."/>
                            <Slider     Grid.Column="1" x:Name="AxleSlipFrontStrengthSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                        TickFrequency="0.1" ValueChanged="AxleSlipFrontStrengthSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="AxleSlipFrontStrengthText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.30"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Rear strength:" Style="{StaticResource LabelText}"
                                       ToolTip="Volume of the deep rear pulse voice, under the main gain."/>
                            <Slider     Grid.Column="1" x:Name="AxleSlipRearStrengthSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                        TickFrequency="0.1" ValueChanged="AxleSlipRearStrengthSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="AxleSlipRearStrengthText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.21"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Front pitch (Hz):" Style="{StaticResource LabelText}"
                                       ToolTip="Center of the front scrub tone (default 200). Lower = smoother rub, higher = sharper hiss. The tone still climbs as the front tires reach the limit."/>
                            <Slider     Grid.Column="1" x:Name="AxleSlipFrontPitchSlider" Minimum="100" Maximum="350" SmallChange="5" LargeChange="25"
                                        TickFrequency="25" ValueChanged="AxleSlipFrontPitchSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="AxleSlipFrontPitchText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="200"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Rear pitch (Hz):" Style="{StaticResource LabelText}"
                                       ToolTip="Center of the rear thump (default 55). Lower = heavier, slower thud. Also the floor for the wheelspin-locked pulse."/>
                            <Slider     Grid.Column="1" x:Name="AxleSlipRearPitchSlider" Minimum="25" Maximum="90" SmallChange="1" LargeChange="5"
                                        TickFrequency="5" ValueChanged="AxleSlipRearPitchSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="AxleSlipRearPitchText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="35"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Understeer judder:" Style="{StaticResource LabelText}"
                                       ToolTip="Depth of the grip-slip-grip chatter once the front is past the limit. 0 = smooth scrub only."/>
                            <Slider     Grid.Column="1" x:Name="AxleSlipJudderSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                        TickFrequency="0.1" ValueChanged="AxleSlipJudderSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="AxleSlipJudderText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.80"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Onset threshold:" Style="{StaticResource LabelText}"
                                       ToolTip="How close to the grip limit before the voices start speaking. 0.85 = 85% of the limit; lower = earlier warning."/>
                            <Slider     Grid.Column="1" x:Name="AxleSlipOnsetSlider" Minimum="0.7" Maximum="0.95" SmallChange="0.01" LargeChange="0.05"
                                        TickFrequency="0.05" ValueChanged="AxleSlipOnsetSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="AxleSlipOnsetText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.85"/>
                        </Grid>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="AxleSlipPredictiveCheck"
                                      Content="Predictive early warning" VerticalAlignment="Center"
                                      Checked="AxleSlipPredictive_Changed" Unchecked="AxleSlipPredictive_Changed"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HelpText}" Margin="18,0,0,8" TextWrapping="Wrap"
                                   Text="Predicts the slide from how fast grip is being used up, so the warning arrives a fraction before the limit instead of at it."/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="AxleSlipRevLockedCheck"
                                      Content="Wheelspin-locked rear pulse" VerticalAlignment="Center"
                                      Checked="AxleSlipRevLocked_Changed" Unchecked="AxleSlipRevLocked_Changed"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HelpText}" Margin="18,0,0,0" TextWrapping="Wrap"
                                   Text="The rear pulse speeds up and slows down with the spinning wheels themselves, so wheelspin feels like wheels turning rather than a generic buzz."/>
                    </StackPanel>
                </Expander>

                <!-- Kerb thump (first-contact whack, distinct from the rumble
                     that follows). Needs kerb telemetry. -->
                <Expander x:Name="KerbThumpExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="KerbThumpEnabledCheck" Content="Kerb thump"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="KerbThumpEnabled_Changed" Unchecked="KerbThumpEnabled_Changed"/>
                            <Border x:Name="KerbThumpNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="KerbThumpOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="Test" Style="{StaticResource EffectTestButton}" Click="KerbThumpTest_Click"/>
                            <Button x:Name="KerbThumpRevertBtn" Content="↶" Tag="KerbThump" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="KerbThumpSaveBtn"   Content="Save…" Tag="KerbThump" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="A single firm whack the instant a wheel first touches a kerb, distinct from the rumble that follows. Scales with speed. Needs kerb telemetry (Forza games today)."/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="KerbThumpGainSlider" Minimum="0" Maximum="3" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="KerbThumpGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="KerbThumpGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.60"/>
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Frequency (Hz):" Style="{StaticResource LabelText}"
                                       ToolTip="Lower = deeper whack. 30 Hz default keeps it below the gear-shift thud."/>
                            <Slider     Grid.Column="1" x:Name="KerbThumpFreqSlider" Minimum="15" Maximum="60" SmallChange="1" LargeChange="5"
                                        TickFrequency="5" ValueChanged="KerbThumpFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="KerbThumpFreqText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="30"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Lockup judder (flat-spot pulse while a braking tire is
                     locked, slowing with the car). Needs per-tire telemetry. -->
                <Expander x:Name="LockupJudderExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="LockupJudderEnabledCheck" Content="Lockup judder"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="LockupJudderEnabled_Changed" Unchecked="LockupJudderEnabled_Changed"/>
                            <Border x:Name="LockupJudderNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="LockupJudderOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="Test" Style="{StaticResource EffectTestButton}" Click="LockupJudderTest_Click"/>
                            <Button x:Name="LockupJudderRevertBtn" Content="↶" Tag="LockupJudder" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="LockupJudderSaveBtn"   Content="Save…" Tag="LockupJudder" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="A flat-spot pulse while a braking tire is locked, slowing with the car the way a real flat spot would. Needs per-tire telemetry (Forza and Assetto Corsa today)."/>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="LockupJudderGainSlider" Minimum="0" Maximum="3" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="LockupJudderGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="LockupJudderGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Gear shift -->
                <Expander x:Name="ShiftExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ShiftEnabledCheck" Content="Gear shift thud"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="ShiftEnabled_Changed" Unchecked="ShiftEnabled_Changed"/>
                            <Border x:Name="ShiftNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="ShiftOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="Test" Style="{StaticResource EffectTestButton}" Click="ShiftTest_Click"/>
                            <Button x:Name="ShiftRevertBtn" Content="↶" Tag="Shift" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="ShiftSaveBtn"   Content="Save…" Tag="Shift" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="ShiftGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="ShiftGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="ShiftGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waveform:" Style="{StaticResource LabelText}"/>
                            <ComboBox  Grid.Column="1" x:Name="ShiftWaveformCombo" SelectionChanged="ShiftWaveform_Changed">
                                <ComboBoxItem Content="Sine"/><ComboBoxItem Content="Square"/><ComboBoxItem Content="Saw"/><ComboBoxItem Content="Triangle"/><ComboBoxItem Content="Noise"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Frequency (Hz):" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="ShiftFreqSlider" Minimum="20" Maximum="100" SmallChange="1" LargeChange="5"
                                        TickFrequency="10" ValueChanged="ShiftFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="ShiftFreqText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="40"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ABS -->
                <Expander x:Name="AbsExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="AbsEnabledCheck" Content="ABS pulse"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="AbsEnabled_Changed" Unchecked="AbsEnabled_Changed"/>
                            <Border x:Name="AbsNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="AbsOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="Test" Style="{StaticResource EffectTestButton}" Click="AbsTest_Click"/>
                            <TextBlock x:Name="AbsUnsupportedBadge" Style="{StaticResource UnsupportedBadge}"
                                       Text="not exposed by Forza UDP"
                                       ToolTip="Forza Horizon's Data Out telemetry doesn't include ABS pump activity, so this effect will stay silent in FH4/FH5/FH6 regardless of the values you set here."/>
                            <Button x:Name="AbsRevertBtn" Content="↶" Tag="Abs" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="AbsSaveBtn"   Content="Save…" Tag="Abs" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="AbsGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="AbsGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="AbsGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waveform:" Style="{StaticResource LabelText}"/>
                            <ComboBox  Grid.Column="1" x:Name="AbsWaveformCombo" SelectionChanged="AbsWaveform_Changed">
                                <ComboBoxItem Content="Sine"/><ComboBoxItem Content="Square"/><ComboBoxItem Content="Saw"/><ComboBoxItem Content="Triangle"/><ComboBoxItem Content="Noise"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mode:" Style="{StaticResource LabelText}"/>
                            <ComboBox  Grid.Column="1" x:Name="AbsModeCombo" SelectionChanged="AbsMode_Changed">
                                <ComboBoxItem Content="Pulse (rhythmic)"/>
                                <ComboBoxItem Content="Per tick (one click per ABS pump)"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Carrier (Hz):" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="AbsFreqSlider" Minimum="30" Maximum="150" SmallChange="1" LargeChange="5"
                                        TickFrequency="10" ValueChanged="AbsFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="AbsFreqText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="80"/>
                        </Grid>
                        <!-- Pulse rate / duty are only meaningful in Pulse mode.
                             Greyed when AbsMode = PerTick. -->
                        <StackPanel x:Name="AbsPulseControls">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pulse rate (Hz):" Style="{StaticResource LabelText}"/>
                                <Slider     Grid.Column="1" x:Name="AbsPulseFreqSlider" Minimum="3" Maximum="30" SmallChange="0.5" LargeChange="2"
                                            TickFrequency="2" ValueChanged="AbsPulseFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="2" x:Name="AbsPulseFreqText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="12"/>
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pulse duty:" Style="{StaticResource LabelText}"/>
                                <Slider     Grid.Column="1" x:Name="AbsDutyCycleSlider" Minimum="0.1" Maximum="0.9" SmallChange="0.05" LargeChange="0.1"
                                            TickFrequency="0.1" ValueChanged="AbsDutyCycleSlider_ValueChanged" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="2" x:Name="AbsDutyCycleText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.40"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Pit limiter (modal flag effect). Pulse train while the
                     pit limiter is engaged. Most modern racing sims surface
                     PitLimiterOn directly via SimHub. -->
                <Expander x:Name="PitLimiterExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="PitLimiterEnabledCheck" Content="Pit limiter"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="PitLimiterEnabled_Changed" Unchecked="PitLimiterEnabled_Changed"/>
                            <Border x:Name="PitLimiterNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="PitLimiterOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="Test" Style="{StaticResource EffectTestButton}" Click="PitLimiterTest_Click"/>
                            <Button x:Name="PitLimiterRevertBtn" Content="↶" Tag="PitLimiter" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="PitLimiterSaveBtn"   Content="Save…" Tag="PitLimiter" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="Feels like the engine being cut at low RPM while the pit limiter is engaged. A steady pulse train you can't miss in the pit lane. Source: SimHub StatusDataBase.PitLimiterOn (works for most racing sims that have a pit lane)."/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="PitLimiterGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="PitLimiterGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="PitLimiterGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waveform:" Style="{StaticResource LabelText}"/>
                            <ComboBox  Grid.Column="1" x:Name="PitLimiterWaveformCombo" SelectionChanged="PitLimiterWaveform_Changed">
                                <ComboBoxItem Content="Sine"/><ComboBoxItem Content="Square"/><ComboBoxItem Content="Saw"/><ComboBoxItem Content="Triangle"/><ComboBoxItem Content="Noise"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Carrier (Hz):" Style="{StaticResource LabelText}"
                                       ToolTip="Tone within each pulse. Lower = deeper thud; higher = brighter."/>
                            <Slider     Grid.Column="1" x:Name="PitLimiterFreqSlider" Minimum="20" Maximum="150" SmallChange="1" LargeChange="5"
                                        TickFrequency="10" ValueChanged="PitLimiterFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="PitLimiterFreqText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="50"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pulse rate (Hz):" Style="{StaticResource LabelText}"
                                       ToolTip="How fast the pulse opens / closes. 5-10 Hz feels like a real pit limiter cadence."/>
                            <Slider     Grid.Column="1" x:Name="PitLimiterPulseFreqSlider" Minimum="3" Maximum="15" SmallChange="0.5" LargeChange="2"
                                        TickFrequency="1" ValueChanged="PitLimiterPulseFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="PitLimiterPulseFreqText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="6.0"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pulse duty:" Style="{StaticResource LabelText}"
                                       ToolTip="Fraction of each pulse during which the carrier is audible. Higher = more sustained; lower = more punctuated."/>
                            <Slider     Grid.Column="1" x:Name="PitLimiterDutyCycleSlider" Minimum="0.1" Maximum="0.9" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="PitLimiterDutyCycleSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="PitLimiterDutyCycleText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.60"/>
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Active amp:" Style="{StaticResource LabelText}"
                                       ToolTip="Peak amplitude while the limiter is engaged."/>
                            <Slider     Grid.Column="1" x:Name="PitLimiterActiveAmpSlider" Minimum="0" Maximum="0.6" SmallChange="0.02" LargeChange="0.05"
                                        TickFrequency="0.1" ValueChanged="PitLimiterActiveAmpSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="PitLimiterActiveAmpText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.30"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- DRS (F1-style flag effect). Activation chirp on rising edge
                     plus low-amp sustained tone while wing is open. Source:
                     SimHub StatusDataBase.DRSEnabled (F1 / F1-like sims). -->
                <Expander x:Name="DrsExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="DrsEnabledCheck" Content="DRS"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="DrsEnabled_Changed" Unchecked="DrsEnabled_Changed"/>
                            <Border x:Name="DrsNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="DrsOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="Test" Style="{StaticResource EffectTestButton}" Click="DrsTest_Click"/>
                            <Button x:Name="DrsRevertBtn" Content="↶" Tag="Drs" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="DrsSaveBtn"   Content="Save…" Tag="Drs" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="A quick chirp the moment DRS opens, then a faint sustained tone while the wing stays open. Silent on games that don't expose DRS. Source: SimHub StatusDataBase.DRSEnabled."/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="DrsGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="DrsGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="DrsGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,4" Text="Activation chirp (rising edge of DRS)" FontWeight="SemiBold"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waveform:" Style="{StaticResource LabelText}"
                                       ToolTip="Shape of the brief blip on the rising edge."/>
                            <ComboBox  Grid.Column="1" x:Name="DrsWaveformCombo" SelectionChanged="DrsWaveform_Changed">
                                <ComboBoxItem Content="Sine"/><ComboBoxItem Content="Square"/><ComboBoxItem Content="Saw"/><ComboBoxItem Content="Triangle"/><ComboBoxItem Content="Noise"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Carrier (Hz):" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="DrsActivationFreqSlider" Minimum="40" Maximum="200" SmallChange="1" LargeChange="5"
                                        TickFrequency="20" ValueChanged="DrsActivationFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="DrsActivationFreqText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="120"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Duration (ms):" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="DrsActivationMsSlider" Minimum="20" Maximum="200" SmallChange="5" LargeChange="20"
                                        TickFrequency="20" ValueChanged="DrsActivationMsSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="DrsActivationMsText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="60"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Amp:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="DrsActivationAmpSlider" Minimum="0" Maximum="0.6" SmallChange="0.02" LargeChange="0.05"
                                        TickFrequency="0.1" ValueChanged="DrsActivationAmpSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="DrsActivationAmpText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.30"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,4" Text="Sustained tone (while DRS held open). Set amp to 0 for chirp-only mode." FontWeight="SemiBold"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waveform:" Style="{StaticResource LabelText}"
                                       ToolTip="Shape of the held trail. Independent from the activation chirp so a sharp Square blip can have a softer Sine trail."/>
                            <ComboBox  Grid.Column="1" x:Name="DrsSustainedWaveformCombo" SelectionChanged="DrsSustainedWaveform_Changed">
                                <ComboBoxItem Content="Sine"/><ComboBoxItem Content="Square"/><ComboBoxItem Content="Saw"/><ComboBoxItem Content="Triangle"/><ComboBoxItem Content="Noise"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Carrier (Hz):" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="DrsSustainedFreqSlider" Minimum="20" Maximum="150" SmallChange="1" LargeChange="5"
                                        TickFrequency="10" ValueChanged="DrsSustainedFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="DrsSustainedFreqText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="70"/>
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Amp:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="DrsSustainedAmpSlider" Minimum="0" Maximum="0.4" SmallChange="0.02" LargeChange="0.05"
                                        TickFrequency="0.05" ValueChanged="DrsSustainedAmpSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="DrsSustainedAmpText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.12"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Collision (variable-amplitude thud on impact). Magnitude
                     comes from PC2's mLastOpponentCollisionMagnitude
                     directly, or is derived from a sudden lateral/vertical
                     accel spike (>5g) for any other source. Global-only
                     for v1 (no per-car override slot yet). -->
                <Expander x:Name="CollisionExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="CollisionEnabledCheck" Content="Collision"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="CollisionEnabled_Changed" Unchecked="CollisionEnabled_Changed"/>
                            <Border x:Name="CollisionNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="CollisionOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="Test" Style="{StaticResource EffectTestButton}" Click="CollisionTest_Click"/>
                            <Button x:Name="CollisionRevertBtn" Content="↶" Tag="Collision" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="CollisionSaveBtn"   Content="Save…" Tag="Collision" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="A thud on impact that hits harder the bigger the crash. Sources: PC2 reads its native impact magnitude directly; other sources derive from sudden lateral/vertical accel spikes above ~5g (well above hard cornering or kerbs)."/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="CollisionGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="CollisionGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="CollisionGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Min threshold:" Style="{StaticResource LabelText}"
                                       ToolTip="Lower = lighter contacts trigger. Raise if light scrapes are too noisy."/>
                            <Slider     Grid.Column="1" x:Name="CollisionMinThresholdSlider" Minimum="0.05" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="CollisionMinThresholdSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="CollisionMinThresholdText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.20"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Max amplitude:" Style="{StaticResource LabelText}"
                                       ToolTip="Cap on the loudest hit. Safety knob for wrists / wheelbase."/>
                            <Slider     Grid.Column="1" x:Name="CollisionMaxAmpSlider" Minimum="0.2" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="CollisionMaxAmpSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="CollisionMaxAmpText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.85"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Carrier (Hz):" Style="{StaticResource LabelText}"
                                       ToolTip="Lower = deeper thud. 50 Hz default."/>
                            <Slider     Grid.Column="1" x:Name="CollisionFreqSlider" Minimum="20" Maximum="120" SmallChange="1" LargeChange="5"
                                        TickFrequency="10" ValueChanged="CollisionFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="CollisionFreqText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="50"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Duration (ms):" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="CollisionEnvelopeMsSlider" Minimum="40" Maximum="300" SmallChange="5" LargeChange="20"
                                        TickFrequency="20" ValueChanged="CollisionEnvelopeMsSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="CollisionEnvelopeMsText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="120"/>
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waveform:" Style="{StaticResource LabelText}"
                                       ToolTip="Shape of the impact thud. Square is the punchiest; Sine is softer."/>
                            <ComboBox  Grid.Column="1" x:Name="CollisionWaveformCombo" SelectionChanged="CollisionWaveform_Changed">
                                <ComboBoxItem Content="Sine"/><ComboBoxItem Content="Square"/><ComboBoxItem Content="Saw"/><ComboBoxItem Content="Triangle"/><ComboBoxItem Content="Noise"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Redline buzz (modal RPM-threshold effect). Hard buzz when
                     RPM reaches the shift point / limiter, held while bouncing
                     off it. Independent of engine pulse; an unmistakable
                     "shift now / on the limiter" cue. Works wherever RPM is
                     reported (the universal SimHub fallback included). -->
                <Expander x:Name="RevLimiterExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="RevLimiterEnabledCheck" Content="Redline buzz"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="RevLimiterEnabled_Changed" Unchecked="RevLimiterEnabled_Changed"/>
                            <Border x:Name="RevLimiterNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="RevLimiterOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="Test" Style="{StaticResource EffectTestButton}" Click="RevLimiterTest_Click"/>
                            <Button x:Name="RevLimiterRevertBtn" Content="↶" Tag="RevLimiter" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="RevLimiterSaveBtn"   Content="Save…" Tag="RevLimiter" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="A hard buzz when you enter the redline start: an unmistakable shift cue. If it fires at the wrong RPM, fix the redline start in Car facts."/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="RevLimiterGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="RevLimiterGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="RevLimiterGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.10"/>
                        </Grid>
                        <!-- (The Engage mode combo, the Redline RPM slider + per-variant
                             save row, and the duplicate per-gear editor were retired
                             2026-07-17: the redline is car truth, edited ONLY in the
                             Car facts panel on the active card. This panel keeps the
                             feel knobs: gain, offset, waveform, tone.) -->
                        <!-- Coverage badge: shown when the rev-limiter cascade fell
                             all the way to the 0.85 × MaxRpm estimate (no user value,
                             no telemetry redline, no community value). Tells the user
                             the shift cue is a guess and offers ONE affordance: jump
                             to the Car facts redline box to set it. Setting is the
                             whole story (auto-submit carries it to the community by
                             itself); a separate share link would reframe saving a
                             value as a contribution act and add pressure. -->
                        <Border x:Name="RedlineGuessBadge" Visibility="Collapsed"
                                Background="#33D89F00" BorderBrush="#FFD89F00" BorderThickness="1"
                                CornerRadius="3" Padding="10,8" Margin="140,0,0,10">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#FFFFE082" FontSize="12">
                                    <Run FontWeight="Bold">Estimated redline.</Run>
                                    <Run>The buzz is firing at 85% of max RPM because no one has confirmed the real redline start yet (where the tachometer turns red). Set it so the shift cue lands right.</Run>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Margin="0,0,12,0" Style="{StaticResource HelpText}">
                                        <Hyperlink x:Name="RedlineGuessSetValueLink" Click="RedlineGuessSetValue_Click">Set the redline start</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- (The community-redline Confirm banner was retired with the
                             set-not-share framing pass: the cascade applies community
                             values directly, corrections are just setting your own
                             redline, and agreement accrues from other drivers'
                             auto-submitted saves rather than a dedicated prompt.) -->
                        <Grid x:Name="RevLimiterOffsetRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Redline offset:" Style="{StaticResource LabelText}"
                                       ToolTip="Shift the engage point relative to the car's redline. Negative fires the buzz before the redline (an early shift cue); positive fires it after. 0 = right at the redline."/>
                            <Slider     Grid.Column="1" x:Name="RevLimiterOffsetSlider" Minimum="-3000" Maximum="1000" SmallChange="50" LargeChange="250"
                                        TickFrequency="250" ValueChanged="RevLimiterOffsetSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="RevLimiterOffsetText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waveform:" Style="{StaticResource LabelText}"/>
                            <ComboBox  Grid.Column="1" x:Name="RevLimiterWaveformCombo" SelectionChanged="RevLimiterWaveform_Changed">
                                <ComboBoxItem Content="Sine"/><ComboBoxItem Content="Square"/><ComboBoxItem Content="Saw"/><ComboBoxItem Content="Triangle"/><ComboBoxItem Content="Noise"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Carrier (Hz):" Style="{StaticResource LabelText}"
                                       ToolTip="Tone within each pulse. Higher reads as a more urgent buzz."/>
                            <Slider     Grid.Column="1" x:Name="RevLimiterFreqSlider" Minimum="30" Maximum="200" SmallChange="1" LargeChange="5"
                                        TickFrequency="10" ValueChanged="RevLimiterFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="RevLimiterFreqText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="90"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pulse rate (Hz):" Style="{StaticResource LabelText}"
                                       ToolTip="How fast the buzz stutters. Faster feels like an aggressive soft-cut limiter."/>
                            <Slider     Grid.Column="1" x:Name="RevLimiterPulseFreqSlider" Minimum="5" Maximum="40" SmallChange="0.5" LargeChange="2"
                                        TickFrequency="5" ValueChanged="RevLimiterPulseFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="RevLimiterPulseFreqText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="20.0"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pulse duty:" Style="{StaticResource LabelText}"
                                       ToolTip="Fraction of each pulse during which the carrier is audible. Higher = more sustained; lower = more punctuated."/>
                            <Slider     Grid.Column="1" x:Name="RevLimiterDutyCycleSlider" Minimum="0.1" Maximum="0.9" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="RevLimiterDutyCycleSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="RevLimiterDutyCycleText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.50"/>
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Active amp:" Style="{StaticResource LabelText}"
                                       ToolTip="Peak amplitude while engaged."/>
                            <Slider     Grid.Column="1" x:Name="RevLimiterActiveAmpSlider" Minimum="0" Maximum="0.6" SmallChange="0.02" LargeChange="0.05"
                                        TickFrequency="0.1" ValueChanged="RevLimiterActiveAmpSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="RevLimiterActiveAmpText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.35"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Ducking: cross-effect amplitude coordinators. Airborne
                     ducking cuts effects while the car is off the ground;
                     sidechain ducking dips continuous effects when transient
                     ones fire. Neither is a voice of its own. -->
                <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,24,0,12"><TextBlock Text="Ducking" Style="{StaticResource SectionHeaderText}"/></Border>

                <!-- Airborne ducking. A coordinator, not a voice: it produces
                     no haptic of its own, it pulls down the OTHER effects while
                     the car is off the ground so jumps / crest pops don't fire
                     phantom slide, engine, or road feedback. Detection comes
                     from the enhanced sources (AC wheel load, Forza suspension
                     droop); the universal SimHub path can't tell, so it's a
                     no-op there. Global (no per-car override / Save button):
                     edits persist immediately. -->
                <Expander x:Name="AirborneExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="AirborneEnabledCheck" Content="Airborne ducking"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="AirborneEnabled_Changed" Unchecked="AirborneEnabled_Changed"/>
                            <Border x:Name="AirborneNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <Button x:Name="AirborneRevertBtn" Content="↶" Tag="Airborne" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="AirborneSaveBtn"   Content="Save…" Tag="Airborne" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="Cuts vibrations while the car is in the air, so a jump feels weightless instead of buzzing as if the tires were still on the track. Everything comes back the moment you land. Choose how far to turn things down and which effects to cut below (the engine keeps pulsing by default, since it's still revving). Works in Assetto Corsa and Forza, the games that report enough to know the car has left the ground; it does nothing elsewhere."/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Reduction:" Style="{StaticResource LabelText}"
                                       ToolTip="How far to turn the chosen effects down while airborne. 100% = fully silent; lower values just dial them back."/>
                            <Slider     Grid.Column="1" x:Name="AirborneReductionSlider" Minimum="0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="AirborneReductionSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="AirborneReductionText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="100%"/>
                        </Grid>
                        <TextBlock Text="Duck these while airborne:" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <WrapPanel Orientation="Horizontal">
                            <CheckBox x:Name="AirborneDuckEngineCheck"      Content="Engine pulse"   Width="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckAudioCheck"       Content="Captured audio" Width="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckRoadBumpsCheck"   Content="Road bumps"     Width="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckTractionCheck"    Content="Traction loss"  Width="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckRevLimiterCheck"  Content="Redline buzz"   Width="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckGearShiftCheck"   Content="Gear shift"     Width="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckAbsCheck"         Content="ABS"            Width="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckPitLimiterCheck"  Content="Pit limiter"    Width="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckDrsCheck"         Content="DRS"            Width="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckCollisionCheck"   Content="Collision"      Width="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <!-- Sidechain ducking. When transient effects fire, continuous
                     effects duck to make room. Sits next to Airborne ducking:
                     both are cross-effect amplitude coordinators rather than
                     voices of their own. -->
                <Expander x:Name="DuckingExpander" IsExpanded="False" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="DuckingEnabledCheck" Content="Sidechain ducking"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="DuckingEnabled_Changed" Unchecked="DuckingEnabled_Changed"/>
                            <Button x:Name="DuckingRevertBtn" Content="↶" Tag="Ducking" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="DuckingSaveBtn"   Content="Save…" Tag="Ducking" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" FontSize="12"
                            Text="When transient effects (gear shift, ABS, road bumps, traction loss) fire, continuous effects (engine pulse, audio capture) duck to make room."/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Depth:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="DuckDepthSlider"
                                        Minimum="0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="DuckDepthSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="DuckDepthText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.50"/>
                        </Grid>
                        <Expander x:Name="AdvancedDuckingExpander" IsExpanded="False" Margin="0,4,0,0">
                            <Expander.Header>
                                <TextBlock Text="Advanced (envelope)" FontSize="12"/>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Attack (ms):" Style="{StaticResource LabelText}"/>
                                    <Slider     Grid.Column="1" x:Name="DuckAttackSlider"
                                                Minimum="1" Maximum="100" SmallChange="1" LargeChange="5"
                                                TickFrequency="10" ValueChanged="DuckAttackSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" x:Name="DuckAttackText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="5"/>
                                </Grid>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Release (ms):" Style="{StaticResource LabelText}"/>
                                    <Slider     Grid.Column="1" x:Name="DuckReleaseSlider"
                                                Minimum="10" Maximum="500" SmallChange="5" LargeChange="25"
                                                TickFrequency="50" ValueChanged="DuckReleaseSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" x:Name="DuckReleaseText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="80"/>
                                </Grid>
                                <CheckBox x:Name="DuckFrequencyAwareCheck" Content="Frequency-aware ducking"
                                          Margin="0,8,0,2" VerticalAlignment="Center"
                                          Checked="DuckFrequencyAware_Changed" Unchecked="DuckFrequencyAware_Changed"/>
                                <TextBlock Style="{StaticResource HelpText}" Margin="18,0,0,0" FontSize="12" TextWrapping="Wrap"
                                           Text="Only ducks effects that overlap in frequency. Grip textures always win their band, so a slide stays crisp through the engine pulse instead of blending into it."/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>

            </StackPanel> <!-- /TelemetryEffectsPanel -->

            <!-- The donation block (Patreon / Ko-fi) and the full "Spread the
                 word" section moved to the dedicated "Support us" tab, to keep
                 the tuning flow non-salesy. Discovery is the bottleneck though,
                 so a single slim Share action stays on this high-traffic Effects
                 tab rather than being buried a tab away. -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,16" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource HelpText}" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,8,0" Text="Enjoying this? Help others find it:"/>
                <Button x:Name="SharePanelButton" Content="Share TF4ALL…"
                        Style="{StaticResource EffectsShareButton}"
                        Click="SharePanelButton_Click" ToolTipService.InitialShowDelay="250"
                        ToolTip="Post on X, Reddit, or Facebook, or copy the GitHub / Nexus link."/>
            </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </sh:SHTabItem>

            <!-- ============================ TELEMETRY BASED FFB ============================ -->
            <!-- Mode B: the steering force is synthesized from telemetry instead of
                 passing the game's FFB through. Global settings (not preset-scoped);
                 every control applies live via ApplyModeBFromSettings /
                 ApplyModeBFeel. Forza only (FM8 / FH5 / FH6). -->
            <sh:SHTabItem x:Name="TelemetryFfbTab" Header="Telemetry FFB">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12,14,14">

            <Border Style="{StaticResource SectionHeaderBorder}">
                <TextBlock Text="Telemetry Based FFB" Style="{StaticResource SectionHeaderText}"/>
            </Border>

            <!-- "Not available here" badge. The controls below stay visible (and
                 pre-tunable) in every game so the section can be explored without a
                 supported title running; this badge appears when the active game
                 can't feed Mode B and explains why the Enable box is greyed out.
                 Visibility + text set by RefreshFromPlugin. Info-styled to match
                 the Forza-discovery banner in this tab. -->
            <Border x:Name="ModeBUnsupportedBadge" Visibility="Collapsed"
                    Background="#3300A8FF" BorderBrush="#00A8FF" BorderThickness="1"
                    CornerRadius="3" Padding="9,7" Margin="0,4,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#9432;" FontSize="14" Foreground="#7FD3FF"
                               VerticalAlignment="Top" Margin="0,1,8,0"/>
                    <TextBlock x:Name="ModeBUnsupportedBadgeText" Foreground="#DCEBFA"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                               MaxWidth="540" Text=""/>
                </StackPanel>
            </Border>

            <!-- The Mode B controls. Always visible; the Enable box greys out and the
                 badge above appears when the active game can't use it. -->
            <StackPanel x:Name="ModeBSupportedPanel">
            <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,10" TextWrapping="Wrap"
                       Text="The wheel's steering force is built from telemetry: slip angle, tire load, and speed, instead of the game's own FFB. Works in Forza Motorsport (2023) and Forza Horizon 4, 5, and 6. Set the game's force feedback and vibration to 0 so this is the only force on the wheel."/>
            <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,10" TextWrapping="Wrap"
                       Text="It also enables your wheel's rev lights. For now rev lights only work with Telemetry Based FFB: writing to them while a game runs its own force feedback makes that force feedback cut out, because they share one channel on the wheel, and replacing the game's force feedback frees them. A custom driver that would enable rev lights in every game is in testing, but it needs to be signed by Microsoft first."/>

            <!-- Contention warning. The plugin latches ModeBContentionDetected when
                 the game keeps streaming its own FFB while Mode B is driving the
                 wheel; the meter timer + RefreshFromPlugin surface it here. -->
            <TextBlock x:Name="ModeBContentionWarning" Visibility="Collapsed"
                       Foreground="#FFFFA726" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="The game is still sending its own force feedback, so two force streams are fighting and the wheel will feel jumpy or buzzy. In the game's wheel settings, set force feedback and vibration strength to 0 so this is the only force on the wheel."/>

            <CheckBox x:Name="ModeBEnabledCheck" Content="Enable Telemetry Based FFB for this game"
                      Margin="0,4,0,2" Checked="ModeBEnabled_Changed" Unchecked="ModeBEnabled_Changed"/>
            <TextBlock x:Name="ModeBGameNote" Style="{StaticResource HelpText}" Margin="22,0,0,12"
                       Text="Enable this per game, for whichever game is running. Set that game's own force feedback and vibration to 0."/>

            <CheckBox x:Name="ModeBRevLightsCheck" Content="Rev lights"
                      Margin="0,0,0,2" Checked="ModeBRevLights_Changed" Unchecked="ModeBRevLights_Changed"/>
            <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,12"
                       Text="Your wheel's rev lights follow the engine: the strip fills as revs climb and flashes at the shift point. Turn this off if a game drives the wheel's lights itself."/>

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Strength:" Style="{StaticResource LabelText}"/>
                <Slider     Grid.Column="1" x:Name="ModeBStrengthSlider" Minimum="0.05" Maximum="1.5" SmallChange="0.05" LargeChange="0.1"
                            TickFrequency="0.1" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" x:Name="ModeBStrengthText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.50"/>
            </Grid>
            <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="Overall steering force. Your wheel's defaults set the starting point."/>

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Min force:" Style="{StaticResource LabelText}"/>
                <Slider     Grid.Column="1" x:Name="ModeBMinForceSlider" Minimum="0" Maximum="0.5" SmallChange="0.01" LargeChange="0.05"
                            TickFrequency="0.05" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" x:Name="ModeBMinForceText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.05"/>
            </Grid>
            <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="The smallest force your wheel will play. Raising it lifts faint cues above the wheel's own friction and brings the average force up, so a belt-driven wheel like the G923 feels stronger overall."/>

            <TextBlock Text="Steering feel" FontWeight="SemiBold" Margin="0,10,0,2"/>
            <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8"
                       Text="The wheel's everyday manner: cornering weight, resistance, and the pull back to center."/>

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Cornering weight:" Style="{StaticResource LabelText}"/>
                <Slider     Grid.Column="1" x:Name="ModeBLatSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                            TickFrequency="0.15" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" x:Name="ModeBLatText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.60"/>
            </Grid>
            <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="Extra weight per g of cornering load. Fast sweepers get heavy, slow hairpins stay light. 0 = off."/>

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Damping:" Style="{StaticResource LabelText}"/>
                <Slider     Grid.Column="1" x:Name="ModeBDamperSlider" Minimum="0" Maximum="0.6" SmallChange="0.02" LargeChange="0.05"
                            TickFrequency="0.05" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" x:Name="ModeBDamperText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.07"/>
            </Grid>
            <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="Resistance to wheel motion. The heavy, planted feel that is not grip force."/>

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Centering:" Style="{StaticResource LabelText}"/>
                <Slider     Grid.Column="1" x:Name="ModeBCenterSlider" Minimum="0" Maximum="0.5" SmallChange="0.02" LargeChange="0.05"
                            TickFrequency="0.05" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" x:Name="ModeBCenterText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.25"/>
            </Grid>
            <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,2" Text="Caster-style pull toward straight, scaled up with speed (a parked wheel stays free). Follows the wheel's own position, so a released wheel settles into center instead of swinging past."/>
            <Grid Margin="20,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Look-ahead (ms):" Style="{StaticResource LabelText}"/>
                <Slider     Grid.Column="1" x:Name="ModeBCenterLeadSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                            TickFrequency="10" ValueChanged="ModeBCenterLeadSlider_ValueChanged" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" x:Name="ModeBCenterLeadText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="40"/>
            </Grid>
            <TextBlock Style="{StaticResource HelpText}" Margin="20,0,0,8" Text="How far ahead of the wheel's motion the centering aims. Raise if a released wheel overshoots center; lower if centering feels nervous."/>

            <CheckBox x:Name="ModeBSuspLoadCheck" Margin="0,0,0,2" Content="Suspension load"
                      Checked="ModeBFeel_Changed" Unchecked="ModeBFeel_Changed"/>
            <TextBlock Style="{StaticResource HelpText}" Margin="20,0,0,8" Text="Steering weight breathes with real front-axle load: braking dive loads up, crests go light."/>
            <CheckBox x:Name="ModeBEarlyPeakCheck" Margin="0,0,0,2" Content="Early torque peak"
                      Checked="ModeBFeel_Changed" Unchecked="ModeBFeel_Changed"/>
            <TextBlock Style="{StaticResource HelpText}" Margin="20,0,0,8" Text="Steering weight tops out just before the grip limit and holds, like a real tire; the plateau is your approach warning."/>
            <CheckBox x:Name="ModeBRoadKickCheck" Margin="0,0,0,2" Content="Road kick (one-wheel bumps)"
                      Checked="ModeBFeel_Changed" Unchecked="ModeBFeel_Changed"/>
            <TextBlock Style="{StaticResource HelpText}" Margin="20,0,0,2" Text="One front wheel hitting a bump or kerb kicks the rim the way a real rack does; both wheels together cancel."/>
            <Grid Margin="20,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Road kick strength:" Style="{StaticResource LabelText}"/>
                <Slider     Grid.Column="1" x:Name="ModeBRoadKickGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                            TickFrequency="0.25" ValueChanged="ModeBRoadKickGainSlider_ValueChanged" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" x:Name="ModeBRoadKickGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.40"/>
            </Grid>

            <Expander IsExpanded="False" Margin="0,8,0,4">
                <Expander.Header>
                    <TextBlock Text="Slides and drifting" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8"
                               Text="How the wheel behaves when the car slides or drifts."/>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Slide lightness:" Style="{StaticResource LabelText}"/>
                        <Slider     Grid.Column="1" x:Name="ModeBFloorSlider" Minimum="0.05" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.1" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="ModeBFloorText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.50"/>
                    </Grid>
                    <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="Torque left once the front has fully let go. Lower = a more dramatic gone-light cue."/>


                    <CheckBox x:Name="ModeBReversalDampCheck" Margin="0,0,0,2" Content="Reversal damping"
                              Checked="ModeBFeel_Changed" Unchecked="ModeBFeel_Changed"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="20,0,0,2" Text="Softens the wheel as you catch a slide back through center, so the moment the force switches sides stops snapping and feeling unstable. Digging deeper into a drift keeps its full weight."/>
                    <Grid Margin="20,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Reversal strength:" Style="{StaticResource LabelText}"/>
                        <Slider     Grid.Column="1" x:Name="ModeBReversalGainSlider" Minimum="0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.1" ValueChanged="ModeBReversalGainSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="ModeBReversalGainText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.50"/>
                    </Grid>

                    <CheckBox x:Name="ModeBPhaseLeadCheck" Margin="0,0,0,2" Content="Anticipation"
                              Checked="ModeBFeel_Changed" Unchecked="ModeBFeel_Changed"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="20,0,0,2" Text="Leads the force slightly ahead of the wheel to cancel telemetry lag, so a released wheel settles instead of oscillating. Raise the lead only until a released wheel stops ringing; too much adds nervousness on fast transitions."/>
                    <Grid Margin="20,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Lead (ms):" Style="{StaticResource LabelText}"/>
                        <Slider     Grid.Column="1" x:Name="ModeBPhaseLeadSlider" Minimum="0" Maximum="120" SmallChange="5" LargeChange="10"
                                    TickFrequency="20" ValueChanged="ModeBPhaseLeadSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="ModeBPhaseLeadText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="40"/>
                    </Grid>
                </StackPanel>
            </Expander>

            <Expander IsExpanded="False" Margin="0,0,0,4">
                <Expander.Header>
                    <TextBlock Text="Braking" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8"
                               Text="How steering weight behaves under braking and lockup."/>

                    <CheckBox x:Name="ModeBGripCalCheck" Margin="0,0,0,2" Content="Adaptive grip &amp; braking feel"
                              Checked="ModeBFeel_Changed" Unchecked="ModeBFeel_Changed"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="20,0,0,8" Text="Learns where each car's grip actually tops out as you drive (about a lap of pushing) and shapes the limit and braking feel to it: the wheel lightens at each car's real grip limit as you brake or slide, instead of at one fixed point. Off = a fixed manual grip limit (the slider below) and the classic lockup fade."/>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Lockup recovery (ms):" Style="{StaticResource LabelText}"/>
                        <Slider     Grid.Column="1" x:Name="ModeBRecoverSlider" Minimum="20" Maximum="400" SmallChange="10" LargeChange="50"
                                    TickFrequency="50" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="ModeBRecoverText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="30"/>
                    </Grid>
                    <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="How quickly steering weight returns as the tires regain grip after a lockup or slide. Lower snaps back fast, higher hands the weight back gently."/>

                    <!-- Global grip-limit fallback: only relevant when per-car grip auto-calibration
                         is OFF (with it on, the learner owns the per-car limit and this just double-scales),
                         so the row is hidden while auto-cal is on (see UpdateModeBGripLimitVisibility). -->
                    <StackPanel x:Name="ModeBGripLimitRow">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Grip limit:" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="ModeBPeakSlider" Minimum="0.4" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="ModeBPeakText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="1.00"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="Where the game's combined-slip metric counts as the grip limit (1.0 = Forza's own limit). Lower = the wheel peaks and washes out earlier. Only used when adaptive grip is off."/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander IsExpanded="False" Margin="0,0,0,4">
                <Expander.Header>
                    <TextBlock Text="Advanced" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8"
                               Text="Force shaping and plumbing. The defaults suit almost everyone."/>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Weight buildup:" Style="{StaticResource LabelText}"/>
                        <Slider     Grid.Column="1" x:Name="ModeBRiseSlider" Minimum="0.2" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.1" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="ModeBRiseText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.80"/>
                    </Grid>
                    <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="How early weight arrives. Lower = heavier in normal cornering; 1.0 = force grows linearly to the limit."/>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Smoothing (ms):" Style="{StaticResource LabelText}"/>
                        <Slider     Grid.Column="1" x:Name="ModeBSmoothSlider" Minimum="5" Maximum="100" SmallChange="5" LargeChange="10"
                                    TickFrequency="10" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="ModeBSmoothText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="40"/>
                    </Grid>
                    <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="Input smoothing. Higher = calmer wheel, slightly laggier response."/>

                    <CheckBox x:Name="ModeBCompressorCheck" Margin="0,0,0,2" Content="Force compressor"
                              Checked="ModeBFeel_Changed" Unchecked="ModeBFeel_Changed"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="20,0,0,8" Text="Soft ceiling on the steering force: stacked cornering weight and road kick compress into the top of the range instead of clipping flat."/>

                    <CheckBox x:Name="ModeBLateralDemandCheck" Margin="0,0,0,2" Content="Lateral-demand force"
                              Checked="ModeBFeel_Changed" Unchecked="ModeBFeel_Changed"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="20,0,0,8" Text="Bases the steering force on cornering (lateral) grip instead of total grip, so braking in a straight line makes almost no force and the wheel cannot start swinging left and right on its own. Cornering feel is unchanged."/>

                    <CheckBox x:Name="ModeBSignCheck" Content="Reverse force direction"
                              Margin="0,0,0,2" Checked="ModeBSign_Changed" Unchecked="ModeBSign_Changed"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="20,0,0,0"
                               Text="Flip this if the wheel pulls INTO the slide instead of countering it."/>
                </StackPanel>
            </Expander>

            <!-- Restore the whole recipe to the shipped baseline. Handler confirms
                 first (discards custom tuning with no undo); leaves the per-game
                 enable and each car's learned grip calibration alone. -->
            <StackPanel Margin="0,14,0,0">
                <Button x:Name="ModeBResetButton" Content="Reset tuning to defaults" Padding="10,3"
                        HorizontalAlignment="Left" Click="ModeBReset_Click"
                        ToolTip="Put every Telemetry Based FFB slider and feel toggle back to your wheel's defaults."/>
                <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Restores your wheel's defaults. The G PRO, RS50, and G923 each get their own strength, and the G923 also gets a min force floor. Your per-game on/off choices and each car's learned grip calibration are kept."/>
            </StackPanel>
            </StackPanel><!-- ModeBSupportedPanel -->

                    </StackPanel>
                </ScrollViewer>
            </sh:SHTabItem>

            <!-- ============================ PRESETS ============================ -->
            <!-- The full preset library is hosted inline here (PresetManagerHost),
                 replacing the old Manage Presets pop-up. Populated in code-behind. -->
            <sh:SHTabItem x:Name="PresetsTab" Header="Presets">
                <Grid x:Name="PresetManagerHost" Margin="14,12,14,14"/>
            </sh:SHTabItem>

            <!-- ============================ CONTROLS ============================ -->
            <sh:SHTabItem x:Name="ControlsTab" Header="Controls">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ControlsTabHost" Margin="14,12,14,14">
                        <Border Style="{StaticResource SectionHeaderBorder}"><TextBlock Text="Controller bindings" Style="{StaticResource SectionHeaderText}"/></Border>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,12" FontSize="12"
                            Text="Bind a wheel or button-box control to change master gain on the fly, without opening this panel. Click a field below, then press the button you want to use. Master gain is clamped between 0 and 2."/>

                        <!-- How much each press of a bound button moves master gain. -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Step per press" Style="{StaticResource LabelText}"
                                       ToolTip="How far master gain moves on each press of the bound buttons below."/>
                            <Slider Grid.Column="1" x:Name="MasterGainStepSlider"
                                    Minimum="0.01" Maximum="0.5" SmallChange="0.01" LargeChange="0.05"
                                    TickFrequency="0.05" IsSnapToTickEnabled="False"
                                    ValueChanged="MasterGainStepSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="MasterGainStepText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0.05"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Master gain up" Style="{StaticResource LabelText}"/>
                            <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.MasterGainUp"
                                                 FriendlyName="TF4ALL: master gain up"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Master gain down" Style="{StaticResource LabelText}"/>
                            <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.MasterGainDown"
                                                 FriendlyName="TF4ALL: master gain down"/>
                        </Grid>

                        <TextBlock Style="{StaticResource HelpText}" Margin="0,8,0,0" FontSize="11"
                            Text="These actions also appear in SimHub's Controls and events list. Bindings are stored by SimHub, not in your TF4ALL preset."/>
                    </StackPanel>
                </ScrollViewer>
            </sh:SHTabItem>

            <!-- ============================ SETTINGS ============================ -->
            <sh:SHTabItem x:Name="SettingsTab" Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12,14,14">

            <!-- Updates: how often the plugin re-checks GitHub for a newer
                 build. A check always runs at startup and on the header's
                 "Check for updates" link regardless of this; the dropdown only
                 sets the background re-check cadence during a running session. -->
            <Expander x:Name="UpdatesExpander" IsExpanded="False" Margin="0,0,0,8"
                      Expanded="UpdatesExpander_Expanded">
                <Expander.Header>
                    <TextBlock Text="Updates" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Check for app updates:" Style="{StaticResource LabelText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="UpdateCheckIntervalCombo" Width="160"
                                  SelectionChanged="UpdateCheckIntervalCombo_SelectionChanged"
                                  ToolTip="How often the plugin checks GitHub for a newer release while it's running. A check always runs once when SimHub starts, and the header's 'Check for updates' link checks on demand, no matter what you pick here. 'On startup only' just turns off the background re-checks.">
                            <ComboBoxItem Tag="0" Content="On startup only"/>
                            <ComboBoxItem Tag="1" Content="Every hour"/>
                            <ComboBoxItem Tag="2" Content="Every 2 hours"/>
                            <ComboBoxItem Tag="6" Content="Every 6 hours"/>
                            <ComboBoxItem Tag="24" Content="Daily"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="The plugin already checks once each time SimHub starts. This adds background re-checks so a fix released mid-session still shows the update banner without a restart. When one's available, an 'Update to vX.Y.Z' button appears in the header up top."/>

                    <!-- Beta (pre-release) updates, open to everyone. Pre-releases
                         are always public on GitHub; this pulls them through the
                         in-app updater instead of downloading each one by hand. -->
                    <CheckBox x:Name="BetaUpdatesCheck" Content="Get beta (pre-release) updates in-app"
                              Margin="0,14,0,0"
                              Checked="BetaUpdates_Changed" Unchecked="BetaUpdates_Changed"
                              ToolTip="Receive pre-release 'beta' builds through the in-app updater, so you can try new effects and fixes before they reach the stable release."/>
                    <TextBlock x:Name="BetaUpdatesNote" Style="{StaticResource HelpText}" Margin="0,4,0,0"
                               FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Text=""/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="Beta builds get fixes and new effects first, but are less tested. Pre-releases are always available by hand on GitHub; this just brings them to the in-app updater. Turn it off to return to the stable release next time one ships."/>
                </StackPanel>
            </Expander>

            <!-- TF4ALL Dash: preferences for the TF4ALL Dash dashboard
                 served to phones/tablets by SimHub's web dash server. -->
            <Expander x:Name="RemoteDashExpander" IsExpanded="False" Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="TF4ALL Dash" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                    <!-- Phone-access funnel: same handler as the header phone
                         button; the QR dialog itself carries the scan / same
                         network / Add to Home Screen guidance. -->
                    <Button x:Name="DashPhoneSettingsButton" Content="Open on your phone or tablet…"
                            Style="{StaticResource PopoverPrimaryButton}"
                            HorizontalAlignment="Left" Height="26"
                            Click="DashPhoneAccess_Click"
                            ToolTip="Shows a QR code and link that open TF4ALL Dash on your phone."/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="Control effects, gains, and presets from your phone or tablet while driving. No SimHub setup needed: scan the QR code and the dash opens in your phone's browser."/>

                    <TextBlock Text="Rev light direction:" Style="{StaticResource LabelText}" Margin="0,14,0,4"/>
                    <RadioButton x:Name="RemoteRevLtrRadio" GroupName="RemoteRevDir" Content="Left to right"
                                 Checked="RemoteRevDirection_Changed"
                                 ToolTip="The rev strip fills from the left edge toward the right as revs climb."/>
                    <RadioButton x:Name="RemoteRevOutsideInRadio" GroupName="RemoteRevDir" Content="Outside in"
                                 Margin="0,4,0,0" Checked="RemoteRevDirection_Changed"
                                 ToolTip="The rev strip lights from both ends toward the center as revs climb, like center-converge shift lights."/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="Applies to the rev LED strip on the TF4ALL Dash dashboard. The strip scales to the current car's redline and flashes in step with the wheel's rev lights; direction changes apply instantly, no dashboard reload needed."/>

                    <TextBlock Text="Opening tab:" Style="{StaticResource LabelText}" Margin="0,14,0,4"/>
                    <CheckBox x:Name="RemoteDashRememberTabCheck" Content="Remember last used tab"
                              Checked="RemoteDashRememberTab_Changed" Unchecked="RemoteDashRememberTab_Changed"
                              ToolTip="The dash comes back on whichever tab was open last, surviving SimHub restarts."/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Default tab:" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                        <!-- Items are built in code (RebuildRemoteDashTabsEditor):
                             only ENABLED tabs are offered, in the user's order. -->
                        <ComboBox x:Name="RemoteDashDefaultTabCombo" Width="140" Margin="8,0,0,0"
                                  SelectionChanged="RemoteDashDefaultTab_Changed"
                                  ToolTip="The tab the dash opens on when 'Remember last used tab' is off."/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="With remember on, the dash reopens where you left it, even across SimHub restarts. Turn it off to always start on the default tab picked here (applies at the next SimHub start)."/>

                    <!-- Tab layout editor: one row per dash tab (enable checkbox
                         + up/down reorder). Rows are built in code
                         (RebuildRemoteDashTabsEditor); the dash re-reads the
                         layout live, so changes apply with no reload. -->
                    <TextBlock Text="Tabs:" Style="{StaticResource LabelText}" Margin="0,14,0,4"/>
                    <StackPanel x:Name="RemoteDashTabsPanel"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="Untick a tab to hide it on the dash; use the arrows to change the order. Changes apply instantly, no dashboard reload needed. At least one tab always stays on."/>

                    <!-- Drive tab: which of the four boxes around the gear shows
                         what, plus the one-row / two-row choice. Combo items are
                         filled in code from the plugin's content list so a new
                         box type needs no XAML change. -->
                    <TextBlock Text="Drive tab boxes:" Style="{StaticResource LabelText}" Margin="0,16,0,4"/>
                    <RadioButton x:Name="RemoteDashDriveTwoRowsRadio" GroupName="RemoteDashDriveRows"
                                 Content="Two rows (tablet)" Checked="RemoteDashDriveRows_Changed"
                                 ToolTip="All four boxes, two above and two below."/>
                    <RadioButton x:Name="RemoteDashDriveOneRowRadio" GroupName="RemoteDashDriveRows"
                                 Content="Bottom row only (phone)" Margin="0,4,0,0" Checked="RemoteDashDriveRows_Changed"
                                 ToolTip="Just the bottom two boxes, with a bigger gear readout above them."/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="RemoteDashDriveSlot0Label" Text="Top left:" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                        <ComboBox   Grid.Row="0" Grid.Column="1" x:Name="RemoteDashDriveSlot0Combo" Margin="0,2" SelectionChanged="RemoteDashDriveSlot_Changed"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="RemoteDashDriveSlot1Label" Text="Top right:" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                        <ComboBox   Grid.Row="1" Grid.Column="1" x:Name="RemoteDashDriveSlot1Combo" Margin="0,2" SelectionChanged="RemoteDashDriveSlot_Changed"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Bottom left:" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                        <ComboBox   Grid.Row="2" Grid.Column="1" x:Name="RemoteDashDriveSlot2Combo" Margin="0,2" SelectionChanged="RemoteDashDriveSlot_Changed"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Bottom right:" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                        <ComboBox   Grid.Row="3" Grid.Column="1" x:Name="RemoteDashDriveSlot3Combo" Margin="0,2" SelectionChanged="RemoteDashDriveSlot_Changed"/>
                    </Grid>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="The Drive tab shows the gear and speed in the middle with these boxes around it. Lap times, tyre and fuel readouts come from the game, so what they show depends on what that game reports."/>

                    <CheckBox x:Name="RemoteDashPedalsCheck" Content="Show pedals and steering around the gear" Margin="0,14,0,0"
                              Checked="RemoteDashPedals_Changed" Unchecked="RemoteDashPedals_Changed"
                              ToolTip="Thin throttle and brake bars either side of the gear on the Drive tab, with steering underneath."/>
                    <CheckBox x:Name="RemoteDashRevCenteredCheck" Content="Narrow the rev strip on the Drive tab" Margin="0,8,0,0"
                              Checked="RemoteDashRevCentered_Changed" Unchecked="RemoteDashRevCentered_Changed"
                              ToolTip="On the Drive tab only: the strip spans the space above the gear between the two box columns instead of the full width. Other tabs are always full width."/>

                    <CheckBox x:Name="RemoteDashFlagsCheck" Content="Show race flags on the dash" Margin="0,14,0,0"
                              Checked="RemoteDashFlags_Changed" Unchecked="RemoteDashFlags_Changed"
                              ToolTip="A coloured band across the top of the dash whenever a flag is out."/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="Shows yellow, blue, black, white and chequered flags across whichever tab is open. Only games that report flags can drive it, which the Forza titles do not, so it simply never appears there."/>

                    <CheckBox x:Name="RemoteDashSpotterCheck" Content="Show the spotter when a car is alongside" Margin="0,8,0,0"
                              Checked="RemoteDashSpotter_Changed" Unchecked="RemoteDashSpotter_Changed"
                              ToolTip="A bar down the edge of whichever tab is open while a car is beside you on that side."/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="SimHub works this out from the other cars in the session, so like the flags it only lights up in games that report car positions and simply never appears in the ones that do not."/>

                    <TextBlock Text="Idle mode" FontWeight="SemiBold" Margin="0,18,0,0"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="With no game running the dash shows an ambient card with your name and number instead of an empty dashboard. It clears the moment a game starts, and there is an Exit button on the card itself."/>
                    <CheckBox x:Name="RemoteDashIdleCheck" Content="Show the idle card when no game is running" Margin="0,8,0,0"
                                 LostFocus="RemoteDashIdleDelay_Commit" KeyDown="RemoteDashIdleDelay_KeyDown"
                                 ToolTip="Only applies while a game IS running: how long the car must sit still before the card takes over from the dashboard. Set it long if you would rather it never interrupted a session. With no game running the card shows straight away regardless."/>
                        <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Text="Background" VerticalAlignment="Center" Margin="24,0,0,0"/>
                              Checked="RemoteDashIdle_Changed" Unchecked="RemoteDashIdle_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Parked for" VerticalAlignment="Center" Width="94"/>
                        <TextBox x:Name="RemoteDashIdleDelayBox" Width="60" TextAlignment="Center"
                        <ComboBox x:Name="RemoteDashIdleStyleCombo" Width="120" Margin="8,0,0,0"
                                  SelectionChanged="RemoteDashIdleStyle_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Driver name" VerticalAlignment="Center" Width="94"/>
                        <TextBox x:Name="RemoteDashIdleNameBox" Width="180"
                                 LostFocus="RemoteDashIdleName_Commit" KeyDown="RemoteDashIdleName_KeyDown"/>
                        <TextBlock Text="Number" VerticalAlignment="Center" Margin="24,0,0,0"/>
                        <TextBox x:Name="RemoteDashIdleNumberBox" Width="70" Margin="8,0,0,0" TextAlignment="Center"
                                 LostFocus="RemoteDashIdleNumber_Commit" KeyDown="RemoteDashIdleNumber_KeyDown"/>
                        <TextBlock Text="Colour" VerticalAlignment="Center" Margin="24,0,0,0"/>
                        <ComboBox x:Name="RemoteDashIdleColorCombo" Width="110" Margin="8,0,0,0"
                                  SelectionChanged="RemoteDashIdleColor_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

                        <CheckBox x:Name="RemoteDashIdleNameAboveCheck" Content="Name above" VerticalAlignment="Center" Margin="24,0,0,0"
                                  Checked="RemoteDashIdleNameAbove_Changed" Unchecked="RemoteDashIdleNameAbove_Changed"
                                  ToolTip="Puts the driver name over the number instead of under it."/>
            <!-- UDP telemetry: Forza UDP setup as its own collapsible, so it
                 reads as a primary setting rather than trailing Diagnostics.
                 Forza is the only UDP-telemetry game, so the body is the Forza
                 config directly. -->
            <Expander x:Name="UdpTelemetryExpander" IsExpanded="False" Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="UDP telemetry" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">

            <!-- Forza Data Out (UDP). Forza titles emit telemetry over UDP
                 instead of shared memory; the user enables UDP RACE TELEMETRY
                 in the in-game Settings → HUD and Gameplay menu and points it
                 at the IP/port set here. Two real-world gotchas:
                  - MS Store / UWP build: Windows network isolation blocks
                    UDP loopback. User has to run CheckNetIsolation.exe to
                    add a loopback exemption (or send to a LAN IP).
                  - Steam build: FH5 sends to the gateway IP (a long-known
                    bug Playground hasn't fixed). User has to send to their
                    LAN IP, not 127.0.0.1.
                 Forza is the only UDP-telemetry game, so this section is the
                 entire body of the UDP telemetry expander. -->
            <StackPanel x:Name="ForzaSection">
            <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" FontSize="12"
                Text="In Forza Horizon 4/5/6, open Settings → HUD and Gameplay → UDP RACE TELEMETRY. Turn DATA OUT ON, set DATA OUT IP ADDRESS to 127.0.0.1, and set DATA OUT IP PORT to match this plugin's Port field below (5300 by default). That is the whole setup."/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Port:" Style="{StaticResource LabelText}"/>
                <TextBox   Grid.Column="1" x:Name="ForzaPortBox" LostFocus="ForzaPort_LostFocus" KeyDown="ForzaPort_KeyDown" VerticalAlignment="Center"
                           ToolTip="Match this in Forza's DATA OUT IP PORT. Default 5300; pick anything if it collides with another listener (SimHub's typical 4123, Sim Racing Studio's 4123, etc.)."/>
                <TextBlock Grid.Column="2" Style="{StaticResource HelpText}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="Takes effect immediately."/>
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Bind address:" Style="{StaticResource LabelText}"/>
                <TextBox   Grid.Column="1" x:Name="ForzaBindBox" LostFocus="ForzaBind_LostFocus" KeyDown="ForzaBind_KeyDown" VerticalAlignment="Center"
                           ToolTip="Local IP to listen on. 0.0.0.0 = all interfaces (recommended). Use a specific LAN IP only if you want to filter."/>
                <TextBlock Grid.Column="2" Style="{StaticResource HelpText}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="0.0.0.0 = listen on every network adapter."/>
            </Grid>
            <Grid Margin="0,4,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Status:" Style="{StaticResource LabelText}"/>
                <TextBlock Grid.Column="1" x:Name="ForzaStatusText" Text="(idle)" FontSize="11" Opacity="0.85"/>
            </Grid>
            <!-- Auto-discovered alternate port banner. Shown when the
                 plugin scanned candidate ports and found Forza packets on
                 one we're not bound to. One-click switch + dismiss. -->
            <Border x:Name="ForzaDiscoveryBanner" Background="#3300A8FF" BorderBrush="#00A8FF" BorderThickness="1"
                    CornerRadius="3" Padding="8" Margin="0,4,0,8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ForzaDiscoveryText" FontSize="11" TextWrapping="Wrap"
                               VerticalAlignment="Center" MaxWidth="380"
                               Text="Forza packets detected on a different port."/>
                    <Button x:Name="ForzaDiscoveryAdoptButton" Content="Switch" Width="80" Height="22" FontSize="11"
                            Style="{StaticResource InfoBannerButton}"
                            Margin="10,0,4,0" Click="ForzaDiscoveryAdopt_Click"/>
                    <Button x:Name="ForzaDiscoveryDismissButton" Content="Dismiss" Width="80" Height="22" FontSize="11"
                            Style="{StaticResource InfoBannerButton}"
                            Click="ForzaDiscoveryDismiss_Click"/>
                </StackPanel>
            </Border>

            <!-- Coexistence forwarder. Forza only sends to one destination, so
                 if the user wants both Trueforce haptics AND SimHub dashboards,
                 they point Forza at us and we relay raw packet bytes verbatim
                 to SimHub. Default off. Explicit opt-in keeps un-forwarded
                 packets out of the network when the user doesn't run SimHub. -->
            <Border BorderThickness="0,1,0,0" BorderBrush="#22FFFFFF" Margin="0,4,0,8" Padding="0,8,0,0">
                <StackPanel>
                    <CheckBox x:Name="ForzaForwardEnabledCheck" Content="Also forward to SimHub (dashboards, ShakeIt / Buttkicker, etc.)" Click="ForzaForwardEnabled_Changed" Margin="0,0,0,4"
                              FontWeight="SemiBold"
                              ToolTip="Enable when you also use SimHub for Forza (dashboards, ShakeIt bass shakers / Buttkicker, anything SimHub drives). Forza can only send telemetry to one place, so this plugin receives it and re-broadcasts every packet verbatim to SimHub."/>
                    <!-- Intro on its own line; the numbered setup steps render as
                         separate rows below so the option isn't a wall of text. -->
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,6" FontSize="11"
                               Text="Also passes Forza's telemetry to SimHub so its dashboards, bass shakers, and Buttkicker keep working. Forza already points at this plugin; this just relays a copy on to SimHub. Setup:"/>
                    <StackPanel Margin="10,0,0,6">
                        <TextBlock Style="{StaticResource HelpText}" FontSize="11" Margin="0,0,0,3"
                                   Text="1. In SimHub, click the Home button at the top of the left sidebar. It should show Forza Horizon as the active game (if not, click Change game). Click Game config and note the UDP port it shows (often 8000). Just read it, do not change anything here."/>
                        <TextBlock Style="{StaticResource HelpText}" FontSize="11" Margin="0,0,0,3"
                                   Text="2. Enable this box, set the forward host to 127.0.0.1, and set the forward port to that SimHub port."/>
                        <TextBlock Style="{StaticResource HelpText}" FontSize="11"
                                   Text="3. Drive for a moment and check the &quot;Forwarded:&quot; line below. Once it shows packets, SimHub's dashboards and bass shakers are back."/>
                    </StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Forward to host:" Style="{StaticResource LabelText}"/>
                        <TextBox   Grid.Column="1" x:Name="ForzaForwardHostBox" LostFocus="ForzaForwardHost_LostFocus" KeyDown="ForzaForwardHost_KeyDown" VerticalAlignment="Center"
                                   ToolTip="127.0.0.1 if SimHub runs on the same PC. A LAN IP (or hostname) for a separate SimHub host."/>
                        <TextBlock Grid.Column="2" Text="port:" Style="{StaticResource LabelText}" Margin="8,0,0,0"/>
                        <TextBox   Grid.Column="3" x:Name="ForzaForwardPortBox" LostFocus="ForzaForwardPort_LostFocus" KeyDown="ForzaForwardPort_KeyDown" VerticalAlignment="Center" Width="120" HorizontalAlignment="Left"
                                   ToolTip="The port SimHub is listening on for Forza Data Out. Match this to the UDP port shown in SimHub's Forza Game config."/>
                    </Grid>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Forwarded:" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Column="1" x:Name="ForzaForwardStatusText" Text="(disabled)" FontSize="11" Opacity="0.85"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Expander x:Name="ForzaTroubleshootExpander" IsExpanded="False" Margin="0,8,0,16">
                <Expander.Header>
                    <TextBlock Text="Not receiving packets?" FontSize="12"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,4" FontSize="11"
                               Text="Most setups receive fine on 127.0.0.1. If you're getting zero packets, work through these:"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,4" FontSize="11"
                               Text="• Confirm Forza's DATA OUT is ON, and its IP and PORT match this plugin (IP 127.0.0.1, PORT = the Port field above)."/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,4" FontSize="11"
                               Text="• Port collision with SimHub or another tool? Pick a different port here, then update Forza's DATA OUT IP PORT to match."/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,4" FontSize="11"
                               Text="• Still nothing on 127.0.0.1: set Forza's DATA OUT IP ADDRESS to your PC's LAN IP (e.g. 192.168.x.x) instead, and leave the bind address here at 0.0.0.0. This gets around localhost quirks on some installs."/>
                    <TextBlock Style="{StaticResource HelpText}" FontSize="11"
                               Text="• Firewall: Windows Defender may prompt the first time the listener opens. Allow it on private/domain networks."/>
                </StackPanel>
            </Expander>
            </StackPanel> <!-- /ForzaSection -->
                </StackPanel>
            </Expander>

            <!-- No "Advanced" heading: these are ordinary settings, shown as
                 flat peer collapsibles (FFB pass-through, Performance, Sidechain
                 ducking, Diagnostics) below the UDP telemetry section; Backup &
                 sync, Issue reporting and the access-code box follow. The host
                 StackPanel is kept (named) so InitializeComponent wires up every
                 field inside and OpenAdvancedSettings_Click / RefreshFromPlugin
                 can reach them. -->
            <StackPanel x:Name="AdvancedSettingsHost" Margin="0,0,0,0">

                <!-- Advanced force-feedback options: experimental FFB detection
                     and the pause-release wheel handoff. -->
                <Expander x:Name="FfbPassthroughExpander" IsExpanded="False" Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Text="Force feedback (advanced)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <!-- Experimental FFB detection. Off by default so the
                             proven capture path is unchanged for everyone; opt
                             in if a game that should have force feedback gives
                             none. Widens how the tap recognizes the wheel's FFB
                             on the bus (HID++ report 0x12 + faster index
                             resolve; helps e.g. the RS50 in Forza, issue #8).
                             Synced with the FFBX access code. -->
                        <CheckBox x:Name="ExperimentalFfbCheck" Content="Enable experimental FFB detection"
                                  Margin="0,4,0,2" Checked="ExperimentalFfbDetection_Changed" Unchecked="ExperimentalFfbDetection_Changed"
                                  ToolTip="Off by default. Turn this on if a game that should have force feedback is giving you none. It widens how the plugin finds your wheel's force feedback on the USB bus (helps some wheels, such as the RS50 in Forza). After enabling, load the game and drive for a few seconds. Turn it back off if it causes any trouble."/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,12"
                                   Text="Try this if you are not getting force feedback in a game that should have it. Load the game and drive for a few seconds after turning it on. Leave it off if your force feedback already works."/>

                        <!-- Release the wheel while paused (issue #13 test, NOLOCK
                             access code). When on, the plugin fully leaves Trueforce
                             mode while the game is paused so the wheel reverts to the
                             game's own FFB / auto-center instead of holding a force.
                             Global, not preset-saved. Default off. -->
                        <CheckBox x:Name="StopStreamOnPauseCheck" Content="Hand the wheel back to the game while paused"
                                  Margin="0,4,0,2" Checked="StopStreamOnPause_Changed" Unchecked="StopStreamOnPause_Changed"
                                  ToolTip="Off by default. When the game pauses (menu, fast travel, race start) the plugin steps fully out of the way, so the wheel uses the game's own force feedback and auto-center instead of holding the last force. Turn this on if your wheel jerks or runs to full lock when you pause (seen on the G923 in Forza Horizon 6)."/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,4"
                                   Text="Try this if the wheel pulls to one side or locks up when you pause the game."/>

                        <!-- Driver testing mode. Hidden by default (Collapsed); revealed
                             only after the DRIVER access code is entered, and kept revealed
                             across restarts via Settings.DriverTestingUnlocked (mirrors the
                             MANUALPIN unlock pattern). Routes FFB through the kernel filter
                             driver; needs the TFFA filter driver installed. -->
                        <CheckBox x:Name="DriverInterceptCheck" Visibility="Collapsed"
                                  Content="Driver testing mode: route FFB through the kernel filter driver (claims sole wheel ownership). Experimental."
                                  Margin="0,4,0,2" Checked="DriverIntercept_Changed" Unchecked="DriverIntercept_Changed"
                                  ToolTip="Experimental. Claims sole ownership of the wheel through the TFFA kernel filter driver and routes the game's force feedback through the Trueforce stream. Needs the TFFA filter driver installed. Takes effect on the next plugin start (restart SimHub or re-detect)."/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,4"
                                   x:Name="DriverInterceptHelp" Visibility="Collapsed"
                                   Text="Restart SimHub or re-detect the wheel after changing this."/>
                    </StackPanel>
                </Expander>

                <!-- Performance / latency tuning. Per-machine, NOT preset-saved
                     (a friend's CPU/scheduler is different from yours).
                     Collapsed Expander since most users never need to touch it. -->
                <Expander x:Name="PerformanceExpander" IsExpanded="False" Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Text="Performance" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" FontSize="12"
                            Text="Smaller ring buffers = less latency between game and wheel, but require Windows to wake our threads on time. Auto starts at the smallest sizes and ratchets up if dropouts occur (one-way; survived size persists across sessions). Manual locks specific sizes (useful for streamers who want guaranteed-stable behavior, or to force-test the lowest values)."/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mode:" VerticalAlignment="Center" Opacity="0.7"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="PerfAutoRadio"   Content="Auto" GroupName="PerfMode"
                                             Margin="0,0,16,0" VerticalAlignment="Center"
                                             ToolTip="Start at smallest ring sizes; ratchet up on persistent dropouts. Survived size is remembered across sessions."
                                             Checked="PerfMode_Changed"/>
                                <RadioButton x:Name="PerfManualRadio" Content="Manual" GroupName="PerfMode"
                                             Margin="0,0,16,0" VerticalAlignment="Center"
                                             ToolTip="Lock the slider values. No automatic changes. Use for streaming or force-testing."
                                             Checked="PerfMode_Changed"/>
                                <Button x:Name="PerfResetButton" Content="Reset to lowest" Padding="10,2" VerticalAlignment="Center"
                                        ToolTip="Drop both rings back to the smallest configured value. In Auto mode the ratchet will re-discover whether your machine can hold them."
                                        Click="PerfReset_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Output ring:" VerticalAlignment="Center" Opacity="0.7"
                                       ToolTip="Sample buffer between the audio mixer and the USB stream. Smaller = lower wheel latency, but Windows must wake the stream thread on time."/>
                            <Slider     Grid.Column="1" x:Name="PerfTfRingSlider"
                                        Minimum="8" Maximum="64" SmallChange="8" LargeChange="8"
                                        TickFrequency="8" IsSnapToTickEnabled="True"
                                        ValueChanged="PerfTfRingSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="PerfTfRingText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="8 (2ms)"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Audio ring:" VerticalAlignment="Center" Opacity="0.7"
                                       ToolTip="Sample buffer between WASAPI loopback and the audio mixer. WASAPI typically delivers ~12 decimated samples per ~3ms callback; 16 fits that with headroom. Setting 8 only works if your audio driver supports a ~2ms WASAPI period (uncommon). If you set 8 and hear continuous clicks, the auto-ratchet (Auto mode) will bump you back up."/>
                            <Slider     Grid.Column="1" x:Name="PerfAudioRingSlider"
                                        Minimum="16" Maximum="128" SmallChange="16" LargeChange="16"
                                        TickFrequency="16" IsSnapToTickEnabled="True"
                                        ValueChanged="PerfAudioRingSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="PerfAudioRingText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="16 (4ms)"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Live counters:" VerticalAlignment="Top" Opacity="0.7" Margin="0,2,0,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="PerfCountersText" FontSize="11" Opacity="0.8"
                                           Text="Output ring: 0 underruns/min · Audio ring: 0 glitches/min"/>
                                <TextBlock Style="{StaticResource HelpText}" FontSize="11" Margin="0,2,0,0"
                                           Text="Counters tally events in a rolling 60-second window. If they're going up, your machine is glitching at the current ring size; Auto mode will bump it up."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Diagnostics. Wheel / stream / FFB / telemetry status.
                     Useful for troubleshooting; rarely needed otherwise. -->
                <Expander x:Name="DiagnosticsExpander" IsExpanded="False" Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Text="Diagnostics &amp; support" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Wheel:" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="WheelText" Text="(checking...)"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Stream:" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StreamText" Text="(checking...)" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="FFB pass-through:" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="FfbTapText" Text="(checking...)" VerticalAlignment="Center"/>
                            <!-- Visible only when USBPcap can't be located. Lets users
                                 point at a non-standard install, or reinstall the
                                 driver from the bundled setup without re-running our
                                 installer. Toggled from code-behind on the tick. -->
                            <Button x:Name="UsbPcapBrowseButton" Content="Browse…"
                                    Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                                    Visibility="Collapsed"
                                    Click="UsbPcapBrowse_Click"
                                    ToolTip="Point at USBPcapCMD.exe if USBPcap is installed somewhere off the default Program Files path."/>
                            <Button x:Name="UsbPcapReinstallButton" Content="Reinstall"
                                    Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                                    Visibility="Collapsed"
                                    Click="UsbPcapReinstall_Click"
                                    ToolTip="Run the bundled USBPcap installer (requires admin). Use this if USBPcap was uninstalled or the install is broken."/>
                            <!-- Hidden by default. Auto-discovery + identity-based
                                 self-heal cover the realistic failure modes for
                                 almost every user; a forgotten manual pin (the
                                 wheel later moved address) was a common source
                                 of false-positive "FFB stopped working" reports.
                                 Power users with a genuine need (multi-wheel
                                 disambiguation, or a USBPcap interface mismatch)
                                 can reveal this with the MANUALPIN access code.
                                 Selection persists across restarts. The
                                 contextual "Pick device manually..." button in
                                 the FfbTapPicker banner stays available, since
                                 it only appears when the tap genuinely can't
                                 find the wheel. -->
                            <Button x:Name="UsbPcapPickDeviceButton" Content="Pick device manually…"
                                    Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                                    Visibility="Collapsed"
                                    Click="UsbPcapPickDevice_Click"
                                    ToolTip="Scan every USBPcap interface and pick your wheel manually. Use this only if auto-discovery genuinely can't find your wheel: a forgotten manual pin can silently break FFB after a replug. Type MANUALPIN in the access code box to reveal this control."/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Telemetry:" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TelemetrySourceText" Text="(checking...)" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Active sources:" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="VoicesText" Text="0" Margin="0,4,0,0"/>
                        <!-- Raw USB packet logging. Off by default. When on,
                             every OUT transfer (host → wheel) on every
                             endpoint is captured to usb-trace.pcap alongside
                             SimHub's logs, in real pcap format so Wireshark
                             with USBPcap opens it directly. Export Logs
                             bundles the trace when present. Caps at 50 MB;
                             toggle off + on to reset. Wider than ep0 only so
                             FFB protocols on non-control endpoints are
                             visible too (some Logitech wheels use ep1 OUT). -->
                        <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                  x:Name="LogUsbBytesCheck"
                                  Margin="0,12,0,0"
                                  Content="Log raw USB FFB packets to usb-trace.pcap (for support)"
                                  Checked="LogUsbBytes_Changed" Unchecked="LogUsbBytes_Changed"
                                  ToolTip="Off by default. When on, captures every USB OUT transfer to your wheel (any endpoint, any transfer type) as a pcap file alongside SimHub's logs. Open in Wireshark with USBPcap. Use only when support asks for it: the file grows several KB/sec during active FFB. Capped at 50 MB; toggle off and on to reset."/>

                        <!-- Self-test: one click that aggregates every health
                             signal into a pass/fail checklist and fires a
                             short buzz so the user can confirm the wheel
                             physically responds. Non-destructive, reads live
                             state; doesn't reopen a healthy device. -->
                        <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                x:Name="SelfTestButton"
                                Content="Run self-test"
                                HorizontalAlignment="Left" Margin="0,14,0,0"
                                Padding="10,3" Click="SelfTest_Click"
                                ToolTip="Checks USBPcap, the wheel, stream, FFB pass-through and telemetry (and whether G HUB is open, since it can hold the wheel), then sends a short test buzz so you can confirm the wheel responds."/>
                        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                                   x:Name="SelfTestResultText"
                                   Visibility="Collapsed"
                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                   FontFamily="Consolas" FontSize="12"/>
                        </Grid>
                        <!-- Issue reporting (bugs, feature requests, weird behavior).
                             Folded in here so the get-help tools live together. -->
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,14,0,8" FontSize="12"
                            Text="Found a bug, weird behavior, or have a feature request? Open an issue on GitHub."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button x:Name="ReportIssueButton" Content="Report an issue…" Width="160" Height="26"
                                    Click="ReportIssue_Click" Margin="0,0,8,0"
                                    ToolTip="Opens a new GitHub issue. Pre-fills plugin version and active game so you don't have to type it."/>
                            <Button x:Name="ExportLogsButton" Content="Export logs…" Width="120" Height="26"
                                    Click="ExportLogs_Click" Margin="0,0,8,0"
                                    ToolTip="Zips your SimHub logs + TF4ALL settings to your Desktop. Attach the zip to your GitHub issue so I can debug what's happening on your machine. The zip includes your settings file (username, game list, tuning); skim it before posting it publicly."/>
                            <Button x:Name="OpenRepoButton" Content="Open project on GitHub" Width="180" Height="26"
                                    Click="OpenRepo_Click"
                                    ToolTip="github.com/Mhytee/Trueforce-For-All"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ResetNoticesButton" Content="Show one-time messages again" Width="220" Height="26"
                                    Click="ResetNotices_Click"
                                    ToolTip="Reset the pop-ups that only show once or were dismissed with 'Don't show again' (welcome, what's new, the iRacing Trueforce notice, share prompt) so they can appear again."/>
                            <TextBlock x:Name="ResetNoticesStatus" Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center" Opacity="0.85"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

            </StackPanel>




            <!-- Widgets: optional SimHub home-screen tiles. A collapsible since it's an extra
                 surface most users set once; currently just the gain tile. -->
            <Expander x:Name="WidgetsExpander" IsExpanded="False" Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="Widgets" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                    <CheckBox x:Name="ShowFeedbackBoxCheck" Content="Show TF4ALL gain tile on SimHub's home screen"
                              Margin="0,0,0,2" Checked="ShowFeedbackBox_Changed" Unchecked="ShowFeedbackBox_Changed"
                              ToolTip="Adds a TF4ALL master + audio gain box to SimHub's home 'Feedback' section, next to Motors and Wind, for quick access without opening this panel."/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,4" FontSize="12"
                               Text="Quick master + audio gain control from SimHub's home screen. Turn off to remove the tile."/>
                </StackPanel>
            </Expander>

            <!-- Account & community moved to its own Account tab (see the AccountTab
                 SHTabItem below). The relocated Expander keeps every x:Name, so the
                 code-behind handlers (AccountExpander_Expanded, RefreshAccountRow, the
                 dev-mode visibility pass, etc.) still resolve unchanged. -->


            <!-- Diagnostics moved into the Advanced Settings modal. See
                 AdvancedSettingsHost near the bottom. -->

            <!-- The standalone "Presets" section was removed: preset handling is
                 now unified in the context card up top (pick + ★ Save all +
                 conditional Set-as-default + Save as new inline with the game
                 preset dropdown; Manage presets… at the bottom of that card). -->

            <!-- Community: online community features (community car facts, preset sharing
                 + auto-update, message of the day). Cloud backup/sync now lives in the
                 Backup & sync expander below, next to local file backup. Collapsed by default. -->
            <Expander x:Name="NetworkExpander" IsExpanded="False" Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="Community" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                    <!-- Networking master toggle (online community features: car-fact
                         fetch/submit + preset sharing). Does NOT gate account sign-in
                         or cloud backup, which have their own controls. -->
                    <CheckBox x:Name="CommunityEnabledCheck" Content="Enable community features (online)"
                              Margin="0,0,0,2" Checked="CommunityEnabled_Changed" Unchecked="CommunityEnabled_Changed"
                              ToolTip="Lets the plugin go online for community features: downloading and submitting community car facts, and sharing presets. Turn off to stay offline for community features (already-downloaded community car facts still apply if 'Use community car facts' is on). Does not affect account sign-in or cloud backup."/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,4" FontSize="12" TextWrapping="Wrap">
                        <Run Text="Sign-in is only needed for presets. Anything you share there (presets, packs, custom engines) shows your username; car facts are anonymous and need no account. "/><Hyperlink Click="PrivacyPolicy_Click" ToolTip="Opens PRIVACY.md on GitHub.">Privacy policy</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="22,0,0,12" FontSize="12" TextWrapping="Wrap" Foreground="#E5C04A"
                               Text="Pre-release: the community backend is in testing. Shared presets, packs, and custom engines are test data and may be reset before the public launch. Your account, achievements, and car data you contribute are kept."/>
                    <!-- ===== Community car facts: apply (read) + auto-submit (write) ===== -->
                    <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,4,0,8">
                        <TextBlock Text="Community car facts" Style="{StaticResource SectionHeaderText}"/>
                    </Border>
                    <!-- Apply community car facts (cache-first; works offline). Separate
                         from the networking master so cached data keeps applying with
                         networking off. -->
                    <CheckBox x:Name="UseCommunityCarFactsCheck" Content="Use community car facts (names, engine types, redlines)"
                              Margin="0,0,0,2" Checked="UseCommunityCarFacts_Changed" Unchecked="UseCommunityCarFacts_Changed"
                              ToolTip="Apply community-sourced car facts to your cars: human-readable names, engine types, and redlines. Uses a local cache, so it keeps working offline and only refreshes from the server every few days (or when you hit the refresh icon). Turn off to ignore community car facts entirely and use only your own values."/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,12" FontSize="12" TextWrapping="Wrap"
                               Text="Cached locally and refreshed at most weekly per car, so it works offline and keeps server traffic low."/>
                    <!-- Car-data sharing. ON by default (opt-out posture; the welcome
                         modal is the disclosure). This checkbox is the opt-out; gated by
                         the community master toggle; no sign-in needed (signed-out
                         submissions use the anon fallback id). Toggling here also
                         answers the residual consent ask (CarFactsConsentGate). -->
                    <CheckBox x:Name="AutoSubmitCarFactsCheck"
                              Content="Share my car data with the community"
                              Margin="0,0,0,2"
                              Checked="AutoSubmitCarFacts_Changed"
                              Unchecked="AutoSubmitCarFacts_Changed"
                              ToolTip="When on, your redline and engine-type corrections are submitted automatically, and naming a car offers a share prompt. Needs community features on; no account required. Turn off to stop sharing car data."/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,12" FontSize="12" TextWrapping="Wrap"
                               Text="Submissions are anonymous and work without an account; signed-in contributions count toward achievements."/>

                    <!-- ===== Community presets: share buttons + auto-update of downloads ===== -->
                    <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,4,0,8">
                        <TextBlock Text="Community presets" Style="{StaticResource SectionHeaderText}"/>
                    </Border>
                    <!-- Effects-tab share buttons: lets a user who uses community data
                         but never shares presets declutter the active card. The Preset
                         Manager stays the place to share regardless. -->
                    <CheckBox x:Name="EffectsTabShareButtonsCheck" Content="Show preset Share buttons on the active car/game card"
                              Margin="0,0,0,2" Checked="EffectsTabShareButtons_Changed" Unchecked="EffectsTabShareButtons_Changed"
                              ToolTip="Adds a Share button to the active game and car on the header card so you can share the preset you're driving. Turn off to keep the Effects tab clean; the Preset Manager is still the place to share. Doesn't affect community car facts."/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,12" FontSize="12" TextWrapping="Wrap"
                               Text="Off hides the card's Share buttons. You can still share anytime from the Preset Manager."/>
                    <!-- Auto-update downloaded community presets. Off by default; only fires on
                         presets you haven't locally edited since download. -->
                    <CheckBox x:Name="AutoUpdateDownloadedPresetsCheck"
                              Content="Auto-update downloaded community presets"
                              Margin="0,0,0,2"
                              Checked="AutoUpdateDownloadedPresets_Changed"
                              Unchecked="AutoUpdateDownloadedPresets_Changed"
                              ToolTip="When a curator publishes a new version of a preset you downloaded, apply it silently. Only runs when you haven't edited your local copy since download."/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,12" FontSize="12" TextWrapping="Wrap"
                               Text="Only runs on downloads you haven't edited locally. If you've changed your local copy, those changes are kept; the curator's update is offered through the updates-available chip instead."/>

                    <!-- Message of the day: how much of the top strip the user wants.
                         Gated by the community master above (the strip is hidden when
                         community features are off). None is honored literally. -->
                    <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,4,0,8">
                        <TextBlock Text="Message of the day" Style="{StaticResource SectionHeaderText}"/>
                    </Border>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,6" FontSize="12" TextWrapping="Wrap"
                               Text="A short message at the top of this window: announcements, tips, and the occasional bit of news."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton x:Name="MotdLevelAllRadio" GroupName="MotdLevel"
                                     Content="Show all" VerticalAlignment="Center"
                                     Checked="MotdLevel_Changed"/>
                        <RadioButton x:Name="MotdLevelImportantRadio" GroupName="MotdLevel"
                                     Content="Important only" VerticalAlignment="Center"
                                     Margin="18,0,0,0" Checked="MotdLevel_Changed"/>
                        <RadioButton x:Name="MotdLevelNoneRadio" GroupName="MotdLevel"
                                     Content="None" VerticalAlignment="Center"
                                     Margin="18,0,0,0" Checked="MotdLevel_Changed"/>
                    </StackPanel>
                    <TextBlock x:Name="MotdNoneWarning" Visibility="Collapsed"
                               Foreground="#FFC107" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,10"
                               Text="With messages off, you may miss important announcements like outage notices or critical fixes."/>
                </StackPanel>
            </Expander>

            <!-- Backup & sync. Holds BOTH cloud backup/sync (a supporter perk, moved here
                 from the old Community section so all backup lives together) and local file
                 backup. The Expanded handler refreshes the cloud-upload supporter gating. -->
            <!-- Top margin: the UDP telemetry section above is collapsed for
                 most users, so this is the first section after the effects list and
                 would otherwise sit flush against the last effect's 4px margin
                 (this margin formerly lived on the removed Presets header). -->
            <Expander x:Name="BackupExpander" IsExpanded="False" Margin="0,0,0,8" Expanded="BackupExpander_Expanded">
                <Expander.Header>
                    <TextBlock Text="Backup &amp; sync" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                    <!-- Cloud backup / sync (moved here from the old Network/Community section).
                         Backs up the whole setup to the signed-in account; restoring reproduces
                         it on another PC. Upload (Back up now / Auto-sync) requires an active
                         supporter (server-enforced); download (Restore) is free. -->
                    <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,2,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cloud backup" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"/>
                            <!-- Small static "Supporter" badge marking this as a member perk, so it's
                                 clear (right where the feature lives) that Patreon unlocks it. -->
                            <Border CornerRadius="7" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Background="#33E5C04A" BorderBrush="#FFE5C04A" BorderThickness="1"
                                    ToolTip="A supporter perk. Support on Patreon (Account tab) to enable cloud backup.">
                                <TextBlock Text="Supporter" FontSize="10" FontWeight="SemiBold" Foreground="#FFE5C04A"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- General cloud-backup description (section intro, above the controls). -->
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" FontSize="12"
                               Text="Backs up your settings, presets, defaults, and car facts. Restore the same setup on another PC by signing in there."/>
                    <CheckBox x:Name="AutoSyncBackupCheck" Content="Keep my devices in sync"
                              Margin="0,0,0,2" Checked="AutoSyncBackup_Changed" Unchecked="AutoSyncBackup_Changed"
                              ToolTip="Automatically uploads your setup to the cloud as you change it, and pulls those changes down on your other signed-in devices. Sign-in required."/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,8" FontSize="12"
                               Text="Real-time sync across your devices: changes you make on one device flow to the others automatically. Off = back up only when you click 'Back up now'."/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                        <TextBlock Text="FFB tuning from a different wheel model:" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox x:Name="CrossWheelFfbModeCombo" Width="140" Margin="8,0,0,0"
                                  SelectionChanged="CrossWheelFfbMode_Changed"
                                  ToolTip="Force feedback tuning (Telemetry Based FFB) is dialed in for a specific wheel. Your FFB always backs up; this controls what happens when a restore or sync brings tuning made for a different wheel model (G PRO, RS50, G923).">
                            <ComboBoxItem Tag="Ask" Content="Ask me"/>
                            <ComboBoxItem Tag="Always" Content="Always apply"/>
                            <ComboBoxItem Tag="Never" Content="Never apply"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" FontSize="12"
                               Text="Your FFB tuning always backs up. This only controls whether it is applied on a device with a different wheel model. 'Ask me' prompts once per change; you can tick 'remember my choice' on that prompt to stop being asked."/>
                    <!-- Cross-wheel FFB notice: shown from code (RefreshCrossWheelFfbNotice) when a
                         restore/sync held back FFB tuning built on a different wheel model. -->
                    <Border x:Name="CrossWheelFfbNotice" Visibility="Collapsed"
                            CornerRadius="6" Padding="10,8" Margin="0,2,0,8"
                            Background="#33E5C04A" BorderBrush="#FFE5C04A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="CrossWheelFfbNoticeText" TextWrapping="Wrap" FontSize="12"
                                       Foreground="#FFF0D890" Margin="0,0,0,6"/>
                            <CheckBox x:Name="CrossWheelFfbRememberCheck" Content="Remember my choice"
                                      Margin="0,0,0,6" FontSize="12" Foreground="#FFF0D890"
                                      ToolTip="Apply this choice to future syncs from a different wheel model without asking again. (Apply anyway = always apply; Dismiss = never apply. Change later under 'FFB tuning from a different wheel model'.)"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CrossWheelFfbApplyBtn" Content="Apply anyway"
                                        Padding="10,3" Height="24" Click="CrossWheelFfbApply_Click"
                                        ToolTip="Apply the held-back FFB tuning to this PC anyway."/>
                                <Button x:Name="CrossWheelFfbDismissBtn" Content="Dismiss"
                                        Margin="8,0,0,0" Padding="10,3" Height="24" Click="CrossWheelFfbDismiss_Click"
                                        ToolTip="Keep this PC's own FFB tuning and discard the held-back tuning."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="BackupNowBtn" Content="Back up now"
                                Padding="10,3,10,3" Height="24" VerticalAlignment="Center"
                                Click="BackupNow_Click"
                                ToolTip="Upload your current setup to the cloud now."/>
                        <Button x:Name="RestoreFromCloudBtn" Content="Restore from cloud"
                                Margin="8,0,0,0" Padding="10,3,10,3" Height="24" VerticalAlignment="Center"
                                Click="RestoreFromCloud_Click"
                                ToolTip="Download your cloud backup and apply it to this PC (your local-only presets are kept)."/>
                        <TextBlock x:Name="BackupStatusText" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="#FFC0C0C0" TextWrapping="Wrap" MaxWidth="220"/>
                    </StackPanel>
                    <TextBlock x:Name="CloudUploadHint" Style="{StaticResource HelpText}"
                               Margin="0,2,0,2" FontSize="12" Foreground="#FFE5C04A"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="CloudRemovalText" Margin="0,0,0,2" FontSize="12" FontWeight="SemiBold"
                               Foreground="#FFFFA033" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <!-- Local file backup: bundle everything into one portable archive. -->
                    <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,12,0,8">
                        <TextBlock Text="Backup to file" Style="{StaticResource SectionHeaderText}"/>
                    </Border>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8"
                               Text="Bundle your full Trueforce For All state (settings, every preset, every default, every car tuning) into one archive for moving to a new machine. To share individual presets or car tunings with other users, use Import / Export in the Preset Manager (Presets tab) instead."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BackupButton" Content="Backup…" Width="140" Height="28" Margin="0,0,8,0" Click="Backup_Click"
                                ToolTip="Save settings + every user preset + every default + every car tuning to a single .zip you can carry to another machine."/>
                        <Button x:Name="RestoreButton" Content="Restore…" Width="140" Height="28" Click="Restore_Click"
                                ToolTip="Replace all current Trueforce For All settings, presets, defaults, and car tunings with a backup archive's contents. Destructive: confirm before running."/>
                    </StackPanel>
                    <TextBlock x:Name="BackupFileStatus" FontSize="11" Foreground="#FFB0B0B0"
                               Margin="0,0,0,4" TextWrapping="Wrap" Text=""/>
                    <!-- Dev-only: backup round-trip + classification self-test. Lives with the
                         backup tools it validates. Hidden unless DevModeUnlocked (ApplyDevModeVisibility). -->
                    <Button x:Name="BackupSelfTestButton" Content="Run backup self-test (dev)"
                            HorizontalAlignment="Left" Margin="0,4,0,0" Padding="10,3"
                            Visibility="Collapsed" Click="BackupSelfTest_Click"
                            ToolTip="Dev only: runs the backup round-trip + the classification audit (flags any unclassified TrueforceSettings field) and shows the result."/>
                </StackPanel>
            </Expander>

            <!-- iRacing / MAIRA passthrough. PERMANENTLY HIDDEN since 2026-08-01:
                 Marvin declined the passthrough PR, so the link this section
                 configures will never ship in MAIRA proper. Kept (not deleted)
                 because the MairaIpcSource listener stays armed and a MAIRA fork
                 could revive the publisher side; iRacing rev lights are then on
                 by default with nothing to configure. Rev lights for Telemetry
                 Based FFB have their own toggle on the Telemetry FFB tab. -->
            <Expander x:Name="RpmLedSection" IsExpanded="False" Visibility="Collapsed" Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="iRacing" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" FontSize="12"
                        Text="In iRacing you disable native Trueforce, which also switches the wheel's rev lights off. A forked MAIRA with the 'Pass FFB through TF4ALL' publisher can hand the wheel to TF4ALL, which then drives the rev lights automatically. Click Test to check they light up."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Test" Style="{StaticResource EffectTestButton}" Click="RpmLedTest_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="MairaPassthroughCheck" Content="Auto-link with MAIRA"
                              VerticalAlignment="Center" Margin="0,0,0,6"
                              Checked="MairaPassthrough_Changed" Unchecked="MairaPassthrough_Changed"
                              ToolTip="Leave on. If a MAIRA build with the 'Pass FFB through TF4ALL' toggle ever publishes, the two link up automatically. Off forces the USBPcap tap path and ignores MAIRA."/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="LED status:" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Column="1" x:Name="RpmLedStatusText" Text="(idle)" FontSize="11" Opacity="0.85"/>
                    </Grid>
                    <TextBlock Margin="0,0,0,8" FontSize="12">
                        <Hyperlink Foreground="#FF4DA3FF" Click="GetMaira_Click">
                            <Run Text="Get MAIRA Refactored (recommended for iRacing)"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Expander> <!-- /RpmLedSection (iRacing) -->

            <!-- Author identity moved into the Account expander above. The
                 hidden TextBox keeps the existing AuthorNameBox bindings
                 working for parts of the code that read/write the text;
                 user-facing edits happen via PickUsernameWindow only. -->
            <TextBox x:Name="AuthorNameBox" Visibility="Collapsed" Width="0" Height="0"
                     LostFocus="AuthorName_Changed" KeyDown="AuthorName_KeyDown"/>
            <TextBlock x:Name="AuthorNameStatus" Visibility="Collapsed"/>


                    <!-- Tester access code box. Type HELP for the catalog.
                     (The old MAIRA / TEST unlock is retired; that section
                     is permanently hidden above.) -->
                <StackPanel Orientation="Horizontal" Margin="0,18,0,2">
                    <TextBlock Text="Access code:" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <TextBox x:Name="AccessCodeBox" Width="120" Height="24" Margin="8,0,0,0"
                             VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="4,0"
                             Background="#FF2D2D30" Foreground="White" CaretBrush="White"
                             BorderBrush="#FF7A7A7A" BorderThickness="1"
                             ToolTip="Enter a code to unlock test or recovery features. Type HELP to list valid codes."
                             LostFocus="AccessCode_Changed" KeyDown="AccessCode_KeyDown"/>
                    <TextBlock x:Name="AccessCodeStatus" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </sh:SHTabItem>

            <!-- Account tab. Relocated out of Settings so identity, supporter status,
                 cloud backup and Discord live in one place, with the Support card
                 (Patreon / Ko-fi + the Patreon-sourced supporters wall) on top. -->
            <sh:SHTabItem x:Name="AccountTab" Header="Account">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12,14,14">

            <!-- Account tab content (no outer expander; the tab name says Account). Identity at
                 top, external-account links under Connections, stats, then a collapsed Account
                 details section for the rarely-needed sessions + data export/delete. The community
                 toggles + cloud backup moved to Settings > Network. -->

            <!-- Sign-in status + button -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock x:Name="AccountStatusLabel" VerticalAlignment="Center" FontSize="12"
                           Foreground="#FFE0E0E0" MaxWidth="360" TextWrapping="Wrap"
                           Text="Not signed in. Sign in to use community features."/>
                <Button x:Name="AccountAuthBtn" Content="Sign in"
                        Margin="10,0,0,0" Padding="10,3,10,3" Height="24" VerticalAlignment="Center"
                        Click="AccountAuth_Click"
                        ToolTip="Sign in with email (one-time code, no password) to use community features."/>
            </StackPanel>

            <!-- Supporter badge. Real entitlement (or a dev DISPLAY override via SUPPORTER).
                 Display only: the backup gate is enforced server-side. Hidden when not a supporter. -->
            <Border x:Name="SupporterBadge" CornerRadius="9" Padding="9,2,9,2" Margin="0,0,0,8"
                    HorizontalAlignment="Left" Background="#33E5C04A" BorderBrush="#FFE5C04A" BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock x:Name="SupporterBadgeText" FontSize="11" FontWeight="SemiBold"
                           Foreground="#FFE5C04A" Text="Supporter"/>
            </Border>

            <!-- Username (read-only; identity is your signed-in username OR anonymous). -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Username:" Style="{StaticResource LabelText}" VerticalAlignment="Center" Width="100"/>
                <TextBlock x:Name="AccountUsernameDisplay" VerticalAlignment="Center" FontSize="13"
                           Foreground="#FFE0E0E0" Text="(anonymous)" MinWidth="180"/>
                <Button x:Name="AccountChangeUsernameBtn" Content="Change…"
                        Margin="10,0,0,0" Padding="8,2,8,2" Height="22" VerticalAlignment="Center"
                        Click="AccountChangeUsername_Click" Visibility="Collapsed"
                        ToolTip="Pick a new username. Checked against the community for uniqueness."/>
                <TextBlock x:Name="AccountAuthorStatus" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                <!-- Hidden TextBox keeps the existing TextBoxBinding pattern working; never shown. -->
                <TextBox x:Name="AccountAuthorBox" Visibility="Collapsed" Width="0" Height="0"
                         LostFocus="AccountAuthor_Changed" KeyDown="AccountAuthor_KeyDown"/>
            </StackPanel>
            <TextBlock x:Name="AccountUsernameHelp" Style="{StaticResource HelpText}" Margin="100,2,0,12" FontSize="11"
                       Text="Sign in to claim a username."/>
            <!-- Change email button. Only meaningful while signed in. -->
            <StackPanel x:Name="AccountChangeEmailRow" Orientation="Horizontal" Margin="0,0,0,4" Visibility="Collapsed">
                <TextBlock Text="Email:" Style="{StaticResource LabelText}" VerticalAlignment="Center" Width="100"/>
                <TextBlock x:Name="AccountEmailValue" VerticalAlignment="Center" FontSize="12" Foreground="#FFE0E0E0" Text=""/>
                <Button x:Name="AccountChangeEmailBtn" Content="Change…"
                        Margin="10,0,0,0" Padding="8,2,8,2" Height="22" VerticalAlignment="Center"
                        Click="AccountChangeEmail_Click"
                        ToolTip="Send a confirmation link to a new address. The current address keeps working until you confirm the new one."/>
            </StackPanel>
            <!-- Inline outcome for routine change-email feedback (validation / errors);
                 the "check your inbox" success stays a modal since it needs a deliberate
                 read. Keeps account outcomes on the inline channel like link / unlink. -->
            <TextBlock x:Name="AccountChangeEmailStatus" FontSize="11" Margin="100,0,0,4"
                       TextWrapping="Wrap" Foreground="#FFB0B0B0" Text="" Visibility="Collapsed"/>

            <!-- Connections: external-account links (Discord, Patreon). One header so future
                 link types have a home. -->
            <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,12,0,8">
                <TextBlock Text="Connections" Style="{StaticResource SectionHeaderText}"/>
            </Border>
            <StackPanel x:Name="DiscordLinkRow" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="LinkDiscordBtn" Content="Join Discord" Style="{StaticResource DiscordButton}"
                        Height="26" VerticalAlignment="Center"
                        Click="LinkDiscord_Click"
                        ToolTip="Opens Discord in your browser to link your account and add you to the Trueforce For All community server, where your contributions earn roles."/>
                <Button x:Name="UnlinkDiscordBtn" Content="Unlink"
                        Margin="8,0,0,0" Padding="8,2,8,2" Height="24" VerticalAlignment="Center"
                        Click="UnlinkDiscord_Click" Visibility="Collapsed"
                        ToolTip="Remove the link between your TF4ALL account and your Discord account."/>
                <TextBlock x:Name="DiscordLinkStatusText" VerticalAlignment="Center" FontSize="12"
                           Foreground="#FFC0C0C0" MaxWidth="320" TextWrapping="Wrap" Margin="12,0,0,0"
                           Text="Sign in to join Discord."/>
            </StackPanel>
            <!-- Patreon link. An active pledge unlocks the supporter badge + cloud backup. If the
                 patron has Discord connected on Patreon AND is already in the community server, we
                 link Discord too; otherwise they use Join Discord above. -->
            <StackPanel x:Name="PatreonLinkRow" Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="LinkPatreonBtn" Content="Link Patreon" Style="{StaticResource SupportButton}"
                        Background="#FFF96854" Height="26" VerticalAlignment="Center"
                        Click="LinkPatreon_Click"
                        ToolTip="Unlock the supporter badge and cloud backup from your Patreon pledge. If your Patreon has Discord connected and you're already in the community server, it links Discord too."/>
                <Button x:Name="UnlinkPatreonBtn" Content="Unlink"
                        Margin="8,0,0,0" Padding="8,2,8,2" Height="24" VerticalAlignment="Center"
                        Click="UnlinkPatreon_Click" Visibility="Collapsed"
                        ToolTip="Remove the link between your TF4ALL account and your Patreon account."/>
                <TextBlock x:Name="PatreonLinkStatusText" VerticalAlignment="Center" FontSize="12"
                           Foreground="#FFC0C0C0" MaxWidth="320" TextWrapping="Wrap" Margin="12,0,0,0"
                           Text="Sign in to link Patreon."/>
            </StackPanel>

            <!-- Account details: the rarely-needed bits (your stats, active sessions, data
                 export, delete), collapsed by default so they don't clutter the account view. -->
            <Expander x:Name="AccountDetailsExpander" Header="Account settings" IsExpanded="False" Margin="0,12,0,4"
                      Expanded="AccountDetails_Expanded">
                <StackPanel Margin="0,8,0,0">
                    <!-- Your stats. Refreshed from get_account_stats when the Account tab is shown. -->
                    <TextBlock Text="Your stats" Foreground="#FFE5C04A" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <Border x:Name="AccountStatsBox" Background="#22FFFFFF" CornerRadius="3"
                            Padding="10,6,10,6" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="AccountStatsCreated"   Foreground="#FFC0C0C0" FontSize="11" Margin="0,1,0,0"/>
                            <TextBlock x:Name="AccountStatsUploads"   Foreground="#FFC0C0C0" FontSize="11" Margin="0,1,0,0"/>
                            <TextBlock x:Name="AccountStatsDownloads" Foreground="#FFC0C0C0" FontSize="11" Margin="0,1,0,0"/>
                            <TextBlock x:Name="AccountStatsVotes"     Foreground="#FFC0C0C0" FontSize="11" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Active sessions. Every device signed in (get_my_sessions, migration 0058);
                         each non-current row revocable, or "Sign out everywhere else". Rows built in
                         RefreshAccountSessions; this device is flagged with no revoke button. -->
                    <Border x:Name="AccountSessionsBox" Background="#22FFFFFF" CornerRadius="3"
                            Padding="10,6,10,6" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Foreground="#FFE5C04A" FontWeight="SemiBold" FontSize="12"
                                           Text="Active sessions" VerticalAlignment="Center"/>
                                <Button x:Name="AccountSessionsRefreshBtn" Content="Refresh"
                                        HorizontalAlignment="Right" Padding="8,1,8,1" Height="20" FontSize="10"
                                        Click="AccountSessionsRefresh_Click"
                                        ToolTip="Re-check which devices are signed in to your account."/>
                            </Grid>
                            <TextBlock x:Name="AccountSessionsStatus" Foreground="#FFC0C0C0" FontSize="11"
                                       Margin="0,1,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <StackPanel x:Name="AccountSessionsList"/>
                            <Button x:Name="AccountSignOutOthersBtn" Content="Sign out everywhere else"
                                    HorizontalAlignment="Left" Padding="10,3,10,3" Height="24" Margin="0,8,0,0"
                                    Visibility="Collapsed"
                                    Click="AccountSignOutOthers_Click"
                                    ToolTip="Revoke every other device's session. This device stays signed in."/>
                            <TextBlock Foreground="#FF808080" FontSize="10"
                                       Text="Revoking signs the other device out within a few minutes while it's running. A device that's offline or asleep signs out the next time it comes online."
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Data export + account delete. Both auth-gated. -->
                    <StackPanel x:Name="AccountDangerZone" Orientation="Horizontal" Margin="0,0,0,4" Visibility="Collapsed">
                        <Button x:Name="AccountExportBtn" Content="Export my data"
                                Padding="10,3,10,3" Height="24" Margin="0,0,8,0"
                                Click="AccountExport_Click"
                                ToolTip="Save a JSON file with the data your account holds: email, profile, uploads, votes, car-fact submissions, download history, sign-in sessions, linked accounts, supporter status, reports you have filed, and any moderation notices."/>
                        <Button x:Name="AccountDeleteBtn" Content="Delete account"
                                Padding="10,3,10,3" Height="24"
                                Background="#8B2E2E" BorderBrush="#8B2E2E"
                                Click="AccountDelete_Click"
                                ToolTip="Permanently remove your account. Presets you uploaded stay available for people who downloaded them but lose your name. Your cloud backup is deleted too."/>
                    </StackPanel>
                    <TextBlock x:Name="AccountExportStatus" FontSize="11" Foreground="#FFB0B0B0"
                               Margin="0,4,0,0" TextWrapping="Wrap" Text=""/>
                    <TextBlock FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap">
                        <Hyperlink Click="PrivacyPolicy_Click" ToolTip="Opens PRIVACY.md on GitHub.">Privacy policy</Hyperlink><Run Text=": what's stored, why, and how to remove it."/>
                    </TextBlock>
                </StackPanel>
            </Expander>

                    </StackPanel>
                </ScrollViewer>
            </sh:SHTabItem>

            <!-- Support tab. Separate from Account: this is the giving / recognition surface
                 (Patreon / Ko-fi / PayPal), share links, and the Patreon-sourced supporters
                 wall. Free base forever; this funds infra + time (patronage, not a paywall).
                 Money handlers reused from the existing Support section (Patreon_Click /
                 Donate_Click) + Paypal_Click. -->
            <sh:SHTabItem x:Name="SupportTab" Header="Support us">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12,14,14">

                        <TextBlock Text="Support Trueforce For All" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13" Opacity="0.8" Margin="0,0,0,14"
                                   Text="Trueforce For All is free for everyone, forever. If it has brought your wheel to life in a game that never had Trueforce, you can chip in to help cover the servers and the time that keep it growing. Supporting on Patreon also gets you cloud backup and sync, and a spot on the wall below."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="SupportPatreonButton" Content="Support on Patreon" Style="{StaticResource SupportButton}"
                                    Background="#FFF96854" Click="Patreon_Click"
                                    ToolTip="Recurring support on Patreon (patreon.com/Mhytee). Also unlocks cloud backup and sync."/>
                            <Button x:Name="SupportKofiButton" Content="Tip on Ko-fi" Style="{StaticResource SupportButton}"
                                    Background="#FF29ABE0" Margin="10,0,0,0" Click="Donate_Click"
                                    ToolTip="One-off tip via Ko-fi, no account needed."/>
                            <Button x:Name="SupportPaypalButton" Content="PayPal" Style="{StaticResource SupportButton}"
                                    Background="#FF0070BA" Margin="10,0,0,0" Click="Paypal_Click"
                                    ToolTip="One-off tip via PayPal (paypal.me/mhytee)."/>
                        </StackPanel>
                        <TextBlock x:Name="SupportOpenStatus" FontSize="11" Foreground="#FF7FB37F"
                                   Margin="0,2,0,0" Text=""/>
                        <TextBlock Style="{StaticResource HelpText}" FontSize="11" Margin="0,4,0,16"
                                   Text="These open in your browser. Patreon is recurring and unlocks cloud backup/sync; Ko-fi and PayPal are one-off tips."/>

                        <!-- Share. Helping another sim racer find TF4ALL is its own support. -->
                        <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,0,0,10">
                            <TextBlock Text="Spread the word" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Style="{StaticResource HelpText}" FontSize="12" Margin="0,0,0,8"
                                   Text="Not into chipping in? Sharing the project helps just as much."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="SupportShareDialogButton" Content="Share TF4ALL…"
                                    Style="{StaticResource EffectsShareButton}"
                                    Click="SharePanelButton_Click" Margin="0,0,8,0" ToolTipService.InitialShowDelay="250"
                                    ToolTip="Post on X, Reddit, or Facebook, or copy the GitHub / Nexus link."/>
                            <Button x:Name="SupportOpenRepoButton" Content="Open project page" Width="160" Height="28"
                                    Click="OpenRepo_Click"
                                    ToolTip="github.com/Mhytee/Trueforce-For-All"/>
                        </StackPanel>

                        <!-- Supporters wall. Populated DIRECTLY from Patreon (list_supporters),
                             so patrons who never link Discord still get recognition. First name
                             + last initial only; filled by RefreshSupportersWallAsync. -->
                        <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,0,0,8">
                            <TextBlock Text="Supporters" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Style="{StaticResource HelpText}" FontSize="12" Margin="0,0,0,10"
                                   Text="The people keeping the lights on. Thank you."/>
                        <TextBlock x:Name="SupportersWallStatus" FontSize="12" Opacity="0.7"
                                   Text="Loading supporters…"/>
                        <StackPanel x:Name="SupportersWallPanel" Margin="0,6,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </sh:SHTabItem>
        </sh:SHTabControl>

        <!-- Achievement celebration toast. Non-modal, in-plugin only (overlays this panel,
             never the game). Auto-dismisses; the × closes early; clicking it opens the
             Achievements tracker. Driven by the toast queue in code-behind. -->
        <Border x:Name="AchievementToast" Grid.RowSpan="2" Visibility="Collapsed"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                Background="#F02A2A2E" BorderBrush="#FFE5C04A" BorderThickness="1" CornerRadius="8"
                Padding="14,10,12,10" Cursor="Hand" MouseLeftButtonUp="AchievementToast_Click">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="#FF000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏆" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center" MaxWidth="300">
                    <TextBlock x:Name="AchievementToastTitle" Text="Achievement unlocked" FontSize="13"
                               FontWeight="SemiBold" Foreground="#FFE5C04A"/>
                    <TextBlock x:Name="AchievementToastBody" Text="" FontSize="12" Foreground="#FFE6E6E6"
                               TextWrapping="Wrap" Margin="0,1,0,0"/>
                </StackPanel>
                <Button x:Name="AchievementToastLinkBtn" Content="Link" Style="{StaticResource DiscordButton}"
                        Visibility="Collapsed" Margin="12,0,0,0" Height="26" Padding="9,4,11,4"
                        FontSize="12" VerticalAlignment="Center" Click="AchievementToastLink_Click"/>
                <Button x:Name="AchievementToastClose" Content="✕" FontSize="11"
                        Background="Transparent" BorderThickness="0" Foreground="#FFB0B0B0"
                        Cursor="Hand" Padding="6,0,2,0" VerticalAlignment="Top"
                        ToolTip="Dismiss this notification (the achievement stays unlocked)."
                        Click="AchievementToastClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
