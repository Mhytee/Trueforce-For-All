                    <TextBlock Text="{loc:T TelemetryFfb_ModeBForzaTuningPanel2Braking}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <CheckBox x:Name="ModeBGripCalCheck" Margin="0,0,0,2" Content="{loc:T TelemetryFfb_ModeBGripCal}"
                              ToolTip="{loc:T TelemetryFfb_ModeBGripCal_Tip}"
                              Checked="ModeBFeel_Changed" Unchecked="ModeBFeel_Changed"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="20,0,0,8" Text="{loc:T TelemetryFfb_ModeBForzaTuningPanel2TheWheelLightensAt}"/>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_ModeBForzaTuningPanel2LockupRecoveryMs}" Style="{StaticResource LabelText}"/>
                        <Slider     Grid.Column="1" x:Name="ModeBRecoverSlider" Minimum="20" Maximum="400" SmallChange="10" LargeChange="50"
                                    TickFrequency="50" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                        <Border Visibility="{Binding Visibility, ElementName=ModeBRecoverText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ModeBRecoverText" Text="30"/></Border>
