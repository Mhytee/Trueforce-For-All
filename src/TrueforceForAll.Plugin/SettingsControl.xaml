                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8"
                               Text="{loc:T TelemetryFfb_ModeBForzaTuningPanel2ForceShapingAndPlumbing}"/>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_ModeBForzaTuningPanel2WeightBuildup}" Style="{StaticResource LabelText}"/>
                        <Slider     Grid.Column="1" x:Name="ModeBRiseSlider" Minimum="0.2" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.1" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                        <Border Visibility="{Binding Visibility, ElementName=ModeBRiseText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ModeBRiseText" Text="0.80"/></Border>
                    </Grid>
                    <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_ModeBForzaTuningPanel2HowEarlyWeightArrives}"/>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_ModeBForzaTuningPanel2SmoothingMs}" Style="{StaticResource LabelText}"/>
                        <Slider     Grid.Column="1" x:Name="ModeBSmoothSlider" Minimum="5" Maximum="100" SmallChange="5" LargeChange="10"
                                    TickFrequency="10" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                        <Border Visibility="{Binding Visibility, ElementName=ModeBSmoothText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ModeBSmoothText" Text="40"/></Border>
                    </Grid>
                    <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_ModeBForzaTuningPanel2InputSmoothingHigherCalmer}"/>

                    <CheckBox x:Name="ModeBCompressorCheck" Margin="0,0,0,2" Content="{loc:T TelemetryFfb_ModeBCompressor}"
                              Checked="ModeBFeel_Changed" Unchecked="ModeBFeel_Changed"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="20,0,0,8" Text="{loc:T TelemetryFfb_ModeBForzaTuningPanel2SoftCeilingOnThe}"/>

                    <CheckBox x:Name="ModeBLateralDemandCheck" Margin="0,0,0,2" Content="{loc:T TelemetryFfb_ModeBLateralDemand}"
                              ToolTip="{loc:T TelemetryFfb_ModeBLateralDemand_Tip}"
                              Checked="ModeBFeel_Changed" Unchecked="ModeBFeel_Changed"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="20,0,0,8" Text="{loc:T TelemetryFfb_ModeBForzaTuningPanel2BrakingInAStraight}"/>

                    <CheckBox x:Name="ModeBSignCheck" Content="{loc:T TelemetryFfb_ModeBSign}"
                              Margin="0,0,0,2" Checked="ModeBSign_Changed" Unchecked="ModeBSign_Changed"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="20,0,0,0"
                               Text="{loc:T TelemetryFfb_ModeBForzaTuningPanel2FlipThisIfTheWheel}"/>
                </StackPanel>
            </Expander>

            </StackPanel><!-- ModeBForzaTuningPanel2 -->

            <!-- Wheel outputs rather than force tuning. Rev lights and the
                 OLED live on this tab because they ride the same HID++ channel
                 as game FFB, so they need Mode B in charge of the wheel; the
                 section sits last so the force tuning reads first. -->

            <!-- Moved here from the Effects tab (owner call): scale, smoothing,
                 sign, the stationary spring and spike reduction all describe how
                 force REACHES THE WHEEL, which is what this tab is about. They
                 were filed under Effects, where they sat beside things that make
                 noise rather than things that shape steering force.

                 Moved rather than duplicated on purpose: two copies of one
                 setting is two places to disagree, and WPF cannot reparent a
                 named control per game anyway. So every game finds them here
                 now, not only iRacing. -->
            <!-- The "FFB tweaks" wrapper is gone (owner, 2026-08-16). It held
                 three unrelated things behind one vague word, and its smoothing
                 slider has moved up beside Damping where it is actually used.
                 Its three parts now stand as their own sections. -->

            <!-- FFB pass-through: how the game's own force feedback is mirrored
                 to the wheel. Scale and sign only now: BOTH are bypassed on the
                 authored iRacing path, so this section is about games we
                 mirror. -->
                <Expander x:Name="FfbPassthroughExpanderSection" IsExpanded="False" Margin="0,12,0,4">
                    <Expander.Header>
                        <TextBlock x:Name="FfbPassthroughHeader" Text="{loc:T TelemetryFfb_FfbPassthrough}" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"/>
                    </Expander.Header>
                    <StackPanel x:Name="FfbPassthroughControls" Margin="0,8,0,0">
                        <CheckBox x:Name="FfbInvertCheck" Content="{loc:T TelemetryFfb_FfbInvert}"
                                  Margin="0,2,0,0" VerticalAlignment="Center"
                                  Checked="FfbInvert_Changed" Unchecked="FfbInvert_Changed"
                                  ToolTip="{loc:T TelemetryFfb_FfbInvert_Tip}"/>
                    </StackPanel>
                </Expander>

                <!-- Stationary friction, for the routes that replace the game's force
                     outright: RaceRoom's takeover (the shared-memory steering force is
                     ~0 parked) and Telemetry Based FFB (the synthesis). The game's
                     low-speed parking resistance goes missing there, so it is
                     resynthesized: firm parked, fading to nothing by the set speed.
                     Visibility is driven in code (R3EStationaryDamperApplies).
                     Sits with the stationary spring, its parked-feel sibling
                     (owner, 2026-09-14). -->
                <Expander x:Name="R3EStationaryDamperExpander" IsExpanded="False" Visibility="Collapsed" Margin="0,12,0,4">
                    <Expander.Header>
                        <CheckBox x:Name="R3EStationaryDamperCheck" Content="{loc:T TelemetryFfb_R3EStationaryDamper}"
                                  FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                  Checked="R3EStationaryDamper_Changed" Unchecked="R3EStationaryDamper_Changed"
                                  ToolTip="{loc:T TelemetryFfb_R3EStationaryDamper_Tip}"/>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_R3EStationaryDamperFrictionStrength}" Style="{StaticResource LabelText}"
                                   ToolTip="{loc:T TelemetryFfb_R3EStationaryDamperFrictionStrength_Tip}"/>
                        <Slider     Grid.Column="1" x:Name="R3EDamperStrengthSlider" Minimum="0" Maximum="0.6" SmallChange="0.02" LargeChange="0.05"
                                    ToolTip="{loc:T TelemetryFfb_R3EDamperStrength_Tip}"
                                    TickFrequency="0.05" ValueChanged="R3EDamperSlider_ValueChanged" VerticalAlignment="Center"/>
                        <Border Visibility="{Binding Visibility, ElementName=R3EDamperStrengthText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="R3EDamperStrengthText" Text="0.40"/></Border>
                    </Grid>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_R3EStationaryDamperFadesOutBy}" Style="{StaticResource LabelText}"
                                   ToolTip="{loc:T TelemetryFfb_R3EStationaryDamperFadesOutBy_Tip}"/>
                        <Slider     Grid.Column="1" x:Name="R3EDamperFadeSlider" Minimum="5" Maximum="80" SmallChange="1" LargeChange="5"
                                    ToolTip="{loc:T TelemetryFfb_R3EDamperFade_Tip}"
                                    TickFrequency="5" ValueChanged="R3EDamperSlider_ValueChanged" VerticalAlignment="Center"/>
                        <Border Visibility="{Binding Visibility, ElementName=R3EDamperFadeText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="R3EDamperFadeText" Text="25"/></Border>
                    </Grid>
                    <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8"
                               Text="{loc:T TelemetryFfb_R3EStationaryDamperFirmWhenParkedEasing}"/>
                    </StackPanel>
                </Expander>

                <!-- Stationary spring: synthesizes a parked-car centering
                     force the game itself doesn't send (a stationary tire has
                     ~0 self-aligning torque). Deficit-fill + speed-fade, so it
                     can't fight the game's FFB. Uses the game's reported
                     steering whenever it provides one (AC / Forza), and falls
                     back to the wheel's physical position (WheelSteeringReader)
                     for any game that doesn't report steering via telemetry, so
                     it works in any game; always off for iRacing (the sim
                     already weights it). Forza's steering is coarse so the consumer
                     smooths it. -->
                <Expander x:Name="StationarySpringExpander" IsExpanded="False" Margin="0,12,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <!-- The toggle lives in the header, as it does for the
                                 feature expanders on this tab (curb softening, soft
                                 lock, stationary friction; owner, 2026-09-13): the
                                 row says whether the spring is on without opening
                                 it. Sized like the section headers either side of
                                 it, which this expander sits among. -->
                            <CheckBox x:Name="StationarySpringCheck"
                                      Content="{loc:T TelemetryFfb_StationarySpring}"
                                      FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="StationarySpring_Changed" Unchecked="StationarySpring_Changed"
                                      ToolTip="{loc:T TelemetryFfb_StationarySpring_Tip}"/>
                            <TextBlock x:Name="StationarySpringUnsupportedBadge" Style="{StaticResource UnsupportedBadge}"
                                       Text="{loc:T TelemetryFfb_StationarySpringUnsupportedBadge}"
                                       ToolTip="{loc:T TelemetryFfb_StationarySpringUnsupportedBadge_Tip}"/>
                            <!-- Hidden: the stationary spring is per-game now and persists on edit,
                                 so it no longer uses the preset Save/Revert. Kept (collapsed) because
                                 the EffectKind machinery still maps to them by name. -->
                            <Button x:Name="StationarySpringRevertBtn" Visibility="Collapsed" Content="↶" Tag="StationarySpring" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="StationarySpringSaveBtn"   Visibility="Collapsed" Content="{loc:T Common_SaveEllipsis}" Tag="StationarySpring" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel x:Name="StationarySpringSliders">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_StationarySpringSlidersSpringStrength}" Style="{StaticResource LabelText}"
                                           ToolTip="{loc:T TelemetryFfb_StationarySpringSlidersSpringStrength_Tip}"/>
                                <Slider     Grid.Column="1" x:Name="StationarySpringStrengthSlider"
                                            Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.25"
                                            TickFrequency="0.25" ValueChanged="StationarySpringStrengthSlider_ValueChanged" VerticalAlignment="Center"/>
                                <Border Visibility="{Binding Visibility, ElementName=StationarySpringStrengthText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="StationarySpringStrengthText" Text="1.00"/></Border>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_StationarySpringSlidersFadeOutKmH}" Style="{StaticResource LabelText}"
                                           ToolTip="{loc:T TelemetryFfb_StationarySpringSlidersFadeOutKmH_Tip}"/>
                                <Slider     Grid.Column="1" x:Name="StationarySpringCutoffSlider"
                                            Minimum="2" Maximum="30" SmallChange="1" LargeChange="5"
                                            TickFrequency="2" ValueChanged="StationarySpringCutoffSlider_ValueChanged" VerticalAlignment="Center"/>
                                <Border Visibility="{Binding Visibility, ElementName=StationarySpringCutoffText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="StationarySpringCutoffText" Text="12"/></Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- FFB spike reduction, now its own section rather than a row
                     inside a grab-bag. Save/Revert live in the expander header. -->
                <Expander x:Name="SpikeReductionExpanderSection" IsExpanded="False" Margin="0,12,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T TelemetryFfb_SpikeReductionExpanderSectionFfbSpikeReduction}" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"/>
                            <Button x:Name="SpikeReductionRevertBtn" Content="↶" Tag="SpikeReduction" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="SpikeReductionSaveBtn"   Content="{loc:T Common_SaveEllipsis}" Tag="SpikeReduction" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <CheckBox x:Name="SpikeTamingEnabledCheck" Content="{loc:T TelemetryFfb_SpikeTamingEnabled}"
                                  FontWeight="SemiBold" Margin="0,0,0,4"
                                  Checked="SpikeTamingEnabled_Changed" Unchecked="SpikeTamingEnabled_Changed"/>
                        <!-- Spike reduction has two mutually exclusive methods: exactly
                             one runs when the box above is on, neither when it's off.
                             The selector and tuning stay readable even when it's off so
                             the method can be set any time. The active method's controls
                             show; the other method's are hidden (no graying), driven by
                             UpdateSpikeModeUi.

                             Each method owns its OWN slider and its own setting. They
                             shared one (FfbSpikeMaxLsbPerMs, read as LSB/ms under the
                             rate limiter and as an LSB threshold under the peak limiter)
                             until 2026-09-05, so switching method silently reinterpreted
                             a number tuned in the other unit and nobody could reason
                             about the result. Two sliders also means a method switch
                             never has to reassign a Value and fire ValueChanged into the
                             wrong setting.

                             All three readouts are percentages of full force; the
                             settings stay in LSB. EditableReadout.Scale converts what a
                             user types, the ValueChanged handlers format what they see. -->
                        <StackPanel x:Name="SpikeTamingBody" Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8"
                                       Text="{loc:T TelemetryFfb_SpikeTamingBodySomeGamesDeliverCurb}"/>
                            <TextBlock Text="{loc:T TelemetryFfb_SpikeTamingBodyMethod}" Style="{StaticResource LabelText}" Margin="0,2,0,4"
                                       ToolTip="{loc:T TelemetryFfb_SpikeTamingBodyMethod_Tip}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <RadioButton x:Name="SpikeModeSlewRadio" GroupName="SpikeMode"
                                             Content="{loc:T TelemetryFfb_SpikeModeSlewRadio}" VerticalAlignment="Center"
                                             Checked="SpikeMode_Changed"/>
                                <RadioButton x:Name="SpikeModeTransientRadio" GroupName="SpikeMode"
                                             Content="{loc:T TelemetryFfb_SpikeModeTransientRadio}" VerticalAlignment="Center"
                                             Margin="18,0,0,0" Checked="SpikeMode_Changed"/>
                            </StackPanel>
                            <TextBlock x:Name="SpikeModeDescription" Style="{StaticResource HelpText}" Margin="0,0,0,8"/>
                            <!-- Rate limiter only. -->
                            <StackPanel x:Name="SpikeRateRow">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_SpikeRateRowRateLimit}" Style="{StaticResource LabelText}"/>
                                    <Slider     Grid.Column="1" x:Name="FfbSpikeLimitSlider"
                                                Minimum="0" Maximum="30000" SmallChange="328" LargeChange="1638"
                                                TickFrequency="2500" ValueChanged="FfbSpikeLimitSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <Border Visibility="{Binding Visibility, ElementName=FfbSpikeLimitText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="FfbSpikeLimitText" Text="7.7%"/></Border>
                                </Grid>
                                <TextBlock Style="{StaticResource HelpText}" Margin="140,4,0,8" x:Name="FfbSpikeLimitHelp"/>
                            </StackPanel>
                            <!-- Peak limiter only. Both knobs live in one panel so the
                                 summary line below them shows and hides with them.

                                 Both knobs describe ONE object: the 200 ms running
                                 average of output force. The limiter compares each
                                 moment against that average, which is what separates a
                                 corner (builds slowly, the average keeps up, nothing to
                                 flatten) from a curb strike (outruns the average, the
                                 whole gap reads as a spike). Max hit is how far above
                                 the average a hit may rise; Minimum reference is a FLOOR
                                 under the average, there because a near-zero average on
                                 a calm road would make every ordinary bump look like a
                                 jump. Since 2026-09-13 the floor is also the gate for
                                 the fixed hit rate limit (HitSlewLsbPerMs in
                                 TrueforceDevice): only a hit above it is slowed.

                                 Two earlier framings of this failed with testers and are
                                 worth not repeating: "levels off above the threshold" is
                                 true only at rest, and "the floor applies when calm, the
                                 load applies when loaded" teaches two regimes handing
                                 off when there is only one rule with a floor under it. -->
                            <StackPanel x:Name="SpikePeakRows">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_SpikePeakRowsMaxHit}" Style="{StaticResource LabelText}"/>
                                    <Slider     Grid.Column="1" x:Name="FfbPeakLimitSlider"
                                                Minimum="0" Maximum="20000" SmallChange="328" LargeChange="1638"
                                                TickFrequency="2000" ValueChanged="FfbPeakLimitSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <Border Visibility="{Binding Visibility, ElementName=FfbPeakLimitText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="FfbPeakLimitText" Text="10%"/></Border>
                                </Grid>
                                <TextBlock Style="{StaticResource HelpText}" Margin="150,4,0,8"
                                           Text="{loc:T TelemetryFfb_SpikePeakRowsTheMostAHitMayRise}"/>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_SpikePeakRowsMinimumReference}" Style="{StaticResource LabelText}"/>
                                    <Slider     Grid.Column="1" x:Name="FfbSpikeThresholdSlider"
                                                Minimum="0" Maximum="30000" SmallChange="328" LargeChange="1638"
                                                TickFrequency="2500" ValueChanged="FfbSpikeThresholdSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <Border Visibility="{Binding Visibility, ElementName=FfbSpikeThresholdText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="FfbSpikeThresholdText" Text="6.3%"/></Border>
                                </Grid>
                                <TextBlock Style="{StaticResource HelpText}" Margin="150,4,0,8"
                                           Text="{loc:T TelemetryFfb_SpikePeakRowsHoldsTheRunningAverage}"/>
                                <TextBlock x:Name="SpikePeakSummary" Style="{StaticResource HelpText}" Margin="150,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Last of the force sections, after Spike reduction (owner,
                     2026-09-14). Out of IRacingTuningPanel since 2026-08-16 so Damping
                     and FFB smooth can sit above it while staying visible in Forza
                     and Farming Simulator. Visibility is now driven in code beside
                     the panel's own. Everything in here is expert surface: the tab
                     needs Strength day to day and Auto once per car, and burying
                     the rest is the difference between a tab someone can use and
                     one they scroll past. -->
                <Expander x:Name="IRacingAdvancedExpander" IsExpanded="False" Margin="0,12,0,4" Visibility="Collapsed">
                        <Expander.Header>
                            <TextBlock Text="{loc:T TelemetryFfb_IRacingAdvanced}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                    <!-- The section reads top-down: the situation, then the choice
                         that follows from it, then the choices that only exist
                         inside that one. The 360 Hz checkbox used to sit LAST,
                         below the two controls it governs. -->
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8"
                               Text="{loc:T TelemetryFfb_IRacingAdvancedIRacingSendsTelemetry60}"/>
                    <!-- One control, four rungs of a single ladder, replacing a
                         checkbox plus a conditional dropdown that between them hid
                         which combinations existed. It writes both underlying
                         settings (IRacingUse360Hz + IRacingForceMode), so nobody's
                         stored configuration moves. -->
                    <Grid Margin="0,0,0,2" x:Name="IRacingFeelRow">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_IRacingFeelRowFeel}" Style="{StaticResource LabelText}"/>
                        <ComboBox Grid.Column="1" x:Name="IRacingForceModeCombo" VerticalAlignment="Center"
                                  SelectionChanged="IRacingForceMode_Changed">
                            <ComboBoxItem Content="{loc:T TelemetryFfb_IRacingForceModePlain}"/>
                            <ComboBoxItem Content="{loc:T TelemetryFfb_IRacingForceModeFilled}"/>
                            <ComboBoxItem Content="{loc:T TelemetryFfb_IRacingForceModeDetailed}"/>
                            <ComboBoxItem Content="{loc:T TelemetryFfb_IRacingForceModeDetailedPredicted}"/>
                        </ComboBox>
                    </Grid>
                    <!-- Text is set in code, per selection: describing both modes at
                         once made this three times as long as the one a driver
                         needs, and buried the difference. Prediction had a slider
                         here until 2026-08-16; the plugin learns that lead per car,
                         so it belongs in Smooth's sentence rather than in a knob.
                         IRacingPredictGain survives as a file-level escape hatch. -->
                    <TextBlock x:Name="IRacingFeelHelp" Style="{StaticResource HelpText}" Margin="140,0,0,8" Text=""/>
                        </StackPanel>
                    </Expander>

            <!-- WheelLightsBlock is ONE movable unit, and it is deliberately the
                 LAST child of ModeBSupportedPanel so both directions of the move
                 are a plain append (see ApplyLightsyncTabVisibility). Locked (the
                 default) it renders right here, exactly as it always has. Unlocked
                 by the LIGHTSYNC access code, the code-behind reparents this whole
                 panel into the LIGHTSYNC tab; the controls, their x:Names and every
                 handler are unchanged, so there is no second copy to drift.
                 The wrapper carries no margin/padding: inside a vertical StackPanel
                 that makes it a layout no-op. -->
            <StackPanel x:Name="WheelLightsBlock">
            <!-- Header text set in RefreshFromPlugin: "Wheel lights" on a
                 wheel with no screen (the OLED expander hides there too). -->
            <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,24,0,12">
                <TextBlock x:Name="WheelLightsHeaderText" Text="{loc:T TelemetryFfb_WheelLightsHeader}" Style="{StaticResource SectionHeaderText}"/>
            </Border>
            <!-- Wheel-wide brightness leads the page: it is the user's own
                 setting that lives on the wheel, applies to every pattern, and
                 is only written when they move it (never on load or shutdown).
                 Hidden (Collapsed) on wheels that do not expose it. -->
            <Grid x:Name="LedBrightnessRow" Margin="0,4,0,24" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_LedBrightnessRowBrightness}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="LedBrightnessSlider" Minimum="0" Maximum="100"
                        SmallChange="1" LargeChange="10" TickFrequency="10" VerticalAlignment="Center"
                        ValueChanged="LedBrightness_Changed"
                        ToolTip="{loc:T TelemetryFfb_LedBrightness_Tip}"/>
                <Border Visibility="{Binding Visibility, ElementName=LedBrightnessText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="LedBrightnessText" Text="100%" FontSize="11"/></Border>
            </Grid>
            <!-- One short line, the same one in every game. The paragraph that used
                 to explain the shared-channel rule here has moved into the guide
                 behind the link below: the switch says what the user wants
                 ("wherever it can"), the guide answers "why not everywhere", and
                 nobody has to read about HID++ endpoints to tick a box. -->
            <CheckBox x:Name="ModeBRevLightsCheck" Content="{loc:T TelemetryFfb_ModeBRevLights}"
                      Margin="0,0,0,2" Checked="ModeBRevLights_Changed" Unchecked="ModeBRevLights_Changed"
                      ToolTip="{loc:T TelemetryFfb_ModeBRevLights_Tip}"/>
            <!-- The "why not every game" link explains the "when possible" in the
                 toggle above; the standalone "your lights follow your revs" line
                 was redundant with the toggle and was removed. -->
            <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,18">
                <Hyperlink Click="WheelLightsWhy_Click"
                           ToolTip="{loc:T TelemetryFfb_WheelLightsBlockWhyTheLightsWork_Tip}"><Run Text="{loc:T TelemetryFfb_WheelLightsBlockWhyNotEveryGame}"/></Hyperlink>
            </TextBlock>
            <!-- No help line under this one. The label says what it does, and the
                 line that used to sit here offered to stop us "overwriting" the
                 wheel's own lighting, which is not what happens: we add lights to
                 games that have none, where we can. -->

            <!-- Hidden on wheels whose strip has a fixed look (G923): a
                 pattern picker there reads as a feature the owner is
                 missing. Same principle as OledSection above. -->
            <StackPanel x:Name="RevLightPatternRow" Orientation="Horizontal" Margin="22,0,0,4">
                <TextBlock Text="{loc:T TelemetryFfb_RevLightPatternRowPattern}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                <ComboBox x:Name="RevLightEffectCombo" Width="230" Margin="8,0,0,0"
                          ToolTip="{loc:T TelemetryFfb_RevLightEffect_Tip}"
                          SelectionChanged="RevLightEffect_Changed"/>
                <Button x:Name="RevLightRememberBtn" Content="{loc:T TelemetryFfb_RevLightRemember}" Margin="8,0,0,0"
                        Padding="10,2" VerticalAlignment="Center" Click="RevLightRemember_Click"/>
                <TextBlock x:Name="RevLightRememberStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="11" Opacity="0.7" Visibility="Collapsed"><Run x:Name="RevLightRememberRun"/> · <Hyperlink Click="RevLightForget_Click"><Run Text="{loc:T TelemetryFfb_RevLightRememberForget}"/></Hyperlink></TextBlock>
            </StackPanel>
            <TextBlock x:Name="RevLightPatternHelp" Style="{StaticResource HelpText}" Margin="22,0,0,12" TextWrapping="Wrap"
                       Text="{loc:T TelemetryFfb_RevLightPattern}"/>

            <!-- Fill timing from the published dataset, for a strip whose look is
                 fixed in firmware. Those wheels never see the LIGHTSYNC tab, so
                 the checkbox up there is out of their reach; this is the same
                 feature minus the half they cannot have, and it rides community
                 features alone (TrueforcePlugin.LovelyFillEnabled). Shown ONLY on
                 those wheels: on a programmable one the LIGHTSYNC box is a single
                 decision covering both halves, and a second control here would
                 split it in two. Sits where the pattern row above hides itself,
                 so the space that row leaves is the space this fills. -->
            <StackPanel x:Name="LovelyFillBlock" Visibility="Collapsed" Margin="0,0,0,12">
                <CheckBox x:Name="LovelyFillCheck" Content="{loc:T TelemetryFfb_LovelyFill}"
                          Margin="0,0,0,2" Checked="LovelyFill_Changed" Unchecked="LovelyFill_Changed"
                          ToolTip="{loc:T TelemetryFfb_LovelyFill_Tip}"/>
                <TextBlock x:Name="LovelyFillNeedsCommunityNote" Style="{StaticResource HelpText}"
                           Margin="22,0,0,6" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="{loc:T Lightsync_LovelyNeedsCommunityNote}"/>
                <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,6" TextWrapping="Wrap"
                           Text="{loc:T TelemetryFfb_LovelyFillBlockYourLightsFillAt}"/>
                <!-- The credit is a condition of using the data rather than
                     decoration, so it belongs wherever the data reaches a user.
                     This is the only place a fixed-strip owner can see it. -->
                <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,0" TextWrapping="Wrap">
                    <Run Text="{loc:T TelemetryFfb_LovelyPerCarRevLightTiming}"/><Hyperlink Click="LovelyCredit_Click"
                            ToolTip="{loc:T Lightsync_OpensTheLovelyCar_Tip}">Lovely Sim Racing</Hyperlink><Run Text=", CC BY-NC-SA 4.0. "/><Hyperlink
                            Click="LovelyGuide_Click"
                            ToolTip="{loc:T Lightsync_WhatTheDatasetCovers_Tip}"><Run Text="{loc:T Lightsync_WhatThisCovers}"/></Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- What the strip does when the revs are not driving it. Two
                 occasions, one vocabulary, and deliberately OUTSIDE the pattern
                 row above, which hides itself on a G923: that wheel's look is
                 fixed, but its five-step bar sweeps and meters as happily as a
                 G PRO's ten.

                 Each picker is followed by a HOST panel, and the two setting
                 blocks below are reparented into whichever host needs them
                 (RefreshAmbientLedRows). The blocks are shared, not duplicated:
                 there is one sweep time and one sensitivity however many
                 occasions are using them, so a second copy of either would be a
                 second control editing one value. With both pickers on the same
                 mode the block sits under the first of them. -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_WheelLightsBlockWhenIdle}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="IdleLedModeCombo" Width="160"
                          SelectionChanged="AmbientLedMode_Changed"
                          ToolTip="{loc:T TelemetryFfb_IdleLedMode_Tip}"/>
            </Grid>
            <StackPanel x:Name="IdleModeExtras" Margin="0,0,0,2"/>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_WheelLightsBlockWhenAGameHasNoRevs}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="NoRevLedModeCombo" Width="160"
                          SelectionChanged="AmbientLedMode_Changed"
                          ToolTip="{loc:T TelemetryFfb_NoRevLedMode_Tip}"/>
            </Grid>
            <StackPanel x:Name="NoRevModeExtras" Margin="0,0,0,2"/>

            <TextBlock Style="{StaticResource HelpText}" Margin="170,0,0,12" TextWrapping="Wrap"
                       Text="{loc:T TelemetryFfb_WheelLightsBlockColorsComeFromThe}"/>

            <!-- Parked here as a starting home; RefreshAmbientLedRows moves each
                 into the host for the picker that wants it, or leaves it hidden
                 when neither does. Their own Visibility is never touched: an
                 unwanted block simply has no host, and a hidden holder is what
                 that means. -->
            <StackPanel x:Name="AmbientLedBlockHolder" Visibility="Collapsed">
                <Grid x:Name="LedSweepRow" Margin="170,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_LedSweepRowSweepTime}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="LedSweepSlider" Minimum="600" Maximum="6000"
                            SmallChange="100" LargeChange="500" TickFrequency="600" VerticalAlignment="Center"
                            ValueChanged="LedSweep_Changed"
                            ToolTip="{loc:T TelemetryFfb_LedSweep_Tip}"/>
                    <Border Visibility="{Binding Visibility, ElementName=LedSweepText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="LedSweepText" Text="2.5 s" FontSize="11"/></Border>
                </Grid>
                <!-- The bar and the device it is reading travel together: both
                     answer "is the meter working", and splitting them would put
                     the answer under a different picker from the question. -->
                <StackPanel x:Name="AudioLedsBlock">
                    <!-- The bar as the wheel would show it, so the meter can be
                         seen working with nothing plugged in and without staring
                         at the rim. Ten steps rather than a smooth fill: a level
                         set against a continuous bar lights a different number of
                         LEDs than the strip really would. -->
                    <ProgressBar x:Name="AmbientLedPreviewBar" Margin="260,0,52,4" Height="10"
                                 Minimum="0" Maximum="10" Foreground="#4CAF50"/>
                    <TextBlock x:Name="AudioLedsStatusText" Style="{StaticResource HelpText}"
                               Margin="170,0,0,4" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
            </StackPanel><!-- /WheelLightsBlock: the screen is a separate movable
                 unit below, so the LIGHTSYNC tab can put the lights at the top
                 and the screen underneath the pattern maker. Locked, the two sit
                 back to back in this same parent and render exactly as before. -->

            <!-- Wheel-base Dynamic OLED (HID++ feature 0x8130). Shares the rev
                 lights' HID++ pipe, so it shares their Mode B + tap-proven-quiet
                 gate. RefreshFromPlugin hides this whole panel on a wheel with
                 no screen. -->
            <StackPanel x:Name="WheelScreenBlock">
            <StackPanel x:Name="OledSection" Margin="0,4,0,4">
            <CheckBox x:Name="ModeBOledCheck" Content="{loc:T TelemetryFfb_ModeBOled}"
                      Margin="0,0,0,2" Checked="ModeBOled_Changed" Unchecked="ModeBOled_Changed"/>
            <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,6" TextWrapping="Wrap"
                       Text="{loc:T TelemetryFfb_OledSectionPutsYourSpeedGear}"/>
            <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,6" TextWrapping="Wrap"
                       Text="{loc:T TelemetryFfb_OledSectionItAlsoReportsChanges}"/>
            <StackPanel Orientation="Horizontal" Margin="22,0,0,6">
                <TextBlock Text="{loc:T TelemetryFfb_OledSectionShow}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                <!-- Items are filled from OledScreenModel.ScreenOrder so the
                     offered order can differ from the persisted enum values. -->
                <ComboBox x:Name="OledScreenCombo" Width="250" Margin="8,0,0,0"
                          SelectionChanged="OledScreen_Changed"/>
                <CheckBox x:Name="OledMphCheck" Content="{loc:T TelemetryFfb_OledMph}" Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Checked="OledMph_Changed" Unchecked="OledMph_Changed"
                          ToolTip="{loc:T TelemetryFfb_OledMph_Tip}"/>
            </StackPanel>
            <!-- Shown only for "Nothing", where the picker's answer needs
                 explaining: the takeovers below still work, and they are the
                 whole point of choosing it. -->
            <TextBlock x:Name="OledNoScreenText" Visibility="Collapsed"
                       Style="{StaticResource HelpText}" Margin="22,0,0,6" TextWrapping="Wrap"
                       Text="{loc:T TelemetryFfb_OledNoScreen}"/>
            <StackPanel Orientation="Horizontal" Margin="22,0,0,6">
                <CheckBox x:Name="OledShiftFlashCheck" Content="{loc:T TelemetryFfb_OledShiftFlash}"
                          VerticalAlignment="Center"
                          Checked="OledShiftFlash_Changed" Unchecked="OledShiftFlash_Changed"
                          ToolTip="{loc:T TelemetryFfb_OledShiftFlash_Tip}"/>
                <ComboBox x:Name="OledFlashStyleCombo" Width="180" Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding IsChecked, ElementName=OledShiftFlashCheck}"
                          SelectionChanged="OledFlashStyle_Changed"
                          ToolTip="{loc:T TelemetryFfb_OledFlashStyle_Tip}">
                    <ComboBoxItem Content="{loc:T TelemetryFfb_OledFlashStyleBigGearSpeedBeside}"/>
                    <ComboBoxItem Content="{loc:T TelemetryFfb_OledFlashStyleCenteredGearWithA}"/>
                </ComboBox>
                <CheckBox x:Name="OledLapResultCheck" Content="{loc:T TelemetryFfb_OledLapResult}"
                          Margin="18,0,0,0" VerticalAlignment="Center"
                          Checked="OledLapResult_Changed" Unchecked="OledLapResult_Changed"
                          ToolTip="{loc:T TelemetryFfb_OledLapResult_Tip}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="22,0,0,6">
                <CheckBox x:Name="OledGreetingCheck" Content="{loc:T TelemetryFfb_OledGreeting}"
                          VerticalAlignment="Center"
                          Checked="OledGreeting_Changed" Unchecked="OledGreeting_Changed"
                          ToolTip="{loc:T TelemetryFfb_OledGreeting_Tip}"/>
                <TextBox x:Name="OledGreetingBox" Width="150" Margin="8,0,0,0" MaxLength="40"
                         VerticalAlignment="Center" TextChanged="OledGreetingText_Changed"
                         IsEnabled="{Binding IsChecked, ElementName=OledGreetingCheck}"
                         ToolTip="{loc:T TelemetryFfb_OledGreetingText_Tip}"/>
            </StackPanel>

            <!-- The custom screen editor. Only visible for "Build my own"; the
                 wheel's firmware fixes the size and position of every slot, so
                 what you choose is a layout and then one field per slot. -->
            <StackPanel x:Name="OledCustomPanel" Visibility="Collapsed" Margin="22,2,0,8">
                <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,6" TextWrapping="Wrap"
                           Text="{loc:T TelemetryFfb_OledCustomPickALayoutThenWhat}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="{loc:T TelemetryFfb_OledCustomLayout}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="OledLayoutCombo" Width="230" Margin="8,0,0,0"
                              ToolTip="{loc:T TelemetryFfb_OledLayout_Tip}"
                              SelectionChanged="OledLayout_Changed"/>
                </StackPanel>
                <Grid x:Name="OledSlot0Row" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="OledSlot0Label" Text="{loc:T TelemetryFfb_OledSlot0}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <ComboBox   Grid.Column="1" x:Name="OledSlot0Combo" Width="140" SelectionChanged="OledSlot_Changed"/>
                    <Border Visibility="{Binding Visibility, ElementName=OledSlot0Text}" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="OledSlot0Text" Visibility="Collapsed" TextChanged="OledSlotText_Changed"/></Border>
                </Grid>
                <Grid x:Name="OledSlot1Row" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="OledSlot1Label" Text="{loc:T TelemetryFfb_OledSlot1}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <ComboBox   Grid.Column="1" x:Name="OledSlot1Combo" Width="140" SelectionChanged="OledSlot_Changed"/>
                    <Border Visibility="{Binding Visibility, ElementName=OledSlot1Text}" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="OledSlot1Text" Visibility="Collapsed" TextChanged="OledSlotText_Changed"/></Border>
                </Grid>
                <Grid x:Name="OledSlot2Row" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="OledSlot2Label" Text="{loc:T TelemetryFfb_OledSlot2}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <ComboBox   Grid.Column="1" x:Name="OledSlot2Combo" Width="140" SelectionChanged="OledSlot_Changed"/>
                    <Border Visibility="{Binding Visibility, ElementName=OledSlot2Text}" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="OledSlot2Text" Visibility="Collapsed" TextChanged="OledSlotText_Changed"/></Border>
                </Grid>
                <Grid x:Name="OledSlot3Row" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="OledSlot3Label" Text="{loc:T TelemetryFfb_OledSlot3}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <ComboBox   Grid.Column="1" x:Name="OledSlot3Combo" Width="140" SelectionChanged="OledSlot_Changed"/>
                    <Border Visibility="{Binding Visibility, ElementName=OledSlot3Text}" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="OledSlot3Text" Visibility="Collapsed" TextChanged="OledSlotText_Changed"/></Border>
                </Grid>
            </StackPanel>

            <TextBlock x:Name="OledDeltaUnavailableText" Visibility="Collapsed"
                       Foreground="#FFFFA726" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,8"
                       Text=""/>

            <Grid Margin="22,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_OledSectionScreenStatus}" Style="{StaticResource LabelText}"/>
                <TextBlock Grid.Column="1" x:Name="OledStatusText" Text="{loc:T TelemetryFfb_OledStatus}" FontSize="11"
                           Opacity="0.85" TextWrapping="Wrap"/>
            </Grid>
            </StackPanel> <!-- /OledSection -->
            </StackPanel><!-- /WheelScreenBlock -->
            </StackPanel><!-- ModeBSupportedPanel -->

            <!-- Restore this tab's force tuning to the shipped baseline. Handler
                 confirms first (discards custom tuning with no undo); leaves the
                 per-game enable, each car's learned grip calibration and the
                 wheel-light / screen settings alone.

                 OUTSIDE ModeBSupportedPanel, and last in the tab, on purpose.
                 Bottom of the tab because it acts on everything above it, not
                 just the Telemetry FFB recipe it started as: spike reduction had
                 no route back to its defaults at all. Outside the panel because
                 ApplyLightsyncTabVisibility moves the lights and screen blocks
                 back in with Children.Add, which APPENDS, so anything sharing
                 that panel stops being last the first time LIGHTSYNC is toggled. -->
            <StackPanel Margin="0,20,0,0">
                <Button x:Name="ModeBResetButton" Content="{loc:T TelemetryFfb_ModeBReset}" Padding="10,3"
                        HorizontalAlignment="Left" Click="ModeBReset_Click"
                        ToolTip="{loc:T TelemetryFfb_ModeBReset_Tip}"/>
                <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{loc:T TelemetryFfb_RestoresTheDefaultsFor}"/>
            </StackPanel>

                <!-- Effect test bench. Hidden until the FXTEST access
                     code reveals it: it drives the wheel directly and
                     stops the Trueforce stream to do it, which is not
                     something to leave a hand's width from the normal
                     FFB controls. -->
                <StackPanel x:Name="FxBenchSection" Visibility="Collapsed">
                    <!-- Effect test bench: native (firmware-rendered DirectInput
                         effect, stream in keepalive) vs the plugin's renderer,
                         side by side on the same parameters. Tune, compare,
                         save. Collapsed by default; needs no game. -->
                    <Expander Header="{loc:T TelemetryFfb_FxBenchSectionEffectTestBench_Header}" Margin="0,14,0,0" IsExpanded="False" Loaded="FxBench_Loaded">
                        <StackPanel Margin="8,8,0,0">
                            <TextBlock Style="{StaticResource HelpText}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"
                                Text="{loc:T TelemetryFfb_FxBenchSectionPlayAnEffectThrough}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{loc:T TelemetryFfb_FxBenchSectionEffect}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="FxTestEffectBox" Width="110" Margin="8,0,0,0" SelectedIndex="0" VerticalAlignment="Center"
                                          SelectionChanged="FxTestEffect_Changed"
                                          ToolTip="{loc:T TelemetryFfb_FxTestEffect_Tip}">
                                    <ComboBoxItem Content="DAMPER" Tag="DAMPER"/>
                                    <ComboBoxItem Content="SPRING" Tag="SPRING"/>
                                    <ComboBoxItem Content="FRICTION" Tag="FRICTION"/>
                                    <ComboBoxItem Content="INERTIA" Tag="INERTIA"/>
                                    <ComboBoxItem Content="SINE" Tag="SINE"/>
                                    <ComboBoxItem Content="SQUARE" Tag="SQUARE"/>
                                    <ComboBoxItem Content="TRIANGLE" Tag="TRIANGLE"/>
                                    <ComboBoxItem Content="SAWUP" Tag="SAWUP"/>
                                    <ComboBoxItem Content="SAWDOWN" Tag="SAWDOWN"/>
                                    <ComboBoxItem Content="RAMP" Tag="RAMP"/>
                                </ComboBox>
                                <TextBlock Text="{loc:T TelemetryFfb_FxBenchSectionStrength}" Style="{StaticResource LabelText}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                <Slider x:Name="FxTestStrengthSlider" Width="110" Minimum="0" Maximum="100" Value="50"
                                        Margin="8,0,0,0" VerticalAlignment="Center" ValueChanged="FxTestParam_Changed"/>
                                <Border Visibility="{Binding Visibility, ElementName=FxTestStrengthText}" Width="40" Margin="6,0,0,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="FxTestStrengthText" Text="50%" FontSize="11"/></Border>
                                <TextBlock Text="{loc:T TelemetryFfb_FxBenchSectionPeriod}" Style="{StaticResource LabelText}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                <Slider x:Name="FxTestPeriodSlider" Width="90" Minimum="50" Maximum="1000" Value="250"
                                        Margin="8,0,0,0" VerticalAlignment="Center" ValueChanged="FxTestParam_Changed"/>
                                <Border Visibility="{Binding Visibility, ElementName=FxTestPeriodText}" Width="52" Margin="6,0,0,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="FxTestPeriodText" Text="250 ms" FontSize="11"/></Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                <Button x:Name="FxTestNativeButton" Content="{loc:T TelemetryFfb_FxTestNative}" MinWidth="100" Height="24" Click="FxTestNative_Click"
                                        ToolTip="{loc:T TelemetryFfb_FxTestNative_Tip}"/>
                                <Button x:Name="FxTestEngineButton" Content="{loc:T TelemetryFfb_FxTestEngine}" MinWidth="100" Height="24" Margin="8,0,0,0" Click="FxTestEngine_Click"
                                        ToolTip="{loc:T TelemetryFfb_FxTestEngine_Tip}"/>
                                <Button x:Name="FxTestStopButton" Content="{loc:T TelemetryFfb_FxTestStop}" Width="70" Height="24" Margin="8,0,0,0" Click="FxTestStop_Click"/>
                                <Button x:Name="FxTraceButton" Content="{loc:T TelemetryFfb_FxTrace}" Width="100" Height="24" Margin="16,0,0,0" Click="FxTrace_Click"
                                        ToolTip="{loc:T TelemetryFfb_FxTrace_Tip}"/>
                                <TextBlock x:Name="FxTestStatus" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                                <TextBlock x:Name="FxTuneGainCaption" Text="{loc:T TelemetryFfb_FxTuneGainCaption}" MinWidth="94"
                                           Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <Slider x:Name="FxTuneGainSlider" Width="130" Minimum="0" Maximum="5" Value="0.25"
                                        Margin="8,0,0,0" VerticalAlignment="Center" ValueChanged="FxTuneGain_Changed"
                                        ToolTip="{loc:T TelemetryFfb_FxTuneGain_Tip}"/>
                                <Border Visibility="{Binding Visibility, ElementName=FxTuneGainText}" Width="44" Margin="6,0,0,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="FxTuneGainText" Text="0.25" FontSize="11"/></Border>
                                <Button x:Name="FxTuneResetKindButton" Content="{loc:T Common_Reset}" MinWidth="60" Height="22" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Click="FxTuneResetKind_Click"
                                        ToolTip="{loc:T TelemetryFfb_FxTuneResetKind_Tip}"/>
                                <CheckBox x:Name="FxTuneInertiaCoastsCheck" Content="{loc:T TelemetryFfb_FxTuneInertiaCoasts}" Margin="14,0,0,0" VerticalAlignment="Center"
                                          Checked="FxTuneInertiaCoasts_Changed" Unchecked="FxTuneInertiaCoasts_Changed"
                                          ToolTip="{loc:T TelemetryFfb_FxTuneInertiaCoasts_Tip}"/>
                                <CheckBox x:Name="FxTuneInertiaAsDampingCheck" Content="{loc:T TelemetryFfb_FxTuneInertiaAsDamping}" Margin="14,0,0,0" VerticalAlignment="Center"
                                          Checked="FxTuneInertiaAsDamping_Changed" Unchecked="FxTuneInertiaAsDamping_Changed"
                                          ToolTip="{loc:T TelemetryFfb_FxTuneInertiaAsDamping_Tip}"/>
                                <CheckBox x:Name="FxTuneSignCheck" Content="{loc:T TelemetryFfb_FxTuneSign}" Margin="16,0,0,0" VerticalAlignment="Center"
                                          Checked="FxTuneSign_Changed" Unchecked="FxTuneSign_Changed"
                                          ToolTip="{loc:T TelemetryFfb_FxTuneSign_Tip}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                <TextBlock Text="{loc:T TelemetryFfb_FxBenchSectionConditionFilter}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <Slider x:Name="FxTuneLpfSlider" Width="130" Minimum="0" Maximum="500" Value="200"
                                        Margin="8,0,0,0" VerticalAlignment="Center" ValueChanged="FxTuneLpf_Changed"
                                        ToolTip="{loc:T TelemetryFfb_FxTuneLpf_Tip}"/>
                                <Border Visibility="{Binding Visibility, ElementName=FxTuneLpfText}" Width="52" Margin="6,0,0,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="FxTuneLpfText" Text="200 Hz" FontSize="11"/></Border>
                                <CheckBox x:Name="FxAutoTuneRepeatCheck" Content="x5" Margin="16,0,0,0" VerticalAlignment="Center"
                                          ToolTip="{loc:T TelemetryFfb_FxAutoTuneRepeat_Tip}"/>
                                <Button x:Name="FxAutoTuneButton" Content="{loc:T TelemetryFfb_FxAutoTune}" Width="100" Height="24" Margin="8,0,0,0" Click="FxAutoTune_Click"
                                        ToolTip="{loc:T TelemetryFfb_FxAutoTune_Tip}"/>
                                <Button x:Name="FxTuneSaveButton" Content="{loc:T TelemetryFfb_FxTuneSave}" MinWidth="100" Height="24" Margin="8,0,0,0" Click="FxTuneSave_Click"
                                        ToolTip="{loc:T TelemetryFfb_FxTuneSave_Tip}"/>
                                <Button x:Name="FxTuneResetAllButton" Content="{loc:T TelemetryFfb_FxTuneResetAll}" MinWidth="80" Height="24" Margin="8,0,0,0" Click="FxTuneResetAll_Click"
                                        ToolTip="{loc:T TelemetryFfb_FxTuneResetAll_Tip}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </sh:SHTabItem>

            <!-- ============================ LIGHTSYNC ============================ -->
            <!-- Lighting is device-scoped (not per-game, not per-preset), so every
                 LED control belongs on one surface instead of being spread across
                 tabs. Sits directly after the FFB tab because that is where these
                 controls used to live: the two are the wheel's own hardware, and
                 separating them by five unrelated tabs made the move read as a
                 demotion.
                 Two call sites set MainTabs.SelectedIndex = 0 to mean "Effects",
                 so a tab may sit anywhere EXCEPT ahead of Effects.
                 This tab owns no controls of its own. On unlock the code-behind
                 moves the live WheelLightsBlock into LightsyncTabHost, so the tab is
                 empty in the XAML by design. -->
            <sh:SHTabItem x:Name="LightsyncTab" Header="{loc:T Lightsync_LightsyncTab_Header}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12,14,14">
                        <!-- One-time hint about the cycle binding. The library's whole
                             promise is more patterns than the wheel's five slots, and
                             the only way to STEP through them while driving is a bound
                             button. Rather than send anyone to the Controls tab to hunt
                             for a row called "Rev pattern next", SimHub's own binder
                             widget is embedded right here.

                             Self-suppressing on two counts: it hides once the action is
                             bound (checked through ControlsEditorModel, so the person
                             who already sorted it never sees a nag) and once dismissed.
                             Zero permanent clutter, which matters on a tab that is being
                             actively slimmed down. -->
                        <Border x:Name="LightsyncCycleHint" Visibility="Collapsed"
                                Background="#1FFFFFFF" CornerRadius="4" Padding="10,8,10,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                               Text="{loc:T Lightsync_LightsyncCycleYourWheelHoldsFive}"/>
                                    <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,8" TextWrapping="Wrap"
                                               Text="{loc:T Lightsync_LightsyncCycleTheExtrasAreSwapped}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:T Lightsync_LightsyncCycleNextPattern}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                        <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.RevLightPatternNext"
                                                             FriendlyName="{loc:T Controls_ControlsTabHostTf4allRevLightPatternNext_FriendlyName}"/>
                                    </Grid>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="LightsyncCycleHintDismiss"
                                        Content="✕" Width="22" Height="22" Margin="10,0,0,0"
                                        VerticalAlignment="Top"
                                        Click="LightsyncCycleHintDismiss_Click"
                                        Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                        Cursor="Hand" ToolTip="{loc:T Lightsync_LightsyncCycleHintDismiss_Tip}"/>
                            </Grid>
                        </Border>

                        <!-- Rev lights first: the on/off switch and the wheel's own
                             pattern selector are what someone opens this tab for. -->
                        <StackPanel x:Name="LightsyncTabHost"/>

                        <!-- Community per-car data. Fetching it DOES ride
                             CommunityEnabled, because it is a networked community
                             data source like any other; this switch governs only
                             whether it reaches the light strip. The redlines and
                             blink rate that come with it work on every wheel and
                             need no switch here, which is what keeps them reachable
                             on a wheel that never sees this tab. Sits up here with
                             the on/off switch because it is the other thing that
                             changes what the lights DO without anyone authoring
                             anything. Attribution is a licence condition, not
                             decoration: do not remove the credit. -->
                        <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,20,0,10">
                            <TextBlock Text="{loc:T Lightsync_LightPatternsFromCar}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <!-- Sits with the other per-car lighting behaviour rather than
                             beside the pattern list, because it is about what happens
                             when you PICK a pattern, not about the library itself. -->
                        <CheckBox x:Name="AlwaysRememberPatternCheck" Content="{loc:T Lightsync_AlwaysRememberPattern}"
                                  Margin="0,0,0,2" Checked="AlwaysRememberPattern_Changed" Unchecked="AlwaysRememberPattern_Changed"
                                  ToolTip="{loc:T Lightsync_AlwaysRememberPattern_Tip}"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,10" TextWrapping="Wrap"
                                   Text="{loc:T Lightsync_PickAPatternWhile}"/>
                        <CheckBox x:Name="LovelyCarDataCheck" Content="{loc:T Lightsync_LovelyCarData}"
                                  Margin="0,0,0,2" Checked="LovelyCarData_Changed" Unchecked="LovelyCarData_Changed"
                                  ToolTip="{loc:T Lightsync_LovelyCarData_Tip}"/>
                        <!-- Shown only when community features are off, because the
                             box above is then dead and nothing else on this tab
                             would tell the user why. The DATA half of this dataset
                             (redlines, blink rate) rides community features on its
                             own and needs no box, which is what makes it reachable
                             on a wheel that never sees this tab. -->
                        <TextBlock x:Name="LovelyNeedsCommunityNote" Style="{StaticResource HelpText}"
                                   Margin="22,0,0,6" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="{loc:T Lightsync_LovelyNeedsCommunityNote}"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,6" TextWrapping="Wrap"
                                   Text="{loc:T Lightsync_GivesYourWheelThe}"/>
                        <!-- The credit stays here and stays visible: the licence
                             requires it, so it is a condition of using the data
                             rather than decoration. What moved into the guide is
                             the DISCLOSURE around it, which was three more lines
                             drawing the line between what the dataset supplies
                             (patterns, per-gear redlines, blink rate) and what
                             comes from our own community car facts (names,
                             engine data, the redline consensus). Precise, worth
                             saying, and far too much text under one checkbox. -->
                        <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,10" TextWrapping="Wrap">
                            <Run Text="{loc:T Lightsync_LightPatternsPerCar}"/><Hyperlink Click="LovelyCredit_Click"
                                    ToolTip="{loc:T Lightsync_OpensTheLovelyCar_Tip}">Lovely Sim Racing</Hyperlink><Run Text=", CC BY-NC-SA 4.0. "/><Hyperlink
                                    Click="LovelyGuide_Click"
                                    ToolTip="{loc:T Lightsync_WhatTheDatasetCovers_Tip}"><Run Text="{loc:T Lightsync_WhatThisCovers}"/></Hyperlink>
                        </TextBlock>


                        <!-- Pattern maker. The wheel holds five slots; the library
                             holds as many patterns as the user likes and we swap
                             one slot's contents, so that slot behaves like a
                             folder. The ten rectangles ARE the strip, left to
                             right, and index 0 is the leftmost LED (confirmed on
                             hardware), so what the user sees here is what lights
                             there with no mental flip. -->
                        <Expander x:Name="PatternMakerExpander" IsExpanded="False" Margin="0,16,0,4">
                            <Expander.Header>
                                <TextBlock Text="{loc:T Lightsync_PatternMakerPatternEditor}" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"/>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,10" TextWrapping="Wrap"
                                   Text="{loc:T Lightsync_PatternMakerMakeYourOwnWheel}"/>

                        <!-- No slot picker on purpose. Which of the five slots gets
                             borrowed is plumbing: the plugin takes the first slot
                             that has never been programmed (the last one when all
                             five are in use), saves what was in it, and hands it
                             back on exit. The list below marks the one in use, so
                             it stays visible without being a decision.
                             SLOTPICK<n> in the access box pins one for anyone who
                             wants to. -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Library: order here is cycle order. -->
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="{loc:T Lightsync_PatternMakerYourPatterns}" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                <ListBox x:Name="PatternList" Height="300" SelectionChanged="PatternList_SelectionChanged"
                                         HorizontalContentAlignment="Stretch"
                                         MouseDoubleClick="PatternList_MouseDoubleClick"
                                         ToolTip="{loc:T Lightsync_PatternList_Tip}"/>
                                <TextBlock Style="{StaticResource HelpText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="{loc:T Lightsync_PatternMakerTheBlueBracketMarks}"/>
                                <UniformGrid Columns="3" Margin="0,6,0,0">
                                    <Button x:Name="PatternUpBtn" Content="{loc:T Lightsync_PatternUp}" Margin="0,0,3,3" Padding="0,3" Click="PatternMove_Click" Tag="-1"/>
                                    <Button x:Name="PatternDownBtn" Content="{loc:T Lightsync_PatternDown}" Margin="0,0,3,3" Padding="0,3" Click="PatternMove_Click" Tag="1"/>
                                    <Button x:Name="PatternNewBtn" Content="{loc:T Lightsync_PatternNew}" Margin="0,0,0,3" Padding="0,3" Click="PatternNew_Click"/>
                                    <Button x:Name="PatternCopyBtn" Content="{loc:T Lightsync_PatternCopy}" Margin="0,0,3,0" Padding="0,3" Click="PatternCopy_Click"
                                            ToolTip="{loc:T Lightsync_PatternCopy_Tip}"/>
                                    <Button x:Name="PatternResetBtn" Content="{loc:T Common_Reset}" Margin="0,0,3,0" Padding="0,3" Click="PatternReset_Click"
                                            ToolTip="{loc:T Lightsync_PatternReset_Tip}"/>
                                    <!-- Red because it is the one action here that
                                         destroys something and cannot be undone. -->
                                    <Button x:Name="PatternDeleteBtn" Content="{loc:T Common_Delete}" Padding="0,3" Click="PatternDelete_Click"
                                            Background="#FF8B2E2E" Foreground="White"/>
                                </UniformGrid>

                                <TextBlock Style="{StaticResource HelpText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="{loc:T Lightsync_PatternMakerUpAndDownDecideWhere}"/>
                            </StackPanel>

                            <!-- Editor -->
                            <StackPanel Grid.Column="1">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:T Lightsync_PatternMakerName}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="PatternNameBox" MaxLength="40" VerticalAlignment="Center" Margin="0,0,12,0"
                                             LostFocus="PatternName_Committed" KeyDown="PatternName_KeyDown"/>
                                    <TextBlock Grid.Column="2" Text="{loc:T Lightsync_PatternMakerFills}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="3" x:Name="PatternDirectionCombo" VerticalAlignment="Center"
                                              SelectionChanged="PatternDirection_Changed"
                                              ToolTip="{loc:T Lightsync_PatternDirection_Tip}"/>
                                </Grid>

                                <CheckBox x:Name="PatternApplyTrimBox" Margin="0,0,0,6"
                                          Content="{loc:T Lightsync_PatternApplyTrim}"
                                          Checked="PatternApplyTrim_Changed" Unchecked="PatternApplyTrim_Changed"
                                          ToolTip="{loc:T Lightsync_PatternApplyTrim_Tip}"/>

                                <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,5"
                                           Text="{loc:T Lightsync_PatternMakerClickAnLedToSelect}"/>
                                <ItemsControl x:Name="PatternLedStrip" Margin="0,0,0,12">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <!-- Color picker: current color, sliders for any
                                     value, swatches for the common ones. -->
                                <Border BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="PatternSelectedLedText" Text="{loc:T Lightsync_PatternSelectedLed}" FontSize="11"
                                                       Opacity="0.8" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <Border x:Name="PatternCurrentSwatch" Width="74" Height="74" CornerRadius="4"
                                                    BorderThickness="1" BorderBrush="#60FFFFFF" Background="Black"/>
                                            <TextBox x:Name="PatternHexBox" Width="74" MaxLength="7" Margin="0,6,0,0"
                                                     HorizontalContentAlignment="Center"
                                                     LostFocus="PatternHex_Committed" KeyDown="PatternHex_KeyDown"
                                                     ToolTip="{loc:T Lightsync_PatternHex_Tip}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{loc:T Lightsync_PatternChannelRed}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="PatternRSlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                                                        VerticalAlignment="Center" ValueChanged="PatternRgbSlider_Changed"/>
                                                <Border Visibility="{Binding Visibility, ElementName=PatternRText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="PatternRText" Text="0" FontSize="11"/></Border>
                                            </Grid>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{loc:T Lightsync_PatternChannelGreen}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="PatternGSlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                                                        VerticalAlignment="Center" ValueChanged="PatternRgbSlider_Changed"/>
                                                <Border Visibility="{Binding Visibility, ElementName=PatternGText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="PatternGText" Text="0" FontSize="11"/></Border>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{loc:T Lightsync_PatternChannelBlue}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" x:Name="PatternBSlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                                                        VerticalAlignment="Center" ValueChanged="PatternRgbSlider_Changed"/>
                                                <Border Visibility="{Binding Visibility, ElementName=PatternBText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="PatternBText" Text="0" FontSize="11"/></Border>
                                            </Grid>

                                            <ItemsControl x:Name="PatternPalette">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="PatternPreviewBtn" Content="{loc:T Lightsync_PatternPreview}" Padding="14,5" Click="PatternPreview_Click"
                                            ToolTip="{loc:T Lightsync_PatternPreview_Tip}"/>
                                    <Button x:Name="PatternFillAllBtn" Content="{loc:T Lightsync_PatternFillAll}" Margin="8,0,0,0" Padding="10,5"
                                            Click="PatternFillAll_Click" ToolTip="{loc:T Lightsync_PatternFillAll_Tip}"/>
                                    <Button x:Name="PatternMirrorBtn" Content="{loc:T Lightsync_PatternMirror}" Margin="6,0,0,0" Padding="10,5"
                                            Click="PatternMirror_Click" ToolTip="{loc:T Lightsync_PatternMirror_Tip}"/>
                                    <Button x:Name="PatternReverseBtn" Content="{loc:T Lightsync_PatternReverse}" Margin="6,0,0,0" Padding="10,5"
                                            Click="PatternReverse_Click" ToolTip="{loc:T Lightsync_PatternReverse_Tip}"/>
                                </StackPanel>
                                <TextBlock x:Name="PatternStatusText" FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>

                            </StackPanel>
                        </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Color trim. Patterns store what a color means
                                     on a screen; these three say how far each channel
                                     has to come down for THIS wheel's LEDs to render
                                     that meaning. Red is the weak die on the wheels
                                     we have measured, so it stays at 100 and the
                                     other two come down to meet it. -->
                        <Expander x:Name="LedTrimExpander" IsExpanded="False" Margin="0,10,0,0">
                            <Expander.Header>
                                <TextBlock Text="{loc:T Lightsync_LedTrimColorTrim}" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"/>
                            </Expander.Header>
                            <StackPanel x:Name="LedTrimPanel" Margin="0,8,0,0">
                                    <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,6"
                                               Text="{loc:T Lightsync_LedTrimYourWheelSLEDsAre}"/>
                                    <!-- The invariant, stated because the sliders do
                                         not behave the way three independent
                                         brightness controls would: only the RATIO
                                         between them survives, so the highest slider
                                         is the reference and the other two are cut
                                         relative to it. Someone who drags one down
                                         part way is weakening the correction, not
                                         dimming that channel, and levelling all
                                         three switches it off entirely. -->
                                    <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Text="{loc:T Lightsync_LedTrimOnlyTheGapBetween}"/>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:T Lightsync_LedTrimRed}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="LedTrimRSlider" Minimum="10" Maximum="100"
                                                SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                                                ValueChanged="LedTrim_Changed"
                                                ToolTip="{loc:T Lightsync_LedTrimR_Tip}"/>
                                        <Border Visibility="{Binding Visibility, ElementName=LedTrimRText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="LedTrimRText" Text="100%" FontSize="11"/></Border>
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:T Lightsync_LedTrimGreen}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="LedTrimGSlider" Minimum="10" Maximum="100"
                                                SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                                                ValueChanged="LedTrim_Changed"
                                                ToolTip="{loc:T Lightsync_LedTrimG_Tip}"/>
                                        <Border Visibility="{Binding Visibility, ElementName=LedTrimGText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="LedTrimGText" Text="100%" FontSize="11"/></Border>
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:T Lightsync_LedTrimBlue}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="LedTrimBSlider" Minimum="10" Maximum="100"
                                                SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                                                ValueChanged="LedTrim_Changed"
                                                ToolTip="{loc:T Lightsync_LedTrimB_Tip}"/>
                                        <Border Visibility="{Binding Visibility, ElementName=LedTrimBText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="LedTrimBText" Text="100%" FontSize="11"/></Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="LedTrimYellowBtn" Content="{loc:T Lightsync_LedTrimYellow}" Padding="10,5"
                                                Click="LedTrimYellow_Click"
                                                ToolTip="{loc:T Lightsync_LedTrimYellow_Tip}"/>
                                        <Button x:Name="LedTrimWhiteBtn" Content="{loc:T Lightsync_LedTrimWhite}" Margin="6,0,0,0" Padding="10,5"
                                                Click="LedTrimWhite_Click"
                                                ToolTip="{loc:T Lightsync_LedTrimWhite_Tip}"/>
                                        <Button x:Name="LedTrimResetBtn" Content="{loc:T Common_Reset}" Margin="6,0,0,0" Padding="10,5"
                                                Click="LedTrimReset_Click"
                                                ToolTip="{loc:T Lightsync_LedTrimReset_Tip}"/>
                                    </StackPanel>
                                </StackPanel>
                        </Expander>

                        <!-- The wheel's screen. Collapsed by default: it is a
                             different job from lighting, and someone sets it
                             once. It stays on this tab rather than getting its
                             own because the "needs Telemetry Based FFB" warning
                             above covers the screen too, and that warning should
                             live in one place. -->
                        <Expander x:Name="LightsyncScreenExpander" IsExpanded="False" Margin="0,10,0,0">
                            <Expander.Header>
                                <!-- Logitech's own name for the panel. "Wheel screen"
                                     was descriptive but anonymous; the branded name
                                     is what the wheel's box and G HUB call it. -->
                                <TextBlock Text="{loc:T Lightsync_LightsyncScreenDynamicOled}" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"/>
                            </Expander.Header>
                            <StackPanel x:Name="LightsyncScreenHost" Margin="0,8,0,0"/>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </sh:SHTabItem>
            <!-- ============================ PRESETS ============================ -->
            <!-- The full preset library is hosted inline here (PresetManagerHost),
                 replacing the old Manage Presets pop-up. Populated in code-behind. -->
            <sh:SHTabItem x:Name="PresetsTab" Header="{loc:T Presets_PresetsTab_Header}">
                <Grid x:Name="PresetManagerHost" Margin="14,12,14,14"/>
            </sh:SHTabItem>

            <!-- ============================ CONTROLS ============================ -->
            <sh:SHTabItem x:Name="ControlsTab" Header="{loc:T Controls_ControlsTab_Header}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ControlsTabHost" Margin="14,12,14,14">
                        <Border Style="{StaticResource SectionHeaderBorder}"><TextBlock Text="{loc:T Controls_ControlsTabHostControllerBindings}" Style="{StaticResource SectionHeaderText}"/></Border>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,12" FontSize="12"
                            Text="{loc:T Controls_ControlsTabHostBindWheelOrButton}"/>

                        <!-- How much each press of a bound button moves master gain. -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Controls_ControlsTabHostStepPerPress}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Controls_ControlsTabHostStepPerPress_Tip}"/>
                            <Slider Grid.Column="1" x:Name="MasterGainStepSlider"
                                    Minimum="0.01" Maximum="0.5" SmallChange="0.01" LargeChange="0.05"
                                    TickFrequency="0.05" IsSnapToTickEnabled="False"
                                    ValueChanged="MasterGainStepSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=MasterGainStepText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="MasterGainStepText" Text="0.05"/></Border>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Controls_ControlsTabHostMasterGainUp}" Style="{StaticResource LabelText}"/>
                            <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.MasterGainUp"
                                                 FriendlyName="{loc:T Controls_ControlsTabHostTf4allMasterGainUp_FriendlyName}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Controls_ControlsTabHostMasterGainDown}" Style="{StaticResource LabelText}"/>
                            <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.MasterGainDown"
                                                 FriendlyName="{loc:T Controls_ControlsTabHostTf4allMasterGainDown_FriendlyName}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Controls_ControlsTabHostTelemetryFfbUp}" Style="{StaticResource LabelText}"/>
                            <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.ModeBStrengthUp"
                                                 FriendlyName="{loc:T Controls_ControlsTabHostTf4allTelemetryFfbStrengthUp_FriendlyName}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Controls_ControlsTabHostTelemetryFfbDown}" Style="{StaticResource LabelText}"/>
                            <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.ModeBStrengthDown"
                                                 FriendlyName="{loc:T Controls_ControlsTabHostTf4allTelemetryFfbStrengthDown_FriendlyName}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Controls_ControlsTabHostWheelOledNext}" Style="{StaticResource LabelText}"/>
                            <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.OledScreenNext"
                                                 FriendlyName="{loc:T Controls_ControlsTabHostTf4allWheelOledNext_FriendlyName}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Controls_ControlsTabHostWheelOledBack}" Style="{StaticResource LabelText}"/>
                            <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.OledScreenPrev"
                                                 FriendlyName="{loc:T Controls_ControlsTabHostTf4allWheelOledBack_FriendlyName}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Controls_ControlsTabHostRevPatternNext}" Style="{StaticResource LabelText}"/>
                            <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.RevLightPatternNext"
                                                 FriendlyName="{loc:T Controls_ControlsTabHostTf4allRevLightPatternNext_FriendlyName}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Controls_ControlsTabHostRevPatternBack}" Style="{StaticResource LabelText}"/>
                            <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.RevLightPatternPrev"
                                                 FriendlyName="{loc:T Controls_ControlsTabHostTf4allRevLightPatternBack_FriendlyName}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Controls_ControlsTabHostDashTabNext}" Style="{StaticResource LabelText}"/>
                            <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.DashTabNext"
                                                 FriendlyName="{loc:T Controls_ControlsTabHostTf4allDashTabNext_FriendlyName}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Controls_ControlsTabHostDashTabBack}" Style="{StaticResource LabelText}"/>
                            <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.DashTabPrev"
                                                 FriendlyName="{loc:T Controls_ControlsTabHostTf4allDashTabBack_FriendlyName}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Controls_ControlsTabHostPeakForceUp}" Style="{StaticResource LabelText}"/>
                            <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.IRacingMaxForceUp"
                                                 FriendlyName="{loc:T Controls_ControlsTabHostTf4allMaxForceUp_FriendlyName}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Controls_ControlsTabHostPeakForceDown}" Style="{StaticResource LabelText}"/>
                            <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.IRacingMaxForceDown"
                                                 FriendlyName="{loc:T Controls_ControlsTabHostTf4allMaxForceDown_FriendlyName}"/>
                        </Grid>
                        <!-- One press runs the active game's auto force calibration
                             (iRacing and Le Mans Ultimate adopt the learned max force,
                             RaceRoom applies this car's learned strength, Forza and the
                             other Telemetry Based FFB games re-level the auto strength).
                             The mapping shipped in 0.3.0 without this row, so it was
                             only reachable from SimHub's own list. -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Controls_ControlsTabHostAutoForce}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Controls_ControlsTabHostAutoForce_Tip}"/>
                            <shui:ControlsEditor Grid.Column="1" ActionName="TrueforcePlugin.AutoForce"
                                                 FriendlyName="{loc:T Controls_ControlsTabHostTf4allAutoForceCalibrate_FriendlyName}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource HelpText}" Margin="0,8,0,0" FontSize="11"
                            Text="{loc:T Controls_ControlsTabHostTheseActionsAlsoAppear}"/>
                    </StackPanel>
                </ScrollViewer>
            </sh:SHTabItem>

            <!-- ============================ SETTINGS ============================ -->
            <sh:SHTabItem x:Name="SettingsTab" Header="{loc:T Settings_SettingsTab_Header}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12,14,14">

            <!-- Language: what the panel, its dialogs and the wheel notices are
                 drawn in. First in the tab because it changes every other label in
                 it. Automatic is the default and follows SimHub's own language
                 setting, then Windows; the thread culture is never read, since
                 SimHub pins it to en-US for everyone. Choosing a language loads it
                 at once: the store raises its change event, every bound label
                 re-renders and the relabel passes re-run, so nothing restarts. -->
            <Expander x:Name="LanguageExpander" IsExpanded="False" Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="{loc:T Settings_Language}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T Settings_LanguagePanelLanguage}" Style="{StaticResource LabelText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="UiLanguageCombo" Width="240"
                                  SelectionChanged="UiLanguageCombo_SelectionChanged"
                                  ToolTip="{loc:T Settings_UiLanguage_Tip}"/>
                    </StackPanel>
                    <TextBlock x:Name="UiLanguageNote" Style="{StaticResource HelpText}" Margin="0,6,0,0"
                               FontSize="12" TextWrapping="Wrap" Text=""/>
                    <!-- Hidden on an English panel, where the whole feature is inert:
                         no request, no file, no layer. RelabelLanguageSection sets
                         its visibility from the active tag. -->
                    <CheckBox x:Name="UseCommunityTranslationsCheck" Margin="0,10,0,0"
                              Content="{loc:T Settings_UseCommunityTranslations}"
                              ToolTip="{loc:T Settings_UseCommunityTranslations_Tip}"
                              Checked="UseCommunityTranslations_Changed"
                              Unchecked="UseCommunityTranslations_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="TranslateButton" Content="{loc:T Settings_LanguageTranslate}"
                                Click="TranslateButton_Click" Padding="10,4" MinWidth="120"
                                ToolTip="{loc:T Settings_LanguageTranslate_Tip}"/>
                        <Button x:Name="LanguageFolderButton" Content="{loc:T Settings_LanguageOpenFolder}"
                                Click="LanguageFolderButton_Click" Padding="10,4" MinWidth="120" Margin="8,0,0,0"
                                ToolTip="{loc:T Settings_LanguageOpenFolder_Tip}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="{loc:T Settings_LanguageHelp}"/>
                </StackPanel>
            </Expander>

            <!-- Updates: how often the plugin re-checks GitHub for a newer
                 build. A check always runs at startup and on the header's
                 "Check for updates" link regardless of this; the dropdown only
                 sets the background re-check cadence during a running session. -->
            <Expander x:Name="UpdatesExpander" IsExpanded="False" Margin="0,0,0,8"
                      Expanded="UpdatesExpander_Expanded">
                <Expander.Header>
                    <TextBlock Text="{loc:T Settings_Updates}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T Settings_UpdatesCheckForAppUpdates}" Style="{StaticResource LabelText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="UpdateCheckIntervalCombo" Width="160"
                                  SelectionChanged="UpdateCheckIntervalCombo_SelectionChanged"
                                  ToolTip="{loc:T Settings_UpdateCheckInterval_Tip}">
                            <ComboBoxItem Tag="0" Content="{loc:T Settings_UpdateCheckIntervalOnStartupOnly}"/>
                            <ComboBoxItem Tag="1" Content="{loc:T Settings_UpdateCheckIntervalEveryHour}"/>
                            <ComboBoxItem Tag="2" Content="{loc:T Settings_UpdateCheckIntervalEvery2Hours}"/>
                            <ComboBoxItem Tag="6" Content="{loc:T Settings_UpdateCheckIntervalEvery6Hours}"/>
                            <ComboBoxItem Tag="24" Content="{loc:T Settings_UpdateCheckIntervalDaily}"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="{loc:T Settings_UpdatesWhenAnUpdateIsAvailable}"/>

                    <!-- Beta (pre-release) updates, open to everyone. Pre-releases
                         are always public on GitHub; this pulls them through the
                         in-app updater instead of downloading each one by hand. -->
                    <CheckBox x:Name="BetaUpdatesCheck" Content="{loc:T Settings_BetaUpdates}"
                              Margin="0,14,0,0"
                              Checked="BetaUpdates_Changed" Unchecked="BetaUpdates_Changed"
                              ToolTip="{loc:T Settings_BetaUpdates_Tip}"/>
                    <TextBlock x:Name="BetaUpdatesNote" Style="{StaticResource HelpText}" Margin="0,4,0,0"
                               FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Text=""/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Text="{loc:T Settings_UpdatesBetaBuildsGetFixes}"/>
                </StackPanel>
            </Expander>

            <!-- TF4ALL Dash: preferences for the TF4ALL Dash dashboard
                 served to phones/tablets by SimHub's web dash server. -->
            <Expander x:Name="RemoteDashExpander" IsExpanded="False" Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="TF4ALL Dash" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                    <!-- Grouped rather than one flat scroll: this section had grown to
                         six unrelated concerns in a single list. Phone access stays at
                         the top because it is how you first get the dash onto a device,
                         not a preference. Tabs opens by default as the one people come
                         here for; the rest stay shut until wanted. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{loc:T Settings_RemoteDashTheme}" VerticalAlignment="Center" Width="52"/>
                        <ComboBox x:Name="RemoteDashThemeCombo" Width="140"
                                  SelectionChanged="RemoteDashTheme_Changed"
                                  ToolTip="{loc:T Settings_RemoteDashTheme_Tip}"/>
                    </StackPanel>

                    <!-- Phone-access funnel: same handler as the header phone
                    button; the QR dialog itself carries the scan / same
                    network / Add to Home Screen guidance. -->
                    <Button x:Name="DashPhoneSettingsButton" Content="{loc:T Settings_DashPhoneSettings}"
                    Style="{StaticResource PopoverPrimaryButton}"
                    HorizontalAlignment="Left" Height="26"
                    Click="DashPhoneAccess_Click"
                    ToolTip="{loc:T Settings_DashPhoneSettings_Tip}"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                    Text="{loc:T Settings_RemoteDashControlEffectsGainsAnd}"/>

                    <Expander IsExpanded="True" Margin="0,8,0,0">
                        <Expander.Header>
                            <TextBlock Text="{loc:T Settings_RemoteDashTabs}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,4">
                            <TextBlock Text="{loc:T Settings_RemoteDashOpeningTab}" Style="{StaticResource LabelText}" Margin="0,14,0,4"/>
                            <CheckBox x:Name="RemoteDashRememberTabCheck" Content="{loc:T Settings_RemoteDashRememberTab}"
                            Checked="RemoteDashRememberTab_Changed" Unchecked="RemoteDashRememberTab_Changed"
                            ToolTip="{loc:T Settings_RemoteDashRememberTab_Tip}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{loc:T Settings_RemoteDashDefaultTab}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                            <!-- Items are built in code (RebuildRemoteDashTabsEditor):
                            only ENABLED tabs are offered, in the user's order. -->
                            <ComboBox x:Name="RemoteDashDefaultTabCombo" Width="140" Margin="8,0,0,0"
                            SelectionChanged="RemoteDashDefaultTab_Changed"
                            ToolTip="{loc:T Settings_RemoteDashDefaultTab_Tip}"/>
                            </StackPanel>

                            <!-- Tab layout editor: one row per dash tab (enable checkbox
                            + up/down reorder). Rows are built in code
                            (RebuildRemoteDashTabsEditor); the dash re-reads the
                            layout live, so changes apply with no reload. -->
                            <TextBlock Text="{loc:T Settings_RemoteDashTabsList}" Style="{StaticResource LabelText}" Margin="0,14,0,4"/>
                            <StackPanel x:Name="RemoteDashTabsPanel"/>
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                            Text="{loc:T Settings_RemoteDashUntickATabToHide}"/>

                            <!-- Drive tab: which of the four boxes around the gear shows
                            what, plus the one-row / two-row choice. Combo items are
                            filled in code from the plugin's content list so a new
                            box type needs no XAML change. -->
                        </StackPanel>
                    </Expander>
                    <Expander IsExpanded="False" Margin="0,8,0,0">
                        <Expander.Header>
                            <TextBlock Text="{loc:T Settings_RemoteDashDriveTab}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,4">
                            <TextBlock Text="{loc:T Settings_RemoteDashDriveTabBoxes}" Style="{StaticResource LabelText}" Margin="0,16,0,4"/>
                            <RadioButton x:Name="RemoteDashDriveTwoRowsRadio" GroupName="RemoteDashDriveRows"
                            Content="{loc:T Settings_RemoteDashDriveTwoRowsRadio}" Checked="RemoteDashDriveRows_Changed"
                            ToolTip="{loc:T Settings_RemoteDashDriveTwoRowsRadio_Tip}"/>
                            <RadioButton x:Name="RemoteDashDriveOneRowRadio" GroupName="RemoteDashDriveRows"
                            Content="{loc:T Settings_RemoteDashDriveOneRowRadio}" Margin="0,4,0,0" Checked="RemoteDashDriveRows_Changed"
                            ToolTip="{loc:T Settings_RemoteDashDriveOneRowRadio_Tip}"/>
                            <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="RemoteDashDriveSlot0Label" Text="{loc:T Settings_RemoteDashDriveSlot0}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                            <ComboBox   Grid.Row="0" Grid.Column="1" x:Name="RemoteDashDriveSlot0Combo" Margin="0,2" SelectionChanged="RemoteDashDriveSlot_Changed"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="RemoteDashDriveSlot1Label" Text="{loc:T Settings_RemoteDashDriveSlot1}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                            <ComboBox   Grid.Row="1" Grid.Column="1" x:Name="RemoteDashDriveSlot1Combo" Margin="0,2" SelectionChanged="RemoteDashDriveSlot_Changed"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Settings_RemoteDashBottomLeft}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                            <ComboBox   Grid.Row="2" Grid.Column="1" x:Name="RemoteDashDriveSlot2Combo" Margin="0,2" SelectionChanged="RemoteDashDriveSlot_Changed"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:T Settings_RemoteDashBottomRight}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                            <ComboBox   Grid.Row="3" Grid.Column="1" x:Name="RemoteDashDriveSlot3Combo" Margin="0,2" SelectionChanged="RemoteDashDriveSlot_Changed"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                            Text="{loc:T Settings_RemoteDashLapTimesTireAndFuel}"/>

                            <CheckBox x:Name="RemoteDashDrivePerGameCheck" Content="{loc:T Settings_RemoteDashDrivePerGame}" Margin="0,14,0,0"
                            Checked="RemoteDashDrivePerGame_Changed" Unchecked="RemoteDashDrivePerGame_Changed"
                            ToolTip="{loc:T Settings_RemoteDashDrivePerGame_Tip}"/>
                            <TextBlock Style="{StaticResource HelpText}" Margin="20,2,0,0" FontSize="12" TextWrapping="Wrap"
                            Text="{loc:T Settings_RemoteDashWithThisOnAGameYou}"/>

                            <CheckBox x:Name="RemoteDashPedalsCheck" Content="{loc:T Settings_RemoteDashPedals}" Margin="0,14,0,0"
                            Checked="RemoteDashPedals_Changed" Unchecked="RemoteDashPedals_Changed"
                            ToolTip="{loc:T Settings_RemoteDashPedals_Tip}"/>
                            <CheckBox x:Name="RemoteDashRevCenteredCheck" Content="{loc:T Settings_RemoteDashRevCentered}" Margin="0,8,0,0"
                            Checked="RemoteDashRevCentered_Changed" Unchecked="RemoteDashRevCentered_Changed"
                            ToolTip="{loc:T Settings_RemoteDashRevCentered_Tip}"/>
                        </StackPanel>
                    </Expander>
                    <Expander IsExpanded="False" Margin="0,8,0,0">
                        <Expander.Header>
                            <TextBlock Text="{loc:T Settings_RemoteDashRevLights}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,4">
                            <TextBlock Text="{loc:T Settings_RemoteDashRevLightDirection}" Style="{StaticResource LabelText}" Margin="0,14,0,4"/>
                            <RadioButton x:Name="RemoteRevAutoRadio" GroupName="RemoteRevDir" Content="{loc:T Settings_RemoteRevAutoRadio}"
                            Checked="RemoteRevDirection_Changed"
                            ToolTip="{loc:T Settings_RemoteRevAutoRadio_Tip}"/>
                            <RadioButton x:Name="RemoteRevLtrRadio" GroupName="RemoteRevDir" Content="{loc:T Settings_RemoteRevLtrRadio}"
                            Margin="0,4,0,0" Checked="RemoteRevDirection_Changed"
                            ToolTip="{loc:T Settings_RemoteRevLtrRadio_Tip}"/>
                            <RadioButton x:Name="RemoteRevOutsideInRadio" GroupName="RemoteRevDir" Content="{loc:T Settings_RemoteRevOutsideInRadio}"
                            Margin="0,4,0,0" Checked="RemoteRevDirection_Changed"
                            ToolTip="{loc:T Settings_RemoteRevOutsideInRadio_Tip}"/>
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                            Text="{loc:T Settings_RemoteDashAppliesToTheRevLed}"/>
                        </StackPanel>
                    </Expander>
                    <Expander IsExpanded="False" Margin="0,8,0,0">
                        <Expander.Header>
                            <TextBlock Text="{loc:T Settings_RemoteDashAlerts}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,4">
                            <CheckBox x:Name="RemoteDashFlagsCheck" Content="{loc:T Settings_RemoteDashFlags}" Margin="0,14,0,0"
                            Checked="RemoteDashFlags_Changed" Unchecked="RemoteDashFlags_Changed"
                            ToolTip="{loc:T Settings_RemoteDashFlags_Tip}"/>
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                            Text="{loc:T Settings_RemoteDashShowsYellowBlueBlack}"/>

                            <CheckBox x:Name="RemoteDashSpotterCheck" Content="{loc:T Settings_RemoteDashSpotter}" Margin="0,8,0,0"
                            Checked="RemoteDashSpotter_Changed" Unchecked="RemoteDashSpotter_Changed"
                            ToolTip="{loc:T Settings_RemoteDashSpotter_Tip}"/>

                            <CheckBox x:Name="RemoteDashIncidentsCheck" Content="{loc:T Settings_RemoteDashIncidents}" Margin="0,8,0,0"
                            Checked="RemoteDashIncidents_Changed" Unchecked="RemoteDashIncidents_Changed"
                            ToolTip="{loc:T Settings_RemoteDashIncidents_Tip}"/>
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                            Text="{loc:T Settings_RemoteDashShowsThePointsYou}"/>
                        </StackPanel>
                    </Expander>
                    <Expander IsExpanded="False" Margin="0,8,0,0">
                        <Expander.Header>
                            <TextBlock Text="{loc:T Settings_RemoteDashIdleCard}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,4">
                            <TextBlock Text="{loc:T Settings_RemoteDashIdleMode}" FontWeight="SemiBold" Margin="0,18,0,0"/>
                            <CheckBox x:Name="RemoteDashIdleCheck" Content="{loc:T Settings_RemoteDashIdle}" Margin="0,8,0,0"
                            ToolTip="{loc:T Settings_RemoteDashIdle_Tip}"
                            Checked="RemoteDashIdle_Changed" Unchecked="RemoteDashIdle_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{loc:T Settings_RemoteDashParkedFor}" VerticalAlignment="Center" MinWidth="94"/>
                            <TextBox x:Name="RemoteDashIdleDelayBox" Width="60" TextAlignment="Center"
                            LostFocus="RemoteDashIdleDelay_Commit" KeyDown="RemoteDashIdleDelay_KeyDown"
                            ToolTip="{loc:T Settings_RemoteDashIdleDelay_Tip}"/>
                            <TextBlock Text="{loc:T Settings_RemoteDashSeconds}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Text="{loc:T Settings_RemoteDashBackground}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                            <ComboBox x:Name="RemoteDashIdleStyleCombo" Width="120" Margin="8,0,0,0"
                            SelectionChanged="RemoteDashIdleStyle_Changed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{loc:T Settings_RemoteDashDriverName}" VerticalAlignment="Center" MinWidth="94"/>
                            <TextBox x:Name="RemoteDashIdleNameBox" Width="180"
                            LostFocus="RemoteDashIdleName_Commit" KeyDown="RemoteDashIdleName_KeyDown"/>
                            <TextBlock Text="{loc:T Settings_RemoteDashNumber}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                            <TextBox x:Name="RemoteDashIdleNumberBox" Width="70" Margin="8,0,0,0" TextAlignment="Center"
                            LostFocus="RemoteDashIdleNumber_Commit" KeyDown="RemoteDashIdleNumber_KeyDown"/>
                            <TextBlock Text="{loc:T Settings_RemoteDashColor}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                            <ComboBox x:Name="RemoteDashIdleColorCombo" Width="110" Margin="8,0,0,0"
                            SelectionChanged="RemoteDashIdleColor_Changed"/>
                            <TextBlock Text="{loc:T Settings_RemoteDashFont}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                            <ComboBox x:Name="RemoteDashIdleFontCombo" Width="118" Margin="8,0,0,0"
                            SelectionChanged="RemoteDashIdleFont_Changed"
                            ToolTip="{loc:T Settings_RemoteDashIdleFont_Tip}"/>
                            <CheckBox x:Name="RemoteDashIdleNameAboveCheck" Content="{loc:T Settings_RemoteDashIdleNameAbove}" VerticalAlignment="Center" Margin="24,0,0,0"
                            Checked="RemoteDashIdleNameAbove_Changed" Unchecked="RemoteDashIdleNameAbove_Changed"
                            ToolTip="{loc:T Settings_RemoteDashIdleNameAbove_Tip}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Expander>

            <!-- UDP telemetry: Forza UDP setup as its own collapsible, so it
                 reads as a primary setting rather than trailing Diagnostics.
                 Forza is the only UDP-telemetry game, so the body is the Forza
                 config directly. -->
            <Expander x:Name="UdpTelemetryExpander" IsExpanded="False" Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="{loc:T Settings_UdpTelemetry}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">

            <!-- Forza Data Out (UDP). Forza titles emit telemetry over UDP
                 instead of shared memory; the user enables UDP RACE TELEMETRY
                 in the in-game Settings → HUD and Gameplay menu and points it
                 at the IP/port set here. Two real-world gotchas:
                  - MS Store / UWP build: Windows network isolation blocks
                    UDP loopback. User has to run CheckNetIsolation.exe to
                    add a loopback exemption (or send to a LAN IP).
                  - Steam build: FH5 sends to the gateway IP (a long-known
                    bug Playground hasn't fixed). User has to send to their
                    LAN IP, not 127.0.0.1.
                 Forza is the only UDP-telemetry game, so this section is the
                 entire body of the UDP telemetry expander. -->
            <StackPanel x:Name="ForzaSection">
            <!-- The steps are rendered here from Guides\forza-setup.md, which is
                 the same text the "Forza: UDP & Data Out setup" guide shows. They
                 were four hand-written TextBlocks until the guide started carrying
                 the same steps; the copy nobody would remember to update is the one
                 printed beside the controls. Filled by RenderEmbeddedGuideSteps. -->
            <StackPanel x:Name="ForzaStepsHost" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T Settings_ForzaSectionPort}" Style="{StaticResource LabelText}"/>
                <TextBox   Grid.Column="1" x:Name="ForzaPortBox" LostFocus="ForzaPort_LostFocus" KeyDown="ForzaPort_KeyDown" VerticalAlignment="Center"
                           ToolTip="{loc:T Settings_ForzaPort_Tip}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource HelpText}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{loc:T Settings_ForzaSectionTakesEffectImmediately}"/>
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T Settings_ForzaSectionBindAddress}" Style="{StaticResource LabelText}"/>
                <TextBox   Grid.Column="1" x:Name="ForzaBindBox" LostFocus="ForzaBind_LostFocus" KeyDown="ForzaBind_KeyDown" VerticalAlignment="Center"
                           ToolTip="{loc:T Settings_ForzaBind_Tip}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource HelpText}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{loc:T Settings_ForzaSection0000ListenOn}"/>
            </Grid>
            <Grid Margin="0,4,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T Settings_ForzaSectionStatus}" Style="{StaticResource LabelText}"/>
                <TextBlock Grid.Column="1" x:Name="ForzaStatusText" Text="{loc:T Settings_ForzaStatus}" FontSize="11" Opacity="0.85"/>
            </Grid>
            <!-- Auto-discovered alternate port banner. Shown when the
                 plugin scanned candidate ports and found Forza packets on
                 one we're not bound to. One-click switch + dismiss. -->
            <Border x:Name="ForzaDiscoveryBanner" Background="#3300A8FF" BorderBrush="#00A8FF" BorderThickness="1"
                    CornerRadius="3" Padding="8" Margin="0,4,0,8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ForzaDiscoveryText" FontSize="11" TextWrapping="Wrap"
                               VerticalAlignment="Center" MaxWidth="380"
                               Text="{loc:T Settings_ForzaDiscovery}"/>
                    <Button x:Name="ForzaDiscoveryAdoptButton" Content="{loc:T Settings_ForzaDiscoveryAdopt}" Width="80" Height="22" FontSize="11"
                            Style="{StaticResource InfoBannerButton}"
                            Margin="10,0,4,0" Click="ForzaDiscoveryAdopt_Click"/>
                    <Button x:Name="ForzaDiscoveryDismissButton" Content="{loc:T Settings_ForzaDiscoveryDismiss}" Width="80" Height="22" FontSize="11"
                            Style="{StaticResource InfoBannerButton}"
                            Click="ForzaDiscoveryDismiss_Click"/>
                </StackPanel>
            </Border>

            <!-- Coexistence forwarder. Forza only sends to one destination, so
                 if the user wants both Trueforce haptics AND SimHub dashboards,
                 they point Forza at us and we relay raw packet bytes verbatim
                 to SimHub. Default off. Explicit opt-in keeps un-forwarded
                 packets out of the network when the user doesn't run SimHub. -->
            <Border BorderThickness="0,1,0,0" BorderBrush="#22FFFFFF" Margin="0,4,0,8" Padding="0,8,0,0">
                <StackPanel>
                    <CheckBox x:Name="ForzaForwardEnabledCheck" Content="{loc:T Settings_ForzaForwardEnabled}" Click="ForzaForwardEnabled_Changed" Margin="0,0,0,4"
                              FontWeight="SemiBold"
                              ToolTip="{loc:T Settings_ForzaForwardEnabled_Tip}"/>
                    <!-- Intro on its own line; the numbered setup steps render as
                         separate rows below so the option isn't a wall of text. -->
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,6" FontSize="11"
                               Text="{loc:T Settings_ForzaSectionForzaAlreadyPointsAt}"/>
                    <!-- Rendered from Guides\forza-forward.md, the same text the
                         "Forza: UDP & Data Out setup" guide carries under its own
                         steps. Filled by RenderEmbeddedGuideSteps. -->
                    <StackPanel x:Name="ForzaForwardStepsHost" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T Settings_ForzaSectionForwardToHost}" Style="{StaticResource LabelText}"/>
                        <TextBox   Grid.Column="1" x:Name="ForzaForwardHostBox" LostFocus="ForzaForwardHost_LostFocus" KeyDown="ForzaForwardHost_KeyDown" VerticalAlignment="Center"
                                   ToolTip="{loc:T Settings_ForzaForwardHost_Tip}"/>
                        <TextBlock Grid.Column="2" Text="{loc:T Settings_ForzaSectionForwardPort}" Style="{StaticResource LabelText}" Margin="8,0,0,0"/>
                        <TextBox   Grid.Column="3" x:Name="ForzaForwardPortBox" LostFocus="ForzaForwardPort_LostFocus" KeyDown="ForzaForwardPort_KeyDown" VerticalAlignment="Center" Width="120" HorizontalAlignment="Left"
                                   ToolTip="{loc:T Settings_ForzaForwardPort_Tip}"/>
                    </Grid>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T Settings_ForzaSectionForwarded}" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Column="1" x:Name="ForzaForwardStatusText" Text="{loc:T Settings_ForzaForwardStatus}" FontSize="11" Opacity="0.85"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Expander x:Name="ForzaTroubleshootExpander" IsExpanded="False" Margin="0,8,0,16">
                <Expander.Header>
                    <TextBlock Text="{loc:T Settings_ForzaTroubleshootNotReceivingPackets}" FontSize="12"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,4" FontSize="11"
                               Text="{loc:T Settings_ForzaTroubleshootMostSetupsReceiveFine}"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,4" FontSize="11"
                               Text="{loc:T Settings_ForzaTroubleshootConfirmForzaSData}"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,4" FontSize="11"
                               Text="{loc:T Settings_ForzaTroubleshootPortCollisionWithSimHub}"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,4" FontSize="11"
                               Text="{loc:T Settings_ForzaTroubleshootStillNothingOn127}"/>
                    <TextBlock Style="{StaticResource HelpText}" FontSize="11"
                               Text="{loc:T Settings_ForzaTroubleshootFirewallWindowsDefenderMay}"/>
                </StackPanel>
            </Expander>
            </StackPanel> <!-- /ForzaSection -->
                </StackPanel>
            </Expander>

            <!-- Game mods: per-game setup that unlocks extra features, grouped
                 in one always-present expander so it can be found before playing,
                 not only while the game is running. Holds the Farming Simulator
                 telemetry mod and the Assetto Corsa TF4ALL CSP Bridge. The
                 contextual nudges elsewhere (the FS tab banner, the AC on-sight
                 prompt) still fire, but this is the standing home for both. FS
                 rows are built in SettingsControl.Guides.cs from the same folder
                 the install writes to, so what this says is what the game finds. -->
            <!-- Arcade leaderboards. On the Settings tab rather than beside the FFB controls
                 because these are global: one choice for the cabinet, not something a preset
                 carries. The FFB tab's arcade panel is per-cabinet tuning, which these are not. -->
            <Expander x:Name="ArcadeLeaderboardExpander" IsExpanded="False" Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="{loc:T Settings_ArcadeLeaderboardArcadeLeaderboards}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <!-- Initial D 8 only: it is the one cabinet whose boards we know how to
                         fill. The controls stay visible with it not running, because this is a
                         standing preference rather than something to set mid-session. -->
                    <CheckBox x:Name="ArcadeLeaderboardsCheck" Margin="0,0,0,4"
                              Checked="ArcadeLeaderboards_Changed" Unchecked="ArcadeLeaderboards_Changed"
                              Content="{loc:T Settings_ArcadeLeaderboards}"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="{loc:T Settings_ArcadeLeaderboardSegaSServersShut}"/>

                    <StackPanel x:Name="ArcadeLeaderboardOptions">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" VerticalAlignment="Center" Text="{loc:T Settings_ArcadeLeaderboardOptionsOnlineBoardShows}"/>
                            <ComboBox Grid.Column="1" x:Name="ArcadeOnlineSourceCombo" Width="170" VerticalAlignment="Center"
                                      SelectionChanged="ArcadeBoardSource_Changed">
                                <ComboBoxItem Content="{loc:T Settings_ArcadeOnlineSourceAll}" Tag="Merged"/>
                                <ComboBoxItem Content="Trueforce For All" Tag="Community"/>
                                <ComboBoxItem Content="TeknoParrot" Tag="TeknoParrot"/>
                                <ComboBoxItem Content="{loc:T Settings_ArcadeOnlineSourceLocal}" Tag="Local"/>
                            </ComboBox>
                        </Grid>
                        <Grid x:Name="ArcadeShopSourceRow" Margin="0,0,0,6" ToolTipService.ShowOnDisabled="True">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" VerticalAlignment="Center" Text="{loc:T Settings_ArcadeShopSourceRowShopBoardShows}"/>
                            <ComboBox Grid.Column="1" x:Name="ArcadeShopSourceCombo" Width="170" VerticalAlignment="Center"
                                      SelectionChanged="ArcadeBoardSource_Changed">
                                <ComboBoxItem Content="{loc:T Settings_ArcadeShopSourceAll}" Tag="Merged"/>
                                <ComboBoxItem Content="Trueforce For All" Tag="Community"/>
                                <ComboBoxItem Content="TeknoParrot" Tag="TeknoParrot"/>
                                <ComboBoxItem Content="{loc:T Settings_ArcadeShopSourceLocal}" Tag="Local"/>
                                <!-- Shown ONLY while climb mode owns this board, and the box is
                                     greyed whenever it is. It reads Ladder rather than All because
                                     All is what the board is doing and Ladder is why, and why is
                                     the thing a greyed control has to answer. Tagged Merged so that
                                     if it is ever read back it says what the board actually shows.
                                     Collapsed the rest of the time so it is not a second All in
                                     the list. -->
                                <ComboBoxItem x:Name="ArcadeShopSourceLadderItem" Content="{loc:T Settings_ArcadeShopSourceLadderItem}"
                                              Tag="Merged" Visibility="Collapsed"/>
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="{loc:T Settings_ArcadeLeaderboardOptionsTwoBoardsSoTheyCan}"/>

                        <CheckBox x:Name="ArcadeLadderClimbCheck" Margin="0,0,0,4"
                                  Checked="ArcadeLadderClimb_Changed" Unchecked="ArcadeLadderClimb_Changed"
                                  Content="{loc:T Settings_ArcadeLadderClimb}"/>
                        <TextBlock x:Name="ArcadeLadderClimbHelp" Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="{loc:T Settings_ArcadeLadderClimbHelp}"/>

                        <CheckBox x:Name="ArcadeSubmitTimesCheck" Margin="0,0,0,4"
                                  Checked="ArcadeSubmitTimes_Changed" Unchecked="ArcadeSubmitTimes_Changed"
                                  Content="{loc:T Settings_ArcadeSubmitTimes}"/>
                        <TextBlock x:Name="ArcadeSubmitTimesHelp" Style="{StaticResource HelpText}" Margin="0,0,0,4" TextWrapping="Wrap"
                                   Text="{loc:T Settings_ArcadeSubmitTimesHelp}"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander x:Name="FsModExpander" IsExpanded="False" Margin="0,0,0,8"
                      Expanded="FsModExpander_Expanded">
                <Expander.Header>
                    <TextBlock Text="{loc:T Settings_FsModGameMods}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <!-- One card per mod, built in SettingsControl.Guides.cs
                         (RefreshModsList). Uniform: title + version, description,
                         status, Install/Remove. The home for future mods too. -->
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="{loc:T Settings_FsModOptionalPerGameMods}"/>
                    <StackPanel x:Name="FsModTargetsPanel"/>
                    <TextBlock x:Name="FsModTargetsStatus" Style="{StaticResource HelpText}" FontSize="11"
                               Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Expander>

            <!-- No "Advanced" heading: these are ordinary settings, shown as
                 flat peer collapsibles (FFB pass-through, Performance, Sidechain
                 ducking, Diagnostics) below the UDP telemetry section; Backup &
                 sync, Issue reporting and the access-code box follow. The host
                 StackPanel is kept (named) so InitializeComponent wires up every
                 field inside and OpenAdvancedSettings_Click / RefreshFromPlugin
                 can reach them. -->
            <StackPanel x:Name="AdvancedSettingsHost" Margin="0,0,0,0">

                <!-- Advanced force-feedback options: experimental FFB detection
                     and the pause-release wheel handoff. -->
                <Expander x:Name="FfbPassthroughExpander" IsExpanded="False" Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Text="{loc:T Settings_FfbPassthroughForceFeedbackAdvanced}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <!-- Hand the wheel back to the game while paused. When on,
                             the plugin fully leaves Trueforce mode while the game is
                             paused so the wheel reverts to the game's own FFB /
                             auto-center instead of holding a force.
                             Global, not preset-saved. Default OFF since 0.4.0: the
                             pause path handles a pause itself now (the game's constant
                             force zeroed, its spring and damper kept), so this is the
                             escape hatch (owner call 2026-09-14). -->
                        <CheckBox x:Name="StopStreamOnPauseCheck" Content="{loc:T Settings_StopStreamOnPause}"
                                  Margin="0,4,0,2" Checked="StopStreamOnPause_Changed" Unchecked="StopStreamOnPause_Changed"
                                  ToolTip="{loc:T Settings_StopStreamOnPause_Tip}"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,4"
                                   Text="{loc:T Settings_FfbPassthroughIfTheWheelMisbehaves}"/>

                        <!-- The sibling of the above, for the games its test cannot
                             reach: one that keeps its car idling in the background
                             neither raises a pause flag nor stops sending telemetry,
                             so alt-tabbing left a held force walking the wheel to
                             its stop (Wreckfest, owner 2026-08-16). -->
                        <CheckBox x:Name="ReleaseOnFocusLossCheck" Content="{loc:T Settings_ReleaseOnFocusLoss}"
                                  Margin="0,4,0,2" Checked="ReleaseOnFocusLoss_Changed" Unchecked="ReleaseOnFocusLoss_Changed"
                                  ToolTip="{loc:T Settings_ReleaseOnFocusLoss_Tip}"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,4"
                                   Text="{loc:T Settings_FfbPassthroughForceComesBackAs}"/>

                        <!-- Driver testing mode. Hidden by default (Collapsed); revealed
                             only after the DRIVER access code is entered, and kept revealed
                             across restarts via Settings.DriverTestingUnlocked (mirrors the
                             MANUALPIN unlock pattern). Routes FFB through the kernel filter
                             driver; needs the TFFA filter driver installed. -->
                        <CheckBox x:Name="DriverInterceptCheck" Visibility="Collapsed"
                                  Content="{loc:T Settings_DriverIntercept}"
                                  Margin="0,4,0,2" Checked="DriverIntercept_Changed" Unchecked="DriverIntercept_Changed"
                                  ToolTip="{loc:T Settings_DriverIntercept_Tip}"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,4"
                                   x:Name="DriverInterceptHelp" Visibility="Collapsed"
                                   Text="{loc:T Settings_DriverInterceptHelp}"/>
                    </StackPanel>
                </Expander>

                <!-- Performance / latency tuning. Per-machine, NOT preset-saved
                     (a friend's CPU/scheduler is different from yours).
                     Collapsed Expander since most users never need to touch it. -->
                <Expander x:Name="PerformanceExpander" IsExpanded="False" Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Text="{loc:T Settings_Performance}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" FontSize="12"
                            Text="{loc:T Settings_PerformanceSmallerRingBuffersLess}"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Settings_PerformanceMode}" VerticalAlignment="Center" Opacity="0.7"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="PerfAutoRadio"   Content="{loc:T Settings_PerfAutoRadio}" GroupName="PerfMode"
                                             Margin="0,0,16,0" VerticalAlignment="Center"
                                             ToolTip="{loc:T Settings_PerfAutoRadio_Tip}"
                                             Checked="PerfMode_Changed"/>
                                <RadioButton x:Name="PerfManualRadio" Content="{loc:T Settings_PerfManualRadio}" GroupName="PerfMode"
                                             Margin="0,0,16,0" VerticalAlignment="Center"
                                             ToolTip="{loc:T Settings_PerfManualRadio_Tip}"
                                             Checked="PerfMode_Changed"/>
                                <Button x:Name="PerfResetButton" Content="{loc:T Settings_PerfReset}" Padding="10,2" VerticalAlignment="Center"
                                        ToolTip="{loc:T Settings_PerfReset_Tip}"
                                        Click="PerfReset_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Settings_PerformanceOutputRing}" VerticalAlignment="Center" Opacity="0.7"
                                       ToolTip="{loc:T Settings_PerformanceOutputRing_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="PerfTfRingSlider"
                                        Minimum="8" Maximum="64" SmallChange="8" LargeChange="8"
                                        TickFrequency="8" IsSnapToTickEnabled="True"
                                        ValueChanged="PerfTfRingSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=PerfTfRingText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="PerfTfRingText" Text="8 (2ms)"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Settings_PerformanceAudioRing}" VerticalAlignment="Center" Opacity="0.7"
                                       ToolTip="{loc:T Settings_PerformanceAudioRing_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="PerfAudioRingSlider"
                                        Minimum="16" Maximum="128" SmallChange="16" LargeChange="16"
                                        TickFrequency="16" IsSnapToTickEnabled="True"
                                        ValueChanged="PerfAudioRingSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=PerfAudioRingText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="PerfAudioRingText" Text="16 (4ms)"/></Border>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Settings_PerformanceLiveCounters}" VerticalAlignment="Top" Opacity="0.7" Margin="0,2,0,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="PerfCountersText" FontSize="11" Opacity="0.8"
                                           Text="{loc:T Settings_PerfCounters}"/>
                                <TextBlock Style="{StaticResource HelpText}" FontSize="11" Margin="0,2,0,0"
                                           Text="{loc:T Settings_PerformanceCountersTallyEventsIn}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Diagnostics. Wheel / stream / FFB / telemetry status.
                     Useful for troubleshooting; rarely needed otherwise. -->
                <Expander x:Name="DiagnosticsExpander" IsExpanded="False" Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Text="{loc:T Settings_DiagnosticsSupport}" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Settings_DiagnosticsWheel}" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="WheelText" Text="{loc:T Settings_Wheel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Settings_DiagnosticsStream}" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StreamText" Text="{loc:T Settings_Stream}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Settings_DiagnosticsFfbPassThrough}" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="FfbTapText" Text="{loc:T Settings_FfbTap}" VerticalAlignment="Center"/>
                            <!-- Visible only when USBPcap can't be located. Lets users
                                 point at a non-standard install, or reinstall the
                                 driver from the bundled setup without re-running our
                                 installer. Toggled from code-behind on the tick. -->
                            <Button x:Name="UsbPcapBrowseButton" Content="{loc:T Settings_UsbPcapBrowse}"
                                    Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                                    Visibility="Collapsed"
                                    Click="UsbPcapBrowse_Click"
                                    ToolTip="{loc:T Settings_UsbPcapBrowse_Tip}"/>
                            <Button x:Name="UsbPcapReinstallButton" Content="{loc:T Settings_UsbPcapReinstall}"
                                    Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                                    Visibility="Collapsed"
                                    Click="UsbPcapReinstall_Click"
                                    ToolTip="{loc:T Settings_UsbPcapReinstall_Tip}"/>
                            <!-- Shown only when USBPcap is installed but its
                                 capture driver is not attached, and USBPcap's
                                 own uninstaller is on disk. That combination is
                                 the one case Reinstall cannot repair: USBPcap's
                                 setup aborts whenever it finds an existing
                                 install, so the only way forward is a genuine
                                 uninstall first (issue #44). Kept hidden on a
                                 healthy machine so nobody removes a working
                                 capture driver out of curiosity. -->
                            <Button x:Name="UsbPcapUninstallButton" Content="{loc:T Settings_UsbPcapUninstall}"
                                    Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                                    Visibility="Collapsed"
                                    Click="UsbPcapUninstall_Click"
                                    ToolTip="{loc:T Settings_UsbPcapUninstall_Tip}"/>
                            <!-- Hidden by default. Auto-discovery + identity-based
                                 self-heal cover the realistic failure modes for
                                 almost every user; a forgotten manual pin (the
                                 wheel later moved address) was a common source
                                 of false-positive "FFB stopped working" reports.
                                 Power users with a genuine need (multi-wheel
                                 disambiguation, or a USBPcap interface mismatch)
                                 can reveal this with the MANUALPIN access code.
                                 Selection persists across restarts. The
                                 contextual "Pick device manually..." button in
                                 the FfbTapPicker banner stays available, since
                                 it only appears when the tap genuinely can't
                                 find the wheel. -->
                            <Button x:Name="UsbPcapPickDeviceButton" Content="{loc:T Settings_UsbPcapPickDevice}"
                                    Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                                    Visibility="Collapsed"
                                    Click="UsbPcapPickDevice_Click"
                                    ToolTip="{loc:T Settings_UsbPcapPickDevice_Tip}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:T Settings_DiagnosticsTelemetry}" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TelemetrySourceText" Text="{loc:T Settings_TelemetrySource}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:T Settings_DiagnosticsActiveSources}" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="VoicesText" Text="0" Margin="0,4,0,0"/>
                        <!-- Raw USB packet logging. Off by default. When on,
                             every OUT transfer (host → wheel) on every
                             endpoint is captured to usb-trace.pcap alongside
                             SimHub's logs, in real pcap format so Wireshark
                             with USBPcap opens it directly. Export Logs
                             bundles the trace when present. Caps at 50 MB;
                             toggle off + on to reset. Wider than ep0 only so
                             FFB protocols on non-control endpoints are
                             visible too (some Logitech wheels use ep1 OUT). -->
                        <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                  x:Name="LogUsbBytesCheck"
                                  Margin="0,12,0,0"
                                  Content="{loc:T Settings_LogUsbBytes}"
                                  Checked="LogUsbBytes_Changed" Unchecked="LogUsbBytes_Changed"
                                  ToolTip="{loc:T Settings_LogUsbBytes_Tip}"/>

                        <!-- On by default, and it rescues a real failure: a
                             capture that came up with no filter on the wheel
                             sees none of the game's FFB, and cycling the port
                             is the only thing that re-attaches it. It is also
                             the one piece of the plugin that deliberately drops
                             the wheel off the USB bus, so anyone it bothers
                             needs a way to say no without editing JSON. -->
                        <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                  x:Name="AutoReEnumerateCheck"
                                  Margin="0,8,0,0"
                                  Content="Re-enumerate the wheel automatically when FFB capture comes up blind"
                                  Checked="AutoReEnumerate_Changed" Unchecked="AutoReEnumerate_Changed"
                                  ToolTip="On by default. If the FFB capture starts without a filter on your wheel it can see none of the game's force feedback, and the only fix is to cycle the wheel's USB port, which switches the wheel off and back on once. Turn this off if you would rather the plugin never did that; FFB pass-through may then stay dead until you replug the wheel yourself."/>

                        <!-- Self-test: one click that aggregates every health
                             signal into a pass/fail checklist and fires a
                             short buzz so the user can confirm the wheel
                             physically responds. Non-destructive, reads live
                             state; doesn't reopen a healthy device. -->
                        <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                                x:Name="SelfTestButton"
                                Content="{loc:T Settings_SelfTest}"
                                HorizontalAlignment="Left" Margin="0,14,0,0"
                                Padding="10,3" Click="SelfTest_Click"
                                ToolTip="{loc:T Settings_SelfTest_Tip}"/>
                        <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                                   x:Name="SelfTestResultText"
                                   Visibility="Collapsed"
                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                   FontFamily="Consolas" FontSize="12"/>
                        </Grid>
                        <!-- Anonymous usage statistics. Opt-out (default on). The
                             plugin's once-a-day telemetry ping: a random id (not
                             tied to the user or hardware), plugin version, wheel,
                             current game, a scalar settings snapshot, games played,
                             per-game presets, and two language codes (two letters
                             each). Sits with the other "for support" reporting
                             controls. Handler
                             flips Settings.ShareUsageStats + persists; the ping
                             self-gates on it. -->
                        <CheckBox x:Name="ShareUsageStatsCheck"
                                  Content="{loc:T Settings_ShareUsageStats}"
                                  Margin="0,16,0,0"
                                  Checked="ShareUsageStats_Changed" Unchecked="ShareUsageStats_Changed"
                                  ToolTip="{loc:T Settings_ShareUsageStats_Tip}"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="22,2,0,0" FontSize="12" TextWrapping="Wrap">
                            <Run Text="{loc:T Settings_DiagnosticsHelpsDecideWhatTo}"/><Hyperlink Click="PrivacyPolicy_Click" ToolTip="{loc:T Settings_DiagnosticsOpensPrivacyMdOn_Tip}"><Run Text="{loc:T Settings_DiagnosticsPrivacyPolicy}"/></Hyperlink>
                        </TextBlock>
                        <!-- Issue reporting moved to the bottom of this tab,
                             outside any expander: beta users shouldn't have to
                             know which section to open to file a bug.
                             "Show one-time messages again" lives under
                             Widgets & Display: it is about what the panel shows,
                             not a diagnostic. -->
                    </StackPanel>
                </Expander>

            </StackPanel>




            <!-- Widgets & display: optional SimHub home-screen tiles plus in-plugin
                 display preferences. A collapsible since it's an extra surface most
                 users set once. -->
            <Expander x:Name="WidgetsExpander" IsExpanded="False" Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="{loc:T Settings_WidgetsDisplay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                    <CheckBox x:Name="ShowFeedbackBoxCheck" Content="{loc:T Settings_ShowFeedbackBox}"
                              Margin="0,0,0,2" Checked="ShowFeedbackBox_Changed" Unchecked="ShowFeedbackBox_Changed"
                              ToolTip="{loc:T Settings_ShowFeedbackBox_Tip}"/>
                    <CheckBox x:Name="ShowPerGearRedlineEditorCheck" Content="{loc:T Settings_ShowPerGearRedlineEditor}"
                              Margin="0,8,0,2" Checked="ShowPerGearRedlineEditor_Changed" Unchecked="ShowPerGearRedlineEditor_Changed"
                              ToolTip="{loc:T Settings_ShowPerGearRedlineEditor_Tip}"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,4" FontSize="12"
                               Text="{loc:T Settings_WidgetsOffByDefaultToKeep}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="ResetNoticesButton" Content="{loc:T Settings_ResetNotices}" MinWidth="220" Height="26"
                                Click="ResetNotices_Click"
                                ToolTip="{loc:T Settings_ResetNotices_Tip}"/>
                        <TextBlock x:Name="ResetNoticesStatus" Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center" Opacity="0.85"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Account & community moved to its own Account tab (see the AccountTab
                 SHTabItem below). The relocated Expander keeps every x:Name, so the
                 code-behind handlers (AccountExpander_Expanded, RefreshAccountRow, the
                 dev-mode visibility pass, etc.) still resolve unchanged. -->


            <!-- Diagnostics moved into the Advanced Settings modal. See
                 AdvancedSettingsHost near the bottom. -->

            <!-- The standalone "Presets" section was removed: preset handling is
                 now unified in the context card up top (pick + ★ Save all +
                 conditional Set-as-default + Save as new inline with the game
                 preset dropdown; Manage presets… at the bottom of that card). -->

            <!-- Community: online community features (community car facts, preset sharing
                 + auto-update, message of the day). Cloud backup/sync now lives in the
                 Backup & sync expander below, next to local file backup. Collapsed by default. -->
            <Expander x:Name="NetworkExpander" IsExpanded="False" Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="{loc:T Settings_NetworkCommunity}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                    <!-- Networking master toggle (online community features: car-fact
                         fetch/submit, preset sharing, and the Lovely per-car dataset).
                         Does NOT gate account sign-in or cloud backup, which have
                         their own controls. This is the only consent surface for the
                         third-party dataset fetch, so its tooltip has to name it. -->
                    <CheckBox x:Name="CommunityEnabledCheck" Content="{loc:T Settings_CommunityEnabled}"
                              Margin="0,0,0,2" Checked="CommunityEnabled_Changed" Unchecked="CommunityEnabled_Changed"
                              ToolTip="{loc:T Settings_CommunityEnabled_Tip}"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,4" FontSize="12" TextWrapping="Wrap">
                        <Run Text="{loc:T Settings_NetworkSignInIsOnlyNeeded}"/><Hyperlink Click="PrivacyPolicy_Click" ToolTip="{loc:T Settings_NetworkOpensPrivacyMdOn_Tip}"><Run Text="{loc:T Settings_NetworkPrivacyPolicy}"/></Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="22,0,0,12" FontSize="12" TextWrapping="Wrap" Foreground="#E5C04A"
                               Text="{loc:T Settings_NetworkPreReleaseTheCommunity}"/>
                    <!-- ===== Community car facts: apply (read) + auto-submit (write) ===== -->
                    <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,4,0,8">
                        <TextBlock Text="{loc:T Settings_NetworkCommunityCarFacts}" Style="{StaticResource SectionHeaderText}"/>
                    </Border>
                    <!-- Apply community car facts (cache-first; works offline). Separate
                         from the networking master so cached data keeps applying with
                         networking off. -->
                    <CheckBox x:Name="UseCommunityCarFactsCheck" Content="{loc:T Settings_UseCommunityCarFacts}"
                              Margin="0,0,0,2" Checked="UseCommunityCarFacts_Changed" Unchecked="UseCommunityCarFacts_Changed"
                              ToolTip="{loc:T Settings_UseCommunityCarFacts_Tip}"/>
                    <!-- Car-data sharing. ON by default (opt-out posture; the welcome
                         modal is the disclosure). This checkbox is the opt-out; gated by
                         the community master toggle; no sign-in needed (signed-out
                         submissions use the anon fallback id). Toggling here also
                         answers the residual consent ask (CarFactsConsentGate). -->
                    <CheckBox x:Name="AutoSubmitCarFactsCheck"
                              Content="{loc:T Settings_AutoSubmitCarFacts}"
                              Margin="0,0,0,2"
                              Checked="AutoSubmitCarFacts_Changed"
                              Unchecked="AutoSubmitCarFacts_Changed"
                              ToolTip="{loc:T Settings_AutoSubmitCarFacts_Tip}"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,12" FontSize="12" TextWrapping="Wrap"
                               Text="{loc:T Settings_NetworkSubmissionsAreAnonymousAnd}"/>

                    <!-- ===== Community presets: share buttons + auto-update of downloads ===== -->
                    <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,4,0,8">
                        <TextBlock Text="{loc:T Settings_NetworkCommunityPresets}" Style="{StaticResource SectionHeaderText}"/>
                    </Border>
                    <!-- Effects-tab share buttons: lets a user who uses community data
                         but never shares presets declutter the active card. The Preset
                         Manager stays the place to share regardless. -->
                    <CheckBox x:Name="EffectsTabShareButtonsCheck" Content="{loc:T Settings_EffectsTabShareButtons}"
                              Margin="0,0,0,2" Checked="EffectsTabShareButtons_Changed" Unchecked="EffectsTabShareButtons_Changed"
                              ToolTip="{loc:T Settings_EffectsTabShareButtons_Tip}"/>
                    <!-- Auto-update downloaded community presets. Off by default; only fires on
                         presets you haven't locally edited since download. -->
                    <CheckBox x:Name="AutoUpdateDownloadedPresetsCheck"
                              Content="{loc:T Settings_AutoUpdateDownloadedPresets}"
                              Margin="0,0,0,2"
                              Checked="AutoUpdateDownloadedPresets_Changed"
                              Unchecked="AutoUpdateDownloadedPresets_Changed"
                              ToolTip="{loc:T Settings_AutoUpdateDownloadedPresets_Tip}"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,12" FontSize="12" TextWrapping="Wrap"
                               Text="{loc:T Settings_NetworkIfYouVeChangedYour}"/>

                    <!-- Message of the day: how much of the top strip the user wants.
                         Gated by the community master above (the strip is hidden when
                         community features are off). None is honored literally. -->
                    <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,4,0,8">
                        <TextBlock Text="{loc:T Settings_NetworkMessageOfTheDay}" Style="{StaticResource SectionHeaderText}"/>
                    </Border>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,6" FontSize="12" TextWrapping="Wrap"
                               Text="{loc:T Settings_NetworkAShortMessageAtThe}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton x:Name="MotdLevelAllRadio" GroupName="MotdLevel"
                                     Content="{loc:T Settings_MotdLevelAllRadio}" VerticalAlignment="Center"
                                     Checked="MotdLevel_Changed"/>
                        <RadioButton x:Name="MotdLevelImportantRadio" GroupName="MotdLevel"
                                     Content="{loc:T Settings_MotdLevelImportantRadio}" VerticalAlignment="Center"
                                     Margin="18,0,0,0" Checked="MotdLevel_Changed"/>
                        <RadioButton x:Name="MotdLevelNoneRadio" GroupName="MotdLevel"
                                     Content="{loc:T Settings_MotdLevelNoneRadio}" VerticalAlignment="Center"
                                     Margin="18,0,0,0" Checked="MotdLevel_Changed"/>
                    </StackPanel>
                    <TextBlock x:Name="MotdNoneWarning" Visibility="Collapsed"
                               Foreground="#FFC107" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,10"
                               Text="{loc:T Settings_MotdNoneWarning}"/>
                </StackPanel>
            </Expander>

            <!-- Backup & sync. Holds BOTH cloud backup/sync (a supporter perk, moved here
                 from the old Community section so all backup lives together) and local file
                 backup. The Expanded handler refreshes the cloud-upload supporter gating. -->
            <!-- Top margin: the UDP telemetry section above is collapsed for
                 most users, so this is the first section after the effects list and
                 would otherwise sit flush against the last effect's 4px margin
                 (this margin formerly lived on the removed Presets header). -->
            <Expander x:Name="BackupExpander" IsExpanded="False" Margin="0,0,0,8" Expanded="BackupExpander_Expanded">
                <Expander.Header>
                    <TextBlock Text="{loc:T Settings_BackupSync}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                    <!-- Cloud backup / sync (moved here from the old Network/Community section).
                         Backs up the whole setup to the signed-in account; restoring reproduces
                         it on another PC. Upload (Back up now / Auto-sync) requires an active
                         supporter (server-enforced); download (Restore) is free. -->
                    <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,2,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T Settings_BackupCloudBackup}" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"/>
                            <!-- Small static "Supporter" badge marking this as a member perk, so it's
                                 clear (right where the feature lives) that Patreon unlocks it. -->
                            <Border CornerRadius="7" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Background="#33E5C04A" BorderBrush="#FFE5C04A" BorderThickness="1"
                                    ToolTip="{loc:T Settings_BackupASupporterPerkSupport_Tip}">
                                <TextBlock Text="{loc:T Settings_BackupSupporter}" FontSize="10" FontWeight="SemiBold" Foreground="#FFE5C04A"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- General cloud-backup description (section intro, above the controls). -->
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" FontSize="12"
                               Text="{loc:T Settings_BackupBacksUpYourSettings}"/>
                    <CheckBox x:Name="AutoSyncBackupCheck" Content="{loc:T Settings_AutoSyncBackup}"
                              Margin="0,0,0,2" Checked="AutoSyncBackup_Changed" Unchecked="AutoSyncBackup_Changed"
                              ToolTip="{loc:T Settings_AutoSyncBackup_Tip}"/>
                    <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,8" FontSize="12"
                               Text="{loc:T Settings_BackupOffBackUpOnlyWhen}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                        <TextBlock Text="{loc:T Settings_BackupFfbTuningFromADifferent}" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox x:Name="CrossWheelFfbModeCombo" Width="140" Margin="8,0,0,0"
                                  SelectionChanged="CrossWheelFfbMode_Changed"
                                  ToolTip="{loc:T Settings_CrossWheelFfbMode_Tip}">
                            <ComboBoxItem Tag="Ask" Content="{loc:T Settings_CrossWheelFfbModeAskMe}"/>
                            <ComboBoxItem Tag="Always" Content="{loc:T Settings_CrossWheelFfbModeAlwaysApply}"/>
                            <ComboBoxItem Tag="Never" Content="{loc:T Settings_CrossWheelFfbModeNeverApply}"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" FontSize="12"
                               Text="{loc:T Settings_BackupAskMePromptsOnce}"/>
                    <!-- Cross-wheel FFB notice: shown from code (RefreshCrossWheelFfbNotice) when a
                         restore/sync held back FFB tuning built on a different wheel model. -->
                    <Border x:Name="CrossWheelFfbNotice" Visibility="Collapsed"
                            CornerRadius="6" Padding="10,8" Margin="0,2,0,8"
                            Background="#33E5C04A" BorderBrush="#FFE5C04A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="CrossWheelFfbNoticeText" TextWrapping="Wrap" FontSize="12"
                                       Foreground="#FFF0D890" Margin="0,0,0,6"/>
                            <CheckBox x:Name="CrossWheelFfbRememberCheck" Content="{loc:T Settings_CrossWheelFfbRemember}"
                                      Margin="0,0,0,6" FontSize="12" Foreground="#FFF0D890"
                                      ToolTip="{loc:T Settings_CrossWheelFfbRemember_Tip}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CrossWheelFfbApplyBtn" Content="{loc:T Settings_CrossWheelFfbApply}"
                                        Padding="10,3" Height="24" Click="CrossWheelFfbApply_Click"
                                        ToolTip="{loc:T Settings_CrossWheelFfbApply_Tip}"/>
                                <Button x:Name="CrossWheelFfbDismissBtn" Content="{loc:T Settings_CrossWheelFfbDismiss}"
                                        Margin="8,0,0,0" Padding="10,3" Height="24" Click="CrossWheelFfbDismiss_Click"
                                        ToolTip="{loc:T Settings_CrossWheelFfbDismiss_Tip}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="BackupNowBtn" Content="{loc:T Settings_BackupNow}"
                                Padding="10,3,10,3" Height="24" VerticalAlignment="Center"
                                Click="BackupNow_Click"
                                ToolTip="{loc:T Settings_BackupNow_Tip}"/>
                        <Button x:Name="RestoreFromCloudBtn" Content="{loc:T Settings_RestoreFromCloud}"
                                Margin="8,0,0,0" Padding="10,3,10,3" Height="24" VerticalAlignment="Center"
                                Click="RestoreFromCloud_Click"
                                ToolTip="{loc:T Settings_RestoreFromCloud_Tip}"/>
                        <TextBlock x:Name="BackupStatusText" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="#FFC0C0C0" TextWrapping="Wrap" MaxWidth="220"/>
                    </StackPanel>
                    <TextBlock x:Name="CloudUploadHint" Style="{StaticResource HelpText}"
                               Margin="0,2,0,2" FontSize="12" Foreground="#FFE5C04A"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="CloudRemovalText" Margin="0,0,0,2" FontSize="12" FontWeight="SemiBold"
                               Foreground="#FFFFA033" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <!-- Local file backup: bundle everything into one portable archive. -->
                    <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,12,0,8">
                        <TextBlock Text="{loc:T Settings_BackupToFile}" Style="{StaticResource SectionHeaderText}"/>
                    </Border>
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8"
                               Text="{loc:T Settings_BackupBundleYourFullSetup}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BackupButton" Content="{loc:T Settings_Backup}" MinWidth="140" Height="28" Margin="0,0,8,0" Click="Backup_Click"
                                ToolTip="{loc:T Settings_Backup_Tip}"/>
                        <Button x:Name="RestoreButton" Content="{loc:T Settings_Restore}" Width="140" Height="28" Click="Restore_Click"
                                ToolTip="{loc:T Settings_Restore_Tip}"/>
                    </StackPanel>
                    <TextBlock x:Name="BackupFileStatus" FontSize="11" Foreground="#FFB0B0B0"
                               Margin="0,0,0,4" TextWrapping="Wrap" Text=""/>
                    <!-- Dev-only: backup round-trip + classification self-test. Lives with the
                         backup tools it validates. Hidden unless DevModeUnlocked (ApplyDevModeVisibility). -->
                    <Button x:Name="BackupSelfTestButton" Content="{loc:T Settings_BackupSelfTest}"
                            HorizontalAlignment="Left" Margin="0,4,0,0" Padding="10,3"
                            Visibility="Collapsed" Click="BackupSelfTest_Click"
                            ToolTip="{loc:T Settings_BackupSelfTest_Tip}"/>
                </StackPanel>
            </Expander>

            <!-- iRacing rev lights. PERMANENTLY HIDDEN since 2026-08-01: the
                 external FFB handoff this section configured has been removed.
                 The shell is kept (not deleted) for the LED Test button, which
                 native iRacing telemetry FFB will want. Rev lights for
                 Telemetry Based FFB have their own toggle on that tab. -->
            <Expander x:Name="RpmLedSection" IsExpanded="False" Visibility="Collapsed" Margin="0,0,0,8">
                <Expander.Header>
                    <TextBlock Text="iRacing" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" FontSize="12"
                        Text="{loc:T Settings_RpmLedSectionInIRacingYouDisable}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="{loc:T Common_Test}" Style="{StaticResource EffectTestButton}" Click="RpmLedTest_Click"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T Settings_RpmLedSectionLedStatus}" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Column="1" x:Name="RpmLedStatusText" Text="{loc:T Settings_RpmLedStatus}" FontSize="11" Opacity="0.85"/>
                    </Grid>
                </StackPanel>
            </Expander> <!-- /RpmLedSection (iRacing) -->

            <!-- Author identity moved into the Account expander above. The
                 hidden TextBox keeps the existing AuthorNameBox bindings
                 working for parts of the code that read/write the text;
                 user-facing edits happen via PickUsernameWindow only. -->
            <TextBox x:Name="AuthorNameBox" Visibility="Collapsed" Width="0" Height="0"
                     LostFocus="AuthorName_Changed" KeyDown="AuthorName_KeyDown"/>
            <TextBlock x:Name="AuthorNameStatus" Visibility="Collapsed"/>

            <!-- Issue reporting (bugs, feature requests, weird behavior).
                 Lives at the bottom of the tab, outside any expander, so it's
                 always visible: during beta a findable bug report matters more
                 than a tidy fold (it used to hide inside Diagnostics &
                 support). Export logs sits next to it because a report
                 without logs usually turns into a request for logs. -->
            <TextBlock Style="{StaticResource HelpText}" Margin="0,18,0,8" FontSize="12"
                Text="{loc:T Settings_FoundABugWeirdBehavior}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="ReportIssueButton" Content="{loc:T Settings_ReportIssue}" MinWidth="160" Height="26"
                        Click="ReportIssue_Click" Margin="0,0,8,0"
                        ToolTip="{loc:T Settings_ReportIssue_Tip}"/>
                <Button x:Name="ExportLogsButton" Content="{loc:T Settings_ExportLogs}" MinWidth="120" Height="26"
                        Click="ExportLogs_Click" Margin="0,0,8,0"
                        ToolTip="{loc:T Settings_ExportLogs_Tip}"/>
                <Button x:Name="OpenRepoButton" Content="{loc:T Settings_OpenRepo}" MinWidth="180" Height="26"
                        Click="OpenRepo_Click"
                        ToolTip="github.com/Mhytee/Trueforce-For-All"/>
            </StackPanel>

                    <!-- Tester access code box. Type HELP for the catalog.
                     (The old TEST unlock is retired; that section
                     is permanently hidden above.) -->
                <StackPanel Orientation="Horizontal" Margin="0,18,0,2">
                    <TextBlock Text="{loc:T Settings_AccessCode}" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    <TextBox x:Name="AccessCodeBox" Width="120" Height="24" Margin="8,0,0,0"
                             VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="4,0"
                             Background="#FF2D2D30" Foreground="White" CaretBrush="White"
                             BorderBrush="#FF7A7A7A" BorderThickness="1"
                             ToolTip="{loc:T Settings_AccessCode_Tip}"
                             LostFocus="AccessCode_Changed" KeyDown="AccessCode_KeyDown"/>
                    <TextBlock x:Name="AccessCodeStatus" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </sh:SHTabItem>

            <!-- Account tab. Relocated out of Settings so identity, supporter status
                 and Discord live in one place. Giving and the supporters wall live
                 on the separate Support tab below, and cloud backup now sits under
                 Settings > Backup and Sync. -->
            <sh:SHTabItem x:Name="AccountTab" Header="{loc:T Account_AccountTab_Header}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12,14,14">

            <!-- Account tab content (no outer expander; the tab name says Account). Identity at
                 top, external-account links under Connections, stats, then a collapsed Account
                 details section for the rarely-needed sessions + data export/delete. The community
                 toggles moved to Settings > Community and cloud backup to Settings > Backup & Sync. -->

            <!-- Sign-in status + button -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock x:Name="AccountStatusLabel" VerticalAlignment="Center" FontSize="12"
                           Foreground="#FFE0E0E0" MaxWidth="360" TextWrapping="Wrap"
                           Text="{loc:T Account_AccountStatus}"/>
                <Button x:Name="AccountAuthBtn" Content="{loc:T Account_AccountAuth}"
                        Margin="10,0,0,0" Padding="10,3,10,3" Height="24" VerticalAlignment="Center"
                        Click="AccountAuth_Click"
                        ToolTip="{loc:T Account_AccountAuth_Tip}"/>
            </StackPanel>

            <!-- Supporter badge. Shows the real entitlement.
                 Display only: the backup gate is enforced server-side. Hidden when not a supporter. -->
            <Border x:Name="SupporterBadge" CornerRadius="9" Padding="9,2,9,2" Margin="0,0,0,8"
                    HorizontalAlignment="Left" Background="#33E5C04A" BorderBrush="#FFE5C04A" BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock x:Name="SupporterBadgeText" FontSize="11" FontWeight="SemiBold"
                           Foreground="#FFE5C04A" Text="{loc:T Account_SupporterBadge}"/>
            </Border>

            <!-- Username (read-only; identity is your signed-in username OR anonymous). -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{loc:T Account_Username}" Style="{StaticResource LabelText}" VerticalAlignment="Center" MinWidth="100"/>
                <TextBlock x:Name="AccountUsernameDisplay" VerticalAlignment="Center" FontSize="13"
                           Foreground="#FFE0E0E0" Text="{loc:T Account_AccountUsernameDisplay}" MinWidth="180"/>
                <Button x:Name="AccountChangeUsernameBtn" Content="{loc:T Account_AccountChangeUsername}"
                        Margin="10,0,0,0" Padding="8,2,8,2" Height="22" VerticalAlignment="Center"
                        Click="AccountChangeUsername_Click" Visibility="Collapsed"
                        ToolTip="{loc:T Account_AccountChangeUsername_Tip}"/>
                <TextBlock x:Name="AccountAuthorStatus" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                <!-- Hidden TextBox keeps the existing TextBoxBinding pattern working; never shown. -->
                <TextBox x:Name="AccountAuthorBox" Visibility="Collapsed" Width="0" Height="0"
                         LostFocus="AccountAuthor_Changed" KeyDown="AccountAuthor_KeyDown"/>
            </StackPanel>
            <TextBlock x:Name="AccountUsernameHelp" Style="{StaticResource HelpText}" Margin="100,2,0,12" FontSize="11"
                       Text="{loc:T Account_AccountUsername}"/>
            <!-- Change email button. Only meaningful while signed in. -->
            <StackPanel x:Name="AccountChangeEmailRow" Orientation="Horizontal" Margin="0,0,0,4" Visibility="Collapsed">
                <TextBlock Text="{loc:T Account_AccountChangeEmailRowEmail}" Style="{StaticResource LabelText}" VerticalAlignment="Center" Width="100"/>
                <TextBlock x:Name="AccountEmailValue" VerticalAlignment="Center" FontSize="12" Foreground="#FFE0E0E0" Text=""/>
                <Button x:Name="AccountChangeEmailBtn" Content="{loc:T Account_AccountChangeEmail}"
                        Margin="10,0,0,0" Padding="8,2,8,2" Height="22" VerticalAlignment="Center"
                        Click="AccountChangeEmail_Click"
                        ToolTip="{loc:T Account_AccountChangeEmail_Tip}"/>
            </StackPanel>
            <!-- Inline outcome for routine change-email feedback (validation / errors);
                 the "check your inbox" success stays a modal since it needs a deliberate
                 read. Keeps account outcomes on the inline channel like link / unlink. -->
            <TextBlock x:Name="AccountChangeEmailStatus" FontSize="11" Margin="100,0,0,4"
                       TextWrapping="Wrap" Foreground="#FFB0B0B0" Text="" Visibility="Collapsed"/>

            <!-- Connections: external-account links (Discord, Patreon). One header so future
                 link types have a home. -->
            <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,12,0,8">
                <TextBlock Text="{loc:T Account_Connections}" Style="{StaticResource SectionHeaderText}"/>
            </Border>
            <StackPanel x:Name="DiscordLinkRow" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="LinkDiscordBtn" Content="{loc:T Account_LinkDiscord}" Style="{StaticResource DiscordButton}"
                        Height="26" VerticalAlignment="Center"
                        Click="LinkDiscord_Click"
                        ToolTip="{loc:T Account_LinkDiscord_Tip}"/>
                <Button x:Name="UnlinkDiscordBtn" Content="{loc:T Account_UnlinkDiscord}"
                        Margin="8,0,0,0" Padding="8,2,8,2" Height="24" VerticalAlignment="Center"
                        Click="UnlinkDiscord_Click" Visibility="Collapsed"
                        ToolTip="{loc:T Account_UnlinkDiscord_Tip}"/>
                <TextBlock x:Name="DiscordLinkStatusText" VerticalAlignment="Center" FontSize="12"
                           Foreground="#FFC0C0C0" MaxWidth="320" TextWrapping="Wrap" Margin="12,0,0,0"
                           Text="{loc:T Account_DiscordLinkStatus}"/>
            </StackPanel>
            <!-- Patreon link. An active pledge unlocks the supporter badge + cloud backup. If the
                 patron has Discord connected on Patreon AND is already in the community server, we
                 link Discord too; otherwise they use Join Discord above. -->
            <StackPanel x:Name="PatreonLinkRow" Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="LinkPatreonBtn" Content="{loc:T Account_LinkPatreon}" Style="{StaticResource SupportButton}"
                        Background="#FFF96854" Height="26" VerticalAlignment="Center"
                        Click="LinkPatreon_Click"
                        ToolTip="{loc:T Account_LinkPatreon_Tip}"/>
                <Button x:Name="UnlinkPatreonBtn" Content="{loc:T Account_UnlinkPatreon}"
                        Margin="8,0,0,0" Padding="8,2,8,2" Height="24" VerticalAlignment="Center"
                        Click="UnlinkPatreon_Click" Visibility="Collapsed"
                        ToolTip="{loc:T Account_UnlinkPatreon_Tip}"/>
                <TextBlock x:Name="PatreonLinkStatusText" VerticalAlignment="Center" FontSize="12"
                           Foreground="#FFC0C0C0" MaxWidth="320" TextWrapping="Wrap" Margin="12,0,0,0"
                           Text="{loc:T Account_PatreonLinkStatus}"/>
            </StackPanel>

            <!-- Account details: the rarely-needed bits (your stats, active sessions, data
                 export, delete), collapsed by default so they don't clutter the account view. -->
            <Expander x:Name="AccountDetailsExpander" Header="{loc:T Account_AccountDetails_Header}" IsExpanded="False" Margin="0,12,0,4"
                      Expanded="AccountDetails_Expanded">
                <StackPanel Margin="0,8,0,0">
                    <!-- Your stats. Refreshed from get_account_stats when the Account tab is shown. -->
                    <TextBlock Text="{loc:T Account_AccountDetailsYourStats}" Foreground="#FFE5C04A" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <Border x:Name="AccountStatsBox" Background="#22FFFFFF" CornerRadius="3"
                            Padding="10,6,10,6" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="AccountStatsCreated"   Foreground="#FFC0C0C0" FontSize="11" Margin="0,1,0,0"/>
                            <TextBlock x:Name="AccountStatsUploads"   Foreground="#FFC0C0C0" FontSize="11" Margin="0,1,0,0"/>
                            <TextBlock x:Name="AccountStatsDownloads" Foreground="#FFC0C0C0" FontSize="11" Margin="0,1,0,0"/>
                            <TextBlock x:Name="AccountStatsVotes"     Foreground="#FFC0C0C0" FontSize="11" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Active sessions. Every device signed in (get_my_sessions, migration 0058);
                         each non-current row revocable, or "Sign out everywhere else". Rows built in
                         RefreshAccountSessions; this device is flagged with no revoke button. -->
                    <Border x:Name="AccountSessionsBox" Background="#22FFFFFF" CornerRadius="3"
                            Padding="10,6,10,6" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Foreground="#FFE5C04A" FontWeight="SemiBold" FontSize="12"
                                           Text="{loc:T Account_AccountSessionsActiveSessions}" VerticalAlignment="Center"/>
                                <Button x:Name="AccountSessionsRefreshBtn" Content="{loc:T Common_Refresh}"
                                        HorizontalAlignment="Right" Padding="8,1,8,1" Height="20" FontSize="10"
                                        Click="AccountSessionsRefresh_Click"
                                        ToolTip="{loc:T Account_AccountSessionsRefresh_Tip}"/>
                            </Grid>
                            <TextBlock x:Name="AccountSessionsStatus" Foreground="#FFC0C0C0" FontSize="11"
                                       Margin="0,1,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <StackPanel x:Name="AccountSessionsList"/>
                            <Button x:Name="AccountSignOutOthersBtn" Content="{loc:T Account_AccountSignOutOthers}"
                                    HorizontalAlignment="Left" Padding="10,3,10,3" Height="24" Margin="0,8,0,0"
                                    Visibility="Collapsed"
                                    Click="AccountSignOutOthers_Click"
                                    ToolTip="{loc:T Account_AccountSignOutOthers_Tip}"/>
                            <TextBlock Foreground="#FF808080" FontSize="10"
                                       Text="{loc:T Account_AccountSessionsRevokingSignsTheOther}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Data export + account delete. Both auth-gated. -->
                    <StackPanel x:Name="AccountDangerZone" Orientation="Horizontal" Margin="0,0,0,4" Visibility="Collapsed">
                        <Button x:Name="AccountExportBtn" Content="{loc:T Account_AccountExport}"
                                Padding="10,3,10,3" Height="24" Margin="0,0,8,0"
                                Click="AccountExport_Click"
                                ToolTip="{loc:T Account_AccountExport_Tip}"/>
                        <Button x:Name="AccountDeleteBtn" Content="{loc:T Account_AccountDelete}"
                                Padding="10,3,10,3" Height="24"
                                Background="#8B2E2E" BorderBrush="#8B2E2E"
                                Click="AccountDelete_Click"
                                ToolTip="{loc:T Account_AccountDelete_Tip}"/>
                    </StackPanel>
                    <TextBlock x:Name="AccountExportStatus" FontSize="11" Foreground="#FFB0B0B0"
                               Margin="0,4,0,0" TextWrapping="Wrap" Text=""/>
                    <TextBlock FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap">
                        <Hyperlink Click="PrivacyPolicy_Click" ToolTip="{loc:T Account_AccountDetailsOpensPrivacyMdOn_Tip}"><Run Text="{loc:T Account_AccountDetailsPrivacyPolicy}"/></Hyperlink><Run Text="{loc:T Account_AccountDetailsWhatSStoredWhyAnd}"/>
                    </TextBlock>
                </StackPanel>
            </Expander>

                    </StackPanel>
                </ScrollViewer>
            </sh:SHTabItem>

            <!-- Support tab. Separate from Account: this is the giving / recognition surface
                 (Patreon / Ko-fi / PayPal), share links, and the Patreon-sourced supporters
                 wall. Free base forever; this funds infra + time (patronage, not a paywall).
                 Money handlers reused from the existing Support section (Patreon_Click /
                 Donate_Click) + Paypal_Click. -->
            <sh:SHTabItem x:Name="SupportTab" Header="{loc:T Support_SupportTab_Header}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12,14,14">

                        <TextBlock Text="{loc:T Support_SupportTrueforceForAll}" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13" Opacity="0.8" Margin="0,0,0,14"
                                   Text="{loc:T Support_TrueforceForAllIs}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="SupportPatreonButton" Content="{loc:T Support_SupportPatreon}" Style="{StaticResource SupportButton}"
                                    Background="#FFF96854" Click="Patreon_Click"
                                    ToolTip="{loc:T Support_SupportPatreon_Tip}"/>
                            <Button x:Name="SupportKofiButton" Content="{loc:T Support_SupportKofi}" Style="{StaticResource SupportButton}"
                                    Background="#FF29ABE0" Margin="10,0,0,0" Click="Donate_Click"
                                    ToolTip="{loc:T Support_SupportKofi_Tip}"/>
                            <Button x:Name="SupportPaypalButton" Content="{loc:T Support_SupportPaypal}" Style="{StaticResource SupportButton}"
                                    Background="#FF0070BA" Margin="10,0,0,0" Click="Paypal_Click"
                                    ToolTip="{loc:T Support_SupportPaypal_Tip}"/>
                        </StackPanel>
                        <TextBlock x:Name="SupportOpenStatus" FontSize="11" Foreground="#FF7FB37F"
                                   Margin="0,2,0,0" Text=""/>
                        <TextBlock Style="{StaticResource HelpText}" FontSize="11" Margin="0,4,0,16"
                                   Text="{loc:T Support_TheseOpenInYourBrowser}"/>

                        <!-- Share. Helping another sim racer find TF4ALL is its own support. -->
                        <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,0,0,10">
                            <TextBlock Text="{loc:T Support_SpreadTheWord}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Style="{StaticResource HelpText}" FontSize="12" Margin="0,0,0,8"
                                   Text="{loc:T Support_NotIntoChippingIn}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="SupportShareDialogButton" Content="{loc:T Support_SupportShareDialog}"
                                    Style="{StaticResource EffectsShareButton}"
                                    Click="SharePanelButton_Click" Margin="0,0,8,0" ToolTipService.InitialShowDelay="250"
                                    ToolTip="{loc:T Support_SupportShareDialog_Tip}"/>
                            <Button x:Name="SupportOpenRepoButton" Content="{loc:T Support_SupportOpenRepo}" MinWidth="160" Height="28"
                                    Click="OpenRepo_Click"
                                    ToolTip="github.com/Mhytee/Trueforce-For-All"/>
                        </StackPanel>

                        <!-- Supporters wall. Populated DIRECTLY from Patreon (list_supporters),
                             so patrons who never link Discord still get recognition. First name
                             + last initial only; filled by RefreshSupportersWallAsync. -->
                        <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,0,0,8">
                            <TextBlock Text="{loc:T Support_Supporters}" Style="{StaticResource SectionHeaderText}"/>
                        </Border>
                        <TextBlock Style="{StaticResource HelpText}" FontSize="12" Margin="0,0,0,10"
                                   Text="{loc:T Support_ThePeopleKeepingThe}"/>
                        <TextBlock x:Name="SupportersWallStatus" FontSize="12" Opacity="0.7"
                                   Text="{loc:T Support_SupportersWall}"/>
                        <StackPanel x:Name="SupportersWallPanel" Margin="0,6,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </sh:SHTabItem>

            <!-- ========================== MEMORY MAP ========================== -->
            

        </sh:SHTabControl>

        <!-- Achievement celebration toast. Non-modal, in-plugin only (overlays this panel,
             never the game). Auto-dismisses; the × closes early; clicking it opens the
             Achievements tracker. Driven by the toast queue in code-behind. -->
        <Border x:Name="AchievementToast" Grid.RowSpan="2" Visibility="Collapsed"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                Background="#F02A2A2E" BorderBrush="#FFE5C04A" BorderThickness="1" CornerRadius="8"
                Padding="14,10,12,10" Cursor="Hand" MouseLeftButtonUp="AchievementToast_Click">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="#FF000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏆" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center" MaxWidth="300">
                    <TextBlock x:Name="AchievementToastTitle" Text="{loc:T Trailer_AchievementToastTitle}" FontSize="13"
                               FontWeight="SemiBold" Foreground="#FFE5C04A"/>
                    <TextBlock x:Name="AchievementToastBody" Text="" FontSize="12" Foreground="#FFE6E6E6"
                               TextWrapping="Wrap" Margin="0,1,0,0"/>
                </StackPanel>
                <Button x:Name="AchievementToastLinkBtn" Content="{loc:T Trailer_AchievementToastLink}" Style="{StaticResource DiscordButton}"
                        Visibility="Collapsed" Margin="12,0,0,0" Height="26" Padding="9,4,11,4"
                        FontSize="12" VerticalAlignment="Center" Click="AchievementToastLink_Click"/>
                <Button x:Name="AchievementToastClose" Content="✕" FontSize="11"
                        Background="Transparent" BorderThickness="0" Foreground="#FFB0B0B0"
                        Cursor="Hand" Padding="6,0,2,0" VerticalAlignment="Top"
                        ToolTip="{loc:T Trailer_AchievementToastClose_Tip}"
                        Click="AchievementToastClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
