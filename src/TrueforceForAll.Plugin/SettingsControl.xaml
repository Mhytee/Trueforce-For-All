                            <TextBlock Grid.Column="0" Text="{loc:T Common_FrequencyHz}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="DrsSustainedFreqSlider" Minimum="20" Maximum="150" SmallChange="1" LargeChange="5"
                                        TickFrequency="10" ValueChanged="DrsSustainedFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=DrsSustainedFreqText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="DrsSustainedFreqText" Text="70"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_DrsSustainedAmp}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="DrsSustainedAmpSlider" Minimum="0" Maximum="0.4" SmallChange="0.02" LargeChange="0.05"
                                        TickFrequency="0.05" ValueChanged="DrsSustainedAmpSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=DrsSustainedAmpText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="DrsSustainedAmpText" Text="0.12"/></Border>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Collision (variable-amplitude thud on impact). Magnitude
                     comes from PC2's mLastOpponentCollisionMagnitude
                     directly, or is derived from a sudden lateral/vertical
                     accel spike (>5g) for any other source. Global-only
                     for v1 (no per-car override slot yet). -->
                <Expander x:Name="CollisionExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="CollisionEnabledCheck" Content="{loc:T Effects_CollisionEnabled}"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      ToolTip="{loc:T Effects_CollisionEnabled_Tip}"
                                      Checked="CollisionEnabled_Changed" Unchecked="CollisionEnabled_Changed"/>
                            <Border x:Name="CollisionNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="{loc:T Common_New}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="CollisionOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="{loc:T Common_Test}" Style="{StaticResource EffectTestButton}" Click="CollisionTest_Click"/>
                            <Button x:Name="CollisionRevertBtn" Content="↶" Tag="Collision" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="CollisionSaveBtn"   Content="{loc:T Common_SaveEllipsis}" Tag="Collision" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="{loc:T Effects_CollisionAThudOnImpactThat}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Gain}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="CollisionGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="CollisionGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=CollisionGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="CollisionGainText" Text="1.00"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_CollisionMinThreshold}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_CollisionMinThreshold_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="CollisionMinThresholdSlider" Minimum="0.05" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="CollisionMinThresholdSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=CollisionMinThresholdText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="CollisionMinThresholdText" Text="0.20"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_CollisionMaxAmplitude}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_CollisionMaxAmplitude_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="CollisionMaxAmpSlider" Minimum="0.2" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="CollisionMaxAmpSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=CollisionMaxAmpText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="CollisionMaxAmpText" Text="0.85"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_FrequencyHz}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_CollisionFrequencyHz_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="CollisionFreqSlider" Minimum="20" Maximum="120" SmallChange="1" LargeChange="5"
                                        TickFrequency="10" ValueChanged="CollisionFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=CollisionFreqText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="CollisionFreqText" Text="50"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_CollisionDurationMs}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="CollisionEnvelopeMsSlider" Minimum="40" Maximum="300" SmallChange="5" LargeChange="20"
                                        TickFrequency="20" ValueChanged="CollisionEnvelopeMsSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=CollisionEnvelopeMsText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="CollisionEnvelopeMsText" Text="120"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Waveform}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_CollisionWaveform_Tip}"/>
                            <ComboBox  Grid.Column="1" x:Name="CollisionWaveformCombo" SelectionChanged="CollisionWaveform_Changed">
                                <ComboBoxItem Content="{loc:T Common_Sine}"/><ComboBoxItem Content="{loc:T Common_Square}"/><ComboBoxItem Content="{loc:T Common_Saw}"/><ComboBoxItem Content="{loc:T Common_Triangle}"/><ComboBoxItem Content="{loc:T Common_Noise}"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Redline buzz (modal RPM-threshold effect). Hard buzz when
                     RPM reaches the shift point / limiter, held while bouncing
                     off it. Independent of engine pulse; an unmistakable
                     "shift now / on the limiter" cue. Works wherever RPM is
                     reported (the universal SimHub fallback included). -->
                <Expander x:Name="RevLimiterExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="RevLimiterEnabledCheck" Content="{loc:T Effects_RevLimiterEnabled}"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="RevLimiterEnabled_Changed" Unchecked="RevLimiterEnabled_Changed"/>
                            <Border x:Name="RevLimiterNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="{loc:T Common_New}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="RevLimiterOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="{loc:T Common_Test}" Style="{StaticResource EffectTestButton}" Click="RevLimiterTest_Click"/>
                            <Button x:Name="RevLimiterRevertBtn" Content="↶" Tag="RevLimiter" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="RevLimiterSaveBtn"   Content="{loc:T Common_SaveEllipsis}" Tag="RevLimiter" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="{loc:T Effects_RevLimiterAHardBuzzWhenYou}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Gain}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="RevLimiterGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="RevLimiterGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=RevLimiterGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="RevLimiterGainText" Text="0.10"/></Border>
                        </Grid>
                        <!-- (The Engage mode combo, the Redline RPM slider + per-variant
                             save row, and the duplicate per-gear editor were retired
                             2026-07-17: the redline is car truth, edited ONLY in the
                             Car facts panel on the active card. This panel keeps the
                             feel knobs: gain, offset, waveform, tone.) -->
                        <!-- Coverage badge: shown when the rev-limiter cascade fell
                             all the way to the 0.85 × MaxRpm estimate (no user value,
                             no telemetry redline, no community value). Tells the user
                             the shift cue is a guess and offers ONE affordance: jump
                             to the Car facts redline box to set it. Setting is the
                             whole story (auto-submit carries it to the community by
                             itself); a separate share link would reframe saving a
                             value as a contribution act and add pressure. -->
                        <Border x:Name="RedlineGuessBadge" Visibility="Collapsed"
                                Background="#33D89F00" BorderBrush="#FFD89F00" BorderThickness="1"
                                CornerRadius="3" Padding="10,8" Margin="140,0,0,10">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#FFFFE082" FontSize="12">
                                    <Run FontWeight="Bold" Text="{loc:T Effects_RedlineGuessBadgeEstimatedRedline}"/>
                                    <Run Text="{loc:T Effects_RedlineGuessBadgeTheBuzzIsFiringAt}"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Margin="0,0,12,0" Style="{StaticResource HelpText}">
                                        <Hyperlink x:Name="RedlineGuessSetValueLink" Click="RedlineGuessSetValue_Click"><Run Text="{loc:T Effects_RedlineGuessSetValue}"/></Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- (The community-redline Confirm banner was retired with the
                             set-not-share framing pass: the cascade applies community
                             values directly, corrections are just setting your own
                             redline, and agreement accrues from other drivers'
                             auto-submitted saves rather than a dedicated prompt.) -->
                        <Grid x:Name="RevLimiterOffsetRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_RevLimiterOffsetRowRedlineOffset}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_RevLimiterOffsetRowRedlineOffset_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="RevLimiterOffsetSlider" Minimum="-3000" Maximum="1000" SmallChange="50" LargeChange="250"
                                        TickFrequency="250" ValueChanged="RevLimiterOffsetSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=RevLimiterOffsetText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="RevLimiterOffsetText" Text="0"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Waveform}" Style="{StaticResource LabelText}"/>
                            <ComboBox  Grid.Column="1" x:Name="RevLimiterWaveformCombo" SelectionChanged="RevLimiterWaveform_Changed">
                                <ComboBoxItem Content="{loc:T Common_Sine}"/><ComboBoxItem Content="{loc:T Common_Square}"/><ComboBoxItem Content="{loc:T Common_Saw}"/><ComboBoxItem Content="{loc:T Common_Triangle}"/><ComboBoxItem Content="{loc:T Common_Noise}"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_FrequencyHz}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_RevLimiterFrequencyHz_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="RevLimiterFreqSlider" Minimum="30" Maximum="200" SmallChange="1" LargeChange="5"
                                        TickFrequency="10" ValueChanged="RevLimiterFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=RevLimiterFreqText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="RevLimiterFreqText" Text="90"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_RevLimiterPulseRateHz}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_RevLimiterPulseRateHz_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="RevLimiterPulseFreqSlider" Minimum="5" Maximum="40" SmallChange="0.5" LargeChange="2"
                                        TickFrequency="5" ValueChanged="RevLimiterPulseFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=RevLimiterPulseFreqText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="RevLimiterPulseFreqText" Text="20.0"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_RevLimiterPulseLength}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_RevLimiterPulseLength_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="RevLimiterDutyCycleSlider" Minimum="0.1" Maximum="0.9" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="RevLimiterDutyCycleSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=RevLimiterDutyCycleText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="RevLimiterDutyCycleText" Text="0.50"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_RevLimiterActiveAmp}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_RevLimiterActiveAmp_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="RevLimiterActiveAmpSlider" Minimum="0" Maximum="0.6" SmallChange="0.02" LargeChange="0.05"
                                        TickFrequency="0.1" ValueChanged="RevLimiterActiveAmpSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=RevLimiterActiveAmpText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="RevLimiterActiveAmpText" Text="0.35"/></Border>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Ducking: cross-effect amplitude coordinators. Airborne
                     ducking cuts effects while the car is off the ground;
                     sidechain ducking dips continuous effects when transient
                     ones fire. Neither is a voice of its own. -->
                <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,24,0,12"><TextBlock Text="{loc:T Effects_TelemetryEffectsDucking}" Style="{StaticResource SectionHeaderText}"/></Border>

                <!-- Airborne ducking. A coordinator, not a voice: it produces
                     no haptic of its own, it pulls down the OTHER effects while
                     the car is off the ground so jumps / crest pops don't fire
                     phantom slide, engine, or road feedback. Detection comes
                     from the enhanced sources (AC wheel load, Forza suspension
                     droop, FS per-wheel contact flags from the mod); the
                     universal SimHub path can't tell, so it's a no-op there.
                     Global (no per-car override / Save button):
                     edits persist immediately. -->
                <Expander x:Name="AirborneExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="AirborneEnabledCheck" Content="{loc:T Effects_AirborneEnabled}"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      ToolTip="{loc:T Effects_AirborneEnabled_Tip}"
                                      Checked="AirborneEnabled_Changed" Unchecked="AirborneEnabled_Changed"/>
                            <Border x:Name="AirborneNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="{loc:T Common_New}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <Button x:Name="AirborneRevertBtn" Content="↶" Tag="Airborne" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="AirborneSaveBtn"   Content="{loc:T Common_SaveEllipsis}" Tag="Airborne" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="{loc:T Effects_AirborneCutsVibrationsWhileThe}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_AirborneReduction}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_AirborneReduction_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="AirborneReductionSlider" Minimum="0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="AirborneReductionSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=AirborneReductionText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="AirborneReductionText" Text="100%"/></Border>
                        </Grid>
                        <TextBlock Text="{loc:T Effects_AirborneDuckTheseWhileAirborne}" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <WrapPanel Orientation="Horizontal">
                            <CheckBox x:Name="AirborneDuckEngineCheck"      Content="{loc:T Effects_AirborneDuckEngine}"   Width="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckAudioCheck"       Content="{loc:T Effects_AirborneDuckAudio}" Width="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckRoadBumpsCheck"   Content="{loc:T Effects_AirborneDuckRoadBumps}"     MinWidth="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckTractionCheck"    Content="{loc:T Effects_AirborneDuckTraction}"  MinWidth="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckRevLimiterCheck"  Content="{loc:T Effects_AirborneDuckRevLimiter}"   MinWidth="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckGearShiftCheck"   Content="{loc:T Effects_AirborneDuckGearShift}"     MinWidth="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckAbsCheck"         Content="{loc:T Effects_AirborneDuckAbs}"            MinWidth="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckPitLimiterCheck"  Content="{loc:T Effects_AirborneDuckPitLimiter}"    Width="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckDrsCheck"         Content="{loc:T Effects_AirborneDuckDrs}"            Width="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                            <CheckBox x:Name="AirborneDuckCollisionCheck"   Content="{loc:T Effects_AirborneDuckCollision}"      Width="150" Margin="0,0,0,6" Checked="AirborneToggle_Changed" Unchecked="AirborneToggle_Changed"/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <!-- Sidechain ducking. When transient effects fire, continuous
                     effects duck to make room. Sits next to Airborne ducking:
                     both are cross-effect amplitude coordinators rather than
                     voices of their own. -->
                <Expander x:Name="DuckingExpander" IsExpanded="False" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="DuckingEnabledCheck" Content="{loc:T Effects_DuckingEnabled}"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="DuckingEnabled_Changed" Unchecked="DuckingEnabled_Changed"/>
                            <Button x:Name="DuckingRevertBtn" Content="↶" Tag="Ducking" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="DuckingSaveBtn"   Content="{loc:T Common_SaveEllipsis}" Tag="Ducking" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" FontSize="12"
                            Text="{loc:T Effects_DuckingWhenTransientEffectsGear}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_DuckingDepth}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="DuckDepthSlider"
                                        Minimum="0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="DuckDepthSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=DuckDepthText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="DuckDepthText" Text="0.50"/></Border>
                        </Grid>
                        <Expander x:Name="AdvancedDuckingExpander" IsExpanded="False" Margin="0,4,0,0">
                            <Expander.Header>
                                <TextBlock Text="{loc:T Effects_AdvancedDuckingAdvancedEnvelope}" FontSize="12"/>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:T Effects_AdvancedDuckingAttackMs}" Style="{StaticResource LabelText}"/>
                                    <Slider     Grid.Column="1" x:Name="DuckAttackSlider"
                                                Minimum="1" Maximum="100" SmallChange="1" LargeChange="5"
                                                TickFrequency="10" ValueChanged="DuckAttackSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <Border Visibility="{Binding Visibility, ElementName=DuckAttackText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="DuckAttackText" Text="5"/></Border>
                                </Grid>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:T Effects_AdvancedDuckingReleaseMs}" Style="{StaticResource LabelText}"/>
                                    <Slider     Grid.Column="1" x:Name="DuckReleaseSlider"
                                                Minimum="10" Maximum="500" SmallChange="5" LargeChange="25"
                                                TickFrequency="50" ValueChanged="DuckReleaseSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <Border Visibility="{Binding Visibility, ElementName=DuckReleaseText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="DuckReleaseText" Text="80"/></Border>
                                </Grid>
                                <CheckBox x:Name="DuckFrequencyAwareCheck" Content="{loc:T Effects_DuckFrequencyAware}"
                                          Margin="0,8,0,2" VerticalAlignment="Center"
                                          ToolTip="{loc:T Effects_DuckFrequencyAware_Tip}"
                                          Checked="DuckFrequencyAware_Changed" Unchecked="DuckFrequencyAware_Changed"/>
                                <TextBlock Style="{StaticResource HelpText}" Margin="18,0,0,0" FontSize="12" TextWrapping="Wrap"
                                           Text="{loc:T Effects_AdvancedDuckingOnlyDucksEffectsThat}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>

            </StackPanel> <!-- /TelemetryEffectsPanel -->

            <!-- Trueforce EQ. Sits after the Ducking coordinators, OUTSIDE
                 TelemetryEffectsPanel: it shapes audio rumble too, so it must
                 stay usable when a game sends no telemetry. GLOBAL like master
                 gain (a trait of the wheel and rig, never preset-scoped):
                 boosts or cuts the summed haptic stream at chosen frequencies,
                 before master gain. The curve editor and the band rows are
                 built in code (SettingsControl.TrueforceEq.cs / EqCurveEditor.cs). -->
            <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,24,0,12"><TextBlock Text="{loc:T Effects_Output}" Style="{StaticResource SectionHeaderText}"/></Border>
            <Expander x:Name="TrueforceEqExpander" IsExpanded="False" Margin="0,0,0,8" Expanded="EffectExpander_Expanded">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="TrueforceEqEnabledCheck" Content="{loc:T Effects_TrueforceEqEnabled}"
                                  FontWeight="SemiBold" VerticalAlignment="Center"
                                  ToolTip="{loc:T Effects_TrueforceEqEnabled_Tip}"
                                  Checked="TrueforceEqEnabledCheck_Changed" Unchecked="TrueforceEqEnabledCheck_Changed"/>
                        <Border x:Name="TrueforceEqNewBadge" Style="{StaticResource NewEffectBadge}">
                            <TextBlock Text="{loc:T Common_New}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="TrueforceEqSummaryText" Style="{StaticResource HelpText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <!-- Undo wears the effects' revert style and, like them,
                             only appears once there is something to step back. -->
                        <Button x:Name="TrueforceEqUndoButton" Content="↶" Style="{StaticResource EffectRevertButton}" Margin="14,0,0,0" Click="TrueforceEqUndo_Click"
                                ToolTip="{loc:T Effects_TrueforceEqUndo_Tip}"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8"
                               Text="{loc:T Effects_TrueforceEqTamesTheFrequenciesThat}"/>
                    <Border x:Name="TrueforceEqCurveHost" Height="240" Margin="0,0,0,8"
                            ToolTipService.InitialShowDelay="1500"
                            ToolTip="{loc:T Effects_TrueforceEqCurveHost_Tip}"/>
                    <StackPanel x:Name="TrueforceEqBandRows"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="TrueforceEqAddBandButton" Content="{loc:T Effects_TrueforceEqAddBand}" Style="{StaticResource EffectTestButton}" MinWidth="80" Margin="0" Click="TrueforceEqAddBand_Click"
                                ToolTip="{loc:T Effects_TrueforceEqAddBand_Tip}"/>
                        <Button x:Name="TrueforceEqAuditionButton" Content="{loc:T Effects_TrueforceEqAudition}" Style="{StaticResource EffectTestButton}" MinWidth="80" Margin="10,0,0,0" Click="TrueforceEqAudition_Click" IsEnabled="False"
                                ToolTip="{loc:T Effects_TrueforceEqAudition_Tip}"/>
                        <Button x:Name="TrueforceEqResetButton" Content="{loc:T Effects_TrueforceEqReset}" Style="{StaticResource EffectTestButton}" MinWidth="100" Margin="10,0,0,0" Click="TrueforceEqReset_Click"
                                ToolTip="{loc:T Effects_TrueforceEqReset_Tip}"/>
                    </StackPanel>
                </StackPanel>
            </Expander>


            <!-- The donation block (Patreon / Ko-fi) and the full "Spread the
                 word" section moved to the dedicated "Support us" tab, to keep
                 the tuning flow non-salesy. This slot used to hold a slim
                 Share CTA; while the plugin is in beta an easy-to-find bug
                 report beats one more share affordance, so the high-traffic
                 Effects tab now surfaces issue reporting instead. Share still
                 lives on the Support tab, the active card, and the Preset
                 Manager. -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,16" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource HelpText}" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,8,0" Text="{loc:T Effects_SomethingFeelBrokenOr}"/>
                <Button x:Name="EffectsReportIssueButton" Content="{loc:T Effects_EffectsReportIssue}"
                        Style="{StaticResource EffectsReportButton}"
                        Click="ReportIssue_Click" ToolTipService.InitialShowDelay="250"
                        ToolTip="{loc:T Effects_EffectsReportIssue_Tip}"/>
            </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </sh:SHTabItem>

            <!-- ============================ TELEMETRY BASED FFB ============================ -->
            <!-- Mode B: the steering force is synthesized from telemetry instead of
                 passing the game's FFB through. Global settings (not preset-scoped);
                 every control applies live via ApplyModeBFromSettings /
                 ApplyModeBFeel. Forza only (FM8 / FH5 / FH6). -->
            <sh:SHTabItem x:Name="TelemetryFfbTab" Header="{loc:T TelemetryFfb_TelemetryFfbTab_Header}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12,14,14">

            <!-- FFB scale leads the tab: the one force control every mirrored
                 game shares, so it sits above the (game-specific) Telemetry
                 Based FFB section rather than inside the pass-through expander.
                 Hidden on the iRacing reshape path (RefreshFromPlugin). -->
            <Grid Margin="0,0,0,10" x:Name="FfbScaleRow">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_FfbScaleRowFfbScale}" Style="{StaticResource LabelText}"/>
                <Slider     Grid.Column="1" x:Name="FfbScaleSlider"
                            Minimum="0" Maximum="1.5" SmallChange="0.05" LargeChange="0.1"
                            TickFrequency="0.25" ValueChanged="FfbScaleSlider_ValueChanged" VerticalAlignment="Center"/>
                <Border Visibility="{Binding Visibility, ElementName=FfbScaleText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="FfbScaleText" Text="1.00"/></Border>
            </Grid>

            <Border x:Name="TeleFfbSectionHeaderBorder" Style="{StaticResource SectionHeaderBorder}">
                <TextBlock x:Name="TeleFfbSectionHeader" Text="{loc:T TelemetryFfb_TeleFfbSection}" Style="{StaticResource SectionHeaderText}"/>
            </Border>

            <!-- Standing offer to install the TF4ALL Enhanced Telemetry game mod.
                 Visible while a spring game (Farming Simulator) is active
                 without the mod: declining the first-run dialog silences the
                 dialog, never this. Hidden once installed. -->
            <Border x:Name="FsModBanner" Visibility="Collapsed"
                    Background="#3300A8FF" BorderBrush="#00A8FF" BorderThickness="1"
                    CornerRadius="3" Padding="9,7" Margin="0,4,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="FsModBannerText" Foreground="#DCEBFA"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                               MaxWidth="540"
                               Text="{loc:T TelemetryFfb_FsModBanner}"/>
                    <Button Grid.Column="1" x:Name="FsModInstallButton" Content="{loc:T TelemetryFfb_FsModInstall}"
                            Padding="12,4" Margin="10,0,0,0" VerticalAlignment="Center"
                            Click="FsModInstall_Click"/>
                </Grid>
            </Border>

            <!-- "Not available here" badge. The controls below stay visible (and
                 pre-tunable) in every game so the section can be explored without a
                 supported title running; this badge appears when the active game
                 can't feed Mode B and explains why the Enable box is greyed out.
                 Visibility + text set by RefreshFromPlugin. Info-styled to match
                 the Forza-discovery banner in this tab. -->
            <Border x:Name="ModeBUnsupportedBadge" Visibility="Collapsed"
                    Background="#3300A8FF" BorderBrush="#00A8FF" BorderThickness="1"
                    CornerRadius="3" Padding="9,7" Margin="0,4,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#9432;" FontSize="14" Foreground="#7FD3FF"
                               VerticalAlignment="Top" Margin="0,1,8,0"/>
                    <TextBlock x:Name="ModeBUnsupportedBadgeText" Foreground="#DCEBFA"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                               MaxWidth="540" Text=""/>
                </StackPanel>
            </Border>

            <!-- Arcade cabinets (TeknoParrot). Shown only while one is the active
                 game, the same Visibility-from-RefreshFromPlugin pattern every
                 other per-game block on this tab uses.

                 DELIBERATELY SMALL. Strength, damping, smoothing and invert are
                 already on this tab above, they already apply to this force, and
                 they are already stored per game in the preset, which for an arcade
                 cabinet means per cabinet. Repeating them here would be a second
                 set of knobs for the same job and a second place to look when the
                 wheel feels wrong. What is left is the two things that genuinely
                 have no equivalent, and they belong to the arcade plugin's own
                 settings file rather than to us. -->
            <StackPanel x:Name="ArcadeTuningPanel" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock x:Name="ArcadeTuningHeader" Style="{StaticResource LabelText}"
                           FontWeight="SemiBold" Margin="0,0,0,2" Text="{loc:T TelemetryFfb_ArcadeTuning}"/>
                <TextBlock x:Name="ArcadeTuningStatus" Style="{StaticResource HelpText}"
                           Margin="0,0,0,8" Text=""/>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_ArcadeTuningWeakForceLift}" Style="{StaticResource LabelText}"
                               ToolTip="{loc:T TelemetryFfb_ArcadeTuningWeakForceLift_Tip}"/>
                    <Slider     Grid.Column="1" x:Name="ArcadeMinForceSlider" Minimum="0" Maximum="60" SmallChange="1" LargeChange="5"
                                TickFrequency="10" ValueChanged="ArcadeMinForceSlider_ValueChanged" VerticalAlignment="Center"
                                ToolTip="{loc:T TelemetryFfb_ArcadeMinForce_Tip}"/>
                    <Border Visibility="{Binding Visibility, ElementName=ArcadeMinForceBox}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ArcadeMinForceBox" Text="0" LostFocus="ArcadeMinForce_LostFocus" KeyDown="ArcadeMinForce_KeyDown"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8"
                           Text="{loc:T TelemetryFfb_ArcadeTuningPercentLiftsTheQuiet}"/>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_ArcadeTuningWaveformStrength}" Style="{StaticResource LabelText}"
                               ToolTip="{loc:T TelemetryFfb_ArcadeTuningWaveformStrength_Tip}"/>
                    <Slider     Grid.Column="1" x:Name="ArcadeWaveGainSlider" Minimum="0" Maximum="200" SmallChange="5" LargeChange="25"
                                TickFrequency="50" ValueChanged="ArcadeWaveGainSlider_ValueChanged" VerticalAlignment="Center"
                                ToolTip="{loc:T TelemetryFfb_ArcadeWaveGain_Tip}"/>
                    <Border Visibility="{Binding Visibility, ElementName=ArcadeWaveGainBox}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ArcadeWaveGainBox" Text="100" LostFocus="ArcadeWaveGain_LostFocus" KeyDown="ArcadeWaveGain_KeyDown"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8"
                           Text="{loc:T TelemetryFfb_ArcadeTuningPercentTheBuzzAnd}"/>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_ArcadeTuningForceLinger}" Style="{StaticResource LabelText}"
                               ToolTip="{loc:T TelemetryFfb_ArcadeTuningForceLinger_Tip}"/>
                    <Slider     Grid.Column="1" x:Name="ArcadeHoldMsSlider" Minimum="50" Maximum="5000" SmallChange="50" LargeChange="250"
                                TickFrequency="1000" ValueChanged="ArcadeHoldMsSlider_ValueChanged" VerticalAlignment="Center"
                                ToolTip="{loc:T TelemetryFfb_ArcadeHoldMs_Tip}"/>
                    <Border Visibility="{Binding Visibility, ElementName=ArcadeHoldMsBox}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ArcadeHoldMsBox" Text="0" LostFocus="ArcadeHoldMs_LostFocus" KeyDown="ArcadeHoldMs_KeyDown"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8"
                           Text="{loc:T TelemetryFfb_ArcadeTuningMillisecondsTheGameS}"/>


                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_ArcadeTuningSteadyForceHold}" Style="{StaticResource LabelText}"
                               ToolTip="{loc:T TelemetryFfb_ArcadeTuningSteadyForceHold_Tip}"/>
                    <Slider     Grid.Column="1" x:Name="ArcadeSteerHoldSlider" Minimum="0" Maximum="10000" SmallChange="50" LargeChange="500"
                                TickFrequency="2000" ValueChanged="ArcadeSteerHoldSlider_ValueChanged" VerticalAlignment="Center"
                                ToolTip="{loc:T TelemetryFfb_ArcadeSteerHold_Tip}"/>
                    <Border Visibility="{Binding Visibility, ElementName=ArcadeSteerHoldBox}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ArcadeSteerHoldBox" Text="0" LostFocus="ArcadeSteerHold_LostFocus" KeyDown="ArcadeSteerHold_KeyDown"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8"
                           Text="{loc:T TelemetryFfb_ArcadeTuningMillisecondsForTheSteering}"/>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_ArcadeTuningVibrationHold}" Style="{StaticResource LabelText}"
                               ToolTip="{loc:T TelemetryFfb_ArcadeTuningVibrationHold_Tip}"/>
                    <Slider     Grid.Column="1" x:Name="ArcadeVibHoldSlider" Minimum="0" Maximum="500" SmallChange="10" LargeChange="50"
                                TickFrequency="100" ValueChanged="ArcadeVibHoldSlider_ValueChanged" VerticalAlignment="Center"
                                ToolTip="{loc:T TelemetryFfb_ArcadeVibHold_Tip}"/>
                    <Border Visibility="{Binding Visibility, ElementName=ArcadeVibHoldBox}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ArcadeVibHoldBox" Text="0" LostFocus="ArcadeVibHold_LostFocus" KeyDown="ArcadeVibHold_KeyDown"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8"
                           Text="{loc:T TelemetryFfb_ArcadeTuningMillisecondsBuzzOnly0}"/>

                <TextBlock x:Name="ArcadeTuningFooter" Style="{StaticResource HelpText}" Margin="0,0,0,4"
                           Text="{loc:T TelemetryFfb_ArcadeTuningFooter}"/>

            </StackPanel>

            <!-- The Mode B controls. Always visible; the Enable box greys out and the
                 badge above appears when the active game can't use it. -->
            <StackPanel x:Name="ModeBSupportedPanel">
            <!-- Contextual: RefreshFromPlugin swaps this text when a
                 spring-mode game (Farming Simulator) is active, so each game's
                 player reads only the sentence that applies to them. -->
            <TextBlock x:Name="ModeBIntroText" Style="{StaticResource HelpText}" Margin="0,0,0,10" TextWrapping="Wrap"
                       Text="{loc:T TelemetryFfb_ModeBIntro}"/>
            <!-- The way back to the introduction dialog, which fires once when a
                 supported game first opens this tab and is gone for good after
                 that. Its steps outlive it. Visibility from RefreshFromPlugin. -->
            <TextBlock x:Name="ModeBIntroLink" Style="{StaticResource HelpText}"
                       Margin="0,-6,0,10" Visibility="Collapsed">
                <Hyperlink Click="ModeBIntroLink_Click"
                           ToolTip="{loc:T TelemetryFfb_ModeBIntroWhatTelemetryBasedFfb_Tip}"><Run Text="{loc:T TelemetryFfb_ModeBIntroSetupInstructions}"/></Hyperlink>
            </TextBlock>

            <!-- Contention warning. The plugin latches ModeBContentionDetected when
                 the game keeps streaming its own FFB while Mode B is driving the
                 wheel; the meter timer + RefreshFromPlugin surface it here. -->
            <TextBlock x:Name="ModeBContentionWarning" Visibility="Collapsed"
                       Foreground="#FFFFA726" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="{loc:T TelemetryFfb_ModeBContentionWarning}"/>

            <!-- Slip-starved fallback warning. The plugin latches
                 ModeBSlipStarvedDetected when Mode B is armed but no tire-slip
                 telemetry ever reaches it (typically Forza's Data Out points at
                 SimHub's port, so the plugin's own UDP source has nothing to
                 read); the game's tapped FFB is passed through meanwhile. The
                 button reuses the fallback banner's jump (Settings tab, UDP
                 expander opened, scrolled to the Forza section). -->
            <Grid x:Name="ModeBSlipStarvedWarning" Visibility="Collapsed" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="#FFFFA726" FontSize="11" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Text="{loc:T TelemetryFfb_ModeBSlipStarvedWarningTelemetryBasedFfbIs}"/>
                <Button Grid.Column="1" x:Name="ModeBSlipStarvedSetupButton" Content="{loc:T TelemetryFfb_ModeBSlipStarvedSetup}"
                        Style="{StaticResource UpdateCtaButton}"
                        MinWidth="90" Height="28" Margin="10,0,0,0" VerticalAlignment="Center"
                        Click="ForzaFallbackBannerButton_Click"
                        ToolTip="{loc:T TelemetryFfb_ModeBSlipStarvedSetup_Tip}"/>
            </Grid>

            <CheckBox x:Name="ModeBEnabledCheck" Content="{loc:T TelemetryFfb_ModeBEnabled}"
                      Margin="0,4,0,2" ToolTip="{loc:T TelemetryFfb_ModeBEnabled_Tip}"
                      Checked="ModeBEnabled_Changed" Unchecked="ModeBEnabled_Changed"/>
            <TextBlock x:Name="ModeBGameNote" Style="{StaticResource HelpText}" Margin="22,0,0,12"
                       Text="{loc:T TelemetryFfb_ModeBGameNote}"/>

            <!-- Spring mode (Mode B value 2) has NO toggle: for the games
                 that command spring-only FFB (Farming Simulator) it IS the
                 plugin's force feedback, so it arms itself by game detection
                 and the setting is normalized to on at load (owner call
                 2026-08-08; the old checkbox also undersold everything the
                 FS stack does now). -->

            <!-- The Forza tuning recipe. Hidden as one block while a
                 spring-mode game (Farming Simulator) is active: the sliders
                 shape the telemetry composer, which spring mode does not run.
                 The Wheel lights and screen section below stays: rev lights
                 and the OLED work in spring mode too. -->
            <StackPanel x:Name="ModeBForzaTuningPanel">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_ModeBForzaTuningStrength}" Style="{StaticResource LabelText}"/>
                <Slider     Grid.Column="1" x:Name="ModeBStrengthSlider" Minimum="0.05" Maximum="1.5" SmallChange="0.05" LargeChange="0.1"
                            TickFrequency="0.1" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                <Border Visibility="{Binding Visibility, ElementName=ModeBStrengthText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ModeBStrengthText" Text="0.50"/></Border>
            </Grid>
            <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_ModeBForzaTuningOverallSteeringForceYour}"/>

            <CheckBox x:Name="ModeBAutoStrengthCheck" Margin="0,0,0,2" Content="{loc:T TelemetryFfb_ModeBAutoStrength}"
                      ToolTip="{loc:T TelemetryFfb_ModeBAutoStrength_Tip}"
                      Checked="ModeBFeel_Changed" Unchecked="ModeBFeel_Changed"/>
            <TextBlock Style="{StaticResource HelpText}" Margin="20,0,0,4" Text="{loc:T TelemetryFfb_ModeBForzaTuningLevelsCarsOutSoEvery}"/>
            <!-- Live state for the learner. It has always decided a number per
                 car and never shown it, which made "is this doing anything?"
                 unanswerable without the BAUTOS console command. -->
            <Grid Margin="20,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="ModeBAutoStrengthStatus" VerticalAlignment="Center"
                           FontSize="11" Opacity="0.75" TextWrapping="Wrap" Text=""/>
                <!-- Width overrides EffectTestButton's 50, which is sized for
                     the four-character "Test" labels every other user of that
                     style carries; the template arranges the label INTO the
                     border, so at 50 this reads "Re-lear". -->
                <Button Grid.Column="1" x:Name="ModeBRelearnBtn" Content="{loc:T TelemetryFfb_ModeBRelearn}" Margin="8,0,0,0" MinWidth="86"
                        Style="{StaticResource EffectTestButton}" Click="ModeBRelearnCar_Click"
                        ToolTip="{loc:T TelemetryFfb_ModeBRelearn_Tip}"/>
            </Grid>

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_ModeBForzaTuningMinForce}" Style="{StaticResource LabelText}"/>
                <Slider     Grid.Column="1" x:Name="ModeBMinForceSlider" Minimum="0" Maximum="0.5" SmallChange="0.01" LargeChange="0.05"
                            TickFrequency="0.05" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"
                            ToolTip="{loc:T TelemetryFfb_ModeBMinForce_Tip}"/>
                <Border Visibility="{Binding Visibility, ElementName=ModeBMinForceText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ModeBMinForceText" Text="0.05"/></Border>
            </Grid>
            <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_ModeBForzaTuningTheSmallestForceYour}"/>

            <TextBlock Text="{loc:T TelemetryFfb_ModeBForzaTuningSteeringFeel}" FontWeight="SemiBold" Margin="0,10,0,2"/>

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_ModeBForzaTuningCorneringWeight}" Style="{StaticResource LabelText}"/>
                <Slider     Grid.Column="1" x:Name="ModeBLatSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                            TickFrequency="0.15" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                <Border Visibility="{Binding Visibility, ElementName=ModeBLatText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ModeBLatText" Text="0.60"/></Border>
            </Grid>
            <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_ModeBForzaTuningExtraWeightPerGOf}"/>

            </StackPanel><!-- ModeBForzaTuningPanel (part 1) -->

            <!-- Spring-mode essentials, ABOVE the shared Damping row so a
                 Farming Simulator user reads the panel in the same order as
                 Forza's: Strength first, Damping right under it, feel
                 sliders after (owner order call 2026-08-08). -->
            <StackPanel x:Name="SpringEssentialsPanel" Visibility="Collapsed">
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_SpringEssentialsStrength}" Style="{StaticResource LabelText}"/>
                    <Slider     Grid.Column="1" x:Name="SpringStrengthSlider" Minimum="0.05" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                TickFrequency="0.1" ValueChanged="SpringStrength_ValueChanged" VerticalAlignment="Center"
                                ToolTip="{loc:T TelemetryFfb_SpringStrength_Tip}"/>
                    <Border Visibility="{Binding Visibility, ElementName=SpringStrengthText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="SpringStrengthText" Text="1.00"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_SpringEssentialsOverallSteeringForceSpring}"/>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_SpringEssentialsMinForce}" Style="{StaticResource LabelText}"/>
                    <Slider     Grid.Column="1" x:Name="SpringMinForceSlider" Minimum="0" Maximum="0.5" SmallChange="0.01" LargeChange="0.05"
                                TickFrequency="0.05" ValueChanged="SpringMinForce_ValueChanged" VerticalAlignment="Center"/>
                    <Border Visibility="{Binding Visibility, ElementName=SpringMinForceText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="SpringMinForceText" Text="0.05"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_SpringEssentialsTheSmallestForceYour}"/>
            </StackPanel>

            <!-- iRacing essentials, in the same position and order as the other
                 two families: Strength first, Damping directly under it. The
                 Forza recipe below is hidden here because iRacing RESHAPES the
                 sim's own steering torque rather than synthesizing force from
                 slip, so the SAT model and everything feeding it never runs. -->
            <StackPanel x:Name="IRacingTuningPanel" Visibility="Collapsed">
                <!-- A number box, not a slider. Nobody drags to find a car's peak
                     torque: this is set by Auto, or typed once. The slider also
                     had to render "follow iRacing" (stored as 0) as hard-left,
                     which read as zero force while the label beside it correctly
                     said iRacing's number. iRacing's own box is the same shape. -->
                <!-- Car's peak force + Auto: an iRacing max-force control. It does
                     nothing on the RaceRoom R3EFFB route (that route carries its
                     own scale), so it hides there and RaceRoom uses Strength plus
                     its own auto-strength Apply instead. -->
                <Grid Margin="0,0,0,2" x:Name="IRacingPeakForceRow">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_IRacingPeakForceRowCarSPeakForce}" Style="{StaticResource LabelText}"
                               ToolTip="{loc:T TelemetryFfb_IRacingPeakForceRowCarSPeakForce_Tip}"/>
                    <Button Grid.Column="1" x:Name="IRacingMaxNmDownBtn" Content="-" Width="24" Margin="0,0,4,0"
                            Style="{StaticResource EffectTestButton}" Click="IRacingMaxNmDown_Click"
                            ToolTip="{loc:T TelemetryFfb_IRacingMaxNmDown_Tip}"/>
                    <TextBox   Grid.Column="2" x:Name="IRacingMaxNmBox" VerticalAlignment="Center"
                               ToolTip="{loc:T TelemetryFfb_IRacingMaxNm_Tip}"
                               LostFocus="IRacingMaxNm_LostFocus" KeyDown="IRacingMaxNm_KeyDown"/>
                    <Button Grid.Column="3" x:Name="IRacingMaxNmUpBtn" Content="+" Width="24" Margin="4,0,0,0"
                            Style="{StaticResource EffectTestButton}" Click="IRacingMaxNmUp_Click"
                            ToolTip="{loc:T TelemetryFfb_IRacingMaxNmUp_Tip}"/>
                    <TextBlock Grid.Column="4" x:Name="IRacingMaxNmText" VerticalAlignment="Center"
                               Margin="8,0,0,0" Opacity="0.75" FontSize="11" Text=""/>
                    <!-- Width overrides EffectTestButton's 50, which is sized for
                         its four-character "Test" labels. This one grows a number:
                         "Use 23.8". -->
                    <Button Grid.Column="5" x:Name="IRacingAutoMaxForceBtn" Content="{loc:T TelemetryFfb_IRacingAutoMaxForce}" Margin="8,0,0,0" MinWidth="88" IsEnabled="False"
                            Style="{StaticResource EffectTestButton}" Click="IRacingAutoMaxForce_Click"
                            ToolTip="{loc:T TelemetryFfb_IRacingAutoMaxForce_Tip}"/>
                </Grid>
                <TextBlock x:Name="IRacingPeakForceHelp" Style="{StaticResource HelpText}" Margin="140,0,0,6"
                           Text="{loc:T TelemetryFfb_IRacingPeakForce}"/>
                <!-- RaceRoom auto-strength (R3EFFB): the press-to-apply counterpart
                     to the iRacing Auto button. Until Apply is pressed the wheel
                     matches the game's own strength; Apply locks in this car's
                     learned max. Shown only on the R3EFFB route. -->
                <Grid Margin="0,0,0,2" x:Name="R3EAutoStrengthRow" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_R3EAutoStrengthRowCarSMax}" Style="{StaticResource LabelText}"
                               ToolTip="{loc:T TelemetryFfb_R3EAutoStrengthRowCarSMax_Tip}"/>
                    <Button Grid.Column="1" x:Name="R3EMaxDownBtn" Content="-" Width="24" Margin="0,0,4,0"
                            Style="{StaticResource EffectTestButton}" Click="R3EMaxDown_Click"
                            ToolTip="{loc:T TelemetryFfb_R3EMaxDown_Tip}"/>
                    <TextBox   Grid.Column="2" x:Name="R3EMaxBox" VerticalAlignment="Center"
                               ToolTip="{loc:T TelemetryFfb_R3EMax_Tip}"
                               LostFocus="R3EMax_LostFocus" KeyDown="R3EMax_KeyDown"/>
                    <Button Grid.Column="3" x:Name="R3EMaxUpBtn" Content="+" Width="24" Margin="4,0,0,0"
                            Style="{StaticResource EffectTestButton}" Click="R3EMaxUp_Click"
                            ToolTip="{loc:T TelemetryFfb_R3EMaxUp_Tip}"/>
                    <TextBlock Grid.Column="4" x:Name="R3EAutoStrengthStatus" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.75" FontSize="11" Text=""/>
                    <Button Grid.Column="5" x:Name="R3EApplyStrengthBtn" Content="{loc:T Common_Apply}" Margin="8,0,0,0" Width="88" IsEnabled="False"
                            Style="{StaticResource EffectTestButton}" Click="R3EApplyStrength_Click"
                            ToolTip="{loc:T TelemetryFfb_R3EApplyStrength_Tip}"/>
                </Grid>
                <TextBlock x:Name="R3EAutoStrengthHelp" Style="{StaticResource HelpText}" Margin="140,0,0,6" Visibility="Collapsed"
                           Text="{loc:T TelemetryFfb_R3EAutoStrength}"/>
                <TextBlock x:Name="IRacingAutoMaxForceStatus" Margin="140,0,0,6"
                           FontSize="11" Opacity="0.75" Text="" Visibility="Collapsed"/>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_IRacingTuningStrength}" Style="{StaticResource LabelText}"
                               ToolTip="{loc:T TelemetryFfb_IRacingTuningStrength_Tip}"/>
                    <Slider     Grid.Column="1" x:Name="IRacingGainSlider" Minimum="0.05" Maximum="3.0" SmallChange="0.05" LargeChange="0.1"
                                ToolTip="{loc:T TelemetryFfb_IRacingGain_Tip}"
                                TickFrequency="0.1" ValueChanged="IRacingGain_ValueChanged" VerticalAlignment="Center"/>
                    <Border Visibility="{Binding Visibility, ElementName=IRacingGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="IRacingGainText" Text="1.00"/></Border>
                </Grid>
                <TextBlock x:Name="IRacingClipWarn" Margin="140,0,0,6" FontSize="11" TextWrapping="Wrap"
                           Foreground="#FFE8A33D" Visibility="Collapsed"
                           Text="{loc:T TelemetryFfb_IRacingClipWarn}"/>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8"
                           Text="{loc:T TelemetryFfb_IRacingTuningTheOnlyForceControl}"/>

            </StackPanel> <!-- /IRacingTuningPanel: Damping and FFB smooth follow,
                 outside it, because they are live in every game. The Advanced
                 expander is re-opened below them so the two everyday feel
                 sliders sit together above it. -->

            <!-- Damping sits OUTSIDE the game-specific panels: it is live in
                 spring mode (the anti-ring half of rendering a spring) so it
                 stays visible in Farming Simulator, and live in the iRacing
                 reshape, where it matters MORE because that path is a closed
                 loop through the sim and damping is what settles it. -->
            <Grid Margin="0,0,0,2" x:Name="ModeBDamperRow">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_ModeBDamperRowDamping}" Style="{StaticResource LabelText}"/>
                <Slider     Grid.Column="1" x:Name="ModeBDamperSlider" Minimum="0" Maximum="0.6" SmallChange="0.02" LargeChange="0.05"
                            TickFrequency="0.05" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                <Border Visibility="{Binding Visibility, ElementName=ModeBDamperText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ModeBDamperText" Text="0.07"/></Border>
            </Grid>
            <TextBlock x:Name="ModeBDamperHelp" Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_ModeBDamper}"/>

            <!-- Smoothing moved up here from the old FFB tweaks section (owner,
                 2026-08-16). It belongs beside Damping: both are everyday feel
                 controls, and unlike the FFB scale and invert it sat next to,
                 this one is LIVE on the iRacing path (the authored force
                 bypasses those two but is smoothed by this). -->
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_ModeBSupportedSmoothingMs}" Style="{StaticResource LabelText}"
                           ToolTip="{loc:T TelemetryFfb_ModeBSupportedSmoothingMs_Tip}"/>
                <Slider     Grid.Column="1" x:Name="FfbSmoothSlider"
                            Minimum="0" Maximum="10" SmallChange="0.5" LargeChange="1"
                            TickFrequency="1" ValueChanged="FfbSmoothSlider_ValueChanged" VerticalAlignment="Center"
                            ToolTip="{loc:T TelemetryFfb_FfbSmooth_Tip}"/>
                <Border Visibility="{Binding Visibility, ElementName=FfbSmoothText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="FfbSmoothText" Text="0.0"/></Border>
            </Grid>
            <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8"
                       Text="{loc:T TelemetryFfb_ModeBSupportedLeaveSmoothingAt0}"/>
            <!-- Save/Revert for the Master trio (scale, smoothing, invert).
                 They live with Smoothing because that is the one of the three
                 that is live in EVERY game; the other two hide under the
                 iRacing reshape, and their section hides with them. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                <Button x:Name="MasterRevertBtn" Content="↶" Tag="Master" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                <Button x:Name="MasterSaveBtn"   Content="{loc:T Common_SaveEllipsis}" Tag="Master" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
            </StackPanel>

            <!-- The feature sections, in the order they matter day to day, after
                 the three everyday controls (Strength, Damping, Smoothing; owner,
                 2026-09-14). Curb softening and the soft lock left IRacingTuningPanel
                 for this and are shown by the same rules in code. -->
            <!-- Curb strike softening: the sim's per-wheel shock speed, six
                 times a frame, says which torque samples are a strike; those
                 are eased toward the cornering load before they reach the
                 wheel. iRacing only (RaceRoom's route carries no shock data),
                 so the expander follows iracingPeakVis. -->
            <Expander x:Name="IRacingKerbExpander" IsExpanded="False" Visibility="Collapsed" Margin="0,12,0,4">
                <Expander.Header>
                    <CheckBox x:Name="IRacingKerbCheck" Content="{loc:T TelemetryFfb_IRacingKerb}"
                              FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                              Checked="IRacingKerb_Changed" Unchecked="IRacingKerb_Changed"
                              ToolTip="{loc:T TelemetryFfb_IRacingKerb_Tip}"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,6"
                           Text="{loc:T TelemetryFfb_IRacingKerbEasesTheJoltOfACurb}"/>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_IRacingKerbSoftening}" Style="{StaticResource LabelText}"
                               ToolTip="{loc:T TelemetryFfb_IRacingKerbSoftening_Tip}"/>
                    <Slider     Grid.Column="1" x:Name="IRacingKerbSlider" Minimum="0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                ToolTip="{loc:T TelemetryFfb_IRacingKerbAmount_Tip}"
                                TickFrequency="0.1" ValueChanged="IRacingKerb_ValueChanged" VerticalAlignment="Center"/>
                    <Border Visibility="{Binding Visibility, ElementName=IRacingKerbText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="IRacingKerbText" Text="0.60"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8"
                           Text="{loc:T TelemetryFfb_IRacingKerbHowMuchOfTheStrike}"/>
                </StackPanel>
            </Expander>

            <!-- Soft lock: the wall at the car's steering limit. The sim
                 renders its own inside the force feedback the takeover turns
                 off, so the plugin builds one from the sim's own steering
                 and lock: iRacing's angle and range, RaceRoom's raw axis,
                 lock and wheel range. Shown on both takeover routes; the
                 code-behind drives its visibility beside IRacingTuningPanel's. -->
            <Expander x:Name="IRacingSoftLockExpander" IsExpanded="False" Visibility="Collapsed" Margin="0,12,0,4">
                <Expander.Header>
                    <CheckBox x:Name="IRacingSoftLockCheck" Content="{loc:T TelemetryFfb_IRacingSoftLock}"
                              FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                              Checked="IRacingSoftLock_Changed" Unchecked="IRacingSoftLock_Changed"
                              ToolTip="{loc:T TelemetryFfb_IRacingSoftLock_Tip}"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,6"
                           Text="{loc:T TelemetryFfb_IRacingSoftLockStopsTheWheelWhere}"/>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_IRacingSoftLockStopStrength}" Style="{StaticResource LabelText}"
                               ToolTip="{loc:T TelemetryFfb_IRacingSoftLockStopStrength_Tip}"/>
                    <Slider     Grid.Column="1" x:Name="IRacingSoftLockSlider" Minimum="0.1" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                ToolTip="{loc:T TelemetryFfb_IRacingSoftLockStrength_Tip}"
                                TickFrequency="0.1" ValueChanged="IRacingSoftLock_ValueChanged" VerticalAlignment="Center"/>
                    <Border Visibility="{Binding Visibility, ElementName=IRacingSoftLockText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="IRacingSoftLockText" Text="1.00"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8"
                           Text="{loc:T TelemetryFfb_IRacingSoftLockHowHardTheStopPushes}"/>
                </StackPanel>
            </Expander>

            <!-- Spring-mode enhancements. Visible only in spring-mode games
                 (Farming Simulator); each is its own toggle so they can be
                 tested one at a time. Terrain feel is the first. -->
            <StackPanel x:Name="SpringTerrainPanel" Visibility="Collapsed">
                <CheckBox x:Name="SpringTerrainCheck" Content="{loc:T TelemetryFfb_SpringTerrain}"
                          Margin="0,4,0,2" Checked="SpringTerrain_Changed" Unchecked="SpringTerrain_Changed"
                          ToolTip="{loc:T TelemetryFfb_SpringTerrain_Tip}"/>
                <TextBlock Style="{StaticResource HelpText}" Margin="22,0,0,8"
                           Text="{loc:T TelemetryFfb_SpringTerrainBumpsAndGroundTexture}"/>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_SpringTerrainStrength}" Style="{StaticResource LabelText}"/>
                    <Slider     Grid.Column="1" x:Name="SpringTerrainStrengthSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                TickFrequency="0.1" ValueChanged="SpringTerrainStrength_ValueChanged" VerticalAlignment="Center"/>
                    <Border Visibility="{Binding Visibility, ElementName=SpringTerrainStrengthText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="SpringTerrainStrengthText" Text="1.00"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_SpringTerrainHowHardTheGround}"/>

                <Grid Margin="0,4,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_SpringTerrainCentering}" Style="{StaticResource LabelText}"/>
                    <Slider     Grid.Column="1" x:Name="SpringCenterGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                TickFrequency="0.1" ValueChanged="SpringCenterGain_ValueChanged" VerticalAlignment="Center"
                                ToolTip="{loc:T TelemetryFfb_SpringCenterGain_Tip}"/>
                    <Border Visibility="{Binding Visibility, ElementName=SpringCenterGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="SpringCenterGainText" Text="1.00"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_SpringTerrainThePullBackToCenter}"/>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_SpringTerrainCenterFirmness}" Style="{StaticResource LabelText}"/>
                    <Slider     Grid.Column="1" x:Name="SpringCenterFirmSlider" Minimum="0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                TickFrequency="0.1" ValueChanged="SpringCenterFirm_ValueChanged" VerticalAlignment="Center"/>
                    <Border Visibility="{Binding Visibility, ElementName=SpringCenterFirmText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="SpringCenterFirmText" Text="0.50"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_SpringTerrainHowSolidTheWheel}"/>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_SpringTerrainSpeedEffect}" Style="{StaticResource LabelText}"/>
                    <Slider     Grid.Column="1" x:Name="SpringSpeedFxSlider" Minimum="0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                TickFrequency="0.1" ValueChanged="SpringSpeedFx_ValueChanged" VerticalAlignment="Center"/>
                    <Border Visibility="{Binding Visibility, ElementName=SpringSpeedFxText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="SpringSpeedFxText" Text="0.65"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_SpringTerrainHowMuchSpeedStrengthens}"/>

                <CheckBox x:Name="SpringDragCheck" Content="{loc:T TelemetryFfb_SpringDrag}"
                          Margin="0,4,0,2" Checked="SpringDrag_Changed" Unchecked="SpringDrag_Changed"
                          ToolTip="{loc:T TelemetryFfb_SpringDrag_Tip}"/>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_SpringTerrainDragAmount}" Style="{StaticResource LabelText}"/>
                    <Slider     Grid.Column="1" x:Name="SpringDragGainSlider" Minimum="0" Maximum="3.0" SmallChange="0.05" LargeChange="0.1"
                                TickFrequency="0.1" ValueChanged="SpringDragGain_ValueChanged" VerticalAlignment="Center"/>
                    <Border Visibility="{Binding Visibility, ElementName=SpringDragGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="SpringDragGainText" Text="1.00"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_SpringTerrainHowMuchWorkingEquipment}"/>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_SpringTerrainEngineStrain}" Style="{StaticResource LabelText}"/>
                    <Slider     Grid.Column="1" x:Name="SpringDragStrainSlider" Minimum="0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                TickFrequency="0.05" ValueChanged="SpringDragStrain_ValueChanged" VerticalAlignment="Center"/>
                    <Border Visibility="{Binding Visibility, ElementName=SpringDragStrainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="SpringDragStrainText" Text="0.35"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_SpringTerrainHowMuchOfThatWeight}"/>

                <CheckBox x:Name="SpringWeightCheck" Content="{loc:T TelemetryFfb_SpringWeight}"
                          Margin="0,4,0,2" Checked="SpringWeight_Changed" Unchecked="SpringWeight_Changed"
                          ToolTip="{loc:T TelemetryFfb_SpringWeight_Tip}"/>
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_SpringTerrainWeightAmount}" Style="{StaticResource LabelText}"/>
                    <Slider     Grid.Column="1" x:Name="SpringWeightGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                TickFrequency="0.1" ValueChanged="SpringWeightGain_ValueChanged" VerticalAlignment="Center"/>
                    <Border Visibility="{Binding Visibility, ElementName=SpringWeightGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="SpringWeightGainText" Text="1.00"/></Border>
                </Grid>
                <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_SpringTerrainHowMuchCorneringLoad}"/>
            </StackPanel>

            <StackPanel x:Name="ModeBForzaTuningPanel2">

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_ModeBForzaTuningPanel2Centering}" Style="{StaticResource LabelText}"/>
                <Slider     Grid.Column="1" x:Name="ModeBCenterSlider" Minimum="0" Maximum="0.5" SmallChange="0.02" LargeChange="0.05"
                            TickFrequency="0.05" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"
                            ToolTip="{loc:T TelemetryFfb_ModeBCenter_Tip}"/>
                <Border Visibility="{Binding Visibility, ElementName=ModeBCenterText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ModeBCenterText" Text="0.25"/></Border>
            </Grid>
            <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,2" Text="{loc:T TelemetryFfb_ModeBForzaTuningPanel2CasterStylePullToward}"/>
            <Grid Margin="20,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
