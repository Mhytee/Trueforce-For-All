                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ShiftEnabledCheck" Content="{loc:T Effects_ShiftEnabled}"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="ShiftEnabled_Changed" Unchecked="ShiftEnabled_Changed"/>
                            <Border x:Name="ShiftNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="{loc:T Common_New}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="ShiftOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="{loc:T Common_Test}" Style="{StaticResource EffectTestButton}" Click="ShiftTest_Click"/>
                            <Button x:Name="ShiftRevertBtn" Content="↶" Tag="Shift" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="ShiftSaveBtn"   Content="{loc:T Common_SaveEllipsis}" Tag="Shift" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Gain}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="ShiftGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="ShiftGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=ShiftGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ShiftGainText" Text="1.00"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Waveform}" Style="{StaticResource LabelText}"/>
                            <ComboBox  Grid.Column="1" x:Name="ShiftWaveformCombo" SelectionChanged="ShiftWaveform_Changed">
                                <ComboBoxItem Content="{loc:T Common_Sine}"/><ComboBoxItem Content="{loc:T Common_Square}"/><ComboBoxItem Content="{loc:T Common_Saw}"/><ComboBoxItem Content="{loc:T Common_Triangle}"/><ComboBoxItem Content="{loc:T Common_Noise}"/>
