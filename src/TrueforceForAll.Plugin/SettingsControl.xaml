<UserControl x:Class="TrueforceForAll.Plugin.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TrueforceForAll.Plugin.Localization"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
             xmlns:sh="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             d:DesignHeight="900" d:DesignWidth="700">
    <UserControl.Resources>
        <!-- Every number beside a slider is TYPEABLE, and for a long time none
             of them looked it: a bare TextBox on this theme renders as plain
             text, so the only way to discover you could click into one was to
             try. These give each one a light outline, which is the whole of
             what says "field" to a reader.

             Applied as local values on each box rather than through a Style,
             deliberately. This panel merges no resource dictionaries, so a
             Style with no BasedOn would REPLACE SimHub's own implicit TextBox
             style and take its theme colours with it, and a BasedOn pointing at
             a theme style that might not exist fails at load rather than at
             build. Local values change the border and nothing else.

             The outline is a Border WRAPPING each box, not the box's own
             BorderBrush and BorderThickness. Those were the first attempt and
             they rendered nothing: the compiled BAML carried them (checked),
             but the TextBox template this app themes with does not honour
             them. A Border is a plain decorator and draws whatever the child's
             template does.

             Each Border follows its box's Visibility, so a hidden field does
             not leave an empty outline behind. Four of them are shown and
             hidden from code (the OLED custom slots) and the rest are always
             on, but binding all of them means the next readout added here
             inherits the behaviour without anyone having to know. -->
        <SolidColorBrush x:Key="EditableNumberBorder" Color="#8CFFFFFF"/>

        <Style x:Key="SectionHeaderBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,8"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style x:Key="OverrideBadge" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FFD54F"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Text" Value="{loc:T Resources_OverrideBadgeCarOverride}"/>
        </Style>
        <!-- Per-effect "not exposed by this game" badge. Surfaces in an
             effect's header when the active game's telemetry source doesn't
             expose the signal the effect needs (e.g. Forza Data Out doesn't
             include ABS pump activity). Muted grey so it reads as info,
             not a warning; section stays interactive so users can still
             tune values for other games. -->
        <Style x:Key="UnsupportedBadge" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>
        <!-- Per-effect "NEW" badge. Surfaces in an effect's expander header
             until the user has acknowledged it (expanded the section, or
             changed any of its values). Pre-seeded as already-seen on fresh
             install / pre-feature upgrade so existing users don't get a wall
             of badges for effects they've already been using. Code-behind
             toggles Visibility from RefreshNewBadges. -->
        <Style x:Key="NewEffectBadge" TargetType="Border">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="#3D8B40"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="ToolTip" Value="{loc:T Resources_NewEffectBadgeAddedInARecentUpdate_Tip}"/>
        </Style>
        <!-- Custom-templated effect-header buttons. SimHub's stock theme greys
             every Button.Background; a full ControlTemplate replaces the visual
             tree so our accent colors survive. Test = always visible blue.
             Save = only visible when that section is dirty (toggled from
             code-behind), amber to draw attention to the unsaved state. -->
        <Style x:Key="EffectTestButton" TargetType="Button">
            <!-- MinWidth, not Width: the button sizes to its own label so a
                 longer language grows the button instead of clipping it, and
                 50 stays the floor so a row of short labels looks unchanged. -->
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#3A6BBE" CornerRadius="3" SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F5DA6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#234A88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#555"/>
                                <Setter Property="Foreground" Value="#AAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EffectRevertButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ToolTip" Value="{loc:T Resources_EffectRevertDiscardUnsavedChangesRevert_Tip}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#6E6E6E" CornerRadius="3" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5C5C5C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Main Save preset button. Saves everything (whole snapshot).
             Visually adapts to dirty state via Tag: when code-behind sets
             Tag="dirty", amber accent + larger; when Tag is empty, grey
             subtle. Content is also flipped between "Save preset" and
             "★ Save all changes" from code-behind. -->
        <Style x:Key="SaveAllPresetButton" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#555" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="dirty">
                                <Setter TargetName="Bd" Property="Background" Value="#FFB300"/>
                                <Setter Property="Foreground" Value="#1A1A1A"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#666"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="dirty"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#FFA000"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#444"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="Tag" Value="dirty"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#E69100"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Primary action button for the per-effect / global Save popovers.
             Those windows are built in code, so their buttons inherit SimHub's
             grey stock chrome and the recommended save target reads as dead.
             A full green ControlTemplate (Background survives the theme) marks
             the primary "Update preset" choice as the obvious CTA, leaving the
             secondary targets (For this car / Cancel) in default grey. -->
        <Style x:Key="PopoverPrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#3D8B40" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="10,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#469A4A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#347A37"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Prominent amber "Update available" CTA in the header. Needs its own
             template because the stock Button chrome paints the theme's grey
             mouse-over brush over the amber Background on hover; the triggers
             below keep the amber and shift it for hover/press instead. -->
        <Style x:Key="UpdateCtaButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FFB300" BorderBrush="#FFA000"
                                BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFC233"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB300"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6A100"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A4A4A"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Quiet action button for info-tier banners (Forza fallback /
             discovery). Their translucent fills composite to near-grey over
             the dark panel, so SimHub's default button chrome reads as
             unstyled/illegible there. A subtle glass chip with white text
             stays legible on the blue/cyan info banners while staying
             deliberately lower-emphasis than the amber warning CTA, so the
             error/warning/info severity ladder is preserved. -->
        <Style x:Key="InfoBannerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#30FFFFFF" BorderBrush="#73FFFFFF"
                                BorderThickness="1" CornerRadius="3" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="#BBBBBB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Flat link-style button for tertiary preset/admin actions
             (Save as new, Delete, Manage, Set/Clear default). No border or
             fill so the row reads as "extra actions" instead of competing
             with the primary Apply / Save preset buttons above. -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Txt"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="Txt" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EffectSaveButton" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ToolTip" Value="{loc:T Resources_EffectSaveUnsavedChangesClickTo_Tip}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FFB300" CornerRadius="3" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFA000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E69100"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Compact amber "Save all" buttons that live in the header next to
             the game / car preset pickers. Shown only when that target has
             unsaved tuning; each saves every changed section at once to its
             own target (game default vs this car). -->
        <!-- Share is a CTA. Brighter brand-gold pill so users notice
             the share affordance next to the picker; sister to
             HeaderSaveAllButton's deeper amber so "outbound" (share to
             community) is visually distinct from "inbound" (save your
             work). -->
        <Style x:Key="HeaderShareButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="14,2"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#E5C04A" BorderBrush="#E5C04A" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2D165"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F2D165"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C9A53A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C9A53A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3F3727"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3F3727"/>
                                <Setter Property="Foreground" Value="#7A6D4D"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Compact share affordance for the active-card preset rows. The gold
             "★ Share" pill competed with the Save all CTA and crowded the row,
             so community share is now a tinted icon (Segoe MDL2 share glyph).
             Still gold so it stays discoverable (share drives uploads), but it
             recedes behind the primary save. Transparent fill so SimHub's stock
             chrome doesn't box it; faint gold wash on hover. -->
        <Style x:Key="HeaderShareIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#E5C04A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- Icon-only button: the tooltip is the only label, so surface it
                 fast instead of after WPF's ~1s default. -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22E5C04A"/>
                                <Setter Property="Foreground" Value="#F2D165"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#C9A53A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6B5F3D"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Slim share CTA at the bottom of the Effects tab. A gold OUTLINE
             (ghost) so it matches the active-card share icon (share = gold
             across the UI) and stays discoverable, but reads as a quiet
             secondary action, not a heavy donation-style block. Leading Segoe
             MDL2 share glyph. Brightens on hover, darkens on press. -->
        <Style x:Key="EffectsShareButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E5C04A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#E5C04A" BorderThickness="1"
                                CornerRadius="8" SnapsToDevicePixels="True" Padding="13,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22E5C04A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F2D165"/>
                                <Setter Property="Foreground" Value="#F2D165"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33E5C04A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C9A53A"/>
                                <Setter Property="Foreground" Value="#C9A53A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sister to EffectsShareButton for the bottom-of-Effects-tab
             issue-report CTA: same slim ghost pill so it reads as a quiet
             secondary action, but in the UI's info blue (reporting = getting
             help, not the gold share/outbound family). Leading Segoe MDL2
             bug glyph. -->
        <Style x:Key="EffectsReportButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#4DA3FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#4DA3FF" BorderThickness="1"
                                CornerRadius="8" SnapsToDevicePixels="True" Padding="13,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xEBE8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#224DA3FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7BBCFF"/>
                                <Setter Property="Foreground" Value="#7BBCFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334DA3FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3D82CC"/>
                                <Setter Property="Foreground" Value="#3D82CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderSaveAllButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="14,2"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#C8860B" CornerRadius="8" SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E09B0E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A8720A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Discord-branded button (Blurple #5865F2 + white logo), per Discord's brand
             guidelines. The logo lives in the template so any button using this style keeps
             a plain string Content (state text like "Relink"/"Cancel") and still shows the
             mark. Hover/pressed/disabled states use Discord's darker blurples. -->
        <Style x:Key="DiscordButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF5865F2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="11,5,13,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="18" Height="14" VerticalAlignment="Center" Margin="0,0,7,0"
                                      Fill="White" Stretch="Uniform"
                                      Data="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF4752C4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3C45A5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FF4A4D5E"/>
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Generic branded support button. Full ControlTemplate so SimHub's stock theme
             doesn't grey the Background; each button sets its own brand Background inline (a
             local value beats the theme setter, and applying this Style explicitly replaces
             SimHub's implicit Button style), and the template binds to it. Hover / pressed
             darken via opacity so ONE style serves Patreon / Ko-fi / PayPal. -->
        <Style x:Key="SupportButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.74"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- Root is a two-row Grid: a persistent header (title + update CTA +
         conditional banners + Game/Car/Preset context card) that stays put on
         every tab, and a TabControl beneath it (Effects / Presets / Controls /
         Settings). Each tab scrolls independently. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="20,20,20,4">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Trueforce For All" FontSize="22" FontWeight="Bold"/>
                <TextBlock x:Name="HeaderVersionText" Text="" FontSize="13" Opacity="0.5"
                           VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                <!-- "Check for updates" link. Hidden when an update is available;
                     the UpdateAvailableButton takes its place. -->
                <Button x:Name="CheckForUpdatesButton" Content="{loc:T Header_CheckForUpdates}"
                        Style="{StaticResource LinkButton}" Margin="12,0,0,3"
                        VerticalAlignment="Bottom"
                        Click="CheckForUpdatesButton_Click"
                        ToolTip="{loc:T Header_CheckForUpdates_Tip}"/>
                <TextBlock x:Name="CheckForUpdatesStatus" Text="" FontSize="11" Opacity="0.6"
                           VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                <!-- Community-preset update checking moved into the Preset browser; the
                     header keeps only the primary "Check for updates" button. -->

                <!-- Prominent inline CTA. Hidden until UpdateChecker confirms a
                     newer GitHub release; visibility + label are driven from
                     RefreshFromPlugin. Click opens the same modal that the
                     legacy banner used to open. -->
                <Button x:Name="UpdateAvailableButton" Visibility="Collapsed"
                        Style="{StaticResource UpdateCtaButton}"
                        Margin="12,0,0,3" VerticalAlignment="Bottom"
                        Click="UpdateAvailableButton_Click"
                        ToolTip="{loc:T Header_UpdateAvailable_Tip}">
                    <TextBlock x:Name="UpdateAvailableButtonText" Text="{loc:T Header_UpdateAvailableButton}"/>
                </Button>
            </StackPanel>
            <TextBlock Text="{loc:T Header_TheUltimateCompanionFor}"
                       FontSize="13" Opacity="0.7" Margin="0,0,0,2" TextWrapping="Wrap"/>
            <!-- The only place the app says this. It is not in the EULA or the privacy
                 policy, and the UI uses the Trueforce name throughout, so keep it
                 somewhere visible even when the line above gets rewritten. -->
            <TextBlock Text="{loc:T Header_UnofficialNotAffiliatedWith}"
                       FontSize="11" Opacity="0.45" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <!-- "What's new" banner. Shown when the running build's version
                 is ahead of Settings.LastSeenVersion (i.e. the user just
                 upgraded). Click opens a modal listing every changelog
                 entry newer than their stamp; dismissing the modal stamps
                 LastSeenVersion to the current build. Hidden after dismiss. -->
            <Border x:Name="WhatsNewBanner" Visibility="Collapsed"
                    Background="#3D8B40" CornerRadius="4" Padding="10,8,10,8" Margin="0,0,0,10"
                    Cursor="Hand" MouseLeftButtonUp="WhatsNewBanner_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="WhatsNewBannerText" Foreground="White"
                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                               Text="{loc:T Header_WhatsNewBanner}"/>
                    <TextBlock Grid.Column="1" Foreground="White" Opacity="0.85"
                               FontSize="12" VerticalAlignment="Center" Text="{loc:T Header_WhatsNewBannerView}"/>
                </Grid>
            </Border>

            <!-- "Spread the word" banner. One-and-done. Surfaces only after
                 the user has banked real working seat time
                 (Settings.ActiveStreamingSeconds past the threshold) so it
                 never lands mid-setup. Clicking copies a short blurb and
                 opens the project page; the x declines. Either path latches
                 ShareCtaDismissed so it never shows again. -->
            <Border x:Name="ShareCtaBanner" Visibility="Collapsed"
                    Background="#5B4B9E" CornerRadius="4" Padding="10,8,10,8" Margin="0,0,0,10"
                    Cursor="Hand" MouseLeftButtonUp="ShareCtaBanner_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="White"
                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{loc:T Header_ShareCtaBannerWheelFeelingAliveIn}"/>
                    <TextBlock Grid.Column="1" Foreground="White" Opacity="0.85"
                               FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                               Text="{loc:T Header_ShareCtaBannerShare}"/>
                    <Button Grid.Column="2" x:Name="ShareCtaDismiss"
                            Content="✕" Width="22" Height="22" Margin="10,0,0,0"
                            Click="ShareCtaDismiss_Click"
                            Background="Transparent" Foreground="White"
                            BorderBrush="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="{loc:T Header_ShareCtaDismiss_Tip}"/>
                </Grid>
            </Border>

            <!-- Offline-edit mode banner. Visible when the user clicked Edit
                 on a preset row in the Manage Presets dialog. While shown,
                 the plugin holds back the auto-apply-game-default path so a
                 background game launch doesn't clobber in-progress edits.
                 Built-ins use the same banner with the Save button relabeled
                 "Save as new…" so the fork behavior is obvious from the
                 button itself, no separate subtitle needed. -->
            <Border x:Name="OfflineEditBanner" Visibility="Collapsed"
                    Background="#3A6BBE" CornerRadius="4" Padding="12,8,12,8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="OfflineEditTitle" Foreground="White" FontWeight="SemiBold"
                                   FontSize="13" Text="{loc:T Header_OfflineEditTitle}"/>
                        <TextBlock x:Name="OfflineEditHint" Foreground="White" Opacity="0.85" FontSize="11"
                                   Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="{loc:T Header_OfflineEditHint}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="OfflineEditDoneBtn" Content="{loc:T Header_OfflineEditDone}" Width="84" Height="26"
                                Click="OfflineEditDone_Click"
                                ToolTip="{loc:T Header_OfflineEditDone_Tip}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- UDP setup nudge. Forza delivers telemetry over UDP, which
                 must be turned on in-game and pointed at the plugin. The setup
                 lives on the Settings tab; this persistent banner surfaces
                 when Forza is running but no packets are arriving,
                 so a user whose wheel is silent doesn't have to go digging.
                 Driven from UpdateUdpSetupBanner on the refresh tick. -->
            <Border x:Name="UdpSetupBanner" Visibility="Collapsed"
                    Background="#FF8F00" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚠" FontSize="14" Foreground="#222"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" x:Name="UdpSetupBannerText" Foreground="#222"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text=""/>
                    <Button Grid.Column="2" x:Name="UdpSetupBannerButton" Content="{loc:T Header_UdpSetupBannerSetUp}"
                            MinWidth="90" Height="28" Margin="10,0,0,0"
                            Click="UdpSetupBannerButton_Click"
                            Background="#222" Foreground="#FFC107"
                            BorderBrush="#222" BorderThickness="1" Cursor="Hand"
                            ToolTip="{loc:T Header_UdpSetupBannerSetUp_Tip}"/>
                </Grid>
            </Border>

            <!-- Forza SimHub-fallback notice. Shown when a Forza title is
                 running and telemetry IS reaching the plugin, but only via
                 SimHub (Forza's Data Out is pointed at SimHub's port, not the
                 plugin's). Everything still works; the effects that lean on
                 Forza's richer telemetry (road texture detail, airborne feel,
                 per-tire / cylinder data) just aren't as precise as they are
                 when Forza talks to the plugin directly. Less severe than the
                 no-telemetry banner above, so it's styled as info, not a
                 warning. Driven from UpdateForzaFallbackBanner. -->
            <Border x:Name="ForzaFallbackBanner" Visibility="Collapsed"
                    Background="#332196F3" BorderBrush="#2196F3" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ⓘ" FontSize="15" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" x:Name="ForzaFallbackBannerText" Foreground="White"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="{loc:T Header_ForzaFallbackBanner}"/>
                    <Button Grid.Column="2" x:Name="ForzaFallbackBannerButton" Content="{loc:T Header_ForzaFallbackBannerSetUp}"
                            Style="{StaticResource InfoBannerButton}"
                            MinWidth="90" Height="28" Margin="10,0,0,0"
                            Click="ForzaFallbackBannerButton_Click"
                            ToolTip="{loc:T Header_ForzaFallbackBannerSetUp_Tip}"/>
                </Grid>
            </Border>

            <!-- Header strip: master toggle + at-a-glance context.
                 Just Game / Car / Preset and a single status pill. Verbose
                 wheel/stream/telemetry strings live in Diagnostics. -->
            <Border Background="#22FFFFFF" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Master switch. Three states rather than two since the
                             lighting work: a checkbox cannot say "lights but no
                             force", and leaving that behaviour to fall out of
                             "disabled" made the plugin do things nobody asked for. -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Header_Mode}" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="MasterModeCombo" Width="150" VerticalAlignment="Center"
                                      SelectionChanged="MasterMode_Changed"
                                      ToolTip="{loc:T Header_MasterMode_Tip}">
                                <!-- Tagged with their mode because the list is built
                                     per wheel: the Lightsync only item is removed for a
                                     wheel whose lights are one fixed look, where it does
                                     nothing. Position arithmetic would then quietly mean
                                     the wrong mode, so the Tag is the mapping. -->
                                <ComboBoxItem Content="{loc:T Header_MasterModeNormal}" Tag="Normal"/>
                                <ComboBoxItem x:Name="MasterModeLightsyncItem"
                                              Content="{loc:T Header_MasterModeLightsyncItem}" Tag="LightsyncOnly"/>
                                <ComboBoxItem Content="{loc:T Header_MasterModeOff}" Tag="Off"/>
                            </ComboBox>
                        </StackPanel>
                        <!-- Live status pill, moved up beside the on/off toggle so the
                             control and the state it produces read together. The gold
                             "Enhanced" badge rides alongside when a per-game source is
                             delivering frames. Reclaims the old dedicated status row. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                            <Border x:Name="StatusPill" CornerRadius="10" Padding="10,3" Background="#3D8B40">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusPillDot" Width="8" Height="8" Fill="#A5D6A7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="StatusPillText" Text="{loc:T Header_StatusPill}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="EnhancedBadge" CornerRadius="10" Padding="10,3" Background="#FFB300"
                                    Margin="6,0,0,0" Visibility="Collapsed"
                                    ToolTip="{loc:T Header_EnhancedBadge_Tip}">
                                <TextBlock x:Name="EnhancedBadgeText" Text="{loc:T Header_EnhancedBadge}" Foreground="#1A1A1A" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <!-- Account chip. Always visible: a lightweight, persistent
                             entry point to community sign-in that doubles as an
                             identity readout, riding on every tab via this header
                             card. Signed out -> "Sign in" opens the sign-in dialog.
                             Signed in -> shows the username; clicking drops a small
                             menu (Account settings / Sign out). The full Account
                             section still lives on the Settings tab; this is just a
                             shortcut. Driven by RefreshAccountChip. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                            <!-- Guides. Every game that needs something done outside
                                 the plugin (iRacing's two switches, Forza's Data Out)
                                 says so in a banner or a dialog that appears when it
                                 is already wrong and is gone once answered. This is
                                 the standing list: one place to go and look, rather
                                 than a thing you had to catch. Each entry is a route
                                 into copy that lives somewhere else, never a second
                                 copy of it. The tooltip names the surface, not what
                                 is in it, so adding a guide never dates it. Built in
                                 SettingsControl.Guides.cs. -->
                            <Button x:Name="HelpGuidesHeaderButton"
                                    Height="26" Padding="6,0" Margin="0,0,4,0" Cursor="Hand"
                                    Click="HelpGuides_Click"
                                    ToolTip="{loc:T Header_HelpGuidesHeader_Tip}"
                                    ToolTipService.InitialShowDelay="150">
                                <TextBlock Text="❔" FontSize="13" VerticalAlignment="Center"/>
                            </Button>
                            <!-- TF4ALL Dash phone access. Opens our QR dialog
                                 (DashPhoneWindow) deep-linked to the dash, so scanning
                                 the QR lands straight on TF4ALL Dash instead of
                                 SimHub's dashboard list. Always visible: this is the
                                 funnel for users who don't know SimHub's web dash
                                 exists. The Settings > TF4ALL Dash section has the
                                 same entry point. -->
                            <Button x:Name="DashPhoneHeaderButton"
                                    Height="26" Padding="6,0" Margin="0,0,4,0" Cursor="Hand"
                                    Click="DashPhoneAccess_Click"
                                    ToolTip="{loc:T Header_DashPhoneHeader_Tip}"
                                    ToolTipService.InitialShowDelay="150">
                                <TextBlock Text="📱" FontSize="13" VerticalAlignment="Center"/>
                            </Button>
                            <!-- Achievements crown + new-achievement dot. Shown when signed
                                 in; click opens the Achievements tracker and clears the dot. -->
                            <Button x:Name="AchievementCrownButton" Visibility="Collapsed"
                                    Height="26" Padding="6,0" Margin="0,0,4,0" Cursor="Hand"
                                    Click="AchievementCrown_Click" ToolTip="{loc:T Header_AchievementCrown_Tip}">
                                <Grid>
                                    <TextBlock x:Name="AchievementCrownIcon" Text="👑" FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <Ellipse x:Name="AchievementCrownDot" Width="8" Height="8"
                                             Fill="#FFE5453F" Stroke="#FF231F1F" StrokeThickness="1"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,-1,-2,0" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                            <Button x:Name="AccountChipButton"
                                    VerticalAlignment="Center" Height="26" Padding="10,0" Cursor="Hand"
                                    Click="AccountChip_Click"
                                    ToolTip="{loc:T Header_AccountChip_Tip}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Connection dot. Drawn as an Ellipse (not a text
                                         glyph) so green-filled and grey-hollow are exactly
                                         the same size. Fill/Stroke set in ApplyAccountDot. -->
                                    <Ellipse x:Name="AccountChipIcon" Width="11" Height="11"
                                             VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="AccountChipText" Text="{loc:T Header_AccountChip}" FontSize="12"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AccountChipCaret" Text="▾" FontSize="10"
                                               VerticalAlignment="Center" Margin="5,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <!-- One line saying what the chosen mode does and does not touch.
                         The mode is the plugin's biggest single behaviour switch, and
                         "Lightsync only" in particular has to be legible without opening
                         a tooltip. Text comes from RefreshMasterModeUi. -->
                    <TextBlock x:Name="MasterModeNote" FontSize="11" Opacity="0.75"
                               TextWrapping="Wrap" Margin="0,6,0,10"
                               Text=""/>
                    <!-- Game + Car share one row to save vertical space; the 84-wide
                         label column lines up with the preset labels below. -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T Common_Game}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="HeaderGameText" Text="{loc:T Header_HeaderGame}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="2" Text="{loc:T Header_Car}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderCarText" Text="{loc:T Header_HeaderCar}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <!-- The header "Rename…" button was removed: car naming lives in
                                 the Car facts panel right below (Name box + Save), which runs
                                 the same CarNameShareFlow. -->
                            <!-- Old "★ N community" discoverability chip + popover
                                 removed in favour of the inline "── Top community
                                 presets ──" section that the car preset dropdown
                                 surfaces. One path with a preview-first apply
                                 flow is clearer than two paths with different
                                 semantics. -->
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Header_GamePreset}" FontSize="12" Opacity="0.6" Margin="0,3,0,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,0">
                            <ComboBox x:Name="HeaderPresetCombo" SelectionChanged="HeaderPresetCombo_Changed"
                                      MinWidth="220" MaxWidth="340" VerticalAlignment="Center"
                                      MaxDropDownHeight="420" IsTextSearchEnabled="True"
                                      ToolTip="{loc:T Header_HeaderPreset_Tip}"/>
                            <Button x:Name="HeaderGameSaveAllBtn" Content="{loc:T Header_HeaderGameSaveAll}"
                                    Style="{StaticResource HeaderSaveAllButton}" Click="HeaderGameSaveAll_Click"
                                    ToolTip="{loc:T Header_HeaderGameSaveAll_Tip}"/>
                            <!-- Conditional: shown alongside ★ Save all (i.e.
                                 when there's unsaved tuning), see
                                 UpdateGlobalDirtyFromEffects. -->
                            <Button x:Name="HeaderSaveAsNewBtn" Content="{loc:T Header_HeaderSaveAsNew}" Visibility="Collapsed"
                                    Style="{StaticResource LinkButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Click="SaveAsPreset_Click"
                                    ToolTip="{loc:T Header_HeaderSaveAsNew_Tip}"/>
                            <!-- Conditional: visible when community is on AND the
                                 active preset is user-owned (not a built-in).
                                 Hidden in UpdateHeaderShareButtons. -->
                            <Button x:Name="HeaderGameShareBtn" Content="&#xE72D;" Visibility="Collapsed"
                                    Style="{StaticResource HeaderShareIconButton}"
                                    Click="HeaderGameShare_Click"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="{loc:T Header_HeaderGameShare_Tip}"/>
                            <!-- Transient "Saved ✓" flash after a header save, in place of
                                 the old blocking success dialog. Cleared on a timer. -->
                            <TextBlock x:Name="HeaderGameSaveStatus" Text="" FontSize="11"
                                       Foreground="#7FC77F" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Header_CarPreset}" FontSize="12" Opacity="0.6" Margin="0,3,0,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,0">
                            <ComboBox x:Name="HeaderCarPresetCombo" SelectionChanged="HeaderCarPresetCombo_Changed"
                                      MinWidth="220" MaxWidth="340"
                                      VerticalAlignment="Center"
                                      MaxDropDownHeight="420" IsTextSearchEnabled="True"
                                      ToolTip="{loc:T Header_HeaderCarPreset_Tip}"/>
                            <Button x:Name="HeaderCarSaveAllBtn" Content="{loc:T Header_HeaderCarSaveAll}"
                                    Style="{StaticResource HeaderSaveAllButton}" Click="HeaderCarSaveAll_Click"
                                    ToolTip="{loc:T Header_HeaderCarSaveAll_Tip}"/>
                            <!-- Conditional: shown alongside the car ★ Save all
                                 (i.e. when this car has unsaved tuning), see
                                 UpdateGlobalDirtyFromEffects. -->
                            <Button x:Name="HeaderCarSaveAsNewBtn" Content="{loc:T Header_HeaderCarSaveAsNew}" Visibility="Collapsed"
                                    Style="{StaticResource LinkButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Click="CarSaveAsNew_Click"
                                    ToolTip="{loc:T Header_HeaderCarSaveAsNew_Tip}"/>
                            <!-- Conditional: visible when community is on AND a
                                 real car preset is selected (not "(none)" /
                                 not a built-in). Hidden in
                                 UpdateHeaderShareButtons. -->
                            <Button x:Name="HeaderCarShareBtn" Content="&#xE72D;" Visibility="Collapsed"
                                    Style="{StaticResource HeaderShareIconButton}"
                                    Click="HeaderCarShare_Click"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="{loc:T Header_HeaderCarShare_Tip}"/>
                            <TextBlock x:Name="HeaderCarSaveStatus" Text="" FontSize="11"
                                       Foreground="#7FC77F" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Community vote row: shown only when the applied car
                         preset is a community download. Lets the user rate
                         the tune they're running without leaving the card.
                         Score + up/down arrows mirror the browse list; the
                         arrow the user picked is highlighted. Built / shown /
                         hidden in code (UpdateActiveCardVoteControl). -->
                    <Border x:Name="CommunityVoteRow" Visibility="Collapsed"
                            Background="#22303030" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Header_CommunityVoteRowRateThisCommunityPreset}" FontSize="12"
                                       Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <!-- Chip-styled buttons (background + outline) so they
                                 read as obviously clickable. The arrow lives INSIDE
                                 the chip; the score in the middle is plain net
                                 number. Margin on the score keeps it close to the
                                 chips (was 4px each side, now 2px). -->
                            <Border Background="#33000000" BorderBrush="#55FFFFFF"
                                    BorderThickness="1" CornerRadius="3"
                                    Padding="6,1" Cursor="Hand"
                                    MouseLeftButtonUp="ActiveCardVoteUp_Click"
                                    ToolTip="{loc:T Header_CommunityVoteRowGoodTuneClickAgain_Tip}">
                                <TextBlock x:Name="CommunityVoteUpArrow" Text="▲" FontSize="13"
                                           Foreground="#888888" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="CommunityVoteScore" Text="0" FontSize="12"
                                       Foreground="#CFCFCF" VerticalAlignment="Center"
                                       TextAlignment="Center" MinWidth="22" Margin="2,0,2,0"/>
                            <Border Background="#33000000" BorderBrush="#55FFFFFF"
                                    BorderThickness="1" CornerRadius="3"
                                    Padding="6,1" Cursor="Hand"
                                    MouseLeftButtonUp="ActiveCardVoteDown_Click"
                                    ToolTip="{loc:T Header_CommunityVoteRowNotForMeClickAgain_Tip}">
                                <TextBlock x:Name="CommunityVoteDownArrow" Text="▼" FontSize="13"
                                           Foreground="#888888" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="CommunityVoteStatus" Text="" FontSize="11"
                                       Foreground="#9E9E9E" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- One-time inline "rate it?" nudge. Non-blocking (no
                         MessageBox). Fires at most once per item and obeys a
                         global cooldown; built / shown in code
                         (MaybeShowVoteNudge). -->
                    <Border x:Name="CommunityVoteNudge" Visibility="Collapsed"
                            Background="#2E3A2E" BorderBrush="#3D8B40" BorderThickness="1"
                            CornerRadius="4" Padding="10,7" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CommunityVoteNudgeText" FontSize="12"
                                       Foreground="#E8F5E9" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Text="{loc:T Header_CommunityVoteNudge}"/>
                            <Button x:Name="CommunityVoteNudgeGood" Content="{loc:T Header_CommunityVoteNudgeGood}"
                                    Style="{StaticResource LinkButton}" Margin="14,0,0,0"
                                    Foreground="#A5D6A7" Click="ActiveCardNudgeGood_Click"/>
                            <Button x:Name="CommunityVoteNudgeBad" Content="{loc:T Header_CommunityVoteNudgeBad}"
                                    Style="{StaticResource LinkButton}" Margin="14,0,0,0"
                                    Foreground="#EF9A9A" Click="ActiveCardNudgeBad_Click"/>
                            <Button x:Name="CommunityVoteNudgeLater" Content="{loc:T Header_CommunityVoteNudgeLater}"
                                    Style="{StaticResource LinkButton}" Margin="14,0,0,0"
                                    Click="ActiveCardNudgeLater_Click"/>
                        </StackPanel>
                    </Border>


                    <!-- Car facts summary: at-a-glance view of what the plugin
                         knows about the active car (name, engine/variant + its
                         source, redline + its source), editable inline for the
                         name and redline. Engine/variant edits route to the
                         existing Manage Variants modal. ALWAYS visible and
                         EXPANDED by default (people open the plugin before the
                         game; they should discover car facts exist and that a
                         wrong-feeling redline buzz or shift lights get fixed
                         here); with no active car the body is just the hint
                         line. Populated by RefreshCarFactsPanel. -->
                    <Expander x:Name="CarFactsExpander" IsExpanded="True" Margin="0,10,0,0"
                              ToolTip="{loc:T Header_CarFacts_Tip}">
                        <Expander.Header>
                            <TextBlock Text="{loc:T Header_CarFacts}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <!-- No-car placeholder: tells the user what will appear
                                 here and why they'd care, before they ever drive. -->
                            <TextBlock x:Name="CarFactsNoCarHint" FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                       Text="{loc:T Header_CarFactsNoCar}"/>
                            <StackPanel x:Name="CarFactsRowsPanel">
                            <!-- Name -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:T Header_CarFactsRowsCarName}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                <TextBox  Grid.Column="1" x:Name="CarFactsNameBox" VerticalAlignment="Center" Margin="0,0,8,0"
                                          TextChanged="CarFactsNameBox_TextChanged"
                                          KeyDown="CarFactsName_KeyDown"/>
                                <Button   Grid.Column="2" x:Name="CarFactsNameSaveBtn" Content="{loc:T Common_Save}"
                                          Style="{StaticResource EffectSaveButton}" Visibility="Collapsed"
                                          Click="CarFactsNameSave_Click"
                                          ToolTip="{loc:T Header_CarFactsNameSave_Tip}"/>
                            </Grid>
                            <TextBlock x:Name="CarFactsCommunityNameText" FontSize="11" Opacity="0.55"
                                       Margin="64,0,0,6" Visibility="Collapsed"/>
                            <!-- Engine type: THE engine picker since the 2026-07
                                 centralization (pins the active variant; the gray
                                 readout below carries the auto-detect context and
                                 rev ceiling). -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:T Header_CarFactsRowsEngine}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                <ComboBox  Grid.Column="1" x:Name="CarFactsEngineCombo" SelectionChanged="CarFactsEngine_Changed"
                                           DropDownClosed="CarFactsEngine_DropDownClosed"
                                           LostKeyboardFocus="CarFactsEngine_LostKeyboardFocus"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           ToolTip="{loc:T Header_CarFactsEngine_Tip}"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource HelpText}" VerticalAlignment="Center">
                                    <Hyperlink x:Name="CarFactsRefreshCommunityLink" Click="CarFactsRefreshCommunity_Click"
                                               ToolTip="{loc:T Header_CarFactsRefreshCommunity_Tip}"><Run Text="{loc:T Header_CarFactsRefreshCommunity}"/></Hyperlink>
                                    <Run Text="   "/>
                                    <Hyperlink x:Name="CarFactsManageVariantsLink" Click="CarFactsManageVariants_Click"><Run Text="{loc:T Header_CarFactsManageVariants}"/></Hyperlink>
                                </TextBlock>
                            </Grid>
                            <!-- Auto-detect readout (max RPM rides its end) + community
                                 context. The x:Names are load-bearing: their updaters
                                 also drive the shared per-car community fetch. Custom-
                                 engine authoring lives in the Manage variants modal. -->
                            <TextBlock x:Name="EngineLayoutAutoText" FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="64,0,0,2" Text=""/>
                            <TextBlock x:Name="EngineCommunityText" FontSize="11" Opacity="0.55" Margin="64,0,0,6" Text="" Visibility="Collapsed"/>
                            <!-- Redline -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:T Header_CarFactsRowsRedline}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                <TextBox   Grid.Column="1" x:Name="CarFactsRedlineBox" Width="70" VerticalAlignment="Center"
                                           KeyDown="CarFactsRedline_KeyDown"
                                           ToolTip="{loc:T Header_CarFactsRedline_Tip}"/>
                                <TextBlock Grid.Column="2" Text="{loc:T Header_CarFactsRowsRpm}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                <Button    Grid.Column="3" x:Name="CarFactsRedlineSetBtn" Content="{loc:T Header_CarFactsRedlineSet}"
                                           Style="{StaticResource EffectSaveButton}" Visibility="Visible"
                                           Click="CarFactsRedlineSet_Click"
                                           ToolTip="{loc:T Header_CarFactsRedlineSet_Tip}"/>
                                <TextBlock Grid.Column="4" x:Name="CarFactsRedlineSourceText" FontSize="11" Opacity="0.6"
                                           VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                            <TextBlock Margin="64,0,0,4" FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                                       Text="{loc:T Header_CarFactsRowsWhereTheTachometerTurns}"/>
                            <!-- Factual note when no community redline exists yet. No share
                                 button: Set routes through the submit path by itself. -->
                            <TextBlock x:Name="CarFactsNoCommunityNudge" Margin="64,4,0,0" FontSize="11"
                                       Foreground="#FFE082" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <!-- Per-gear redline overrides (gears 1..N). The redline above
                                 is the default (gear 0); rows here override specific gears,
                                 e.g. a lower 1st-gear limit. Rows are built in code by
                                 RebuildPerGearEditors. This is the ONLY per-gear editor
                                 (the Redline buzz section's duplicate was retired).
                                 Hidden unless the Settings-tab ShowPerGearRedlineEditor
                                 toggle is on OR the variant already has per-gear values
                                 (so stored data is never invisibly active). -->
                            <Expander x:Name="CarFactsPerGearExpander" IsExpanded="False" Margin="0,6,0,0" Visibility="Collapsed">
                                <Expander.Header>
                                    <TextBlock Text="{loc:T Header_CarFactsPerGearRedlines}" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
                                </Expander.Header>
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Text="{loc:T Header_CarFactsPerGearSetADifferentRedline}"/>
                                    <StackPanel x:Name="CarFactsPerGearRows"/>
                                    <Button x:Name="CarFactsAddGearBtn" Content="{loc:T Header_CarFactsAddGear}" HorizontalAlignment="Left"
                                            Padding="10,2" Margin="0,2,0,0" Click="CarFactsAddGear_Click"/>
                                </StackPanel>
                            </Expander>
                            <!-- Rev-light pattern: the wheel's ONE selection,
                                 same picker as the Wheel lights section, plus
                                 the per-car remember controls. Items built in
                                 code (RefreshCarRevLightRow). The separator is
                                 load-bearing: without it this row reads as a
                                 child of the per-gear redlines expander above. -->
                            <Separator x:Name="CarRevLightSeparator" Margin="0,10,0,8" Opacity="0.35"/>
                            <Grid x:Name="CarRevLightRow" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:T Header_CarRevLightRowRevLights}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="CarRevLightCombo" Width="230"
                                          SelectionChanged="CarRevLight_Changed"/>
                                <Button Grid.Column="2" x:Name="CarRevLightRememberBtn" Content="{loc:T Header_CarRevLightRemember}"
                                        Margin="8,0,0,0" Padding="10,2" VerticalAlignment="Center"
                                        Click="RevLightRemember_Click"/>
                                <TextBlock Grid.Column="3" x:Name="CarRevLightRememberStatus" VerticalAlignment="Center"
                                           Margin="10,0,0,0" FontSize="11" Opacity="0.7" Visibility="Collapsed"><Run x:Name="CarRevLightRememberRun"/> · <Hyperlink Click="RevLightForget_Click"><Run Text="{loc:T Header_CarRevLightRememberForget}"/></Hyperlink></TextBlock>
                            </Grid>
                            <TextBlock x:Name="CarRevLightRowHelp" Margin="64,0,0,4" FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                                       Text="{loc:T Header_CarRevLightRowHelp}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Coalesced "issues" region: at most one banner shows at a
                         time (severity order), with a "+N more" bar to reveal the
                         rest. Keeps a misconfigured machine from stacking five
                         full-width banners and crushing the tabs below. Driven by
                         CoalesceCardIssues on the refresh tick. -->
                    <StackPanel x:Name="IssuesHost">
                    <!-- Logitech G HUB warning banner. G HUB claims the wheel's
                         HID interface; while it's running we can't talk to the
                         wheel. Surfaced as a dedicated red banner (separate from
                         the WheelQuietDiagnostic below) so the user sees it even
                         when other issues coexist (e.g., master gain also at 0).
                         Hidden when G HUB isn't detected. -->
                    <Border x:Name="GHubWarningBox" Visibility="Collapsed"
                            Background="#D32F2F" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Foreground="White" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="{loc:T Header_GHubWarningLogitechGHubIsRunning}"/>
                        </StackPanel>
                    </Border>

                    <!-- Admin/elevation warning. SimHub needs to run as
                         administrator for reliable force feedback: USBPcap's
                         bus capture (which mirrors the game's FFB) can fail
                         silently without it, and some games only pass FFB
                         through when elevated. Shown whenever SimHub isn't
                         elevated; treated as effectively required. -->
                    <Border x:Name="AdminWarningBox" Visibility="Collapsed"
                            Background="#D32F2F" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Foreground="White" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="{loc:T Header_AdminWarningSimHubIsNotRunning}"/>
                        </StackPanel>
                    </Border>

                    <!-- Why-is-my-wheel-quiet diagnostic. Shown only when the
                         plugin detects a likely reason output is silent
                         (master switch off, wheel disconnected, no telemetry,
                         all effects disabled, ducker swallowing everything,
                         etc). Hidden when healthy. Yellow background so it's
                         visually distinct from regular status text. -->
                    <Border x:Name="WheelQuietDiagnosticBox" Visibility="Collapsed"
                            Background="#FFC107" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="14" Foreground="#222" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="WheelQuietDiagnosticText" Foreground="#222"
                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text=""/>
                        </StackPanel>
                    </Border>

                    <!-- FFB-tap divergence banner. HID found the wheel (so
                         Trueforce effects play) but USBPcap couldn't find it
                         on the bus, so the game's native force feedback gets
                         clobbered. Surfaces the manual picker right where the
                         user notices the problem instead of hiding it inside
                         Diagnostics. Hidden once the user picks a device. -->
                    <Border x:Name="FfbTapPickerBanner" Visibility="Collapsed"
                            Background="#FF8F00" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚠" FontSize="14" Foreground="#222"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Foreground="#222"
                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="{loc:T Header_FfbTapPickerBannerYourWheelIsConnected}"/>
                            <!-- Manual-pick fallback is hidden by default
                                 (forgotten pins silently broke FFB after a
                                 replug; the report-an-issue path gives us the
                                 data to fix the root cause instead). Power
                                 users with multi-wheel disambiguation or a
                                 specific USBPcap-interface mismatch can flip
                                 it back on with MANUALPIN. -->
                            <Button Grid.Column="2" x:Name="FfbTapPickerBannerButton"
                                    Content="{loc:T Header_FfbTapPickerBanner}"
                                    MinWidth="170" Height="28" Margin="10,0,0,0"
                                    Visibility="Collapsed"
                                    Click="UsbPcapPickDevice_Click"
                                    Background="#222" Foreground="#FFC107"
                                    BorderBrush="#222" BorderThickness="1"/>
                        </Grid>
                    </Border>

                    <!-- Unverified-wheel notice. Detected PID is supported by
                         inference (shared HID++ family) but not hardware-tested.
                         Asks the user to report the one failure mode we can't
                         rule out: Trueforce effects play but game FFB is silent
                         (init/handshake divergence). Blue = informational,
                         not an error. Hidden for confirmed wheels (all supported
                         PIDs today, so this banner is currently never shown). -->
                    <Border x:Name="UnverifiedWheelBanner" Visibility="Collapsed"
                            Background="#1565C0" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ⓘ" FontSize="14" Foreground="White"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="UnverifiedWheelText" Foreground="White"
                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text=""/>
                        </StackPanel>
                    </Border>

                    <!-- Dropped-default notice: a game's default preset pointed at
                         a name that no longer exists, so the built-in default took
                         over. Previously log-only, which let a user unknowingly
                         edit the built-in (2026-07-19). Dismiss clears the notice. -->
                    <Border x:Name="DefaultDroppedBanner" Visibility="Collapsed"
                            Background="#1565C0" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ⓘ" FontSize="14" Foreground="White"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" x:Name="DefaultDroppedText" Foreground="White"
                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text=""/>
                            <Button Grid.Column="2" Content="{loc:T Header_DefaultDroppedBannerDismiss}" Padding="10,3" Margin="10,0,0,0"
                                    VerticalAlignment="Center" Click="DefaultDroppedDismiss_Click"/>
                        </Grid>
                    </Border>

                    <!-- "+N more" reveal. Shown only when more than one issue is
                         active; the collapsed view shows just the top-severity
                         banner. Clicking expands to the full stack (and back). -->
                    <Border x:Name="MoreIssuesBar" Visibility="Collapsed" Cursor="Hand"
                            Background="#1FFFFFFF" CornerRadius="4" Padding="10,5" Margin="0,8,0,0"
                            MouseLeftButtonUp="MoreIssues_Click"
                            ToolTip="{loc:T Header_MoreIssuesBar_Tip}">
                        <TextBlock x:Name="MoreIssuesText" FontSize="12" Foreground="#E0E0E0"
                                   Text="{loc:T Header_MoreIssues}"/>
                    </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Message-of-the-day strip: spans all tabs, sits between the header and
             the tab content. Hosts the MotdStrip control (added in code-behind);
             collapses to nothing when there's no message. -->
        <ContentControl x:Name="MotdStripHost" Grid.Row="1" Margin="20,0,20,8"/>

        <sh:SHTabControl x:Name="MainTabs" Grid.Row="2" Margin="20,4,20,12" SelectionChanged="MainTabs_SelectionChanged">
            <!-- ============================ EFFECTS (main) ============================ -->
            <sh:SHTabItem x:Name="EffectsTab" Header="{loc:T Effects_EffectsTab_Header}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12,14,14">

            <!-- Master. Master gain is a GLOBAL setting (auto-saved, not
                 preset-scoped), so this section has no Save/Revert. The
                 FFB pass-through Save/Revert (which cover scale/smooth/invert,
                 EffectKind.Master) live with those controls in the FFB tweaks
                 expander below. -->
            <Border Style="{StaticResource SectionHeaderBorder}">
                <TextBlock Text="{loc:T Effects_Master}" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"/>
            </Border>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T Effects_MasterGain}" Style="{StaticResource LabelText}"
                           ToolTip="{loc:T Effects_MasterGain_Tip}"/>
                <Slider     Grid.Column="1" x:Name="MasterGainSlider"
                            ToolTip="{loc:T Effects_MasterGain_Tip}"
                            Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                            TickFrequency="0.25" ValueChanged="MasterGainSlider_ValueChanged" VerticalAlignment="Center"/>
                <Border Visibility="{Binding Visibility, ElementName=MasterGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="MasterGainText" Text="1.00"/></Border>
            </Grid>
            <!-- (The old "Active car" Save/Delete box was removed: per-car
                 tuning now saves via each effect's ★/Save popover ("For this
                 car"), and deleting a car preset lives in Manage Presets. The
                 header car-preset picker still switches the active car preset.) -->

            <!-- FFB tweaks: optional force-feedback comfort/feel adjustments,
                 collapsed by default so they don't crowd the top of the Effects
                 tab. Holds the parked-car "stationary spring" and FFB spike
                 reduction. -->

            <!-- Effects -->
            <Border Style="{StaticResource SectionHeaderBorder}" Margin="0,24,0,12"><TextBlock Text="{loc:T Effects_Effects}" Style="{StaticResource SectionHeaderText}"/></Border>

            <!-- Audio capture (game audio → wheel). Lives outside the
                 telemetry-greyed panel because it works even when the game
                 emits no useful telemetry (custom SimHub games etc). -->
            <Expander x:Name="AudioExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="AudioEnabledCheck" Content="{loc:T Effects_AudioEnabled}"
                                  FontWeight="SemiBold" VerticalAlignment="Center"
                                  ToolTip="{loc:T Effects_AudioEnabled_Tip}"
                                  Checked="AudioEnabled_Changed" Unchecked="AudioEnabled_Changed"/>
                        <Border x:Name="AudioNewBadge" Style="{StaticResource NewEffectBadge}">
                            <TextBlock Text="{loc:T Common_New}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="AudioOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                        <Button    x:Name="AudioRevertBtn"  Content="↶" Tag="Audio" Margin="14,0,0,0"
                                   Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                        <Button    x:Name="AudioSaveBtn"    Content="{loc:T Common_SaveEllipsis}" Tag="Audio"
                                   Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T Common_Gain}" Style="{StaticResource LabelText}"/>
                        <Slider     Grid.Column="1" x:Name="AudioGainSlider"
                                    Minimum="0" Maximum="3.0" SmallChange="0.05" LargeChange="0.25"
                                    TickFrequency="0.5" ValueChanged="AudioGainSlider_ValueChanged" VerticalAlignment="Center"/>
                        <Border Visibility="{Binding Visibility, ElementName=AudioGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="AudioGainText" Text="1.00"/></Border>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T Effects_AudioHighpassHz}" Style="{StaticResource LabelText}"/>
                        <Slider     Grid.Column="1" x:Name="AudioHighpassSlider"
                                    Minimum="0" Maximum="200" SmallChange="5" LargeChange="20"
                                    TickFrequency="20" ValueChanged="AudioHighpassSlider_ValueChanged" VerticalAlignment="Center"/>
                        <Border Visibility="{Binding Visibility, ElementName=AudioHighpassText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="AudioHighpassText" Text="30"/></Border>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T Effects_AudioLowpassHz}" Style="{StaticResource LabelText}"/>
                        <Slider     Grid.Column="1" x:Name="AudioFilterSlider"
                                    Minimum="100" Maximum="1500" SmallChange="10" LargeChange="50"
                                    TickFrequency="100" ValueChanged="AudioFilterSlider_ValueChanged" VerticalAlignment="Center"/>
                        <Border Visibility="{Binding Visibility, ElementName=AudioFilterText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="AudioFilterText" Text="350"/></Border>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T Effects_AudioLevel}" Style="{StaticResource LabelText}"/>
                        <ProgressBar Grid.Column="1" x:Name="AudioLevelMeter" Minimum="0" Maximum="1" Height="14" Foreground="#4CAF50"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T Effects_AudioStatus}" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Column="1" x:Name="CaptureStatusText" Text="{loc:T Effects_CaptureStatus}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Power-user: per-game capture exe override. Hidden by
                         default; surfaces when auto-detect misses a game. -->
                    <Expander x:Name="CaptureNotWorkingExpander" IsExpanded="False" Margin="0,8,0,0">
                        <Expander.Header>
                            <TextBlock Text="{loc:T Effects_CaptureNotWorkingAudioCaptureNotPicking}" FontSize="12"/>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,4"
                                       Text="{loc:T Effects_CaptureNotWorkingTypeTheGameSExeName}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:T Effects_CaptureNotWorkingCaptureExe}" Style="{StaticResource LabelText}"/>
                                <TextBox   Grid.Column="1" x:Name="CaptureExeOverrideBox"
                                           VerticalAlignment="Center" LostFocus="CaptureExeOverride_LostFocus"
                                           KeyDown="CaptureExeOverride_KeyDown"
                                           ToolTip="{loc:T Effects_CaptureExeOverride_Tip}"/>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Expander>

            <!-- Telemetry-driven effects: greyed when a game is running but
                 emits no useful telemetry (e.g. SimHub custom games where
                 only audio capture produces output). When no game is loaded,
                 the panel stays enabled so the user can still tune presets
                 for future sessions. -->
            <StackPanel x:Name="TelemetryEffectsPanel">

                <!-- Engine pulse -->
                <Expander x:Name="EngineExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="EngineEnabledCheck" Content="{loc:T Effects_EngineEnabled}"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      ToolTip="{loc:T Effects_EngineEnabled_Tip}"
                                      Checked="EngineEnabled_Changed" Unchecked="EngineEnabled_Changed"/>
                            <Border x:Name="EngineNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="{loc:T Common_New}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="EngineOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="{loc:T Common_Test}" Style="{StaticResource EffectTestButton}" Click="EngineTest_Click"/>
                            <Button x:Name="EngineRevertBtn" Content="↶" Tag="Engine" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="EngineSaveBtn"   Content="{loc:T Common_SaveEllipsis}" Tag="Engine" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <!-- Evergreen guidance (not a migration note) so it reads
                             right for new users too. -->
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8"
                                   Text="{loc:T Effects_EngineSetTheEngineType}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Gain}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="EngineGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="EngineGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=EngineGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="EngineGainText" Text="1.00"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_EnginePitch}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="EnginePitchSlider" Minimum="0.25" Maximum="4.0" SmallChange="0.05" LargeChange="0.25"
                                        TickFrequency="0.25" ValueChanged="EnginePitchSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=EnginePitchText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="EnginePitchText" Text="1.00"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Waveform}" Style="{StaticResource LabelText}"/>
                            <ComboBox  Grid.Column="1" x:Name="EngineWaveformCombo" SelectionChanged="EngineWaveform_Changed">
                                <ComboBoxItem Content="{loc:T Common_Sine}"/><ComboBoxItem Content="{loc:T Common_Square}"/><ComboBoxItem Content="{loc:T Common_Saw}"/><ComboBoxItem Content="{loc:T Common_Triangle}"/><ComboBoxItem Content="{loc:T Common_Noise}"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_EngineLowpassHz}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_EngineLowpassHz_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="EngineLowpassSlider" Minimum="0" Maximum="2000" SmallChange="10" LargeChange="50"
                                        TickFrequency="200" ValueChanged="EngineLowpassSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=EngineLowpassText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="EngineLowpassText" Text="0"/></Border>
                        </Grid>
                        <!-- Electric car behavior: applies only when the resolver
                             flags the active car as a pure EV. Combustion cars
                             ignore this. Per-car preset overrides the global. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_EngineElectricCars}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_EngineElectricCars_Tip}"/>
                            <ComboBox  Grid.Column="1" x:Name="EngineElectricModeCombo" SelectionChanged="EngineElectricMode_Changed">
                                <ComboBoxItem Content="{loc:T Effects_EngineElectricModeMutedHum25}"/>
                                <ComboBoxItem Content="{loc:T Effects_EngineElectricModeSilentOff}"/>
                            </ComboBox>
                        </Grid>
                        <!-- Engine TYPE, its auto-detect/community context, the
                             variant readout, and the pattern readout all moved to
                             the Car facts panel on the active card (2026-07
                             centralization): the engine is car truth, not preset
                             feel. This section keeps feel knobs only; the Car
                             facts guidance line sits at the top of the section. -->
                        <!-- High-RPM perceptibility helpers. On by default;
                             keep the engine feel present where the wheel
                             motor naturally rolls off the firing pulse. -->
                        <Separator Margin="0,8,0,8"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="EngineLoadLayerCheck"
                                      Content="{loc:T Effects_EngineLoadLayer}" VerticalAlignment="Center"
                                      Checked="EngineLoadLayer_Changed" Unchecked="EngineLoadLayer_Changed"
                                      ToolTip="{loc:T Effects_EngineLoadLayer_Tip}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_EngineStrength}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="EngineLoadLayerGainSlider" Minimum="0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="EngineLoadLayerGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=EngineLoadLayerGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="EngineLoadLayerGainText" Text="0.80"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="EngineHighRpmBoostCheck"
                                      Content="{loc:T Effects_EngineHighRpmBoost}" VerticalAlignment="Center"
                                      Checked="EngineHighRpmBoost_Changed" Unchecked="EngineHighRpmBoost_Changed"
                                      ToolTip="{loc:T Effects_EngineHighRpmBoost_Tip}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_EngineAmount}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="EngineHighRpmBoostSlider" Minimum="0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="EngineHighRpmBoostSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=EngineHighRpmBoostText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="EngineHighRpmBoostText" Text="0.70"/></Border>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Road bumps -->
                <Expander x:Name="BumpsExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="SlipEnabledCheck" Content="{loc:T Effects_SlipEnabled}"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="SlipEnabled_Changed" Unchecked="SlipEnabled_Changed"/>
                            <Border x:Name="BumpsNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="{loc:T Common_New}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="BumpsOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="{loc:T Common_Test}" Style="{StaticResource EffectTestButton}" Click="BumpsTest_Click"/>
                            <Button x:Name="BumpsRevertBtn" Content="↶" Tag="Bumps" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="BumpsSaveBtn"   Content="{loc:T Common_SaveEllipsis}" Tag="Bumps" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Gain}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="SlipGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="SlipGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=SlipGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="SlipGainText" Text="1.00"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Waveform}" Style="{StaticResource LabelText}"/>
                            <ComboBox  Grid.Column="1" x:Name="BumpsWaveformCombo" SelectionChanged="BumpsWaveform_Changed">
                                <ComboBoxItem Content="{loc:T Common_Sine}"/><ComboBoxItem Content="{loc:T Common_Square}"/><ComboBoxItem Content="{loc:T Common_Saw}"/><ComboBoxItem Content="{loc:T Common_Triangle}"/><ComboBoxItem Content="{loc:T Common_Noise}"/>
                            </ComboBox>
                        </Grid>
                        <Grid x:Name="BumpsFreqRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_FrequencyHz}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="BumpsFreqSlider" Minimum="20" Maximum="300" SmallChange="1" LargeChange="10"
                                        TickFrequency="20" ValueChanged="BumpsFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=BumpsFreqText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="BumpsFreqText" Text="60"/></Border>
                        </Grid>

                        <!-- FS-only: the Kerb thump voice folded into this
                             section as its "Leading edge" dimension (owner
                             call 2026-08-08). Drives the SAME KerbThump
                             settings block the standalone (Forza) section
                             edits, so presets carry one identity; 0 on this
                             slider means off (no separate enable in the
                             folded shape). -->
                        <StackPanel x:Name="BumpsLeadingEdgePanel" Visibility="Collapsed">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:T Effects_BumpsLeadingEdge}" Style="{StaticResource LabelText}"
                                           ToolTip="{loc:T Effects_BumpsLeadingEdge_Tip}"/>
                                <Slider     Grid.Column="1" x:Name="BumpsLeadingEdgeSlider" Minimum="0" Maximum="3" SmallChange="0.05" LargeChange="0.1"
                                            TickFrequency="0.25" ValueChanged="BumpsLeadingEdge_ValueChanged" VerticalAlignment="Center"/>
                                <Border Visibility="{Binding Visibility, ElementName=BumpsLeadingEdgeText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="BumpsLeadingEdgeText" Text="0.00"/></Border>
                            </Grid>
                        </StackPanel>

                        <!-- Surface texture (Forza-supplied SurfaceRumble + WheelOnRumbleStrip).
                             Has its own oscillator so the user can pick a higher freq /
                             brighter waveform than the heave path. Visible ONLY while a
                             Forza title is active (RefreshFromPlugin): no other source
                             supplies SurfaceRumble, and dead knobs in other games read
                             as broken (owner call 2026-08-08). -->
                        <Border x:Name="BumpsSurfacePanel" BorderThickness="0,1,0,0" BorderBrush="#22FFFFFF" Margin="0,4,0,8" Padding="0,8,0,0">
                            <StackPanel>
                                <CheckBox x:Name="BumpsSurfaceEnabledCheck" Content="{loc:T Effects_BumpsSurfaceEnabled}" FontWeight="SemiBold" Margin="0,0,0,4"
                                          Checked="BumpsSurfaceEnabled_Changed" Unchecked="BumpsSurfaceEnabled_Changed"
                                          ToolTip="{loc:T Effects_BumpsSurfaceEnabled_Tip}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:T Effects_BumpsSurfaceGain}" Style="{StaticResource LabelText}"/>
                                    <Slider     Grid.Column="1" x:Name="BumpsSurfaceGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                                TickFrequency="0.25" ValueChanged="BumpsSurfaceGainSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <Border Visibility="{Binding Visibility, ElementName=BumpsSurfaceGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="BumpsSurfaceGainText" Text="1.00"/></Border>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:T Effects_BumpsSurfaceFreqHz}" Style="{StaticResource LabelText}"/>
                                    <Slider     Grid.Column="1" x:Name="BumpsSurfaceFreqSlider" Minimum="20" Maximum="600" SmallChange="5" LargeChange="25"
                                                TickFrequency="50" ValueChanged="BumpsSurfaceFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <Border Visibility="{Binding Visibility, ElementName=BumpsSurfaceFreqText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="BumpsSurfaceFreqText" Text="120"/></Border>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:T Effects_BumpsSurfaceWaveform}" Style="{StaticResource LabelText}"/>
                                    <ComboBox  Grid.Column="1" x:Name="BumpsSurfaceWaveformCombo" SelectionChanged="BumpsSurfaceWaveform_Changed">
                                        <ComboBoxItem Content="{loc:T Common_Sine}"/><ComboBoxItem Content="{loc:T Common_Square}"/><ComboBoxItem Content="{loc:T Common_Saw}"/><ComboBoxItem Content="{loc:T Common_Triangle}"/><ComboBoxItem Content="{loc:T Common_Noise}"/>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:T Effects_BumpsSurfaceRumbleScale}" Style="{StaticResource LabelText}"
                                               ToolTip="{loc:T Effects_BumpsSurfaceRumbleScale_Tip}"/>
                                    <Slider     Grid.Column="1" x:Name="BumpsSurfaceRumbleScaleSlider" Minimum="0.1" Maximum="3.0" SmallChange="0.1" LargeChange="0.25"
                                                TickFrequency="0.25" ValueChanged="BumpsSurfaceRumbleScaleSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <Border Visibility="{Binding Visibility, ElementName=BumpsSurfaceRumbleScaleText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="BumpsSurfaceRumbleScaleText" Text="1.00"/></Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>

                <!-- Traction loss -->
                <Expander x:Name="TractionExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="TractionEnabledCheck" Content="{loc:T Effects_TractionEnabled}"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="TractionEnabled_Changed" Unchecked="TractionEnabled_Changed"/>
                            <Border x:Name="TractionNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="{loc:T Common_New}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="TractionOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="{loc:T Common_Test}" Style="{StaticResource EffectTestButton}" Click="TractionTest_Click"/>
                            <Button x:Name="TractionRevertBtn" Content="↶" Tag="Traction" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="TractionSaveBtn"   Content="{loc:T Common_SaveEllipsis}" Tag="Traction" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Gain}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="TractionGainSlider" Minimum="0" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="TractionGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=TractionGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="TractionGainText" Text="1.00"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_TractionSensitivity}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="TractionSensitivitySlider" Minimum="0.1" Maximum="3.0" SmallChange="0.1" LargeChange="0.25"
                                        TickFrequency="0.25" ValueChanged="TractionSensitivitySlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=TractionSensitivityText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="TractionSensitivityText" Text="1.00"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Waveform}" Style="{StaticResource LabelText}"/>
                            <ComboBox  Grid.Column="1" x:Name="TractionWaveformCombo" SelectionChanged="TractionWaveform_Changed">
                                <ComboBoxItem Content="{loc:T Common_Sine}"/><ComboBoxItem Content="{loc:T Common_Square}"/><ComboBoxItem Content="{loc:T Common_Saw}"/><ComboBoxItem Content="{loc:T Common_Triangle}"/><ComboBoxItem Content="{loc:T Common_Noise}"/>
                            </ComboBox>
                        </Grid>
                        <Grid x:Name="TractionFreqRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_FrequencyHz}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="TractionFreqSlider" Minimum="20" Maximum="300" SmallChange="1" LargeChange="10"
                                        TickFrequency="20" ValueChanged="TractionFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=TractionFreqText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="TractionFreqText" Text="100"/></Border>
                        </Grid>
                        <!-- Noise filter rows: only relevant for Noise waveform.
                             Collapsed otherwise so the panel doesn't show
                             controls that have no audible effect. -->
                        <Grid x:Name="TractionNoiseLpRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_TractionNoiseLpRowNoiseLowpassHz}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_TractionNoiseLpRowNoiseLowpassHz_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="TractionNoiseLpSlider" Minimum="50" Maximum="1000" SmallChange="10" LargeChange="50"
                                        TickFrequency="100" ValueChanged="TractionNoiseLpSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=TractionNoiseLpText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="TractionNoiseLpText" Text="250"/></Border>
                        </Grid>
                        <Grid x:Name="TractionNoiseHpRow" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_TractionNoiseHpRowNoiseHighpassHz}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_TractionNoiseHpRowNoiseHighpassHz_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="TractionNoiseHpSlider" Minimum="0" Maximum="200" SmallChange="5" LargeChange="20"
                                        TickFrequency="20" ValueChanged="TractionNoiseHpSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=TractionNoiseHpText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="TractionNoiseHpText" Text="30"/></Border>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Axle slip (which end of the car is letting go). A high
                     scrub texture as the front washes wide, a deep pulse as
                     the rear steps out. Needs per-tire telemetry. -->
                <Expander x:Name="AxleSlipExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="AxleSlipEnabledCheck" Content="{loc:T Effects_AxleSlipEnabled}"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="AxleSlipEnabled_Changed" Unchecked="AxleSlipEnabled_Changed"/>
                            <Border x:Name="AxleSlipNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="{loc:T Common_New}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="AxleSlipOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="{loc:T Common_Test}" Style="{StaticResource EffectTestButton}" Click="AxleSlipTest_Click"/>
                            <Button x:Name="AxleSlipRevertBtn" Content="↶" Tag="AxleSlip" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="AxleSlipSaveBtn"   Content="{loc:T Common_SaveEllipsis}" Tag="AxleSlip" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="{loc:T Effects_AxleSlipFeelWhichAxleIsSlipping}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Gain}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="AxleSlipGainSlider" Minimum="0" Maximum="3" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="AxleSlipGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=AxleSlipGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="AxleSlipGainText" Text="1.00"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_AxleSlipFrontStrength}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_AxleSlipFrontStrength_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="AxleSlipFrontStrengthSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                        TickFrequency="0.1" ValueChanged="AxleSlipFrontStrengthSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=AxleSlipFrontStrengthText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="AxleSlipFrontStrengthText" Text="0.30"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_AxleSlipRearStrength}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_AxleSlipRearStrength_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="AxleSlipRearStrengthSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                        TickFrequency="0.1" ValueChanged="AxleSlipRearStrengthSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=AxleSlipRearStrengthText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="AxleSlipRearStrengthText" Text="0.21"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_AxleSlipFrontPitchHz}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_AxleSlipFrontPitchHz_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="AxleSlipFrontPitchSlider" Minimum="100" Maximum="350" SmallChange="5" LargeChange="25"
                                        TickFrequency="25" ValueChanged="AxleSlipFrontPitchSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=AxleSlipFrontPitchText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="AxleSlipFrontPitchText" Text="200"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_AxleSlipRearPitchHz}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_AxleSlipRearPitchHz_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="AxleSlipRearPitchSlider" Minimum="25" Maximum="90" SmallChange="1" LargeChange="5"
                                        TickFrequency="5" ValueChanged="AxleSlipRearPitchSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=AxleSlipRearPitchText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="AxleSlipRearPitchText" Text="35"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_AxleSlipUndersteerJudder}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_AxleSlipUndersteerJudder_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="AxleSlipJudderSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                        TickFrequency="0.1" ValueChanged="AxleSlipJudderSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=AxleSlipJudderText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="AxleSlipJudderText" Text="0.80"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_AxleSlipOnsetThreshold}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_AxleSlipOnsetThreshold_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="AxleSlipOnsetSlider" Minimum="0.7" Maximum="0.95" SmallChange="0.01" LargeChange="0.05"
                                        TickFrequency="0.05" ValueChanged="AxleSlipOnsetSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=AxleSlipOnsetText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="AxleSlipOnsetText" Text="0.85"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="AxleSlipPredictiveCheck"
                                      Content="{loc:T Effects_AxleSlipPredictive}" VerticalAlignment="Center"
                                      Checked="AxleSlipPredictive_Changed" Unchecked="AxleSlipPredictive_Changed"
                                      ToolTip="{loc:T Effects_AxleSlipPredictive_Tip}"/>
                        </Grid>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="AxleSlipRevLockedCheck"
                                      Content="{loc:T Effects_AxleSlipRevLocked}" VerticalAlignment="Center"
                                      Checked="AxleSlipRevLocked_Changed" Unchecked="AxleSlipRevLocked_Changed"
                                      ToolTip="{loc:T Effects_AxleSlipRevLocked_Tip}"/>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Kerb thump (first-contact whack, distinct from the rumble
                     that follows). Needs kerb telemetry. -->
                <Expander x:Name="KerbThumpExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="KerbThumpEnabledCheck" Content="{loc:T Effects_KerbThumpEnabled}"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="KerbThumpEnabled_Changed" Unchecked="KerbThumpEnabled_Changed"/>
                            <Border x:Name="KerbThumpNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="{loc:T Common_New}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="KerbThumpOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="{loc:T Common_Test}" Style="{StaticResource EffectTestButton}" Click="KerbThumpTest_Click"/>
                            <Button x:Name="KerbThumpRevertBtn" Content="↶" Tag="KerbThump" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="KerbThumpSaveBtn"   Content="{loc:T Common_SaveEllipsis}" Tag="KerbThump" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="{loc:T Effects_KerbThumpASingleFirmWhack}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Gain}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="KerbThumpGainSlider" Minimum="0" Maximum="3" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="KerbThumpGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=KerbThumpGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="KerbThumpGainText" Text="1.60"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_FrequencyHz}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_KerbThumpFrequencyHz_Tip}"/>
                            <Slider     Grid.Column="1" x:Name="KerbThumpFreqSlider" Minimum="15" Maximum="60" SmallChange="1" LargeChange="5"
                                        TickFrequency="5" ValueChanged="KerbThumpFreqSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=KerbThumpFreqText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="KerbThumpFreqText" Text="30"/></Border>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Lockup judder (flat-spot pulse while a braking tire is
                     locked, slowing with the car). Needs per-tire telemetry. -->
                <Expander x:Name="LockupJudderExpander" IsExpanded="False" Margin="0,0,0,4" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="LockupJudderEnabledCheck" Content="{loc:T Effects_LockupJudderEnabled}"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="LockupJudderEnabled_Changed" Unchecked="LockupJudderEnabled_Changed"/>
                            <Border x:Name="LockupJudderNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="{loc:T Common_New}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="LockupJudderOverrideBadge" Style="{StaticResource OverrideBadge}"/>
                            <Button Content="{loc:T Common_Test}" Style="{StaticResource EffectTestButton}" Click="LockupJudderTest_Click"/>
                            <Button x:Name="LockupJudderRevertBtn" Content="↶" Tag="LockupJudder" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="LockupJudderSaveBtn"   Content="{loc:T Common_SaveEllipsis}" Tag="LockupJudder" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="{loc:T Effects_LockupJudderAFlatSpotPulseWhile}"/>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Gain}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="LockupJudderGainSlider" Minimum="0" Maximum="3" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.25" ValueChanged="LockupJudderGainSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=LockupJudderGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="LockupJudderGainText" Text="1.00"/></Border>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Gear shift -->
