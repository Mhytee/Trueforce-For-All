                            <Border Visibility="{Binding Visibility, ElementName=ShiftFreqText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ShiftFreqText" Text="40"/></Border>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Implement thud (Farming Simulator). Shown only while an
                     FS title is active: no other source reports the working
                     flag, and dead knobs read as broken. Global-only (no
                     per-car override badge), but preset-anchored like
                     Airborne: edits surface the Save/Revert pair. -->
                <Expander x:Name="ImplementThudExpander" IsExpanded="False" Margin="0,0,0,4"
                          Visibility="Collapsed" Expanded="EffectExpander_Expanded">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="ImplementThudCheck" Content="{loc:T Effects_ImplementThud}"
                                      FontWeight="SemiBold" VerticalAlignment="Center"
                                      Checked="ImplementThud_Changed" Unchecked="ImplementThud_Changed"
                                      ToolTip="{loc:T Effects_ImplementThud_Tip}"/>
                            <Border x:Name="ImplementThudNewBadge" Style="{StaticResource NewEffectBadge}">
                                <TextBlock Text="{loc:T Common_New}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <Button Content="{loc:T Common_Test}" Style="{StaticResource EffectTestButton}" Click="ImplementThudTest_Click"/>
                            <Button x:Name="ImplementThudRevertBtn" Content="↶" Tag="ImplementThud" Style="{StaticResource EffectRevertButton}" Click="EffectRevert_Click"/>
                            <Button x:Name="ImplementThudSaveBtn"   Content="{loc:T Common_SaveEllipsis}" Tag="ImplementThud" Style="{StaticResource EffectSaveButton}" Click="EffectSave_Click"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Gain}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="ImplementThudGainSlider" Minimum="0" Maximum="3.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="ImplementThudGain_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=ImplementThudGainText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ImplementThudGainText" Text="1.00"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_Waveform}" Style="{StaticResource LabelText}"/>
                            <ComboBox  Grid.Column="1" x:Name="ImplementThudWaveformCombo" SelectionChanged="ImplementThudWaveform_Changed">
                                <ComboBoxItem Content="{loc:T Common_Sine}"/><ComboBoxItem Content="{loc:T Common_Square}"/><ComboBoxItem Content="{loc:T Common_Saw}"/><ComboBoxItem Content="{loc:T Common_Triangle}"/><ComboBoxItem Content="{loc:T Common_Noise}"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Common_FrequencyHz}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="ImplementThudFreqSlider" Minimum="20" Maximum="100" SmallChange="1" LargeChange="5"
                                        TickFrequency="10" ValueChanged="ImplementThudFreq_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=ImplementThudFreqText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ImplementThudFreqText" Text="30"/></Border>
                        </Grid>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T Effects_ImplementThudRaiseAmount}" Style="{StaticResource LabelText}"
                                       ToolTip="{loc:T Effects_ImplementThudRaiseAmount_Tip}"/>
