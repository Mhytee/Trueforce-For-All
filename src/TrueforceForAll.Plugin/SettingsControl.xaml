                                <ComboBoxItem Content="{loc:T Common_Sine}"/><ComboBoxItem Content="{loc:T Common_Square}"/><ComboBoxItem Content="{loc:T Common_Saw}"/><ComboBoxItem Content="{loc:T Common_Triangle}"/><ComboBoxItem Content="{loc:T Common_Noise}"/>
                            </ComboBox>
