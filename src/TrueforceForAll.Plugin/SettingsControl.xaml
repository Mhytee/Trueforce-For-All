                    <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_ModeBForzaTuningPanel2HowQuicklySteeringWeight}"/>

                    <!-- Global grip-limit fallback: only relevant when per-car grip auto-calibration
