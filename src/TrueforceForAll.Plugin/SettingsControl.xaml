                         so the row is hidden while auto-cal is on (see UpdateModeBGripLimitVisibility). -->
                    <StackPanel x:Name="ModeBGripLimitRow">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:T TelemetryFfb_ModeBGripLimitRowGripLimit}" Style="{StaticResource LabelText}"/>
                            <Slider     Grid.Column="1" x:Name="ModeBPeakSlider" Minimum="0.4" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                        TickFrequency="0.1" ValueChanged="ModeBSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding Visibility, ElementName=ModeBPeakText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="{StaticResource EditableNumberBorder}" CornerRadius="2" Padding="4,1"><TextBox x:Name="ModeBPeakText" Text="1.00"/></Border>
                        </Grid>
                        <TextBlock Style="{StaticResource HelpText}" Margin="140,0,0,8" Text="{loc:T TelemetryFfb_ModeBGripLimitRowWhereTheGameSCombined}"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander IsExpanded="False" Margin="0,0,0,4">
