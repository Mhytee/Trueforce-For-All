<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the pure logic in TrueforceForAll.Core (telemetry
       parsing, synthesis math). Deliberately NOT added to TrueforceForAll.sln
       so it doesn't perturb the net48 plugin build; run it with:
         dotnet test src/TrueforceForAll.Core.Tests
       Core is netstandard2.0, which net8.0 consumes directly. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- InstalledPacksStore (linked below) serializes with Newtonsoft. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- AudioOutputMeter (linked below) reaches Windows' per-endpoint peak
         meter through NAudio.CoreAudioApi. Same version the plugin compiles
         against; nothing here ships, so the never-overwrite-SimHub's-copy rule
         that governs the plugin's reference does not apply. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrueforceForAll.Core\TrueforceForAll.Core.csproj" />
    <ProjectReference Include="..\TrueforceForAll.Engine\TrueforceForAll.Engine.csproj" />
  </ItemGroup>

  <!-- Link-compile the self-contained pack registry from the (net48, SimHub-
       coupled) plugin so its pure merge/dedup logic can be unit-tested here
       without referencing the whole plugin assembly. The file has no WPF /
       SimHub dependencies, only Newtonsoft.Json. -->
  <ItemGroup>
    <Compile Include="..\TrueforceForAll.Plugin\InstalledPacksStore.cs">
      <Link>Linked\InstalledPacksStore.cs</Link>
    </Compile>
    <!-- Shared untrusted-JSON guard the store references (SafeJson.Settings). -->
    <Compile Include="..\TrueforceForAll.Plugin\SafeJson.cs">
      <Link>Linked\SafeJson.cs</Link>
    </Compile>
    <!-- Lovely car-data parsing + the light math built on it. Same rationale as
         InstalledPacksStore: no WPF / SimHub dependencies, only Newtonsoft, and
         the logic is worth testing precisely because the slot-write path it
         feeds cannot be exercised on hardware yet. -->
    <Compile Include="..\TrueforceForAll.Plugin\LovelyCarData.cs">
      <Link>Linked\LovelyCarData.cs</Link>
    </Compile>
    <Compile Include="..\TrueforceForAll.Plugin\LovelyLightMath.cs">
      <Link>Linked\LovelyLightMath.cs</Link>
    </Compile>
    <Compile Include="..\TrueforceForAll.Plugin\LovelyCarDataStore.cs">
      <Link>Linked\LovelyCarDataStore.cs</Link>
    </Compile>
    <!-- Per-channel LED colour trim. BCL only. Worth pinning because three
         separate comparison sites depend on it being deterministic, and a
         rounding change would make them re-upload slots forever. -->
    <Compile Include="..\TrueforceForAll.Plugin\LedColorGain.cs">
      <Link>Linked\LedColorGain.cs</Link>
    </Compile>
    <!-- Light layout library + slot backup: ordering, naming, cycling and the
         backup round-trip are pure logic, and the backup guards a user's saved
         wheel colours, so they are worth pinning. -->
    <Compile Include="..\TrueforceForAll.Plugin\LightPatternLibrary.cs">
      <Link>Linked\LightPatternLibrary.cs</Link>
    </Compile>
    <Compile Include="..\TrueforceForAll.Plugin\LightSlotBackup.cs">
      <Link>Linked\LightSlotBackup.cs</Link>
    </Compile>
    <!-- The wheel button's running order and where in it we stand. Extracted
         from TrueforcePlugin precisely so it could be tested: it produced four
         user-visible bugs in one week while it was unreachable in there. -->
    <Compile Include="..\TrueforceForAll.Plugin\LightCycle.cs">
      <Link>Linked\LightCycle.cs</Link>
    </Compile>
    <!-- Rev-level decision. Links cleanly because the controller talks to
         WheelLedChannel (Core) and nothing else, and an unopened channel is
         inert, so the level maths can be exercised with no wheel present.
         Worth pinning because the dash mirror reads LastLevel and the whole
         point of computing it apart from the write is that it stays honest in
         the frames where the write does not happen. -->
    <Compile Include="..\TrueforceForAll.Plugin\RpmLedController.cs">
      <Link>Linked\RpmLedController.cs</Link>
    </Compile>
    <!-- The audio level meter. Only its peak-to-bar mapping is testable
         without a sound card, and that is the part worth pinning: get the
         decibel window wrong and the strip either never lights or never moves,
         with nothing in the log to say so. -->
    <Compile Include="..\TrueforceForAll.Plugin\AudioOutputMeter.cs">
      <Link>Linked\AudioOutputMeter.cs</Link>
    </Compile>
    <!-- The language table behind every localized string. Pure C# by contract
         (no WPF, no SimHub types, Newtonsoft.Json.Linq only) so that layer
         precedence, parent fallback, the missing-key path and the strict file
         parse can be pinned here. The WPF half of the runtime (the markup
         extension, the folder watcher, the diagnostics) is never linked. -->
    <Compile Include="..\TrueforceForAll.Plugin\Localization\LocStore.cs">
      <Link>Linked\LocStore.cs</Link>
    </Compile>
    <!-- The static door to that table. Three of the linked files above now
         read their display text through it, and it is WPF-free by the same
         contract, so it links too. With no store initialized every call
         returns the key, which is what a test wants: a label asserted here
         is asserted as a key, not as one language's wording. -->
    <Compile Include="..\TrueforceForAll.Plugin\Localization\Loc.cs">
      <Link>Linked\Loc.cs</Link>
    </Compile>
    <!-- The two pure halves of the translation service's client side. LocFile holds
         the hash that names an English, which is the contract a mixed-version fleet
         rests on, and the file shape the tools also write. LocPlaceholderRules is the
         gate every fetched row passes before it can reach a label. Both are file and
         string code with no WPF and no HTTP, so they compile here and the rules are
         asserted rather than trusted. -->
    <Compile Include="..\TrueforceForAll.Plugin\Localization\LocFile.cs">
      <Link>Linked\LocFile.cs</Link>
    </Compile>
    <Compile Include="..\TrueforceForAll.Plugin\Localization\LocPlaceholderRules.cs">
      <Link>Linked\LocPlaceholderRules.cs</Link>
    </Compile>
    <!-- The plural rules. Pure arithmetic over a language tag and a count, and the one
         part of the localization runtime whose failure is invisible: a wrong category
         shows an ungrammatical sentence rather than a missing one, in a language the
         maintainer does not read. Asserted count by count in LocPluralTests. -->
    <Compile Include="..\TrueforceForAll.Plugin\Localization\LocPlurals.cs">
      <Link>Linked\LocPlurals.cs</Link>
    </Compile>
    <!-- Which language tags reach the picker. Pure, and linked here because the culture
         table differs between net48 and net8: the rule is asserted against fixed inputs
         rather than against whichever table the test host carries. -->
    <Compile Include="..\TrueforceForAll.Plugin\Localization\LocLanguageList.cs">
      <Link>Linked\LocLanguageList.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
