                                      },
                                      {
                                          "$type":  "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.EllipseItem, SimHub.Plugins",
                                          "FillColor":  "#00FFFFFF",
                                          "EllipseColor":  "#FFA0A0A0",
                                          "EllipseThickness":  2,
                                          "EllipseBackgroundImage":  "None",
                                          "BackgroundColor":  "#00FFFFFF",
                                          "Height":  28,
                                          "Left":  382.5,
                                          "Opacity":  56,
                                          "Top":  318,
                                          "Visible":  true,
                                          "Width":  35,
                                          "Rotation":  0,
                                          "RenderingSkip":  0,
                                          "IsFreezed":  false,
                                          "Name":  "idle-fld0",
                                          "Bindings":  {
                                                           "EllipseColor":  {
                                                                                "Formula":  {
                                                                                                "Interpreter":  1,
                                                                                                "Expression":  "return \"\"+$prop(\"TrueforcePlugin.Dash.Theme.Accent1\")"
                                                                                            },
                                                                                "Mode":  2,
                                                                                "TargetPropertyName":  "EllipseColor"
                                                                            },
                                                           "Left":  {
                                                                        "Formula":  {
                                                                                        "Interpreter":  1,
                                                                                        "Expression":  "var T=(1*$prop(\"TrueforcePlugin.Dash.Idle.T\"));var s=(\"\"+($prop(\"TrueforcePlugin.Dash.Idle.Style\")||\"Aurora\"));var x,r;if(s==\"Spiral\"){var b=14*(1+0.08*Math.sin(6.283185307*(2*T+0)));var th=0+6.283185307*T;x=400+b*Math.cos(th)*1.4;r=3.5;}else if(s==\"Ribbon\"){var p=T-0;x=400+300*Math.sin(6.283185307*3*p);r=15;}else if(s==\"Wave\"){x=60;r=8;}else if(s==\"Warp\"){var q=(T+0)%1;x=400+(20+520*q)*1;r=2+11*q;}else if(s==\"Orbit\"){x=400+160*Math.cos(6.283185307*(0+T))+80*Math.cos(6.283185307*(0+2*T));r=6;}else if(s==\"Caustics\"){x=50+18*Math.sin(6.283185307*(T+0));r=46+26*Math.sin(6.283185307*(2*T+0));}else if(s==\"Fractal\"){var q=(T+0)%1;var sc=Math.pow(1.6,8*q);var an=0+0.7853982*q;x=400+11*sc*Math.cos(an);r=4.2*sc;}else if(s==\"Rain\"){var q=(2*T+0)%1;r=80*Math.pow(q,0.65)*(1-Math.pow(q,12));x=392.2;}else if(s==\"Pipes\"){var hd=T\u003c0.7?T/0.7*70:70;var tl=T\u003c0.7?0:(T-0.7)/0.3*70;r=17*Math.min(1,Math.max(0,hd-0))*Math.min(1,Math.max(0,0-tl+1));x=136;}else{x=400+150*Math.sin(6.283185307*(1*T+0));r=(14+7*Math.sin(6.283185307*(2*T+0)))*1.25;}return x-r"
                                                                                    },
                                                                        "Mode":  2,
                                                                        "TargetPropertyName":  "Left"
                                                                    },
                                                           "Top":  {
                                                                       "Formula":  {
                                                                                       "Interpreter":  1,
                                                                                       "Expression":  "var T=(1*$prop(\"TrueforcePlugin.Dash.Idle.T\"));var s=(\"\"+($prop(\"TrueforcePlugin.Dash.Idle.Style\")||\"Aurora\"));var y,r;if(s==\"Spiral\"){var b=14*(1+0.08*Math.sin(6.283185307*(2*T+0)));var th=0+6.283185307*T;y=240+b*Math.sin(th)*0.92;r=3.5;}else if(s==\"Ribbon\"){var p=T-0;y=240+185*Math.sin(6.283185307*(2*p+0.25));r=15;}else if(s==\"Wave\"){y=92+26*Math.sin(6.283185307*(T+0))+14*Math.sin(6.283185307*(2*T+0));r=8;}else if(s==\"Warp\"){var q=(T+0)%1;y=240+(20+520*q)*0*0.62;r=2+11*q;}else if(s==\"Orbit\"){y=240+110*Math.sin(6.283185307*(0+T))+55*Math.sin(6.283185307*(0+2*T));r=6;}else if(s==\"Caustics\"){y=58+14*Math.cos(6.283185307*(2*T+0));r=34+20*Math.cos(6.283185307*(3*T+0));}else if(s==\"Fractal\"){var q=(T+0)%1;var sc=Math.pow(1.6,8*q);var an=0+0.7853982*q;y=240+11*sc*Math.sin(an)*0.62;r=4.2*sc;}else if(s==\"Rain\"){var q=(2*T+0)%1;r=80*Math.pow(q,0.65)*(1-Math.pow(q,12));y=171.1;r=r*0.55;}else if(s==\"Pipes\"){var hd=T\u003c0.7?T/0.7*70:70;var tl=T\u003c0.7?0:(T-0.7)/0.3*70;r=17*Math.min(1,Math.max(0,hd-0))*Math.min(1,Math.max(0,0-tl+1));y=102;}else{y=240+92*Math.cos(6.283185307*(2*T+0));r=14+7*Math.sin(6.283185307*(2*T+0));}return y-r"
                                                                                   },
                                                                       "Mode":  2,
                                                                       "TargetPropertyName":  "Top"
                                                                   },
                                                           "Width":  {
                                                                         "Formula":  {
                                                                                         "Interpreter":  1,
                                                                                         "Expression":  "var T=(1*$prop(\"TrueforcePlugin.Dash.Idle.T\"));var s=(\"\"+($prop(\"TrueforcePlugin.Dash.Idle.Style\")||\"Aurora\"));var r;if(s==\"Spiral\"){r=3.5;}else if(s==\"Ribbon\"){r=15;}else if(s==\"Wave\"){r=8;}else if(s==\"Warp\"){r=2+11*((T+0)%1);}else if(s==\"Orbit\"){r=6;}else if(s==\"Caustics\"){r=46+26*Math.sin(6.283185307*(2*T+0));}else if(s==\"Fractal\"){var q=(T+0)%1;var sc=Math.pow(1.6,8*q);r=4.2*sc;}else if(s==\"Rain\"){var q=(2*T+0)%1;r=80*Math.pow(q,0.65)*(1-Math.pow(q,12));}else if(s==\"Pipes\"){var hd=T\u003c0.7?T/0.7*70:70;var tl=T\u003c0.7?0:(T-0.7)/0.3*70;r=17*Math.min(1,Math.max(0,hd-0))*Math.min(1,Math.max(0,0-tl+1));}else{r=(14+7*Math.sin(6.283185307*(2*T+0)))*1.25;}return r*2"
                                                                                     },
                                                                         "Mode":  2,
                                                                         "TargetPropertyName":  "Width"
                                                                     },
                                                           "Height":  {
                                                                          "Formula":  {
                                                                                          "Interpreter":  1,
