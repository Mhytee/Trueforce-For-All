                                                                        "Formula":  {
                                                                                        "Interpreter":  1,
                                                                                        "Expression":  "var n=($prop(\"TrueforcePlugin.Dash.TabSlot0.On\")?1:0)+($prop(\"TrueforcePlugin.Dash.TabSlot1.On\")?1:0)+($prop(\"TrueforcePlugin.Dash.TabSlot2.On\")?1:0)+($prop(\"TrueforcePlugin.Dash.TabSlot3.On\")?1:0)+($prop(\"TrueforcePlugin.Dash.TabSlot4.On\")?1:0)+($prop(\"TrueforcePlugin.Dash.TabSlot5.On\")?1:0)+($prop(\"TrueforcePlugin.Dash.TabSlot6.On\")?1:0);if(n\u003c1)n=7;return 10+0*(784/n)"
                                                                                    },
