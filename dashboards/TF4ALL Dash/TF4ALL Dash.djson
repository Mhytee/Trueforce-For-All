                                          "Name":  "flag-bg",
                                          "Bindings":  {
                                                           "BackgroundColor":  {
                                                                                   "Formula":  {
                                                                                                   "Interpreter":  1,
                                                                                                   "Expression":  "if($prop(\"DataCorePlugin.GameData.NewData.Flag_Yellow\"))return \"#F2E8C33D\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_Blue\"))return \"#F23D7FE8\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_Black\"))return \"#F21A1A1A\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_White\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_Checkered\"))return \"#F2E8EAEE\";return \"#00FFFFFF\""
                                                                                               },
                                                                                   "Mode":  2,
                                                                                   "TargetPropertyName":  "BackgroundColor"
                                                                               },
                                                           "Visible":  {
                                                                           "Formula":  {
                                                                                           "Interpreter":  1,
                                                                                           "Expression":  "return $prop(\"TrueforcePlugin.Dash.FlagsOn\") \u0026\u0026 ($prop(\"DataCorePlugin.GameData.NewData.Flag_Yellow\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_Blue\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_Black\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_White\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_Checkered\"))"
                                                                                       },
                                                                           "Mode":  2,
                                                                           "TargetPropertyName":  "Visible"
                                                                       }
                                                       }
                                      },
                                      {
                                          "$type":  "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins",
                                          "FontWeight":  "Bold",
                                          "TextWrapping":  1,
                                          "FontStyle":  "Normal",
                                          "FontSize":  24,
                                          "Text":  "",
                                          "TextColor":  "#FFF2F4F8",
                                          "HorizontalAlignment":  1,
                                          "VerticalAlignment":  1,
                                          "BackgroundColor":  "#00FFFFFF",
                                          "Height":  48,
                                          "Left":  0,
                                          "Opacity":  100,
                                          "Top":  14,
                                          "Visible":  true,
                                          "Width":  800,
                                          "Rotation":  0,
                                          "RenderingSkip":  0,
                                          "IsFreezed":  false,
                                          "Name":  "flag-t",
                                          "Bindings":  {
                                                           "Text":  {
                                                                        "Formula":  {
                                                                                        "Interpreter":  1,
                                                                                        "Expression":  "var n=\"\"+($prop(\"DataCorePlugin.GameData.NewData.Flag_Name\")||\"\");if(n!=\"\")return n.toUpperCase();if($prop(\"DataCorePlugin.GameData.NewData.Flag_Yellow\"))return \"YELLOW FLAG\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_Blue\"))return \"BLUE FLAG\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_Black\"))return \"BLACK FLAG\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_Checkered\"))return \"CHEQUERED FLAG\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_White\"))return \"WHITE FLAG\";return \"\""
                                                                                    },
                                                                        "Mode":  2,
                                                                        "TargetPropertyName":  "Text"
                                                                    },
                                                           "TextColor":  {
                                                                             "Formula":  {
                                                                                             "Interpreter":  1,
                                                                                             "Expression":  "if($prop(\"DataCorePlugin.GameData.NewData.Flag_Black\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_Blue\"))return \"#FFF2F4F8\";return \"#FF101216\""
                                                                                         },
                                                                             "Mode":  2,
                                                                             "TargetPropertyName":  "TextColor"
                                                                         },
                                                           "Visible":  {
                                                                           "Formula":  {
                                                                                           "Interpreter":  1,
                                                                                           "Expression":  "return $prop(\"TrueforcePlugin.Dash.FlagsOn\") \u0026\u0026 ($prop(\"DataCorePlugin.GameData.NewData.Flag_Yellow\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_Blue\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_Black\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_White\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_Checkered\"))"
