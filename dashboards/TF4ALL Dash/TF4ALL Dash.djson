                                                                           "Formula":  {
                                                                                           "Interpreter":  1,
                                                                                           "Expression":  "return $prop(\"TrueforcePlugin.Dash.Idle.On\") \u0026\u0026 [\"Topo\",\"Spiral\",\"Ribbon\",\"Wave\",\"Warp\",\"Orbit\",\"Caustics\",\"Rain\",\"Pipes\",\"Fractal\"].indexOf((\"\"+($prop(\"TrueforcePlugin.Dash.Idle.Style\")||\"Aurora\")))\u003e=0"
                                                                                       },
                                                                           "Mode":  2,
                                                                           "TargetPropertyName":  "Visible"
                                                                       }
                                                       }
