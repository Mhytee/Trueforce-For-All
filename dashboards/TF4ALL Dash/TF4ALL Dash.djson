                                                                        "Formula":  {
                                                                                        "Interpreter":  1,
                                                                                        "Expression":  "var n=\"\"+($prop(\"DataCorePlugin.GameData.NewData.Flag_Name\")||\"\");if(n!=\"\")return n.toUpperCase();if($prop(\"DataCorePlugin.GameData.NewData.Flag_Yellow\"))return \"YELLOW FLAG\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_Blue\"))return \"BLUE FLAG\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_Black\"))return \"BLACK FLAG\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_Checkered\"))return \"CHEQUERED FLAG\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_Orange\"))return \"MEATBALL FLAG\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_Green\"))return \"GREEN FLAG\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_White\"))return \"WHITE FLAG\";return \"\""
                                                                                    },
