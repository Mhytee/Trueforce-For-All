                                                                                   "Formula":  {
                                                                                                   "Interpreter":  1,
                                                                                                   "Expression":  "if($prop(\"DataCorePlugin.GameData.NewData.Flag_Yellow\"))return \"#F2E8C33D\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_Blue\"))return \"#F23D7FE8\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_Black\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_Orange\"))return \"#F21A1A1A\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_Green\"))return \"#F23DC77A\";if($prop(\"DataCorePlugin.GameData.NewData.Flag_White\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_Checkered\"))return \"#F2E8EAEE\";return \"#00FFFFFF\""
                                                                                               },
                                                                                   "Mode":  2,
                                                                                   "TargetPropertyName":  "BackgroundColor"
                                                                               },
                                                           "Opacity":  {
                                                                           "Formula":  {
                                                                                           "Interpreter":  1,
                                                                                           "Expression":  "if(!$prop(\"DataCorePlugin.GameData.NewData.Flag_Yellow\"))return 100;var t=1*$prop(\"TrueforcePlugin.Dash.PulseT\");return 62+38*(0.5+0.5*Math.sin(6.283185307*t))"
                                                                                       },
                                                                           "Mode":  2,
                                                                           "TargetPropertyName":  "Opacity"
                                                                       },
                                                           "Visible":  {
                                                                           "Formula":  {
                                                                                           "Interpreter":  1,
                                                                                           "Expression":  "return $prop(\"TrueforcePlugin.Dash.FlagsOn\") \u0026\u0026 ($prop(\"DataCorePlugin.GameData.NewData.Flag_Yellow\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_Blue\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_Black\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_White\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_Checkered\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_Orange\")||$prop(\"DataCorePlugin.GameData.NewData.Flag_Green\"))"
                                                                                       },
