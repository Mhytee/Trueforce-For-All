                                                                     },
                                                           "BackgroundColor":  {
                                                                                   "Formula":  {
                                                                                                   "Interpreter":  1,
                                                                                                   "Expression":  "return $prop(\"TrueforcePlugin.Dash.TabSlot0.Active\")?\"#FF23503A\":\"#FF232936\""
                                                                                               },
