                                                                        "Formula":  {
                                                                                        "Interpreter":  1,
                                                                                        "Expression":  "var T=(1*$prop(\"TrueforcePlugin.Dash.Idle.T\"));var s=(\"\"+($prop(\"TrueforcePlugin.Dash.Idle.Style\")||\"Aurora\"));var x,r;if(s==\"Spiral\"){var b=14*(1+0.08*Math.sin(6.283185307*(2*T+0)));var th=0+6.283185307*T;x=400+b*Math.cos(th)*1.4;r=3.5;}else if(s==\"Ribbon\"){var p=T-0;x=400+300*Math.sin(6.283185307*3*p);r=15;}else if(s==\"Wave\"){x=60;r=8;}else if(s==\"Warp\"){var q=(T+0)%1;x=400+(20+520*q)*1;r=2+11*q;}else if(s==\"Orbit\"){x=400+160*Math.cos(6.283185307*(0+T))+80*Math.cos(6.283185307*(0+2*T));r=6;}else if(s==\"Caustics\"){x=50+18*Math.sin(6.283185307*(T+0));r=46+26*Math.sin(6.283185307*(2*T+0));}else if(s==\"Fractal\"){var q=(T+0)%1;var sc=Math.pow(1.6,8*q);var an=0+0.7853982*q;x=400+11*sc*Math.cos(an);r=4.2*sc;}else if(s==\"Rain\"){var q=(2*T+0)%1;r=80*Math.pow(q,0.65)*(1-Math.pow(q,12));x=392.2;}else if(s==\"Pipes\"){var hd=T\u003c0.7?T/0.7*70:70;var tl=T\u003c0.7?0:(T-0.7)/0.3*70;r=17*Math.min(1,Math.max(0,hd-0))*Math.min(1,Math.max(0,0-tl+1));x=136;}else{x=400+150*Math.sin(6.283185307*(1*T+0));r=(14+7*Math.sin(6.283185307*(2*T+0)))*1.25;}return x-r"
                                                                                    },
