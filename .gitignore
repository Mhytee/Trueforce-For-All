bin/
obj/
*.user
.vs/
*.suo
packages/
.DS_Store
**/.DS_Store
*.pdb

# USB captures moved to ..\SimHubTrueforce-local\captures (2026-07-07).
# Rule kept so pcaps never get committed if the folder reappears.
captures/

# Ad-hoc working artifacts. Convention: throwaway scratch files get a __
# prefix so they're easy to ignore in bulk. pcap/pcapng captures anywhere
# should never be committed even if they escape captures/.
__*
*.pcap
*.pcapng

# Dev/test harnesses moved to ..\SimHubTrueforce-local\dev-harnesses
# (2026-07-07). Rules kept in case they get copied back for wheel work.
/src/SineTest/
/src/DiscoveryTest/
/src/UsbPcapTest/

# Maintainer-only running changelog. Local dev notes, not a user-facing doc.
# (RELEASING.md is tracked as the public release checklist.)
/CHANGELOG_UNRELEASED.md

# Maintainer-only marketing copy + design drafts + private docs. Working
# notes for outreach posts and feature planning; not part of the public
# product docs.
/docs/marketing/
/docs/preset-sharing-design.md
/docs/troubleshooting-ffb.md
/docs/agent-audit.md
/docs/haptic-engine-merge-plan.md
/docs/TESTER-HANDOFF.md
# Internal engineering audit catalogs (full findings with line refs) and the
# distilled open-bug backlog. Local maintainer reference only, not public docs.
/docs/archive/
/docs/open-backlog.md

# Local agent orientation file (build/deploy gotchas, architecture map).
# Per-developer, not a public doc.
/CLAUDE.md

# Claude Code working state (per-machine: scheduled tasks, settings,
# MCP config). MCP URL is public but the file is per-developer.
.claude/
.mcp.json

# Stray dumps that occasionally spill into the repo root when SimHub's
# build tooling runs outside its expected output dir, or when Windows
# ildasm mangles a %TEMP% path into the output filename. All rooted so
# we don't accidentally ignore files with similar names elsewhere.
/SimHub.Plugins.*.resources
/*.leonardo.hex
/UsersmhyteAppDataLocalTemp*

# Farming Simulator mod build output. build-mod.py generates all of this from
# modDesc.xml and the Lua beside it: it writes the DDS icon itself (no external
# tooling) and zips one archive per game generation. Tracking the output meant
# carrying a stale TF4ALLTelemetry.zip once the script moved to per-generation
# names, and a committed zip can drift out of step with the Lua it came from.
# The sources stay tracked; run build-mod.py to produce the rest.
/gamemods/FarmingSimulator/*.zip
/gamemods/FarmingSimulator/TF4ALLTelemetry/tf4all.dds
